<Project>
  <!--
    Central package management. Every package added here MUST have its license
    verified (OSI-approved, MIT-compatible) and recorded in THIRD-PARTY-NOTICES.md.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <AvaloniaVersion>12.1.3</AvaloniaVersion>
    <RoslynVersion>5.9.0</RoslynVersion>
    <!-- Coverlet is bundled with the .NET test plugin (ADR 0011), not referenced: see its project file. -->
    <CoverletVersion>10.1.0</CoverletVersion>
    <!-- The last collector for test hosts before .NET 8 (netstandard2.0), bundled next to the current one (M33, ADR 0030). -->
    <CoverletLegacyCollectorVersion>6.0.4</CoverletLegacyCollectorVersion>
  </PropertyGroup>
  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <PackageVersion Include="TextMateSharp.Grammars" Version="2.0.3" />
    <PackageVersion Include="Dock.Avalonia" Version="12.1.0.7" />
    <PackageVersion Include="Dock.Model.Mvvm" Version="12.1.0.7" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.7" />
  </ItemGroup>
  <ItemGroup Label="Language services and build host">
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="$(RoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="$(RoslynVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="$(RoslynVersion)" />
    <PackageVersion Include="ICSharpCode.Decompiler" Version="11.1.0.9782" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
    <PackageVersion Include="Microsoft.Build" Version="17.11.48" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="17.11.48" />
    <PackageVersion Include="Microsoft.NET.StringTools" Version="18.4.0" />
    <!-- Compile-time only: at run time the build host uses the NuGet that ships in the user's SDK (ADR 0012). -->
    <PackageVersion Include="NuGet.Credentials" Version="6.11.2" />
    <PackageVersion Include="NuGet.Protocol" Version="6.11.2" />
  </ItemGroup>
  <ItemGroup Label="Installers and self-update (M31, M32; keep in step with the vpk version in eng/package.sh)">
    <PackageVersion Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.DXGI" Version="3.8.3" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Testing (the .NET test plugin, ADR 0010 and 0011)">
    <PackageVersion Include="Microsoft.TestPlatform.TranslationLayer" Version="18.10.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <!-- CI's hang dumps: they name the tests still running when a test process hangs. -->
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.0.2" />
  </ItemGroup>
</Project>
