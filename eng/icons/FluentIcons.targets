<Project>
  <!--
    Compiles the shell's Fluent UI System Icons (Icons/Fluent/*.svg) into C# geometries before the compiler runs (D24,
    M34a). The task is inline C# (RoslynCodeTaskFactory), so it builds with the SDK on every OS and needs no tool.
  -->
  <PropertyGroup>
    <FluentIconsSource>$(MSBuildThisFileDirectory)CompileFluentIcons.cs</FluentIconsSource>
    <!-- IntermediateOutputPath isn't set yet where projects import this; the output is the same for every configuration. -->
    <FluentIconsOutput>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)FluentIcons/FluentIcons.g.cs</FluentIconsOutput>
  </PropertyGroup>

  <ItemGroup>
    <FluentIcon Include="$(MSBuildProjectDirectory)/Icons/Fluent/*.svg" />
    <!-- Shown in the IDE, not compiled. -->
    <None Remove="@(FluentIcon)" />
  </ItemGroup>

  <UsingTask TaskName="CompileFluentIcons" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Icons ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs" Source="$(FluentIconsSource)" />
    </Task>
  </UsingTask>

  <Target Name="CompileFluentIcons" Inputs="@(FluentIcon);$(FluentIconsSource);$(MSBuildThisFileFullPath)" Outputs="$(FluentIconsOutput)">
    <CompileFluentIcons Icons="@(FluentIcon)" OutputFile="$(FluentIconsOutput)" />
  </Target>

  <Target Name="IncludeFluentIcons" BeforeTargets="CoreCompile" DependsOnTargets="CompileFluentIcons">
    <ItemGroup>
      <Compile Include="$(FluentIconsOutput)" />
      <FileWrites Include="$(FluentIconsOutput)" />
    </ItemGroup>
  </Target>
</Project>
