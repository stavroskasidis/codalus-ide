# Maintainer: Stavros Kasidis (https://github.com/stavroskasidis)
# The AUR package of a stable release (filled in by eng/aur.sh): the published .tar.gz as it is, with the desktop
# entry, icon and license from the release's tag. Nothing is built or stripped (the shell is a Native AOT binary, the
# hosts are .NET assemblies).
pkgname=codalus-bin
pkgver={{VERSION}}
pkgrel=1
pkgdesc='Cross-platform, open-source IDE for .NET'
arch=('x86_64' 'aarch64')
url='https://github.com/stavroskasidis/codalus-ide'
license=('MIT')
depends=('git' 'icu' 'fontconfig')
optdepends=('dotnet-sdk: open, build and run solutions (required for any solution; .NET 11 or later runs the hosts)')
provides=('codalus')
conflicts=('codalus')
options=('!strip' '!debug')
_raw="https://raw.githubusercontent.com/stavroskasidis/codalus-ide/v${pkgver}"
source=("codalus.desktop::${_raw}/eng/packaging/linux/codalus.desktop"
        "codalus.png::${_raw}/assets/logo/png/codalus-256.png"
        "LICENSE::${_raw}/LICENSE")
source_x86_64=("${url}/releases/download/v${pkgver}/codalus-${pkgver}-linux-x64.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/codalus-${pkgver}-linux-arm64.tar.gz")
sha256sums=('{{SHA256_DESKTOP}}'
            '{{SHA256_ICON}}'
            '{{SHA256_LICENSE}}')
sha256sums_x86_64=('{{SHA256_X64}}')
sha256sums_aarch64=('{{SHA256_ARM64}}')

package() {
  install -d "$pkgdir/opt" "$pkgdir/usr/bin"
  cp -a codalus "$pkgdir/opt/codalus"
  ln -s /opt/codalus/codalus "$pkgdir/usr/bin/codalus"
  install -Dm644 codalus.desktop "$pkgdir/usr/share/applications/codalus.desktop"
  install -Dm644 codalus.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/codalus.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
