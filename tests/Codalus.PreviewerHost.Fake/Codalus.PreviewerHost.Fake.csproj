<Project Sdk="Microsoft.NET.Sdk">
  <!-- A stand-in designer host for the previewer's session tests: it speaks Avalonia's remote protocol and holds answers back as Avalonia's designer can. -->
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <AssemblyName>codalus-fake-previewer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="xunit.v3.mtp-v2" />
    <PackageReference Remove="Microsoft.Testing.Extensions.HangDump" />
    <Using Remove="Xunit" />
    <PackageReference Include="Avalonia.Remote.Protocol" />
  </ItemGroup>
</Project>
