<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The metadata navigation tests read this assembly's own sources from its embedded PDB. -->
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Windows Forms designer's frames, pixel by pixel (#78). -->
    <Compile Include="..\Shared\PngPixels.cs" Link="Shared\PngPixels.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Codalus.LanguageServices.Host\Codalus.LanguageServices.Host.csproj" />
    <ProjectReference Include="..\..\src\Codalus.Workbench\Codalus.Workbench.csproj" />
    <!-- Built so the tests can launch it; not referenced as an assembly. -->
    <ProjectReference Include="..\..\src\Codalus.Projects.Host\Codalus.Projects.Host.csproj" ReferenceOutputAssembly="false" />
    <!-- The Windows Forms designer's host (Windows only tests; built everywhere). -->
    <ProjectReference Include="..\..\src\Codalus.WinForms.Designer\Codalus.WinForms.Designer.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" />
  </ItemGroup>
</Project>
