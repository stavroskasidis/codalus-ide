  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <AssemblyName>codalus-lsp-conformance</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="xunit.v3.mtp-v2" />
    <PackageReference Remove="Microsoft.Testing.Extensions.HangDump" />
    <Using Remove="Xunit" />
    <ProjectReference Include="..\..\src\Codalus.Rpc\Codalus.Rpc.csproj" />
  </ItemGroup>
</Project>
