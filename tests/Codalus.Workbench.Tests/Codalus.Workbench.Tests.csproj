<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The Secret Service test sets the native environment (LibraryImport of setenv). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Codalus.Workbench\Codalus.Workbench.csproj" />
    <ProjectReference Include="..\..\src\Codalus.Platform\Codalus.Platform.csproj" />
    <!-- Built so the tests can launch it; not referenced as an assembly. -->
    <ProjectReference Include="..\..\src\Codalus.Interactive.Host\Codalus.Interactive.Host.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Codalus.LspConformance.Server\Codalus.LspConformance.Server.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Codalus.AcpAgent.Fake\Codalus.AcpAgent.Fake.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Codalus.PreviewerHost.Fake\Codalus.PreviewerHost.Fake.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Codalus.Markup.Host\Codalus.Markup.Host.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Codalus.Remote.Server\Codalus.Remote.Server.csproj" ReferenceOutputAssembly="false" />
    <!-- Launched by the tests, and referenced for its plan parsers (internals visible to these tests). -->
    <ProjectReference Include="..\..\src\Codalus.Data.Host\Codalus.Data.Host.csproj" />
    <!-- Launched by the tests, and referenced for its profile views (internals visible to these tests). -->
    <ProjectReference Include="..\..\src\Codalus.Diagnostics.Host\Codalus.Diagnostics.Host.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The previewer agent (a startup hook) next to the tests, where PreviewService finds it (M19a). -->
    <ProjectReference Include="..\..\src\Codalus.Previewer.Agent\Codalus.Previewer.Agent.csproj" />
    <PackageReference Include="Avalonia.Remote.Protocol" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\MockHttpServer.cs" Link="Shared\MockHttpServer.cs" />
    <!-- Properties and items of the fixtures' projects, read from MSBuild's answer file. -->
    <Compile Include="..\Shared\MSBuildQuery.cs" Link="Shared\MSBuildQuery.cs" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The WPF previewer (M40b): its WPF-free reading of the root's start tag is tested on every OS; the designer host and
      the live agent (WPF code) are built for the Windows-only tests, which run them from its bin folder.
    -->
    <Compile Include="..\..\src\Codalus.Previewer.Wpf\DesignXaml.cs" Link="Shared\WpfDesignXaml.cs" />
    <ProjectReference Include="..\..\src\Codalus.Previewer.Wpf\Codalus.Previewer.Wpf.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" />
  </ItemGroup>
</Project>
