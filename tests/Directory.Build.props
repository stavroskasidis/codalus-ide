<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test names read better with underscores. -->
    <NoWarn>$(NoWarn);CA1707;CA2201</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Fixtures copied out of the repository keep its SDK (M30). -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/FixtureSdk.cs" Link="Shared/FixtureSdk.cs" />
    <!-- The repository's target framework, for paths to built hosts and plugins (M30b). -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/RepoBuild.cs" Link="Shared/RepoBuild.cs" />
    <!-- The WSL distribution the remote tests use, when it has the tests' .NET. -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/WslStandIn.cs" Link="Shared/WslStandIn.cs" />
    <!-- Stand-in programs written so they start ("Text file busy" on Linux, #209). -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/StandInScript.cs" Link="Shared/StandInScript.cs" />
    <!-- Names a test that hangs and prints the stacks while the process still runs (CI's silent macOS hangs). Test
         projects only: the stand-in tools here have no xUnit (items see the project's own IsTestProject). -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/TestWatchdog.cs" Link="Shared/TestWatchdog.cs" Condition="'$(IsTestProject)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets tests locate fixtures under samples/ and built binaries under src/. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CodalusRepoRoot</_Parameter1>
      <_Parameter2>$(CodalusRepoRoot)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CodalusConfiguration</_Parameter1>
      <_Parameter2>$(Configuration)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CodalusTargetFramework</_Parameter1>
      <_Parameter2>$(TargetFramework)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
