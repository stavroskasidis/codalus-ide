<Project Sdk="Microsoft.NET.Sdk">
  <!-- A stand-in for dotnet-svcutil (CODALUS_SVCUTIL) for the WCF reference tests: it records its arguments and writes recorded output. -->
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <AssemblyName>codalus-fake-svcutil</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="xunit.v3.mtp-v2" />
    <PackageReference Remove="Microsoft.Testing.Extensions.HangDump" />
    <Using Remove="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The code dotnet-svcutil 8.0.0 generated for samples/Wcf's client. -->
    <EmbeddedResource Include="..\..\samples\Wcf\CalculatorClient\Connected Services\CalculatorService\Reference.cs" LogicalName="Reference.cs" />
  </ItemGroup>
</Project>
