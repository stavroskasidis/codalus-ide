<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <Company>Codalus IDE contributors</Company>
    <Product>Codalus IDE</Product>
    <Copyright>Copyright (c) Codalus IDE contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/stavroskasidis/codalus-ide</RepositoryUrl>

    <!-- Central place for repo-relative paths used by tests and benchmarks. -->
    <CodalusRepoRoot>$(MSBuildThisFileDirectory)</CodalusRepoRoot>

    <!-- The version of the next release (M31, D21). Release builds stamp it with -p:Version; local builds add -dev. -->
    <CodalusVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</CodalusVersion>
  </PropertyGroup>
</Project>
