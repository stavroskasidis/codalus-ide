<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daedalus.Shell.ViewModels"
             xmlns:controls="using:Daedalus.Shell.Controls"
             x:Class="Daedalus.Shell.Views.ErrorListView"
             x:DataType="vm:ErrorListViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="6,4">
      <ComboBox SelectedIndex="0" x:Name="Scope" MinWidth="150" AutomationProperties.Name="Scope">
        <ComboBoxItem Content="Entire Solution" />
        <ComboBoxItem Content="Current Document" />
      </ComboBox>
      <ToggleButton Classes="toolbar" IsChecked="{Binding ShowErrors}" AutomationProperties.Name="{Binding ErrorsLabel}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <controls:Icon Kind="error" Classes="error" />
          <TextBlock Text="{Binding ErrorsLabel}" />
        </StackPanel>
      </ToggleButton>
      <ToggleButton Classes="toolbar" IsChecked="{Binding ShowWarnings}" AutomationProperties.Name="{Binding WarningsLabel}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <controls:Icon Kind="warning" Classes="warning" />
          <TextBlock Text="{Binding WarningsLabel}" />
        </StackPanel>
      </ToggleButton>
      <ToggleButton Classes="toolbar" IsChecked="{Binding ShowMessages}" AutomationProperties.Name="{Binding MessagesLabel}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <controls:Icon Kind="info" />
          <TextBlock Text="{Binding MessagesLabel}" />
        </StackPanel>
      </ToggleButton>
      <TextBox Text="{Binding Filter}" Watermark="Search Error List" MinWidth="200" AutomationProperties.Name="Search Error List" />
    </StackPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="28,90,*,140,200" Margin="8,2" >
      <TextBlock Grid.Column="1" Classes="muted" Text="Code" />
      <TextBlock Grid.Column="2" Classes="muted" Text="Description" />
      <TextBlock Grid.Column="3" Classes="muted" Text="Project" />
      <TextBlock Grid.Column="4" Classes="muted" Text="File" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="12,8" Text="No problems." IsVisible="{Binding IsEmpty}" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="Error List">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ErrorListRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ErrorListRow">
          <Grid ColumnDefinitions="28,90,*,140,200">
            <controls:Icon Kind="{Binding Icon}" Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" />
            <TextBlock Grid.Column="1" Text="{Binding Code}" />
            <TextBlock Grid.Column="2" Text="{Binding Description}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" />
            <TextBlock Grid.Column="3" Text="{Binding Project}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="4" Text="{Binding Location}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
