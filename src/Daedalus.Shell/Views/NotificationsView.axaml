<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daedalus.Shell.ViewModels"
             xmlns:views="using:Daedalus.Shell.Views"
             xmlns:controls="using:Daedalus.Shell.Controls"
             x:Class="Daedalus.Shell.Views.NotificationsView"
             x:DataType="vm:NotificationsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="6,4">
      <Button Classes="toolbar"
              Command="{Binding ClearAllCommand}"
              ToolTip.Tip="Clear All Notifications"
              AutomationProperties.Name="Clear all notifications">
        <controls:Icon Kind="clear-all" />
      </Button>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="12,8" Text="No new notifications." IsVisible="{Binding IsEmpty}" />
    <ListBox x:Name="List" ItemsSource="{Binding Items}" Background="Transparent" AutomationProperties.Name="Notifications">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:NotificationViewModel">
          <Setter Property="Padding" Value="0" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:NotificationViewModel">
          <views:NotificationCard />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
