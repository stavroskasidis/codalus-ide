<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daedalus.Shell.ViewModels"
             x:Class="Daedalus.Shell.Views.VariablesView"
             x:DataType="vm:VariablesViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="12,8" Text="Variables appear here while the program is stopped." IsVisible="{Binding IsEmpty}" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" Background="Transparent" AutomationProperties.Name="Variables">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:VariableNode">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="vm:VariableNode" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Value}" Classes.error="{Binding IsError}" TextTrimming="CharacterEllipsis" MaxWidth="600" ToolTip.Tip="{Binding Value}" />
            <TextBlock Text="{Binding Type}" Classes="muted" IsVisible="{Binding HasType}" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
