<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daedalus.Shell.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="Daedalus.Shell.Views.TextFileView"
             x:DataType="vm:TextFileDocument">
  <ae:TextEditor x:Name="Editor"
                 Document="{Binding Text}"
                 ShowLineNumbers="True"
                 FontFamily="{Binding Font.Family}"
                 FontSize="{Binding Font.Size}"
                 Background="{DynamicResource Shell.Editor.Background}"
                 Foreground="{DynamicResource Shell.Editor.Foreground}"
                 LineNumbersForeground="{DynamicResource Shell.Editor.LineNumbers}"
                 Padding="4,2"
                 AutomationProperties.Name="{Binding FilePath}" />
</UserControl>
