<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daedalus.Shell.ViewModels"
             xmlns:controls="using:Daedalus.Shell.Controls"
             x:Class="Daedalus.Shell.Views.PluginsView"
             x:DataType="vm:PluginsViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="12,8" TextWrapping="Wrap"
               Text="No plugins are installed. Put plugins in the user plugins folder or pass --plugin-dir."
               IsVisible="{Binding IsEmpty}" />
    <ListBox x:Name="List" ItemsSource="{Binding Plugins}" Background="Transparent" AutomationProperties.Name="Installed plugins">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:PluginRowViewModel">
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:PluginRowViewModel">
          <StackPanel Spacing="2" Margin="2,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Kind="extensions" VerticalAlignment="Center" />
              <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
              <TextBlock Classes="muted" FontSize="11" Text="{Binding State}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="muted" FontSize="11" Text="{Binding Details}" TextWrapping="Wrap" />
            <TextBlock Foreground="{DynamicResource Shell.Error}" FontSize="11" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
