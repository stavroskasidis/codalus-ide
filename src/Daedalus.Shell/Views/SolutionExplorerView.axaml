<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daedalus.Shell.ViewModels"
             xmlns:controls="using:Daedalus.Shell.Controls"
             x:Class="Daedalus.Shell.Views.SolutionExplorerView"
             x:DataType="vm:SolutionExplorerViewModel">
  <Grid>
    <StackPanel Margin="12" Spacing="10" IsVisible="{Binding !HasSolution}">
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="No solution is open." />
      <Button Content="Open Solution…" HorizontalAlignment="Left" Command="{Binding OpenSolutionCommand}" />
    </StackPanel>
    <ListBox x:Name="List"
             ItemsSource="{Binding Rows}"
             SelectedItem="{Binding Selected}"
             IsVisible="{Binding HasSolution}"
             Background="Transparent"
             DragDrop.AllowDrop="True"
             AutomationProperties.Name="Solution Explorer">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ExplorerRowViewModel">
          <Setter Property="Padding" Value="0,1" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
        <Style Selector="ListBoxItem.dropTarget">
          <Setter Property="BorderBrush" Value="{DynamicResource Shell.Focus}" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.linked">
          <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style Selector="TextBlock.startup">
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ExplorerRowViewModel">
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="{Binding Indent}" Background="Transparent" ToolTip.Tip="{Binding Node.Path}">
            <Border Classes="chevron" Width="16" Height="18" Background="Transparent">
              <controls:Icon Kind="{Binding Chevron}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <controls:Icon Kind="{Binding Icon}" Classes.warning="{Binding IsWarning}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Classes.linked="{Binding IsLinked}" Classes.startup="{Binding IsStartup}" />
            <TextBlock Classes="muted" FontSize="11" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
