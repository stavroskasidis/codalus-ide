<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Daedalus.Shell"
        xmlns:vm="using:Daedalus.Shell.ViewModels"
        xmlns:views="using:Daedalus.Shell.Views"
        xmlns:controls="using:Daedalus.Shell.Controls"
        x:Class="Daedalus.Shell.Views.MainWindow"
        x:DataType="shell:ShellHost"
        Title="Daedalus Studio"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Daedalus Studio">

  <Window.Resources>
    <DataTemplate x:Key="StatusItemTemplate" x:DataType="vm:StatusItemViewModel">
      <Button Classes="statusbar"
              Command="{Binding Command}"
              IsTabStop="{Binding IsInteractive}"
              ToolTip.Tip="{Binding Tooltip}"
              AutomationProperties.Name="{Binding AccessibleName}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <controls:Icon Kind="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="14" Height="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Text}" IsVisible="{Binding HasText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <Menu x:Name="MenuBar" DockPanel.Dock="Top" AutomationProperties.Name="Menu bar" />

    <Border x:Name="StatusBarHost"
            DockPanel.Dock="Bottom"
            Background="{DynamicResource Shell.StatusBar}"
            BorderBrush="{DynamicResource Shell.StatusBar.Border}"
            BorderThickness="0,1,0,0"
            MinHeight="24"
            IsVisible="{Binding StatusBar.IsVisible}"
            AutomationProperties.Name="Status bar">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <ItemsControl ItemsSource="{Binding StatusBar.Left}" ItemTemplate="{StaticResource StatusItemTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Column="1"
                   Text="{Binding StatusBar.Message}"
                   Foreground="{DynamicResource Shell.StatusBar.Foreground}"
                   FontSize="12"
                   Margin="12,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   AutomationProperties.LiveSetting="Polite" />
        <ItemsControl Grid.Column="2" ItemsSource="{Binding StatusBar.Right}" ItemTemplate="{StaticResource StatusItemTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </Border>

    <Grid>
      <DockControl x:Name="Dock" Layout="{Binding Layout.Root}" Factory="{Binding Layout.Factory}" />

      <ItemsControl x:Name="Toasts"
                    ItemsSource="{Binding Notifications.Toasts}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="440"
                    Margin="0,0,14,14"
                    AutomationProperties.Name="Notification toasts">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NotificationViewModel">
            <views:NotificationCard Margin="0,8,0,0" Floating="True" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Panel x:Name="PaletteLayer" Background="Transparent" IsVisible="{Binding Palette.IsOpen}">
        <views:QuickPickView x:Name="Palette"
                             DataContext="{Binding Palette}"
                             Width="640"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Margin="0,6,0,0" />
      </Panel>
    </Grid>
  </DockPanel>
</Window>
