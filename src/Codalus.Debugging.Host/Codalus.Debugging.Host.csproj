<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- On .NET 10 when installed, else the next newer .NET (ADR 0025). -->
    <RollForward>Major</RollForward>
    <AssemblyName>codalus-debughost</AssemblyName>
    <RootNamespace>Codalus.Debugging.Host</RootNamespace>
    <Description>The debug companion host (M14b, ADR 0032): the debuggee's debugger attributes, dumps (ClrMD) and Create Dump, over JSON-RPC on stdio; with --mono-dap, the Mono debugger adapter over DAP (M20b, ADR 0065); with --netfx-dap, the desktop-CLR (.NET Framework) debugger adapter over DAP on Windows (M43b, ADR 0076); with --clr-dap, CoreCLR's debugger adapter over DAP, and with --launch, the program it launches started through dbgshim (M54, ADR 0086); with --activate-app, a packaged Windows app started through Windows (M44, ADR 0074).</Description>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Source-generated COM interop: IApplicationActivationManager, to start packaged apps (M44). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      The launcher (the launch mode, ADR 0086) runs with the debugged program's environment, so a DOTNET_STARTUP_HOOKS meant
      for the program would run in it too; nothing here uses startup hooks.
    -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codalus.Rpc\Codalus.Rpc.csproj" />
    <ProjectReference Include="..\Codalus.Debugging\Codalus.Debugging.csproj" />
    <!-- The Mono debugger adapter's protocol client (M20b, ADR 0065; MIT, vendored). -->
    <ProjectReference Include="..\ThirdParty\Mono.Debugger.Soft\Mono.Debugger.Soft.csproj" />
    <!-- Not used by the host: shipped beside it in debughost/, for programs debugged in the terminal (M14c). -->
    <ProjectReference Include="..\Codalus.Debugging.StartupHook\Codalus.Debugging.StartupHook.csproj" />
    <!-- Likewise: the XAML previewer's agent, loaded into Avalonia's designer host (M19a, ADR 0048). -->
    <ProjectReference Include="..\Codalus.Previewer.Agent\Codalus.Previewer.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- It loads into the user's program, on whatever .NET that runs: plain IL, not code compiled for ours. -->
    <PublishReadyToRunExclude Include="Codalus.Debugging.StartupHook.dll" />
    <PublishReadyToRunExclude Include="Codalus.Previewer.Agent.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
    <!--
      The ICorDebug wrappers (MIT) of the desktop-CLR debugger adapter (M43b, ADR 0076) and, on every OS, CoreCLR's
      (M54, ADR 0086): COM interop only, the runtime's own mscordbi does the work.
    -->
    <PackageReference Include="ClrDebug" />
    <!--
      dbgshim (MIT), which starts CoreCLR programs for the debugger and finds their runtime's mscordbi (ADR 0086): a
      publish for a runtime identifier takes its platform's library, a build without one (the tests) every platform's
      under runtimes/, which the deps.json resolves.
    -->
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.win-x64" />
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.linux-x64" />
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.linux-arm64" />
    <PackageReference Include="Microsoft.Diagnostics.DbgShim.osx-arm64" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Codalus.Debugging.Tests" />
  </ItemGroup>
</Project>
