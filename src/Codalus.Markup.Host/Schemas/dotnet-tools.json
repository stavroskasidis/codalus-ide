{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dotnet-tools.json",
  "description": "The repository's local .NET tools (`dotnet tool restore`).",
  "type": "object",
  "properties": {
    "version": { "type": "integer", "const": 1, "description": "The manifest format version." },
    "isRoot": { "type": "boolean", "description": "Whether the search for manifests stops here." },
    "tools": {
      "type": "object",
      "description": "Tools by package id.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": { "type": "string", "description": "The package version." },
          "commands": { "type": "array", "items": { "type": "string" }, "description": "The commands the tool adds (`dotnet <command>`)." },
          "rollForward": { "type": "boolean", "description": "Whether the tool may run on a newer runtime." }
        },
        "required": [ "version", "commands" ]
      }
    }
  },
  "required": [ "version", "tools" ]
}
