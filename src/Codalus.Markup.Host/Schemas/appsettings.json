{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "appsettings.json",
  "description": "ASP.NET Core and generic host configuration. Any section is allowed; the well-known ones are described here.",
  "type": "object",
  "properties": {
    "Logging": {
      "type": "object",
      "description": "Logging configuration.",
      "properties": {
        "LogLevel": { "$ref": "#/definitions/logLevels" },
        "Console": { "type": "object", "properties": { "LogLevel": { "$ref": "#/definitions/logLevels" }, "FormatterName": { "type": "string", "enum": [ "simple", "json", "systemd" ] } } },
        "Debug": { "type": "object", "properties": { "LogLevel": { "$ref": "#/definitions/logLevels" } } },
        "EventLog": { "type": "object", "properties": { "LogLevel": { "$ref": "#/definitions/logLevels" } } }
      },
      "additionalProperties": { "type": "object", "properties": { "LogLevel": { "$ref": "#/definitions/logLevels" } } }
    },
    "AllowedHosts": { "type": "string", "description": "Host names the app answers to, separated by `;` (`*` allows all)." },
    "ConnectionStrings": { "type": "object", "description": "Connection strings by name (`GetConnectionString(name)`).", "additionalProperties": { "type": "string" } },
    "Kestrel": {
      "type": "object",
      "description": "Kestrel web server options.",
      "properties": {
        "Endpoints": {
          "type": "object",
          "description": "Endpoints by name.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "Url": { "type": "string", "description": "e.g. `https://localhost:5001`." },
              "Protocols": { "type": "string", "enum": [ "Http1", "Http2", "Http1AndHttp2", "Http3", "Http1AndHttp2AndHttp3", "None" ] },
              "Certificate": { "type": "object" }
            },
            "required": [ "Url" ]
          }
        },
        "Limits": { "type": "object" }
      }
    },
    "Urls": { "type": "string", "description": "The URLs the app listens on, separated by `;`." }
  },
  "definitions": {
    "logLevels": {
      "type": "object",
      "description": "Minimum levels by category (`Default`, `Microsoft.AspNetCore`, …).",
      "additionalProperties": { "type": "string", "enum": [ "Trace", "Debug", "Information", "Warning", "Error", "Critical", "None" ] }
    }
  }
}
