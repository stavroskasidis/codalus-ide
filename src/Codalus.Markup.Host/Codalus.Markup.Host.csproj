<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- On .NET 10 when installed, else the next newer .NET (ADR 0025). -->
    <RollForward>Major</RollForward>
    <AssemblyName>codalus-markuphost</AssemblyName>
    <RootNamespace>Codalus.Markup.Host</RootNamespace>
    <Description>Language server for JSON, XML and MSBuild, YAML and .editorconfig (ADR 0016), speaking LSP over stdio.</Description>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codalus.Rpc\Codalus.Rpc.csproj" />
    <ProjectReference Include="..\Codalus.LanguageServices.Protocol\Codalus.LanguageServices.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schemas\*.json" LogicalName="Schemas.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Codalus.Workbench.Tests" />
  </ItemGroup>
</Project>
