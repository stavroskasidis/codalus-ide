<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- On .NET 10 when installed, else the next newer .NET (ADR 0025). -->
    <RollForward>Major</RollForward>
    <AssemblyName>daedalus-t4host</AssemblyName>
    <RootNamespace>DaedalusStudio.TextTemplating.Host</RootNamespace>
    <Description>Out-of-process T4 host (ADR 0035): runs text templates with Mono.TextTemplating. Template code runs here, never in the shell.</Description>
    <!-- Templates compile and load assemblies at run time; the host runs on the regular JIT runtime. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DaedalusStudio.Rpc\DaedalusStudio.Rpc.csproj" />
    <ProjectReference Include="..\DaedalusStudio.TextTemplating.Protocol\DaedalusStudio.TextTemplating.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.TextTemplating" />
    <PackageReference Include="Mono.TextTemplating.Roslyn" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DaedalusStudio.Workbench.Tests" />
  </ItemGroup>
</Project>