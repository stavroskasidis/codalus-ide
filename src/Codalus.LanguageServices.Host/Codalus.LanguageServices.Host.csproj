<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- On .NET 10 when installed, else the next newer .NET (ADR 0025). -->
    <RollForward>Major</RollForward>
    <AssemblyName>codalus-lshost</AssemblyName>
    <RootNamespace>Codalus.LanguageServices.Host</RootNamespace>
    <Description>Out-of-process C# language service host (Roslyn, ADR 0005) speaking LSP over stdio.</Description>
    <!-- Roslyn relies on reflection (MEF, analyzers); the host runs on the regular JIT runtime. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- Roslyn ships messages in 13 languages; the IDE is English for now. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codalus.Rpc\Codalus.Rpc.csproj" />
    <ProjectReference Include="..\Codalus.LanguageServices.Protocol\Codalus.LanguageServices.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
    <!-- Visual Basic (M35): the same Roslyn, in the same workspace. -->
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Features" />
    <PackageReference Include="ICSharpCode.Decompiler" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Codalus.LanguageServices.Host.Tests" />
  </ItemGroup>
</Project>
