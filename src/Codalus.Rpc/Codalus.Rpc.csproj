<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>AOT-safe, bidirectional JSON-RPC 2.0 (LSP framing) and supervised service processes.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Codalus.Rpc.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- ProcessTree.Kill: a host's process tree is ended without .NET's walk, which blocks on macOS. -->
    <ProjectReference Include="..\Codalus.Platform\Codalus.Platform.csproj" />
  </ItemGroup>
</Project>
