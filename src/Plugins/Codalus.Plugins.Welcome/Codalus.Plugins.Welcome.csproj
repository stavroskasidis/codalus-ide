<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Built-in Welcome plugin: the Start page, implemented on the public plugin API only (ADR 0003).</Description>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The plugin host provides the API at runtime, so it is not copied next to the plugin. -->
    <ProjectReference Include="..\..\Codalus.Plugins.Abstractions\Codalus.Plugins.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Update="codalus-plugin.json;codalus-plugin.nls*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
