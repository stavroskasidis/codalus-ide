<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Built-in AI providers (M28a, ADR 0062): OpenAI-compatible endpoints (OpenAI, or a local server) and Anthropic, on the proposed AI provider API. Nothing is sent until the user turns AI on and chooses one.</Description>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The plugin host provides the API at runtime, so it is not copied next to the plugin. -->
    <ProjectReference Include="..\..\Codalus.Plugins.Abstractions\Codalus.Plugins.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Update="codalus-plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Codalus.Plugins.Tests" />
  </ItemGroup>
</Project>
