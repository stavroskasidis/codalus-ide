<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Built-in Templates plugin: New Project and New Solution from dotnet new templates, on the public plugin API only.</Description>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Daedalus.Plugins.Abstractions\Daedalus.Plugins.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Update="daedalus-plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Daedalus.Plugins.Tests" />
  </ItemGroup>
</Project>
