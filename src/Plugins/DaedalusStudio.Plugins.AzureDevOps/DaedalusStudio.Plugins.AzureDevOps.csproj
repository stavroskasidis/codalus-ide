<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Built-in Azure DevOps plugin (ADR 0031): pull requests, review comments, pipelines, work items and publishing, on the proposed hosting API. Inactive until the user signs in.</Description>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The plugin host provides the API at runtime, so it is not copied next to the plugin. -->
    <ProjectReference Include="..\..\DaedalusStudio.Plugins.Abstractions\DaedalusStudio.Plugins.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\DaedalusStudio.Plugins.Hosting\DaedalusStudio.Plugins.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="daedalus-plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DaedalusStudio.Plugins.Tests" />
  </ItemGroup>
</Project>
