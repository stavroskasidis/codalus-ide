<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>daedalus</AssemblyName>
    <RootNamespace>DaedalusStudio.Shell</RootNamespace>
    <Description>Daedalus Studio: the Avalonia shell (Native AOT).</Description>
    <VersionPrefix>$(DaedalusVersion)</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\logo\daedalus.ico</ApplicationIcon>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- LibraryImport (AttachConsole) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The plugin host is referenced only for build order; it is published framework-dependent next to the shell. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Third-party trim/AOT warnings (Dock default templates, reflection bindings in library XAML) are
         reported, not fatal. Our own code must stay warning-free; see docs/adr/0001-ui-stack.md. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2026;IL3050</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DaedalusStudio.Workbench\DaedalusStudio.Workbench.csproj" />
    <ProjectReference Include="..\DaedalusStudio.Diagnostics.BenchEvents\DaedalusStudio.Diagnostics.BenchEvents.csproj" />
  </ItemGroup>

  <!-- Shipped next to the shell but not referenced: helper processes and the built-in plugins. -->
  <ItemGroup>
    <HelperProcess Include="..\DaedalusStudio.Plugins.Host\DaedalusStudio.Plugins.Host.csproj" Folder="pluginhost" />
    <HelperProcess Include="..\DaedalusStudio.Projects.Host\DaedalusStudio.Projects.Host.csproj" Folder="buildhost" />
    <HelperProcess Include="..\DaedalusStudio.LanguageServices.Host\DaedalusStudio.LanguageServices.Host.csproj" Folder="lshost" />
    <HelperProcess Include="..\DaedalusStudio.Interactive.Host\DaedalusStudio.Interactive.Host.csproj" Folder="replhost" />
    <HelperProcess Include="..\DaedalusStudio.Markup.Host\DaedalusStudio.Markup.Host.csproj" Folder="markuphost" />
    <HelperProcess Include="..\DaedalusStudio.Data.Host\DaedalusStudio.Data.Host.csproj" Folder="datahost" />
    <HelperProcess Include="..\DaedalusStudio.Debugging.Host\DaedalusStudio.Debugging.Host.csproj" Folder="debughost" />
    <HelperProcess Include="..\DaedalusStudio.TextTemplating.Host\DaedalusStudio.TextTemplating.Host.csproj" Folder="t4host" />
    <ProjectReference Include="@(HelperProcess)" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot" />
    <BuiltInPlugin Include="..\Plugins\DaedalusStudio.Plugins.Welcome\DaedalusStudio.Plugins.Welcome.csproj" PluginId="daedalus.welcome" />
    <BuiltInPlugin Include="..\Plugins\DaedalusStudio.Plugins.Templates\DaedalusStudio.Plugins.Templates.csproj" PluginId="daedalus.templates" />
    <BuiltInPlugin Include="..\Plugins\DaedalusStudio.Plugins.DotNetTest\DaedalusStudio.Plugins.DotNetTest.csproj" PluginId="daedalus.dotnettest" />
    <BuiltInPlugin Include="..\Plugins\DaedalusStudio.Plugins.GitHub\DaedalusStudio.Plugins.GitHub.csproj" PluginId="daedalus.github" />
    <BuiltInPlugin Include="..\Plugins\DaedalusStudio.Plugins.AzureDevOps\DaedalusStudio.Plugins.AzureDevOps.csproj" PluginId="daedalus.azuredevops" />
    <BuiltInPlugin Include="..\Plugins\DaedalusStudio.Plugins.GitLab\DaedalusStudio.Plugins.GitLab.csproj" PluginId="daedalus.gitlab" />
    <ProjectReference Include="@(BuiltInPlugin)" ReferenceOutputAssembly="false" Private="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="AvaloniaEdit.TextMate" />
    <PackageReference Include="Dock.Avalonia" />
    <PackageReference Include="Dock.Model.Mvvm" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DaedalusStudio.Shell.Tests" />
  </ItemGroup>

  <!-- The smoke test's mock GitHub (M13b): the same source as the tests' mock servers, so nothing reaches GitHub. -->
  <ItemGroup>
    <Compile Include="..\..\tests\Shared\MockHttpServer.cs" Link="Infrastructure\Mocks\MockHttpServer.cs" />
    <Compile Include="..\..\tests\Shared\MockGitHub.cs" Link="Infrastructure\Mocks\MockGitHub.cs" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\logo\daedalus.ico" Link="Assets\daedalus.ico" />
    <!-- Built-in snippets, one file per language (M12b). -->
    <EmbeddedResource Include="Editor\Snippets\*.json" LogicalName="DaedalusStudio.Shell.Snippets.%(Filename).json" />
  </ItemGroup>

  <!-- Terminal shell integration scripts (ADR 0014), next to the shell in terminal/. Dotfiles are listed explicitly. -->
  <ItemGroup>
    <None Include="WebServers\package.json" Link="web-servers\package.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="WebServers\package-lock.json" Link="web-servers\package-lock.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Grammars\http.tmLanguage.json" Link="grammars\http.tmLanguage.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="Grammars\t4.tmLanguage.json" Link="grammars\t4.tmLanguage.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ShellIntegration\daedalus-bash.sh" Link="terminal\daedalus-bash.sh" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ShellIntegration\daedalus.ps1" Link="terminal\daedalus.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ShellIntegration\zsh\.zshrc" Link="terminal\zsh\.zshrc" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="ShellIntegration\zsh\.zshenv" Link="terminal\zsh\.zshenv" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Layout next to the shell executable:
      pluginhost/                 daedalus-pluginhost (framework-dependent, ReadyToRun when published)
      buildhost/                  daedalus-buildhost (likewise; MSBuild comes from the installed SDK)
      lshost/                     daedalus-lshost, the C# language service (likewise)
      replhost/                   daedalus-replhost, C# Interactive (likewise)
      markuphost/                 daedalus-markuphost, JSON/XML/MSBuild/YAML/.editorconfig (likewise)
      datahost/                   daedalus-datahost, databases and the SQL language server (likewise)
      debughost/                  daedalus-debughost, the debug companion: debugger attributes, dumps (likewise),
                                  and DaedalusStudio.Debugging.StartupHook.dll for programs debugged in the terminal
      plugins/<plugin id>/        built-in plugins
      terminal/                   shell integration scripts for the integrated terminal
  -->
  <Target Name="DaedalusBundleForBuild" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_DaedalusHostFiles Include="%(HelperProcess.RootDir)%(HelperProcess.Directory)bin\$(Configuration)\net10.0\**\*">
        <Folder>%(HelperProcess.Folder)</Folder>
      </_DaedalusHostFiles>
    </ItemGroup>
    <Copy SourceFiles="@(_DaedalusHostFiles)" DestinationFiles="@(_DaedalusHostFiles->'$(OutDir)%(Folder)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="DaedalusCopyBuiltInPlugins" Properties="DaedalusPluginTarget=$(OutDir)plugins\" />
  </Target>

  <Target Name="DaedalusBundleForPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_DaedalusPublishDir>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_DaedalusPublishDir>
    </PropertyGroup>
    <MSBuild Projects="%(HelperProcess.FullPath)" Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=false;PublishReadyToRun=true;PublishDir=$(_DaedalusPublishDir)%(HelperProcess.Folder)\"
             RemoveProperties="PublishAot;_IsPublishing" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="DaedalusCopyBuiltInPlugins" Properties="DaedalusPluginTarget=$(_DaedalusPublishDir)plugins\" />
  </Target>

  <Target Name="DaedalusCopyBuiltInPlugins">
    <ItemGroup>
      <_DaedalusPluginFiles Include="%(BuiltInPlugin.RootDir)%(BuiltInPlugin.Directory)bin\$(Configuration)\net10.0\*.dll;%(BuiltInPlugin.RootDir)%(BuiltInPlugin.Directory)bin\$(Configuration)\net10.0\*.pdb;%(BuiltInPlugin.RootDir)%(BuiltInPlugin.Directory)bin\$(Configuration)\net10.0\daedalus-plugin.json">
        <PluginId>%(BuiltInPlugin.PluginId)</PluginId>
      </_DaedalusPluginFiles>
    </ItemGroup>
    <Copy SourceFiles="@(_DaedalusPluginFiles)" DestinationFiles="@(_DaedalusPluginFiles->'$(DaedalusPluginTarget)%(PluginId)\%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- Tools a plugin bundles in a coverage/ subfolder (the .NET test plugin's Coverlet, ADR 0011). -->
    <ItemGroup>
      <_DaedalusPluginTools Include="%(BuiltInPlugin.RootDir)%(BuiltInPlugin.Directory)bin\$(Configuration)\net10.0\coverage\**\*">
        <PluginId>%(BuiltInPlugin.PluginId)</PluginId>
      </_DaedalusPluginTools>
    </ItemGroup>
    <Copy SourceFiles="@(_DaedalusPluginTools)" DestinationFiles="@(_DaedalusPluginTools->'$(DaedalusPluginTarget)%(PluginId)\coverage\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
