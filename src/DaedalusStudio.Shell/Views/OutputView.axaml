<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:output="using:DaedalusStudio.Workbench.Output"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="DaedalusStudio.Shell.Views.OutputView"
             x:DataType="vm:OutputViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="6,4">
      <ComboBox x:Name="Channels"
                MinWidth="220"
                ItemsSource="{Binding Channels}"
                SelectedItem="{Binding Selected}"
                AutomationProperties.Name="Output channel">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="output:OutputChannel">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Classes="toolbar" Command="{Binding ClearCommand}" ToolTip.Tip="Clear Output" AutomationProperties.Name="Clear output">
        <controls:Icon Kind="clear-all" />
      </Button>
      <ToggleButton Classes="toolbar" IsChecked="{Binding ScrollLock}" ToolTip.Tip="Scroll Lock" AutomationProperties.Name="Scroll lock">
        <controls:Icon Kind="lock" />
      </ToggleButton>
    </StackPanel>
    <ae:TextEditor x:Name="Editor"
                   IsReadOnly="True"
                   ShowLineNumbers="False"
                   WordWrap="{Binding WordWrap}"
                   FontFamily="{Binding Font.Family}"
                   FontSize="{Binding Font.Size}"
                   Background="{DynamicResource Shell.Editor.Background}"
                   Foreground="{DynamicResource Shell.Editor.Foreground}"
                   Padding="6,2"
                   AutomationProperties.Name="Output text" />
  </DockPanel>
</UserControl>
