<UserControl xmlns:l="using:DaedalusStudio.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.DumpView"
             x:DataType="vm:DumpViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <TextBlock Margin="8,6,8,2" Text="{Binding Header}" Classes="muted" TextTrimming="CharacterEllipsis" />
    <Border Grid.Row="1" Margin="8,2,8,4" Padding="6,3" IsVisible="{Binding HasException}"
            Background="{DynamicResource Shell.Hover}" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" CornerRadius="3">
      <TextBlock Text="{Binding Exception}" TextWrapping="Wrap" AutomationProperties.Name="{l:T dump.theDumpSException}" />
    </Border>

    <TabControl Grid.Row="2" x:Name="Tabs" Margin="4,0" SelectionChanged="OnTabChanged">
      <TabItem Header="{l:T dump.threads}">
        <Grid ColumnDefinitions="320,4,*">
          <ListBox ItemsSource="{Binding Threads}" SelectedItem="{Binding SelectedThread}" AutomationProperties.Name="{l:T dump.threads}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DumpThreadRow">
                <StackPanel Margin="2,1" AutomationProperties.Name="{Binding AccessibleName}">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Exception}" IsVisible="{Binding HasException}" Foreground="{DynamicResource Shell.Error}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding TopFrame}" Classes="muted" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
          <ListBox Grid.Column="2" x:Name="FrameList" ItemsSource="{Binding Frames}" DoubleTapped="OnFrameDoubleTapped" AutomationProperties.Name="{l:T dump.callStack}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DumpFrameRow">
                <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                  <TextBlock Text="{Binding Method}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
                  <TextBlock Grid.Column="1" Text="{Binding Location}" Classes="muted" Margin="12,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </TabItem>
      <TabItem Header="{l:T dump.heap}">
        <Grid ColumnDefinitions="*,4,180,4,*">
          <ListBox ItemsSource="{Binding Heap}" SelectedItem="{Binding SelectedHeapType}" AutomationProperties.Name="{l:T dump.heapTypesBySize}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DumpHeapRow">
                <Grid ColumnDefinitions="*,90,90" Margin="2,0">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Count}" TextAlignment="Right" Classes="muted" />
                  <TextBlock Grid.Column="2" Text="{Binding Size}" TextAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
          <ListBox Grid.Column="2" x:Name="InstanceList" ItemsSource="{Binding Instances}" SelectionChanged="OnInstanceSelected" AutomationProperties.Name="{l:T dump.objectsOfTheType}"
                   FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
          <GridSplitter Grid.Column="3" ResizeDirection="Columns" />
          <Grid Grid.Column="4" RowDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Margin="2">
              <Button Content="{l:T dump.back}" Click="OnBack" IsEnabled="{Binding CanGoBack}" Margin="0,0,6,0" />
              <TextBlock Text="{Binding ObjectTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ListBox Grid.Row="1" x:Name="FieldList" ItemsSource="{Binding Fields}" DoubleTapped="OnFieldDoubleTapped" AutomationProperties.Name="{l:T dump.fields}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DumpFieldRow">
                  <Grid ColumnDefinitions="150,*" Margin="2,0" ToolTip.Tip="{Binding Type}">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="3" Margin="8,2" Text="{Binding Status}" Classes="muted" />
  </Grid>
</UserControl>
