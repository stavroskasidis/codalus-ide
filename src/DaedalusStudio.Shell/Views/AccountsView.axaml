<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             x:Class="DaedalusStudio.Shell.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,18" Spacing="12" MaxWidth="780" HorizontalAlignment="Left">
      <TextBlock Classes="heading" FontSize="18" Text="Git Hosting Accounts" />
      <TextBlock TextWrapping="Wrap" Classes="muted"
                 Text="Sign in to see pull requests, review comments, CI status and work items, and to publish repositories. Nothing is sent to a host until you sign in to it." />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <controls:Icon Kind="lock" VerticalAlignment="Center" />
        <TextBlock TextWrapping="Wrap" Text="{Binding StoreText}" VerticalAlignment="Center" />
      </StackPanel>
      <Border IsVisible="{Binding IsDisabled}" Background="{DynamicResource Shell.Hover}" CornerRadius="3" Padding="10,6">
        <TextBlock TextWrapping="Wrap" Text="Hosting integration is turned off: the setting hosting.enabled." />
      </Border>
      <ItemsControl ItemsSource="{Binding Providers}" AutomationProperties.Name="Hosting providers">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AccountProviderRow">
            <Border BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10"
                    AutomationProperties.Name="{Binding AccessibleName}">
              <StackPanel Spacing="8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="accent" Content="Sign In" Command="{Binding SignInCommand}" IsVisible="{Binding CanSignIn}" AutomationProperties.Name="{Binding Label, StringFormat='Sign in to {0}'}" />
                    <Button Content="Sign Out" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" AutomationProperties.Name="{Binding Label, StringFormat='Sign out of {0}'}" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding IsSigningIn}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:Icon Kind="cloud" Width="20" Height="20" VerticalAlignment="Center" />
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock Text="{Binding StatusText}" Classes="muted" />
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                <Border IsVisible="{Binding HasCode}" Background="{DynamicResource Shell.Hover}" CornerRadius="3" Padding="12,8">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Enter this code in your browser to approve the sign-in:" TextWrapping="Wrap" />
                    <SelectableTextBlock Text="{Binding UserCode}" FontSize="24" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" AutomationProperties.Name="Device code" />
                    <TextBlock Text="{Binding VerificationUri}" Classes="muted" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="accent" Content="Copy Code and Open Browser" Command="{Binding CopyAndOpenCommand}" />
                      <TextBlock Text="Waiting for approval…" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <StackPanel IsVisible="{Binding CanSignIn}" Spacing="4">
                  <TextBlock Classes="muted" Text="Or sign in with a personal access token:" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Text="{Binding Token}" PasswordChar="●" Width="340" PlaceholderText="Personal access token" AutomationProperties.Name="{Binding Label, StringFormat='Personal access token for {0}'}" />
                    <Button Content="Sign In with Token" Command="{Binding SignInWithTokenCommand}" />
                  </StackPanel>
                  <TextBlock Classes="muted" FontSize="11" Text="{Binding ServerHint}" IsVisible="{Binding HasServerHint}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
