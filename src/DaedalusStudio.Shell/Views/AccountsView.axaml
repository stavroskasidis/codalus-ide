<UserControl xmlns:l="using:DaedalusStudio.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             x:Class="DaedalusStudio.Shell.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,18" Spacing="12" MaxWidth="780" HorizontalAlignment="Left">
      <TextBlock Classes="heading" Text="{l:T accounts.gitHostingAccounts}" />
      <TextBlock TextWrapping="Wrap" Classes="muted"
                 Text="{l:T accounts.signInToSeePullRequests}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <controls:Icon Kind="lock" VerticalAlignment="Center" />
        <TextBlock TextWrapping="Wrap" Text="{Binding StoreText}" VerticalAlignment="Center" />
      </StackPanel>
      <Border IsVisible="{Binding IsDisabled}" Background="{DynamicResource Shell.Hover}" CornerRadius="3" Padding="10,6">
        <TextBlock TextWrapping="Wrap" Text="{l:T accounts.hostingIntegrationIsTurnedOffThe}" />
      </Border>
      <ItemsControl ItemsSource="{Binding Providers}" AutomationProperties.Name="{l:T accounts.hostingProviders}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AccountProviderRow">
            <Border BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10"
                    AutomationProperties.Name="{Binding AccessibleName}">
              <StackPanel Spacing="8">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="accent" Content="{l:T accounts.signIn}" Command="{Binding SignInCommand}" IsVisible="{Binding CanSignIn}" AutomationProperties.Name="{Binding Label, StringFormat='Sign in to {0}'}" />
                    <Button Content="{l:T accounts.signOut}" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}" AutomationProperties.Name="{Binding Label, StringFormat='Sign out of {0}'}" />
                    <Button Content="{l:T accounts.cancel}" Command="{Binding CancelCommand}" IsVisible="{Binding IsSigningIn}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:Icon Kind="cloud" Width="20" Height="20" VerticalAlignment="Center" />
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" Classes="subheading" />
                      <TextBlock Text="{Binding StatusText}" Classes="muted" />
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                <Border IsVisible="{Binding HasCode}" Background="{DynamicResource Shell.Hover}" CornerRadius="3" Padding="12,8">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{l:T accounts.enterThisCodeInYourBrowser}" TextWrapping="Wrap" />
                    <SelectableTextBlock Text="{Binding UserCode}" FontSize="24" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" AutomationProperties.Name="{l:T accounts.deviceCode}" />
                    <TextBlock Text="{Binding VerificationUri}" Classes="muted" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="accent" Content="{l:T accounts.copyCodeAndOpenBrowser}" Command="{Binding CopyAndOpenCommand}" />
                      <TextBlock Text="{l:T accounts.waitingForApproval}" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Border>
                <StackPanel IsVisible="{Binding CanSignIn}" Spacing="4">
                  <TextBlock Classes="muted" Text="{l:T accounts.orSignInWithAPersonal}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox Text="{Binding Token}" PasswordChar="●" Width="340" PlaceholderText="{l:T accounts.personalAccessToken}" AutomationProperties.Name="{Binding Label, StringFormat='Personal access token for {0}'}" />
                    <Button Content="{l:T accounts.signInWithToken}" Command="{Binding SignInWithTokenCommand}" />
                  </StackPanel>
                  <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding ServerHint}" IsVisible="{Binding HasServerHint}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
