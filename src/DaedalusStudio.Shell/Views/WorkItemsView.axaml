<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             x:Class="DaedalusStudio.Shell.Views.WorkItemsView"
             x:DataType="vm:WorkItemsViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="4,3">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
        <Button Classes="toolbar" Command="{Binding MentionCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Mention in the commit message" AutomationProperties.Name="Mention in Commit Message">
          <controls:Icon Kind="edit" />
        </Button>
        <Button Classes="toolbar" Command="{Binding OpenCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="Open in Browser" AutomationProperties.Name="Open in Browser">
          <controls:Icon Kind="link-external" />
        </Button>
        <Button Classes="toolbar" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" AutomationProperties.Name="Refresh Work Items">
          <controls:Icon Kind="refresh" />
        </Button>
      </StackPanel>
      <TextBox Text="{Binding Search}" PlaceholderText="Search by number or words (empty: assigned to me)" AutomationProperties.Name="Search work items" />
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" FontWeight="SemiBold" Margin="8,4,8,2" />
    <StackPanel DockPanel.Dock="Top" Margin="12,6" Spacing="8" IsVisible="{Binding HasMessage}">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="muted" />
      <Button Classes="accent" Content="{Binding SignInLabel}" Command="{Binding SignInCommand}" IsVisible="{Binding CanSignIn}" HorizontalAlignment="Left" />
    </StackPanel>
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="Work items">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:WorkItemRow">
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:WorkItemRow">
          <StackPanel Spacing="1">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <controls:Icon Kind="issue" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Reference}" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" Margin="22,0,0,0" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
