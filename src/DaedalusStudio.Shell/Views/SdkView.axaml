<local:LoadingView xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
                   xmlns:local="using:DaedalusStudio.Shell.Views"
                   xmlns:protocol="using:DaedalusStudio.Projects.Protocol"
                   x:Class="DaedalusStudio.Shell.Views.SdkView"
                   x:DataType="vm:SdkViewModel">
  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock Classes="heading" Text=".NET SDKs" />
      <TextBlock TextWrapping="Wrap" Text="{Binding ResolvedText}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding GlobalJsonText}" />
      <TextBlock Foreground="{DynamicResource Shell.Warning}" TextWrapping="Wrap" Text="{Binding Warning}" IsVisible="{Binding HasWarning}" />
      <TextBlock Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
    <Grid ColumnDefinitions="*,16,*">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4" Text="Installed SDKs" />
        <!-- Wraps rather than clipping when the column is narrow (M34's checklist). -->
        <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,8,0,0">
          <Button Content="Use This SDK" Command="{Binding PinCommand}" ToolTip.Tip="Writes global.json next to the solution and reloads it" />
          <TextBlock VerticalAlignment="Center" Text="Roll forward:" />
          <ComboBox MinWidth="130" ItemsSource="{x:Static vm:SdkViewModel.RollForwardOptions}" SelectedItem="{Binding RollForward}" AutomationProperties.Name="Roll forward" />
          <Button Content="Remove Pin" Command="{Binding UnpinCommand}" />
          <Button Classes="link" Content="Refresh" Command="{Binding RefreshCommand}" />
        </WrapPanel>
        <ListBox ItemsSource="{Binding Sdks}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Installed SDKs">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SdkRow">
              <StackPanel>
                <TextBlock Text="{Binding Display}" />
                <TextBlock Classes="muted" FontSize="11" Text="{Binding Support}" IsVisible="{Binding !IsOutOfSupport}" />
                <TextBlock Foreground="{DynamicResource Shell.Warning}" FontSize="11" Text="{Binding Support}" IsVisible="{Binding IsOutOfSupport}" />
                <TextBlock Classes="muted" FontSize="11" Text="{Binding Path}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4" Text="Workloads" />
        <TextBlock DockPanel.Dock="Top" Classes="muted" Text="No workloads are installed." IsVisible="{Binding !HasWorkloads}" />
        <ListBox ItemsSource="{Binding Workloads}" AutomationProperties.Name="Workloads">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="protocol:DotnetWorkload">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Id}" />
                <TextBlock Classes="muted" Text="{Binding Version}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</local:LoadingView>
