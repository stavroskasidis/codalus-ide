<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.ExceptionSettingsView"
             x:DataType="vm:ExceptionSettingsViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="6,4">
      <TextBox x:Name="Search" Text="{Binding Filter}" PlaceholderText="Search exception types" AutomationProperties.Name="Search exception types" />
      <Button x:Name="CheckAll" Grid.Column="1" Margin="6,0,0,0" Content="Break on All" ToolTip.Tip="Break when any exception is thrown" AutomationProperties.Name="Break on all exceptions" />
      <Button x:Name="UncheckAll" Grid.Column="2" Margin="6,0,0,0" Content="Break on None" ToolTip.Tip="Break only on user-unhandled exceptions" AutomationProperties.Name="Break on no thrown exceptions" />
      <Button x:Name="Reset" Grid.Column="3" Margin="6,0,0,0" Content="Restore Defaults" AutomationProperties.Name="Restore the default exception settings" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="10,2,10,4" TextWrapping="Wrap"
               Text="Checked types break when they are thrown, even if they are caught. User-unhandled exceptions always break. Types match exactly: a base type doesn't cover derived ones." />
    <CheckBox DockPanel.Dock="Top" Margin="10,2" IsChecked="{Binding BreakOnOthers}" Content="All other exception types (not in this list)" AutomationProperties.Name="Break on all other exception types" />
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="6,4">
      <TextBox x:Name="NewType" Text="{Binding NewType}" PlaceholderText="Add a type by its full name, e.g. MyApp.ValidationException (Enter)" AutomationProperties.Name="New exception type" />
      <Button x:Name="Add" Grid.Column="1" Margin="6,0,0,0" Content="Add" AutomationProperties.Name="Add exception type" />
    </Grid>
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="Exception types">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ExceptionTypeRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ExceptionTypeRow">
          <CheckBox IsChecked="{Binding BreakWhenThrown}" Content="{Binding Type}" AutomationProperties.Name="{Binding Type}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
