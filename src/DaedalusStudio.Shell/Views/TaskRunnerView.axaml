<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.TaskRunnerView"
             x:DataType="vm:TaskRunnerViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6,4">
      <Button x:Name="Run" Content="Run" AutomationProperties.Name="Run the selected script" />
      <Button x:Name="Restore" Content="Restore Packages" AutomationProperties.Name="Restore the selected package.json's npm packages" />
      <Button x:Name="Refresh" Content="Refresh" AutomationProperties.Name="Refresh the npm scripts" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="12,8" Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="npm scripts">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:TaskRunnerRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TaskRunnerRow">
          <Panel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsHeader}">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail}" Classes="muted" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !IsHeader}" Margin="12,0,0,0">
              <TextBlock Text="{Binding Label}" Classes="accent" MinWidth="120" />
              <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="muted" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Panel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
