<UserControl xmlns:l="using:DaedalusStudio.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.EndpointsExplorerView"
             x:DataType="vm:EndpointsExplorerViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="6,4">
      <TextBox x:Name="Search" Text="{Binding Filter}" PlaceholderText="{l:T endpointsExplorer.searchRoutesAndHandlers}" AutomationProperties.Name="{l:T endpointsExplorer.searchEndpoints}" />
      <Button x:Name="Refresh" Grid.Column="1" Margin="6,0,0,0" Content="{l:T endpointsExplorer.refresh}" AutomationProperties.Name="{l:T endpointsExplorer.refreshEndpoints}" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{Binding Status}" IsVisible="{Binding HasStatus}" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T endpointsExplorer.endpoints}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:EndpointRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:EndpointRow">
          <Panel>
            <TextBlock Text="{Binding Route}" FontWeight="SemiBold" IsVisible="{Binding IsHeader}" />
            <Grid ColumnDefinitions="76,*,Auto" IsVisible="{Binding !IsHeader}" Margin="12,0,0,0">
              <TextBlock Text="{Binding Method}" FontWeight="SemiBold" Classes="accent" />
              <TextBlock Grid.Column="1" Text="{Binding Route}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding Handler}" Classes="muted" Margin="12,0,0,0" />
            </Grid>
          </Panel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
