<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.AspireView"
             x:DataType="vm:AspireViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6,4">
      <Button x:Name="Dashboard" Content="Open Dashboard" IsEnabled="{Binding HasDashboard}" AutomationProperties.Name="Open the Aspire dashboard in the browser" />
      <Button x:Name="Start" Content="Start" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Start the selected resource" />
      <Button x:Name="Stop" Content="Stop" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Stop the selected resource" />
      <Button x:Name="Restart" Content="Restart" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Restart the selected resource" />
      <Button x:Name="Browse" Content="Open Endpoint" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Open the selected resource's endpoint in the browser" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="12,4" Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="2*,4,3*">
      <ListBox x:Name="ResourceList" ItemsSource="{Binding Resources}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="Aspire resources">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:AspireResourceRow">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:AspireResourceRow">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="{Binding StateGlyph}" Classes="accent" Margin="0,0,6,0" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" Classes="muted" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <TabControl Grid.Column="2" Padding="0">
        <TabItem Header="Console">
          <TextBox x:Name="LogText" Text="{Binding Logs}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" AutomationProperties.Name="The resource's console output" />
        </TabItem>
        <TabItem Header="Environment">
          <ListBox ItemsSource="{Binding Environment}" Background="Transparent" AutomationProperties.Name="Environment variables">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContainerPropertyRow">
                <Grid ColumnDefinitions="260,*">
                  <TextBlock Text="{Binding Name}" Classes="accent" TextTrimming="CharacterEllipsis" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="Details">
          <ListBox ItemsSource="{Binding Properties}" Background="Transparent" AutomationProperties.Name="Endpoints and properties">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContainerPropertyRow">
                <Grid ColumnDefinitions="220,*">
                  <TextBlock Text="{Binding Name}" Classes="accent" TextTrimming="CharacterEllipsis" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
