<local:LoadingView xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
                   xmlns:local="using:DaedalusStudio.Shell.Views"
                   x:Class="DaedalusStudio.Shell.Views.TemplateManagerView"
                   x:DataType="vm:TemplateManagerViewModel">
  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
      <TextBlock Classes="heading" Text="Templates" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="The dotnet new template packages installed for you. New Project and Add New Item offer their templates." />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="PackageBox" Text="{Binding Package}" PlaceholderText="A package id (Id or Id@version), a .nupkg or a template folder" AutomationProperties.Name="Template package to install" />
        <Button Grid.Column="1" Margin="6,0,0,0" Content="Install" Command="{Binding InstallCommand}" AutomationProperties.Name="Install template package" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="Uninstall" Command="{Binding UninstallCommand}" />
        <Button Content="Check for Updates" Command="{Binding CheckUpdatesCommand}" />
        <Button Content="Update All" Command="{Binding UpdateAllCommand}" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        <ProgressBar IsIndeterminate="True" Width="80" Height="2" MinHeight="2" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Status}" />
      </StackPanel>
    </StackPanel>
    <TextBox DockPanel.Dock="Bottom" Height="110" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Output}"
             FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" AutomationProperties.Name="dotnet new output" />
    <Grid ColumnDefinitions="*,*">
      <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Installed template packages">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TemplatePackageRowViewModel">
            <StackPanel Margin="0,2" AutomationProperties.Name="{Binding AccessibleName}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{Binding Id}" />
                <TextBlock Classes="muted" Text="{Binding Version}" />
                <TextBlock Foreground="{DynamicResource Shell.Link}" Text="{Binding Latest, StringFormat='update: {0}'}" IsVisible="{Binding HasUpdate}" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Detail}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="1" Margin="8,0,0,0" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}">
        <StackPanel Spacing="4">
          <TextBlock FontWeight="SemiBold" Text="{Binding Selected.Id}" />
          <TextBlock Classes="muted" Text="Templates:" />
          <TextBlock TextWrapping="Wrap" Text="{Binding Selected.TemplatesText}" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</local:LoadingView>
