<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.ContainersView"
             x:DataType="vm:ContainersViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6,4">
      <Button x:Name="Refresh" Content="Refresh" AutomationProperties.Name="Refresh the containers and images" />
      <Button x:Name="Start" Content="Start" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Start the selected container" />
      <Button x:Name="Stop" Content="Stop" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Stop the selected container" />
      <Button x:Name="Restart" Content="Restart" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Restart the selected container" />
      <Button x:Name="Remove" Content="Remove" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Remove the selected container" />
      <Button x:Name="Browse" Content="Open in Browser" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Open the selected container's first published port in the browser" />
      <Button x:Name="Terminal" Content="Open Terminal" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Open a terminal in the selected container" />
      <Button x:Name="Attach" Content="Attach Debugger" IsEnabled="{Binding HasSelection}" AutomationProperties.Name="Attach the debugger to a process in the selected container" />
      <TextBlock Classes="muted" VerticalAlignment="Center" Text="Working…" IsVisible="{Binding IsBusy}" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="12,4" Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="2*,4,3*">
      <TabControl Grid.Column="0" Padding="0">
        <TabItem Header="Containers">
          <ListBox x:Name="ContainerList" ItemsSource="{Binding Containers}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="Containers">
            <ListBox.Styles>
              <Style Selector="ListBoxItem" x:DataType="vm:ContainerRow">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContainerRow">
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Text="{Binding StateGlyph}" Classes="accent" Margin="0,0,6,0" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="Images">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
              <Button x:Name="RemoveImage" Content="Remove Image" AutomationProperties.Name="Remove the selected image" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" Background="Transparent" AutomationProperties.Name="Images">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ImageRow">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <TabControl Grid.Column="2" Padding="0" SelectedIndex="{Binding Tab}">
        <TabItem Header="Logs">
          <TextBox x:Name="LogText" Text="{Binding Logs}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" AutomationProperties.Name="Container logs" />
        </TabItem>
        <TabItem Header="Environment">
          <ListBox ItemsSource="{Binding Environment}" Background="Transparent" AutomationProperties.Name="Environment variables">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContainerPropertyRow">
                <Grid ColumnDefinitions="220,*">
                  <TextBlock Text="{Binding Name}" Classes="accent" TextTrimming="CharacterEllipsis" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="Ports">
          <ListBox ItemsSource="{Binding Ports}" Background="Transparent" AutomationProperties.Name="Ports and mounts">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContainerPropertyRow">
                <Grid ColumnDefinitions="220,*">
                  <TextBlock Text="{Binding Name}" Classes="accent" TextTrimming="CharacterEllipsis" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="Labels">
          <ListBox ItemsSource="{Binding Labels}" Background="Transparent" AutomationProperties.Name="Labels">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContainerPropertyRow">
                <Grid ColumnDefinitions="260,*">
                  <TextBlock Text="{Binding Name}" Classes="accent" TextTrimming="CharacterEllipsis" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="Files">
          <DockPanel>
            <TextBox x:Name="PathBox" DockPanel.Dock="Top" Margin="4" Text="{Binding FilesPath}" AutomationProperties.Name="Folder in the container (Enter lists it)" />
            <ListBox x:Name="FileList" ItemsSource="{Binding Files}" Background="Transparent" AutomationProperties.Name="Files in the container">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ContainerFileRow">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
