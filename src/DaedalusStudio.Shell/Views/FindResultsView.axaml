<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.FindResultsView"
             x:DataType="vm:FindResultsViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,180,Auto" Margin="6,4">
      <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="Find in files" AutomationProperties.Name="Find in files" />
      <ToggleButton Grid.Column="1" Classes="toolbar" Content="Aa" IsChecked="{Binding MatchCase}" ToolTip.Tip="Match case" AutomationProperties.Name="Match case" Margin="4,0,0,0" />
      <ToggleButton Grid.Column="2" Classes="toolbar" Content="ab" IsChecked="{Binding WholeWord}" ToolTip.Tip="Match whole word" AutomationProperties.Name="Match whole word" />
      <ToggleButton Grid.Column="3" Classes="toolbar" Content=".*" IsChecked="{Binding UseRegex}" ToolTip.Tip="Use regular expressions" AutomationProperties.Name="Use regular expressions" />
      <TextBox Grid.Column="4" Text="{Binding Include}" PlaceholderText="Files (e.g. *.cs)" AutomationProperties.Name="File types" Margin="4,0" />
      <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4">
        <Button Content="Find All" Command="{Binding SearchCommand}" AutomationProperties.Name="Find all" />
        <Button Content="Stop" Command="{Binding CancelCommand}" IsVisible="{Binding IsSearching}" AutomationProperties.Name="Stop searching" />
      </StackPanel>
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="10,2" Text="{Binding Summary}" AutomationProperties.LiveSetting="Polite" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="Find results">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:FindResultRow">
          <Setter Property="Padding" Value="4,1" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FindResultRow">
          <TextBlock Text="{Binding Display}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12"
                     FontWeight="{Binding IsHeader, Converter={x:Static vm:FindResultsStyles.Weight}}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
