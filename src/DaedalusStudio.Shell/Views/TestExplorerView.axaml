<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             x:Class="DaedalusStudio.Shell.Views.TestExplorerView"
             x:DataType="vm:TestExplorerViewModel">
  <DockPanel>
    <!-- Toolbar: run, debug, repeat, cancel; grouping, playlist and filter. -->
    <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,3">
      <Button Classes="toolbar" Command="{Binding RunAllCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="Run All Tests (Ctrl+R, A)" AutomationProperties.Name="Run All Tests">
        <controls:Icon Kind="run-all" />
      </Button>
      <Button Classes="toolbar" Command="{Binding RunSelectedCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="Run Selected Tests" AutomationProperties.Name="Run Selected Tests">
        <controls:Icon Kind="play" />
      </Button>
      <Button Classes="toolbar" Command="{Binding DebugSelectedCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="Debug Selected Tests" AutomationProperties.Name="Debug Selected Tests">
        <controls:Icon Kind="debug" />
      </Button>
      <Button Classes="toolbar" Command="{Binding CoverSelectedCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="Run Selected Tests with Coverage" AutomationProperties.Name="Run Selected Tests with Coverage">
        <controls:Icon Kind="coverage" />
      </Button>
      <Button Classes="toolbar" Command="{Binding RunFailedCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="Run Failed Tests" AutomationProperties.Name="Run Failed Tests">
        <controls:Icon Kind="test-failed" Classes="failed" />
      </Button>
      <Button Classes="toolbar" Command="{Binding RunNotRunCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="Run Tests That Have Not Run" AutomationProperties.Name="Run Tests That Have Not Run">
        <controls:Icon Kind="test-none" Classes="none" />
      </Button>
      <Button Classes="toolbar" Command="{Binding RepeatLastCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="Repeat Last Run (Ctrl+R, L)" AutomationProperties.Name="Repeat Last Run">
        <controls:Icon Kind="history" />
      </Button>
      <Button Classes="toolbar" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" ToolTip.Tip="Cancel" AutomationProperties.Name="Cancel Test Run">
        <controls:Icon Kind="stop" />
      </Button>
      <Button Classes="toolbar" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="Refresh (build and discover tests)" AutomationProperties.Name="Refresh Tests">
        <controls:Icon Kind="refresh" />
      </Button>
      <Button Classes="toolbar" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collapse All" AutomationProperties.Name="Collapse All">
        <controls:Icon Kind="collapse-all" />
      </Button>
      <ComboBox ItemsSource="{Binding Groupings}" SelectedIndex="{Binding GroupingIndex}" MinWidth="120" Margin="4,0" ToolTip.Tip="Group by" AutomationProperties.Name="Group by" />
      <ComboBox ItemsSource="{Binding PlaylistNames}" SelectedIndex="{Binding PlaylistIndex}" MinWidth="100" Margin="0,0,4,0" ToolTip.Tip="Playlist" AutomationProperties.Name="Playlist" />
      <TextBox x:Name="Filter" Text="{Binding FilterText}" MinWidth="180" PlaceholderText="Search (outcome:failed trait:Category=Math project:Name)" AutomationProperties.Name="Search Test Explorer" />
    </WrapPanel>
    <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="11" Margin="8,0,8,3" Text="{Binding Summary}" />

    <Grid RowDefinitions="*,Auto,Auto">
      <Grid>
        <TextBlock Classes="muted" Margin="12" TextWrapping="Wrap" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />
        <ListBox x:Name="List"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding Selected}"
                 IsVisible="{Binding HasTests}"
                 Background="Transparent"
                 AutomationProperties.Name="Test Explorer">
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="vm:TestRowViewModel">
              <Setter Property="Padding" Value="0,1" />
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TestRowViewModel">
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="{Binding Indent}" Background="Transparent" ToolTip.Tip="{Binding Tooltip}">
                <Border Classes="chevron" Width="16" Height="18" Background="Transparent">
                  <controls:Icon Kind="{Binding Chevron}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <controls:Icon Kind="{Binding OutcomeIcon}" VerticalAlignment="Center"
                               Classes.passed="{Binding Style.IsPassed}" Classes.failed="{Binding Style.IsFailed}" Classes.skipped="{Binding Style.IsSkipped}"
                               Classes.running="{Binding Style.IsRunning}" Classes.none="{Binding Style.IsNone}" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <TextBlock Classes="muted" FontSize="11" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" VerticalAlignment="Center" />
                <controls:Icon Kind="warning" Classes="warning" IsVisible="{Binding HasError}" ToolTip.Tip="{Binding Error}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Background="{DynamicResource Shell.Border}" IsVisible="{Binding HasDetails}" />

      <!-- Details of the selected test. -->
      <ScrollViewer Grid.Row="2" MaxHeight="320" IsVisible="{Binding HasDetails}" AutomationProperties.Name="Test details">
        <StackPanel Margin="10,6" Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:Icon Kind="{Binding DetailsIcon}"
                           Classes.passed="{Binding DetailsStyle.IsPassed}" Classes.failed="{Binding DetailsStyle.IsFailed}" Classes.skipped="{Binding DetailsStyle.IsSkipped}"
                           Classes.running="{Binding DetailsStyle.IsRunning}" Classes.none="{Binding DetailsStyle.IsNone}" />
            <SelectableTextBlock Text="{Binding DetailsTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Classes="muted" Text="{Binding DetailsOutcome}" />
          <Button Classes="link" Content="{Binding DetailsSource}" IsVisible="{Binding HasSource}" Click="OnOpenSource" AutomationProperties.Name="Open the test's source" />
          <StackPanel IsVisible="{Binding HasMessage}" Spacing="2">
            <TextBlock Classes="muted" Text="Message" />
            <SelectableTextBlock Text="{Binding DetailsMessage}" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" IsVisible="{Binding HasExpected}">
            <TextBlock Classes="muted" Text="Expected  " />
            <SelectableTextBlock Grid.Column="1" Text="{Binding DetailsExpected}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Classes="muted" Text="Actual  " />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailsActual}" TextWrapping="Wrap" />
          </Grid>
          <StackPanel IsVisible="{Binding HasFrames}" Spacing="1">
            <TextBlock Classes="muted" Text="Stack trace" />
            <ItemsControl ItemsSource="{Binding DetailsFrames}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StackFrameRow">
                  <Panel>
                    <Button Classes="link" IsVisible="{Binding HasLocation}" Click="OnOpenFrame" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Text}">
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                    </Button>
                    <TextBlock Classes="muted" IsVisible="{Binding !HasLocation}" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel IsVisible="{Binding HasOutput}" Spacing="2">
            <TextBlock Classes="muted" Text="Output" />
            <SelectableTextBlock Text="{Binding DetailsOutput}" TextWrapping="Wrap" FontSize="12" />
          </StackPanel>
          <StackPanel IsVisible="{Binding HasHistory}" Spacing="1">
            <TextBlock Classes="muted" Text="History" />
            <ItemsControl ItemsSource="{Binding DetailsHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRow">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:Icon Kind="{Binding Icon}"
                                   Classes.passed="{Binding Style.IsPassed}" Classes.failed="{Binding Style.IsFailed}" Classes.skipped="{Binding Style.IsSkipped}"
                                   Classes.none="{Binding Style.IsNone}" />
                    <TextBlock Text="{Binding Outcome}" MinWidth="60" />
                    <TextBlock Classes="muted" Text="{Binding When}" />
                    <TextBlock Classes="muted" Text="{Binding Duration}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
