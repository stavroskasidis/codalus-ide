<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.DataTipView"
             x:DataType="vm:DataTipViewModel">
  <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" Background="Transparent" MaxHeight="360" MinWidth="240" AutomationProperties.Name="Data tip">
    <TreeView.Styles>
      <Style Selector="TreeViewItem" x:DataType="vm:VariableNode">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        <Setter Property="MinHeight" Value="20" />
      </Style>
    </TreeView.Styles>
    <TreeView.ItemTemplate>
      <TreeDataTemplate x:DataType="vm:VariableNode" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Value}" Classes.error="{Binding IsError}" TextTrimming="CharacterEllipsis" MaxWidth="480" ToolTip.Tip="{Binding Value}" />
          <TextBlock Text="{Binding Type}" Classes="muted" IsVisible="{Binding HasType}" />
        </StackPanel>
      </TreeDataTemplate>
    </TreeView.ItemTemplate>
  </TreeView>
</UserControl>
