<UserControl xmlns:l="using:DaedalusStudio.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.HttpResponseView"
             x:DataType="vm:HttpResponseViewModel">
  <Grid ColumnDefinitions="*,4,280">
    <DockPanel>
      <SelectableTextBlock DockPanel.Dock="Top" Margin="8,6" Text="{Binding Summary}" FontWeight="SemiBold" Classes.error="{Binding IsError}" TextWrapping="Wrap" />
      <TabControl x:Name="Tabs" Padding="0">
        <TabItem Header="{l:T httpResponse.body}">
          <Border x:Name="BodyHost" />
        </TabItem>
        <TabItem Header="{l:T httpResponse.headers}">
          <ScrollViewer>
            <SelectableTextBlock Text="{Binding Headers}" FontFamily="{Binding Font.Family}" Margin="8" />
          </ScrollViewer>
        </TabItem>
        <TabItem Header="{l:T httpResponse.request}">
          <ScrollViewer>
            <SelectableTextBlock Text="{Binding RequestText}" FontFamily="{Binding Font.Family}" Margin="8" />
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </DockPanel>
    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
    <DockPanel Grid.Column="2">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="6,4">
        <TextBlock Text="{l:T httpResponse.history}" VerticalAlignment="Center" FontWeight="SemiBold" />
        <Button x:Name="Clear" Grid.Column="1" Content="{l:T httpResponse.clear}" AutomationProperties.Name="{l:T httpResponse.clearTheRequestHistory}" />
      </Grid>
      <ListBox ItemsSource="{Binding History}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="{l:T httpResponse.requestHistory}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:HttpHistoryRow">
            <Setter Property="Padding" Value="2" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:HttpHistoryRow">
            <Grid ColumnDefinitions="44,*,Auto">
              <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Classes.error="{Binding !IsSuccess}" />
              <TextBlock Grid.Column="1" Text="{Binding Request}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Request}" />
              <TextBlock Grid.Column="2" Text="{Binding Time}" Classes="muted" Margin="6,0,0,0" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
