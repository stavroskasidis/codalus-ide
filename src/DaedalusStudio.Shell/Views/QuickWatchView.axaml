<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.QuickWatchView"
             x:DataType="vm:QuickWatchViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="6,4">
      <TextBox x:Name="Input" Text="{Binding Expression}" PlaceholderText="Expression (Enter to evaluate)" AutomationProperties.Name="QuickWatch expression" />
      <Button x:Name="Reevaluate" Grid.Column="1" Margin="6,0,0,0" Content="Reevaluate" AutomationProperties.Name="Reevaluate" />
      <Button x:Name="AddWatch" Grid.Column="2" Margin="6,0,0,0" Content="Add Watch" AutomationProperties.Name="Add Watch" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="error" Margin="12,4" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" Background="Transparent" AutomationProperties.Name="QuickWatch value">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:VariableNode">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="vm:VariableNode" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Value}" Classes.error="{Binding IsError}" TextTrimming="CharacterEllipsis" MaxWidth="600" ToolTip.Tip="{Binding Value}" />
            <TextBlock Text="{Binding Type}" Classes="muted" IsVisible="{Binding HasType}" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
