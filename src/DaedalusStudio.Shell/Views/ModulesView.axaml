<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.ModulesView"
             x:DataType="vm:ModulesViewModel">
  <DockPanel>
    <TextBox x:Name="Search" DockPanel.Dock="Top" Margin="6,4" Text="{Binding Filter}" PlaceholderText="Search modules" AutomationProperties.Name="Search modules" />
    <Grid DockPanel.Dock="Top" ColumnDefinitions="40,240,200,70,*" Margin="8,2" IsVisible="{Binding !IsEmpty}">
      <TextBlock Text="#" Classes="muted" />
      <TextBlock Grid.Column="1" Text="Name" Classes="muted" />
      <TextBlock Grid.Column="2" Text="Symbol Status" Classes="muted" />
      <TextBlock Grid.Column="3" Text="Optimized" Classes="muted" />
      <TextBlock Grid.Column="4" Text="Path" Classes="muted" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="Modules appear here while debugging." IsVisible="{Binding IsEmpty}" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="Modules">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ModuleRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ModuleRow">
          <Grid ColumnDefinitions="40,240,200,70,*">
            <TextBlock Text="{Binding Order}" Classes="muted" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding SymbolStatus}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3" Text="{Binding Optimized}" />
            <TextBlock Grid.Column="4" Text="{Binding Path}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
