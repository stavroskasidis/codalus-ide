<UserControl xmlns:l="using:DaedalusStudio.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             xmlns:terminal="using:DaedalusStudio.Shell.Terminal"
             x:Class="DaedalusStudio.Shell.Views.TerminalView"
             x:DataType="vm:TerminalViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,2">
      <TextBlock Foreground="{DynamicResource Shell.Error}" Text="{Binding Error}" IsVisible="{Binding HasError}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
        <ComboBox x:Name="ProfilePicker" MinWidth="150" ItemsSource="{Binding Profiles}" AutomationProperties.Name="{l:T terminal.terminalProfile}" ToolTip.Tip="{l:T terminal.newTerminalWithThisProfile}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TerminalProfileChoice">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="toolbar" Command="{Binding NewCommand}" ToolTip.Tip="{l:T terminal.newTerminal}" AutomationProperties.Name="{l:T terminal.newTerminal2}">
          <TextBlock Text="+" FontWeight="Bold" />
        </Button>
        <Button Classes="toolbar" Command="{Binding SplitCommand}" ToolTip.Tip="{l:T terminal.splitTerminal}" AutomationProperties.Name="{l:T terminal.splitTerminal2}">
          <controls:Icon Kind="layout" />
        </Button>
        <Button Classes="toolbar" Command="{Binding FindCommand}" ToolTip.Tip="{l:T terminal.findCtrlF}" AutomationProperties.Name="{l:T terminal.findInTerminal}">
          <controls:Icon Kind="search" />
        </Button>
        <Button Classes="toolbar" Command="{Binding ClearCommand}" ToolTip.Tip="{l:T terminal.clearTerminal}" AutomationProperties.Name="{l:T terminal.clearTerminal2}">
          <controls:Icon Kind="clear-all" />
        </Button>
        <Button Classes="toolbar" Command="{Binding KillCommand}" ToolTip.Tip="{l:T terminal.killTerminal}" AutomationProperties.Name="{l:T terminal.killTerminal2}">
          <controls:Icon Kind="trash" />
        </Button>
      </StackPanel>
    </Grid>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto" Margin="4,0,4,2" IsVisible="{Binding FindVisible}">
      <TextBox x:Name="FindBox" Text="{Binding FindText}" PlaceholderText="{l:T terminal.findInTerminal}" AutomationProperties.Name="{l:T terminal.findInTerminal}" />
      <Button Grid.Column="1" Classes="toolbar" Click="OnFindPrevious" ToolTip.Tip="{l:T terminal.previousMatch}" AutomationProperties.Name="{l:T terminal.previousMatch}">
        <TextBlock Text="↑" />
      </Button>
      <Button Grid.Column="2" Classes="toolbar" Click="OnFindNext" ToolTip.Tip="{l:T terminal.nextMatch}" AutomationProperties.Name="{l:T terminal.nextMatch}">
        <TextBlock Text="↓" />
      </Button>
      <Button Grid.Column="3" Classes="toolbar" Command="{Binding FindCommand}" ToolTip.Tip="{l:T terminal.close}" AutomationProperties.Name="{l:T terminal.closeFind}">
        <controls:Icon Kind="close" />
      </Button>
    </Grid>
    <Grid ColumnDefinitions="*,Auto">
      <Grid x:Name="Panes" ColumnDefinitions="*,4,*">
        <DockPanel>
          <ScrollBar x:Name="PrimaryScroll" DockPanel.Dock="Right" Orientation="Vertical" AllowAutoHide="True" />
          <terminal:TerminalControl x:Name="Primary" />
        </DockPanel>
        <GridSplitter x:Name="Splitter" Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource Shell.Border}" />
        <DockPanel x:Name="SecondaryPane" Grid.Column="2">
          <ScrollBar x:Name="SecondaryScroll" DockPanel.Dock="Right" Orientation="Vertical" AllowAutoHide="True" />
          <terminal:TerminalControl x:Name="Secondary" />
        </DockPanel>
      </Grid>
      <TextBlock Classes="emptyState" Text="{l:T terminal.noTerminalIsOpenClickTo}" IsVisible="{Binding !HasTerminal}" />
      <ListBox Grid.Column="1" x:Name="TabList" Width="160" ItemsSource="{Binding Tabs}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:T terminal.terminals}"
               IsVisible="{Binding Tabs.Count, Converter={x:Static vm:TerminalViewConverters.MoreThanOne}}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TerminalTabViewModel">
            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</UserControl>
