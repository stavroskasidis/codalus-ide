<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             x:Class="DaedalusStudio.Shell.Views.StandardToolbar"
             x:DataType="vm:ToolbarViewModel">
  <Border Classes="standardToolbar">
    <WrapPanel x:Name="Panel" Orientation="Horizontal" Margin="4,2" AutomationProperties.Name="Standard toolbar">
      <Button Classes="toolbar" Command="{Binding BackCommand}" Tag="workbench.navigateBack" ToolTip.Tip="Navigate Backward" AutomationProperties.Name="Navigate Backward">
        <controls:Icon Kind="arrow-left" Classes="accent-navigate" />
      </Button>
      <Button Classes="toolbar" Command="{Binding ForwardCommand}" Tag="workbench.navigateForward" ToolTip.Tip="Navigate Forward" AutomationProperties.Name="Navigate Forward">
        <controls:Icon Kind="arrow-right" Classes="accent-navigate" />
      </Button>
      <Border Classes="toolbarSeparator" />
      <Button Classes="toolbar" Command="{Binding OpenCommand}" Tag="workbench.openSolution" ToolTip.Tip="Open Solution or Project" AutomationProperties.Name="Open Solution or Project">
        <controls:Icon Kind="folder-open" Classes="accent-open" />
      </Button>
      <Button Classes="toolbar" Command="{Binding SaveCommand}" Tag="file.save" ToolTip.Tip="Save" AutomationProperties.Name="Save">
        <controls:Icon Kind="save" Classes="accent-save" />
      </Button>
      <Button Classes="toolbar" Command="{Binding SaveAllCommand}" Tag="file.saveAll" ToolTip.Tip="Save All" AutomationProperties.Name="Save All">
        <controls:Icon Kind="save-all" Classes="accent-save" />
      </Button>
      <Border Classes="toolbarSeparator" />
      <Button Classes="toolbar" Command="{Binding UndoCommand}" Tag="edit.undo" ToolTip.Tip="Undo" AutomationProperties.Name="Undo">
        <controls:Icon Kind="undo" />
      </Button>
      <Button Classes="toolbar" Command="{Binding RedoCommand}" Tag="edit.redo" ToolTip.Tip="Redo" AutomationProperties.Name="Redo">
        <controls:Icon Kind="redo" />
      </Button>
      <Border Classes="toolbarSeparator" IsVisible="{Binding HasSolution}" />
      <ComboBox Classes="toolbar" ItemsSource="{Binding Configurations}" SelectedItem="{Binding Configuration}" MinWidth="90"
                IsVisible="{Binding HasSolution}" ToolTip.Tip="Solution Configurations" AutomationProperties.Name="Solution Configurations" />
      <ComboBox Classes="toolbar" ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" MinWidth="90"
                IsVisible="{Binding HasSolution}" ToolTip.Tip="Solution Platforms" AutomationProperties.Name="Solution Platforms" />
      <Border Classes="toolbarSeparator" IsVisible="{Binding HasSolution}" />
      <ComboBox Classes="toolbar" ItemsSource="{Binding StartupProjects}" SelectedItem="{Binding StartupProject}" MinWidth="120"
                IsVisible="{Binding HasSolution}" ToolTip.Tip="Startup Project" AutomationProperties.Name="Startup Project" PlaceholderText="Startup project" />
      <Button x:Name="StartButton" Classes="toolbar start" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}"
              Tag="debug.start" ToolTip.Tip="Start Debugging" AutomationProperties.Name="Start Debugging">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <controls:Icon Kind="play" Classes="start" />
          <TextBlock Text="{Binding StartLabel}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="toolbar" Command="{Binding StartWithoutDebuggingCommand}" IsVisible="{Binding CanStart}"
              Tag="run.startWithoutDebugging" ToolTip.Tip="Start Without Debugging" AutomationProperties.Name="Start Without Debugging">
        <controls:Icon Kind="play-outline" Classes="start" />
      </Button>
      <!-- While debugging: the debug toolbar. -->
      <Button Classes="toolbar" Command="{Binding StartCommand}" IsVisible="{Binding IsStopped}" Tag="debug.start" ToolTip.Tip="Continue" AutomationProperties.Name="Continue">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <controls:Icon Kind="play" Classes="start" />
          <TextBlock Text="Continue" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="toolbar" Command="{Binding BreakAllCommand}" IsVisible="{Binding CanBreak}" Tag="debug.pause" ToolTip.Tip="Break All" AutomationProperties.Name="Break All">
        <controls:Icon Kind="pause" Classes="accent-navigate" />
      </Button>
      <Button Classes="toolbar" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}" Tag="debug.stop" ToolTip.Tip="Stop" AutomationProperties.Name="Stop">
        <controls:Icon Kind="stop" Classes="stop" />
      </Button>
      <Button Classes="toolbar" Command="{Binding RestartCommand}" IsVisible="{Binding IsDebugging}" Tag="debug.restart" ToolTip.Tip="Restart" AutomationProperties.Name="Restart">
        <controls:Icon Kind="restart" Classes="accent-navigate" />
      </Button>
      <Border Classes="toolbarSeparator" IsVisible="{Binding IsStopped}" />
      <Button Classes="toolbar" Command="{Binding StepIntoCommand}" IsVisible="{Binding IsStopped}" Tag="debug.stepInto" ToolTip.Tip="Step Into" AutomationProperties.Name="Step Into">
        <controls:Icon Kind="step-into" Classes="accent-navigate" />
      </Button>
      <Button Classes="toolbar" Command="{Binding StepOverCommand}" IsVisible="{Binding IsStopped}" Tag="debug.stepOver" ToolTip.Tip="Step Over" AutomationProperties.Name="Step Over">
        <controls:Icon Kind="step-over" Classes="accent-navigate" />
      </Button>
      <Button Classes="toolbar" Command="{Binding StepOutCommand}" IsVisible="{Binding IsStopped}" Tag="debug.stepOut" ToolTip.Tip="Step Out" AutomationProperties.Name="Step Out">
        <controls:Icon Kind="step-out" Classes="accent-navigate" />
      </Button>
      <!-- Debug Location (M14b): the process, thread and stack frame while paused. -->
      <Border Classes="toolbarSeparator" IsVisible="{Binding IsStopped}" />
      <TextBlock Text="{Binding DebugLocation.Process}" IsVisible="{Binding IsStopped}" VerticalAlignment="Center" Margin="4,0" Classes="muted"
                 ToolTip.Tip="Process" AutomationProperties.Name="Process" />
      <ComboBox Classes="toolbar" ItemsSource="{Binding DebugLocation.Threads}" SelectedItem="{Binding DebugLocation.Thread}" MinWidth="140" MaxWidth="240"
                IsVisible="{Binding IsStopped}" ToolTip.Tip="Thread" AutomationProperties.Name="Thread" />
      <ComboBox Classes="toolbar" ItemsSource="{Binding DebugLocation.Frames}" SelectedItem="{Binding DebugLocation.Frame}" MinWidth="180" MaxWidth="360"
                IsVisible="{Binding IsStopped}" ToolTip.Tip="Stack Frame" AutomationProperties.Name="Stack Frame" />
    </WrapPanel>
  </Border>
</UserControl>
