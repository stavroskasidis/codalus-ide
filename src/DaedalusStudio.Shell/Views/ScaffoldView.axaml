<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             x:Class="DaedalusStudio.Shell.Views.ScaffoldView"
             x:DataType="vm:ScaffoldViewModel">
  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
      <TextBlock Classes="heading" Text="{Binding Title}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Empty items come from the SDK's item templates; the Entity Framework and Identity scaffolders run your dotnet-aspnet-codegenerator in the project's folder." />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="AddButton" Classes="accent" Content="Add" Command="{Binding AddCommand}" IsEnabled="{Binding !IsBusy}" IsDefault="True" AutomationProperties.Name="Add scaffolded item" />
        <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Result}" IsVisible="{Binding HasResult}" FontWeight="SemiBold" TextWrapping="Wrap" />
    </StackPanel>

    <Grid ColumnDefinitions="150,300,*">
      <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent" AutomationProperties.Name="Scaffolder categories" />
      <ListBox Grid.Column="1" Margin="8,0" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="Scaffolders">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ScaffolderRow">
            <Grid ColumnDefinitions="Auto,*" Margin="0,2" AutomationProperties.Name="{Binding Name}">
              <controls:Icon Kind="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Engine}" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="2" Padding="12,8" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}">
        <ScrollViewer>
          <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="{Binding SelectedRow.Name}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding SelectedRow.Description}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ToolMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Classes="muted" FontSize="12" Text="{Binding ToolMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Margin="8,0,0,0" Content="Install" Command="{Binding InstallCommand}" IsVisible="{Binding NeedsTool}" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="Install the code generator" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Fields}">
              <ItemsControl.DataTemplates>
                <DataTemplate x:DataType="vm:ScaffoldTextField">
                  <StackPanel Spacing="2" Margin="0,2">
                    <TextBlock Text="{Binding Label}" />
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Text="{Binding Text}" PlaceholderText="{Binding Placeholder}" AutomationProperties.Name="{Binding Parameter.Label}" />
                      <ComboBox Grid.Column="1" Margin="6,0,0,0" MinWidth="150" ItemsSource="{Binding Suggestions}" SelectedItem="{Binding Suggestion}" PlaceholderText="From the project" IsVisible="{Binding HasSuggestions}" />
                    </Grid>
                    <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="vm:ScaffoldBoolField">
                  <CheckBox Margin="0,2" Content="{Binding Parameter.Label}" IsChecked="{Binding IsChecked}" ToolTip.Tip="{Binding Description}" />
                </DataTemplate>
                <DataTemplate x:DataType="vm:ScaffoldChoiceField">
                  <StackPanel Spacing="2" Margin="0,2">
                    <TextBlock Text="{Binding Label}" />
                    <ComboBox MinWidth="200" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{Binding Parameter.Label}" />
                    <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.DataTemplates>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
