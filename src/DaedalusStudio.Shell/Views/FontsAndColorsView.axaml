<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             x:Class="DaedalusStudio.Shell.Views.FontsAndColorsView"
             x:DataType="vm:FontsAndColorsViewModel">
  <DockPanel Margin="12,8">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock Classes="heading" Text="Fonts and Colors" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="Colors over the theme's, for kinds of code, the editor and the window. Type a color (#RRGGBB, or #RRGGBBAA with transparency); Reset returns to the theme's. They're the settings Syntax Colors and Editor and Window Colors, in VS Code's form." />
      <controls:ToolbarPanel>
        <TextBox x:Name="FilterBox" Text="{Binding Filter}" PlaceholderText="Search colors" MinWidth="120" AutomationProperties.Name="Search colors" />
        <CheckBox IsChecked="{Binding ForAllThemes}" Content="For every theme" AutomationProperties.Name="For every theme"
                  ToolTip.Tip="Off: colors set here apply to the active theme only" />
        <Button Content="Fonts…" Command="{Binding OpenFontSettingsCommand}" ToolTip.Tip="The editor's font family and size (Settings)" />
      </controls:ToolbarPanel>
      <TextBlock Classes="muted">
        <Run Text="Theme:" /> <Run Text="{Binding ThemeTitle}" />
      </TextBlock>
    </StackPanel>
    <ListBox x:Name="List" ItemsSource="{Binding Items}" Background="Transparent" Margin="0,6,0,0" AutomationProperties.Name="Colors">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ColorItemViewModel">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ColorItemViewModel">
          <Grid ColumnDefinitions="70,220,26,110,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Text="{Binding Group}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" ToolTip.Tip="{Binding Key}" TextTrimming="CharacterEllipsis" />
            <Border Grid.Column="2" Width="18" Height="14" Background="{Binding Swatch}" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" VerticalAlignment="Center" />
            <TextBox Grid.Column="3" Classes="cell" Text="{Binding Hex, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center"
                     AutomationProperties.Name="{Binding Title}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
            <Button Grid.Column="4" Classes="link" Content="Reset" Command="{Binding ResetCommand}" IsVisible="{Binding IsCustom}" Margin="6,0,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Shell.Error}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
