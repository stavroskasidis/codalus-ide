<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.ParallelWatchView"
             x:DataType="vm:ParallelWatchViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="6,4">
      <TextBox x:Name="ExpressionBox" Text="{Binding Expression}" PlaceholderText="An expression to evaluate on every thread" KeyDown="OnKeyDown"
               AutomationProperties.Name="Expression" />
      <Button Grid.Column="1" Content="Evaluate" Margin="6,0,0,0" Click="OnEvaluate" />
    </Grid>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="160,240,*" Margin="8,2">
      <TextBlock Text="Thread" Classes="muted" />
      <TextBlock Grid.Column="1" Text="Frame" Classes="muted" />
      <TextBlock Grid.Column="2" Text="Value" Classes="muted" />
    </Grid>
    <ListBox ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="Values by thread">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ParallelWatchRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ParallelWatchRow">
          <Grid ColumnDefinitions="160,240,*">
            <TextBlock Text="{Binding Thread}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Frame}" Classes="muted" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding Value}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
