<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             x:Class="DaedalusStudio.Shell.Views.KeyboardShortcutsView"
             x:DataType="vm:KeyboardShortcutsViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Shell.Border}">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="SearchBox"
                   Text="{Binding Search}"
                   PlaceholderText="Search by command, id or keys"
                   AutomationProperties.Name="Search keyboard shortcuts" />
          <Button Grid.Column="1"
                  Classes="link"
                  Margin="16,0,0,0"
                  VerticalAlignment="Center"
                  Content="Edit in keybindings.json"
                  Command="{Binding OpenJsonCommand}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="Change Key Binding…" Command="{Binding ChangeCommand}" ToolTip.Tip="Enter or double-click" />
          <Button Content="Remove" Command="{Binding RemoveCommand}" ToolTip.Tip="Delete" />
          <Button Content="Reset" Command="{Binding ResetCommand}" ToolTip.Tip="Restore the default key binding" />
          <TextBlock Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border x:Name="Recorder"
            DockPanel.Dock="Top"
            Classes="overlay"
            Margin="16,10"
            Padding="16,12"
            Focusable="True"
            IsVisible="{Binding IsRecording}"
            AutomationProperties.Name="{Binding RecordingTitle}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding RecordingTitle}" TextWrapping="Wrap" />
        <TextBlock FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{Binding RecordedLabel}" AutomationProperties.LiveSetting="Assertive" />
        <TextBlock Foreground="{DynamicResource Shell.Warning}" HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding RecordedConflicts}" />
      </StackPanel>
    </Border>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,190,220,170" Margin="22,6,22,2">
      <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="Command" />
      <TextBlock Grid.Column="1" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="Key Binding" />
      <TextBlock Grid.Column="2" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="When" />
      <TextBlock Grid.Column="3" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="Source" />
    </Grid>

    <ListBox x:Name="List"
             Margin="8,0"
             Background="Transparent"
             ItemsSource="{Binding Rows}"
             SelectedItem="{Binding Selected}"
             AutomationProperties.Name="Keyboard shortcuts">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:KeybindingRowViewModel">
          <Setter Property="Padding" Value="14,4" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:KeybindingRowViewModel">
          <Grid ColumnDefinitions="*,190,220,170">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CommandId}" />
              <controls:Icon Kind="warning" Classes="warning" IsVisible="{Binding HasConflict}" ToolTip.Tip="This key binding conflicts with another command." />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding KeyLabel}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Classes="muted" Text="{Binding When}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding When}" />
            <TextBlock Grid.Column="3" Classes="muted" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
