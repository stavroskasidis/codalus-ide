<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.InteractiveRebaseView"
             x:DataType="vm:InteractiveRebaseViewModel">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="pick keeps a commit; reword keeps it with a new message; squash and fixup combine it with the commit above (squash keeps both messages); drop leaves it out. Up and Down reorder." />
      <TextBlock Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
      <Button Classes="accent" Content="Start Rebase" Command="{Binding StartCommand}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Spacing="4" Margin="8,0,0,0">
      <Button Content="Up" Command="{Binding MoveUpCommand}" MinWidth="64" AutomationProperties.Name="Move up" />
      <Button Content="Down" Command="{Binding MoveDownCommand}" MinWidth="64" AutomationProperties.Name="Move down" />
    </StackPanel>
    <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Commits to rebase">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:RebaseStepRow">
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:RebaseStepRow">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{x:Static vm:RebaseStepRow.Actions}" SelectedItem="{Binding Action}" MinWidth="100" AutomationProperties.Name="Action" />
              <TextBlock Text="{Binding ShortHash}" Classes="muted" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
              <TextBlock Text="{Binding Subject}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBox Text="{Binding Message}" IsVisible="{Binding IsReword}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Margin="108,0,0,0"
                     PlaceholderText="The new commit message" AutomationProperties.Name="New message" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
