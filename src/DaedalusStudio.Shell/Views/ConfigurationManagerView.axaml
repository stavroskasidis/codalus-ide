<local:LoadingView xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
                   xmlns:local="using:DaedalusStudio.Shell.Views"
                   x:Class="DaedalusStudio.Shell.Views.ConfigurationManagerView"
                   x:DataType="vm:ConfigurationManagerViewModel">
  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <TextBlock Classes="heading" Text="Configuration Manager" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="For each solution configuration and platform: which configuration and platform of each project builds, and whether it builds at all." />
      <WrapPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="Solution configuration:" />
        <ComboBox MinWidth="140" ItemsSource="{Binding BuildTypes}" SelectedItem="{Binding BuildType}" Margin="0,0,4,4" AutomationProperties.Name="Solution configuration" />
        <Button Content="New…" Command="{Binding AddBuildTypeCommand}" Margin="0,0,4,4" />
        <Button Content="Remove" Command="{Binding RemoveBuildTypeCommand}" Margin="0,0,16,4" />
        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="Platform:" />
        <ComboBox MinWidth="120" ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" Margin="0,0,4,4" AutomationProperties.Name="Solution platform" />
        <Button Content="New…" Command="{Binding AddPlatformCommand}" Margin="0,0,4,4" />
        <Button Content="Remove" Command="{Binding RemovePlatformCommand}" Margin="0,0,16,4" />
        <Button Content="Make Active" Command="{Binding ActivateCommand}" Margin="0,0,4,4" />
      </WrapPanel>
      <TextBlock Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
    <Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,180,140,70" Margin="8,2">
        <TextBlock Classes="muted" Text="Project" />
        <TextBlock Grid.Column="1" Classes="muted" Text="Configuration" />
        <TextBlock Grid.Column="2" Classes="muted" Text="Platform" />
        <TextBlock Grid.Column="3" Classes="muted" Text="Build" />
      </Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" AutomationProperties.Name="Project configurations">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectConfigurationRowViewModel">
            <Grid ColumnDefinitions="*,180,140,70">
              <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <ComboBox Grid.Column="1" Margin="0,0,8,0" ItemsSource="{Binding Configurations}" SelectedItem="{Binding Configuration}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} configuration'}" />
              <ComboBox Grid.Column="2" Margin="0,0,8,0" ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} platform'}" />
              <CheckBox Grid.Column="3" IsChecked="{Binding Build}" AutomationProperties.Name="{Binding Name, StringFormat='Build {0}'}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</local:LoadingView>
