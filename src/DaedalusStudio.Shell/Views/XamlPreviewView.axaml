<UserControl xmlns:l="using:DaedalusStudio.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.XamlPreviewView"
             x:DataType="vm:XamlPreviewViewModel">
  <DockPanel>
    <!-- One toolbar row (M34d): icons with tooltips, and what doesn't fit a narrow pane goes to the overflow menu. -->
    <controls:ToolbarPanel DockPanel.Dock="Top">
      <Button Classes="toolbar" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:T xamlPreview.refreshBuildIfNeededAndRender}" AutomationProperties.Name="{l:T xamlPreview.refresh}">
        <controls:Icon Kind="refresh" />
      </Button>
      <Button Classes="toolbar" Command="{Binding ZoomOutCommand}" ToolTip.Tip="{l:T xamlPreview.zoomOut}" AutomationProperties.Name="{l:T xamlPreview.zoomOut}">
        <controls:Icon Kind="zoom-out" />
      </Button>
      <Button Classes="toolbar" Content="{Binding ZoomText}" Command="{Binding ZoomResetCommand}" MinWidth="44" ToolTip.Tip="{l:T xamlPreview.theZoomClickForActualSize}" AutomationProperties.Name="{l:T xamlPreview.zoomActualSize}" />
      <Button Classes="toolbar" Command="{Binding ZoomInCommand}" ToolTip.Tip="{l:T xamlPreview.zoomIn}" AutomationProperties.Name="{l:T xamlPreview.zoomIn}">
        <controls:Icon Kind="zoom-in" />
      </Button>
      <Button Classes="toolbar" Command="{Binding FitCommand}" ToolTip.Tip="{l:T xamlPreview.fitThePreviewToThePane}" AutomationProperties.Name="{l:T xamlPreview.fitToThePane}">
        <controls:Icon Kind="fit" />
      </Button>
      <Border Classes="toolbarSeparator" />
      <ComboBox Classes="toolbar" ItemsSource="{Binding Scales}" SelectedItem="{Binding SelectedScale}" ToolTip.Tip="{l:T xamlPreview.renderScaleDpi}" AutomationProperties.Name="{l:T xamlPreview.renderScale}" />
      <ComboBox Classes="toolbar" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" ToolTip.Tip="{l:T xamlPreview.themeVariant}" AutomationProperties.Name="{l:T xamlPreview.themeVariant}" />
    </controls:ToolbarPanel>
    <TextBlock DockPanel.Dock="Top" Margin="8,0,8,4" Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasError}" Margin="8,0,8,6" Padding="8,6" BorderThickness="1" BorderBrush="{DynamicResource Shell.Error}" CornerRadius="2">
      <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
    </Border>
    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AllowAutoHide="False">
      <Canvas x:Name="Surface" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="Hand"
              Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
              AutomationProperties.Name="{l:T xamlPreview.thePreviewClickAnElementTo}">
        <Image Source="{Binding Image}" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}" Stretch="Fill" />
        <Rectangle IsVisible="{Binding HasSelection}" IsHitTestVisible="False" StrokeThickness="2" Stroke="{DynamicResource Shell.Accent}"
                   Canvas.Left="{Binding SelectionLeft}" Canvas.Top="{Binding SelectionTop}" Width="{Binding SelectionWidth}" Height="{Binding SelectionHeight}" />
      </Canvas>
    </ScrollViewer>
  </DockPanel>
</UserControl>
