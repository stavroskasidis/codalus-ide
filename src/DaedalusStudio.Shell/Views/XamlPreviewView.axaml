<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.XamlPreviewView"
             x:DataType="vm:XamlPreviewViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4" Spacing="4">
      <Button Content="Refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="Build if needed and render again" />
      <Button Content="−" Command="{Binding ZoomOutCommand}" ToolTip.Tip="Zoom out" AutomationProperties.Name="Zoom out" />
      <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center" MinWidth="40" TextAlignment="Center" AutomationProperties.Name="Zoom" />
      <Button Content="+" Command="{Binding ZoomInCommand}" ToolTip.Tip="Zoom in" AutomationProperties.Name="Zoom in" />
      <Button Content="100%" Command="{Binding ZoomResetCommand}" ToolTip.Tip="Actual size" AutomationProperties.Name="Actual size" />
      <ComboBox ItemsSource="{Binding Scales}" SelectedItem="{Binding SelectedScale}" ToolTip.Tip="Render scale (DPI)" AutomationProperties.Name="Render scale" />
      <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" ToolTip.Tip="Theme variant" AutomationProperties.Name="Theme variant" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Margin="8,0,8,4" Classes="muted" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasError}" Margin="8,0,8,6" Padding="8,6" BorderThickness="1" BorderBrush="{DynamicResource Shell.Error}" CornerRadius="2">
      <SelectableTextBlock Text="{Binding Error}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <Canvas x:Name="Surface" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="Hand"
              Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
              AutomationProperties.Name="The preview: click an element to select it in the XAML">
        <Image Source="{Binding Image}" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}" Stretch="Fill" />
        <Rectangle IsVisible="{Binding HasSelection}" IsHitTestVisible="False" StrokeThickness="2" Stroke="{DynamicResource Shell.Accent}"
                   Canvas.Left="{Binding SelectionLeft}" Canvas.Top="{Binding SelectionTop}" Width="{Binding SelectionWidth}" Height="{Binding SelectionHeight}" />
      </Canvas>
    </ScrollViewer>
  </DockPanel>
</UserControl>
