<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.RemotePortsView"
             x:DataType="vm:RemotePortsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6,4">
      <Button x:Name="Forward" Content="Forward a Port…" AutomationProperties.Name="Forward a port of the remote machine" />
      <Button x:Name="Stop" Content="Stop Forwarding" IsEnabled="{Binding CanStop}" AutomationProperties.Name="Stop forwarding the selected port" />
      <Button x:Name="Browse" Content="Open in Browser" IsEnabled="{Binding CanStop}" AutomationProperties.Name="Open the selected forwarded port in the browser" />
      <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Status}" />
    </StackPanel>
    <ListBox x:Name="PortList" ItemsSource="{Binding Ports}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="Ports">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:RemotePortRow">
          <Setter Property="Padding" Value="4,2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:RemotePortRow">
          <Grid ColumnDefinitions="80,180,*">
            <TextBlock Text="{Binding Port}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding LocalAddress}" Classes="accent" />
            <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
