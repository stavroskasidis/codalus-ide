<UserControl xmlns:l="using:DaedalusStudio.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:dap="using:DaedalusStudio.Debugging"
             x:Class="DaedalusStudio.Shell.Views.CallStackView"
             x:DataType="vm:CallStackViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6,4">
      <TextBlock Text="{l:T callStack.thread}" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding Threads}" SelectedItem="{Binding SelectedThread}" MinWidth="220" AutomationProperties.Name="{l:T callStack.thread2}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="dap:DapThread">
            <TextBlock>
              <Run Text="{Binding Id}" />
              <Run Text="{Binding Name}" />
            </TextBlock>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{l:T callStack.theCallStackAppearsHereWhile}" IsVisible="{Binding IsEmpty}" />
    <ListBox x:Name="List" ItemsSource="{Binding Frames}" Background="Transparent" AutomationProperties.Name="{l:T callStack.callStack}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:FrameRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FrameRow">
          <Grid ColumnDefinitions="20,*,220">
            <TextBlock Text="{Binding Marker}" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Classes.muted="{Binding !HasSource}" />
            <TextBlock Grid.Column="2" Text="{Binding Location}" Classes="muted" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
