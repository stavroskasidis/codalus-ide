<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.DialogView"
             x:DataType="vm:DialogViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.added">
      <Setter Property="Foreground" Value="{DynamicResource Shell.Diff.Added}" />
    </Style>
    <Style Selector="TextBlock.removed">
      <Setter Property="Foreground" Value="{DynamicResource Shell.Diff.Removed}" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,6,0,2" />
    </Style>
  </UserControl.Styles>
  <Border Classes="overlay" Padding="20,16" MinWidth="420" MaxWidth="{Binding HasDetails, Converter={x:Static vm:DialogWidth.Converter}}" KeyboardNavigation.TabNavigation="Cycle"
          AutomationProperties.Name="{Binding Title}">
    <StackPanel Spacing="10">
      <TextBlock Classes="heading" FontSize="16" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBox x:Name="Input"
               Text="{Binding InputText}"
               IsVisible="{Binding HasInput}"
               AutomationProperties.Name="{Binding Title}" />
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasChoices}">
        <Border BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" MaxHeight="320">
          <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" Background="Transparent" AutomationProperties.Name="Choices">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DialogChoiceViewModel">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Label}" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
                  <TextBlock Classes="muted" FontSize="11" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0" IsVisible="{Binding Reorderable}">
          <Button Content="Up" Command="{Binding MoveUpCommand}" MinWidth="64" AutomationProperties.Name="Move up" />
          <Button Content="Down" Command="{Binding MoveDownCommand}" MinWidth="64" AutomationProperties.Name="Move down" />
        </StackPanel>
      </Grid>
      <Border IsVisible="{Binding HasDetails}" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" MaxHeight="420">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Preview">
          <ItemsControl ItemsSource="{Binding Details}" Margin="6,4">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DetailLine">
                <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12"
                           Classes.added="{Binding IsAdded}" Classes.removed="{Binding IsRemoved}" Classes.header="{Binding IsHeader}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>
      <TextBlock Foreground="{DynamicResource Shell.Error}" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                 AutomationProperties.LiveSetting="Assertive" />
      <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right" Margin="0,6,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DialogButtonViewModel">
            <Button Content="{Binding Label}" Command="{Binding Command}" MinWidth="84" HorizontalContentAlignment="Center"
                    Classes.accent="{Binding IsDefault}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
