<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             x:Class="DaedalusStudio.Shell.Views.SolutionExplorerView"
             x:DataType="vm:SolutionExplorerViewModel">
  <DockPanel>
  <!-- The toolbar and search box of a classic IDE's Solution Explorer (M29). -->
  <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasSolution}">
    <controls:ToolbarPanel Spacing="1">
      <Button Classes="toolbar" Command="{Binding HomeCommand}" ToolTip.Tip="Home" AutomationProperties.Name="Home">
        <controls:Icon Kind="home" />
      </Button>
      <Button Classes="toolbar" Command="{Binding SyncCommand}" ToolTip.Tip="Sync with Active Document" AutomationProperties.Name="Sync with Active Document">
        <controls:Icon Kind="link" />
      </Button>
      <Button Classes="toolbar" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collapse All" AutomationProperties.Name="Collapse All">
        <controls:Icon Kind="collapse-all" />
      </Button>
      <ToggleButton Classes="toolbar" IsChecked="{Binding ShowAllFiles}" ToolTip.Tip="Show All Files" AutomationProperties.Name="Show All Files" IsVisible="{Binding !IsFolderView}">
        <controls:Icon Kind="files" />
      </ToggleButton>
      <Button Classes="toolbar" Command="{Binding SwitchViewsCommand}" IsVisible="{Binding CanSwitchViews}" ToolTip.Tip="Switch Views (folder view, solution view)" AutomationProperties.Name="Switch Views">
        <controls:Icon Kind="layout" />
      </Button>
      <Button Classes="toolbar" Command="{Binding PropertiesCommand}" ToolTip.Tip="Properties (Alt+Enter)" AutomationProperties.Name="Properties">
        <controls:Icon Kind="gear" />
      </Button>
    </controls:ToolbarPanel>
    <TextBox x:Name="SearchBox" Text="{Binding Filter}" Margin="4,0,4,4" PlaceholderText="Search Solution Explorer (Ctrl+;)"
             AutomationProperties.Name="Search Solution Explorer" />
  </StackPanel>
  <Grid>
    <StackPanel Margin="{DynamicResource Shell.Padding.EmptyState}" Spacing="10" IsVisible="{Binding !HasSolution}">
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="No solution is open." />
      <Button Content="Open Solution…" HorizontalAlignment="Left" Command="{Binding OpenSolutionCommand}" />
    </StackPanel>
    <ListBox x:Name="List"
             ItemsSource="{Binding Rows}"
             SelectedItem="{Binding Selected}"
             IsVisible="{Binding HasSolution}"
             Background="Transparent"
             DragDrop.AllowDrop="True"
             AutomationProperties.Name="Solution Explorer">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ExplorerRowViewModel">
          <Setter Property="Padding" Value="0,1" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
        <Style Selector="ListBoxItem.dropTarget">
          <Setter Property="BorderBrush" Value="{DynamicResource Shell.Focus}" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.linked">
          <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style Selector="TextBlock.startup">
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.unloaded">
          <Setter Property="Opacity" Value="0.6" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ExplorerRowViewModel">
          <!-- The name trims with an ellipsis in a narrow pane (the root's was cut off, M29); the tooltip has the path (M34d). -->
          <DockPanel Margin="{Binding Indent}" Background="Transparent" ToolTip.Tip="{Binding Node.Path}">
            <Border DockPanel.Dock="Left" Classes="chevron" Width="16" Height="18" Background="Transparent">
              <controls:Icon Kind="{Binding Chevron}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <controls:Icon DockPanel.Dock="Left" Margin="4,0" Kind="{Binding Icon}" Classes.warning="{Binding IsWarning}" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Classes.linked="{Binding IsLinked}" Classes.startup="{Binding IsStartup}" Classes.unloaded="{Binding IsDimmed}">
              <Run Text="{Binding Name}" />
              <Run Text="{Binding Detail}" FontSize="{DynamicResource Shell.FontSize.Small}" FontWeight="Normal" Foreground="{DynamicResource Shell.MutedForeground}" />
            </TextBlock>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
  </DockPanel>
</UserControl>
