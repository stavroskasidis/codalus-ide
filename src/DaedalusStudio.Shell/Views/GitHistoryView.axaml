<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             x:Class="DaedalusStudio.Shell.Views.GitHistoryView"
             x:DataType="vm:GitHistoryViewModel">
  <Grid RowDefinitions="Auto,*,4,220">
    <!-- Filters (not for line history). -->
    <WrapPanel Margin="6,4" IsVisible="{Binding CanFilter}">
      <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding Branch}" MinWidth="160" Margin="0,0,6,0"
                ToolTip.Tip="Branch" AutomationProperties.Name="Branch" />
      <TextBox x:Name="AuthorBox" Text="{Binding Author}" Width="160" Margin="0,0,6,0" PlaceholderText="Author" AutomationProperties.Name="Filter by author" />
      <TextBox x:Name="MessageBox" Text="{Binding MessageFilter}" Width="220" Margin="0,0,6,0" PlaceholderText="Message" AutomationProperties.Name="Filter by message" />
      <Button Content="Filter" Click="OnFilter" />
    </WrapPanel>

    <Grid Grid.Row="1">
      <TextBlock Classes="muted" Margin="12" Text="No commits." IsVisible="{Binding IsEmpty}" />
      <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="Commits">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:GitCommitRow">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          </Style>
          <Style Selector="Border.ref">
            <Setter Property="Background" Value="{DynamicResource Shell.Hover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:GitCommitRow">
            <Grid ColumnDefinitions="Auto,*,160,130,70" Height="22" Background="Transparent">
              <controls:GitGraphCell Row="{Binding Graph}" IsHead="{Binding IsHead}" Lanes="{Binding $parent[ListBox].((vm:GitHistoryViewModel)DataContext).Lanes}" VerticalAlignment="Stretch" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                <ItemsControl ItemsSource="{Binding Refs}" IsVisible="{Binding HasRefs}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <Border Classes="ref">
                        <TextBlock Text="{Binding}" FontSize="11" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding Author}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="{Binding Date}" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{Binding ShortHash}" Classes="muted" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
        <ListBox.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Checkout (Detached)" Tag="checkout" Click="OnCommitAction" />
            <MenuItem Header="New Branch Here…" Tag="branch" Click="OnCommitAction" />
            <MenuItem Header="Create Tag…" Tag="tag" Click="OnCommitAction" />
            <Separator />
            <MenuItem Header="Cherry-Pick" Tag="cherryPick" Click="OnCommitAction" />
            <MenuItem Header="Revert" Tag="revert" Click="OnCommitAction" />
            <MenuItem Header="Reset">
              <MenuItem Header="Keep Changes Staged (Soft)" Tag="reset-soft" Click="OnCommitAction" />
              <MenuItem Header="Keep Changes (Mixed)" Tag="reset-mixed" Click="OnCommitAction" />
              <MenuItem Header="Discard Changes (Hard)…" Tag="reset-hard" Click="OnCommitAction" />
            </MenuItem>
            <MenuItem Header="Interactive Rebase from Here…" Tag="rebaseInteractive" Click="OnCommitAction" />
            <Separator />
            <MenuItem Header="Copy Commit Hash" Tag="copyHash" Click="OnCommitAction" />
          </ContextMenu>
        </ListBox.ContextMenu>
      </ListBox>
    </Grid>

    <GridSplitter Grid.Row="2" ResizeDirection="Rows" Background="{DynamicResource Shell.Border}" />

    <Grid Grid.Row="3" ColumnDefinitions="*,4,*" IsVisible="{Binding HasDetails}">
      <SelectableTextBlock Margin="8,6" Text="{Binding DetailsText}" TextWrapping="Wrap" AutomationProperties.Name="Commit details" />
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource Shell.Border}" />
      <ListBox x:Name="FileList" Grid.Column="2" ItemsSource="{Binding Files}" Background="Transparent" AutomationProperties.Name="Changed files">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:GitCommitFileRow">
            <StackPanel Orientation="Horizontal" Spacing="6" ToolTip.Tip="{Binding RelativePath}">
              <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Width="12" />
              <TextBlock Text="{Binding Name}" />
              <TextBlock Classes="muted" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
