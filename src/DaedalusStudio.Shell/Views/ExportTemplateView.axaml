<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.ExportTemplateView"
             x:DataType="vm:ExportTemplateViewModel">
  <ScrollViewer>
    <StackPanel Margin="16,12" Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Classes="heading" Text="Export Template" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="Makes a project or an item into a dotnet new template and installs it for you." />
      <TextBlock Margin="0,8,0,0" Text="Template type" />
      <ComboBox x:Name="KindPicker" MinWidth="200" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" AutomationProperties.Name="Template type" />
      <StackPanel Spacing="6" IsVisible="{Binding IsProject}">
        <TextBlock Text="Project" />
        <ComboBox MinWidth="320" ItemsSource="{Binding Projects}" SelectedItem="{Binding Project}" AutomationProperties.Name="Project to export">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SolutionProjectChoice">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Spacing="6" IsVisible="{Binding IsItem}">
        <TextBlock Text="Item" />
        <TextBlock Classes="muted" Text="{Binding ItemDisplay}" />
      </StackPanel>
      <TextBlock Text="Name" />
      <TextBox Text="{Binding Name}" AutomationProperties.Name="Template name" />
      <TextBlock Text="Short name (dotnet new &lt;short name&gt;)" />
      <TextBox Text="{Binding ShortName}" AutomationProperties.Name="Short name" />
      <TextBlock Text="Description" />
      <TextBox Text="{Binding Description}" AutomationProperties.Name="Description" />
      <TextBlock Text="Author" />
      <TextBox Text="{Binding Author}" AutomationProperties.Name="Author" />
      <TextBlock Classes="muted" FontSize="11" Text="{Binding Destination, StringFormat='Written to {0}'}" TextWrapping="Wrap" />
      <TextBlock Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      <Button Classes="accent" HorizontalAlignment="Left" Margin="0,6,0,0" Content="Export and Install" Command="{Binding ExportCommand}" />
      <TextBlock TextWrapping="Wrap" Text="{Binding Status}" />
      <TextBox Height="100" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Output}"
               FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" AutomationProperties.Name="dotnet new output" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
