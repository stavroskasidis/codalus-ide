<UserControl xmlns:l="using:DaedalusStudio.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             x:Class="DaedalusStudio.Shell.Views.NotificationCard"
             x:DataType="vm:NotificationViewModel">
  <Border x:Name="Card"
          Padding="12,10"
          AutomationProperties.Name="{Binding AccessibleName}"
          AutomationProperties.LiveSetting="Polite">
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
      <controls:Icon Kind="{Binding Icon}"
                     Classes.info="{Binding IsInfo}"
                     Classes.warning="{Binding IsWarning}"
                     Classes.error="{Binding IsError}"
                     Margin="0,1,10,0"
                     VerticalAlignment="Top" />
      <SelectableTextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
      <Button Grid.Column="2"
              Classes="toolbar"
              Margin="8,-3,-6,0"
              VerticalAlignment="Top"
              Command="{Binding DismissCommand}"
              ToolTip.Tip="{l:T notificationCard.dismiss}"
              AutomationProperties.Name="{l:T notificationCard.dismissNotification}">
        <controls:Icon Kind="close" Width="12" Height="12" />
      </Button>
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
        <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Source}" />
        <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Time}" />
      </StackPanel>
      <ItemsControl Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0"
                    ItemsSource="{Binding Actions}"
                    IsVisible="{Binding HasActions}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NotificationActionViewModel">
            <Button Content="{Binding Label}" Command="{Binding Command}" Padding="10,3" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</UserControl>
