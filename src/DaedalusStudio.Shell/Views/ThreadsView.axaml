<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.ThreadsView"
             x:DataType="vm:ThreadsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6,4">
      <CheckBox IsChecked="{Binding FlaggedOnly}" Content="Show flagged threads only" AutomationProperties.Name="Show flagged threads only" />
    </StackPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="20,28,80,200,*" Margin="8,2" IsVisible="{Binding !IsEmpty}">
      <TextBlock Grid.Column="2" Text="ID" Classes="muted" />
      <TextBlock Grid.Column="3" Text="Name" Classes="muted" />
      <TextBlock Grid.Column="4" Text="Location" Classes="muted" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="Threads appear here while the program is paused." IsVisible="{Binding IsEmpty}" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="Threads">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ThreadRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ThreadRow">
          <Grid ColumnDefinitions="20,28,80,200,*">
            <TextBlock Text="{Binding Marker}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding IsFlagged}" ToolTip.Tip="Flag" AutomationProperties.Name="Flag" Padding="0" MinWidth="0" />
            <TextBlock Grid.Column="2" Text="{Binding IdText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="4" Text="{Binding Location}" VerticalAlignment="Center" Classes="muted" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
