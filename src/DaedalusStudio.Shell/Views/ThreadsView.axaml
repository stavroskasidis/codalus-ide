<UserControl xmlns:l="using:DaedalusStudio.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             x:Class="DaedalusStudio.Shell.Views.ThreadsView"
             x:DataType="vm:ThreadsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6,4">
      <CheckBox IsChecked="{Binding FlaggedOnly}" Content="{l:T threads.showFlaggedThreadsOnly}" AutomationProperties.Name="{l:T threads.showFlaggedThreadsOnly}" />
    </StackPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="20,28,80,200,*" Margin="8,2" IsVisible="{Binding !IsEmpty}">
      <TextBlock Grid.Column="2" Text="{l:T threads.id}" Classes="muted" />
      <TextBlock Grid.Column="3" Text="{l:T threads.name}" Classes="muted" />
      <TextBlock Grid.Column="4" Text="{l:T threads.location}" Classes="muted" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{l:T threads.threadsAppearHereWhileTheProgram}" IsVisible="{Binding IsEmpty}" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T threads.threads}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ThreadRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ThreadRow">
          <Grid ColumnDefinitions="20,28,80,200,*">
            <TextBlock Text="{Binding Marker}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding IsFlagged}" ToolTip.Tip="{l:T threads.flag}" AutomationProperties.Name="{l:T threads.flag}" Padding="0" MinWidth="0" />
            <TextBlock Grid.Column="2" Text="{Binding IdText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="4" Text="{Binding Location}" VerticalAlignment="Center" Classes="muted" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
