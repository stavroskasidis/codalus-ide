<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="DaedalusStudio.Shell.Views.InteractiveView"
             x:DataType="vm:InteractiveViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Shell.Border}" Padding="4,2">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Content="Reset" Command="{Binding ResetCommand}" ToolTip.Tip="Discard the state and start over (also stops a running submission)" AutomationProperties.Name="Reset" />
          <Button Content="Clear" Command="{Binding ClearCommand}" ToolTip.Tip="Clear the window" AutomationProperties.Name="Clear" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.75" Margin="8,0" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Shell.Border}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Left" Text="&gt;" VerticalAlignment="Top" Margin="6,3,0,0"
                   FontFamily="{Binding Font.Family}" FontSize="{Binding Font.Size}" Opacity="0.6" />
        <ae:TextEditor x:Name="InputEditor"
                       MinHeight="22"
                       MaxHeight="220"
                       ShowLineNumbers="False"
                       WordWrap="False"
                       HorizontalScrollBarVisibility="Auto"
                       VerticalScrollBarVisibility="Auto"
                       FontFamily="{Binding Font.Family}"
                       FontSize="{Binding Font.Size}"
                       Background="{DynamicResource Shell.Editor.Background}"
                       Foreground="{DynamicResource Shell.Editor.Foreground}"
                       Padding="4,2"
                       AutomationProperties.Name="C# Interactive input" />
      </DockPanel>
    </Border>
    <ae:TextEditor x:Name="TranscriptEditor"
                   IsReadOnly="True"
                   ShowLineNumbers="False"
                   WordWrap="True"
                   FontFamily="{Binding Font.Family}"
                   FontSize="{Binding Font.Size}"
                   Background="{DynamicResource Shell.Editor.Background}"
                   Foreground="{DynamicResource Shell.Editor.Foreground}"
                   Padding="6,2"
                   AutomationProperties.Name="C# Interactive output" />
  </DockPanel>
</UserControl>
