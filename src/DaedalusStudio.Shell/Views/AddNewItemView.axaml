<local:LoadingView xmlns:l="using:DaedalusStudio.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
                   xmlns:local="using:DaedalusStudio.Shell.Views"
                   xmlns:controls="using:DaedalusStudio.Shell.Controls"
                   x:Class="DaedalusStudio.Shell.Views.AddNewItemView"
                   x:DataType="vm:AddNewItemViewModel">
  <DockPanel Margin="16,12">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <StackPanel Spacing="2">
        <TextBlock Classes="heading" Text="{Binding Title}" />
        <TextBlock Classes="muted" Text="{Binding Location, StringFormat='Adds to {0}'}" />
      </StackPanel>
      <TextBox Grid.Column="1" x:Name="SearchBox" Width="280" VerticalAlignment="Center" Text="{Binding Search}" PlaceholderText="{l:T addNewItem.searchItemTemplates}" AutomationProperties.Name="{l:T addNewItem.searchItemTemplates}" />
    </Grid>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
      <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:T addNewItem.name}" />
      <TextBox Grid.Column="1" x:Name="NameBox" Text="{Binding Name}" AutomationProperties.Name="{l:T addNewItem.name2}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
        <Button Classes="accent" Content="{l:T addNewItem.add}" Command="{Binding AddCommand}" IsDefault="True" AutomationProperties.Name="{l:T addNewItem.addItem}" />
        <Button Content="{l:T addNewItem.cancel}" Command="{Binding CancelCommand}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
        <CheckBox Content="{l:T addNewItem.showTemplatesForEveryKindOf}" IsChecked="{Binding ShowAll}" />
        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      </StackPanel>
    </Grid>

    <Grid ColumnDefinitions="170,*,340">
      <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent" AutomationProperties.Name="{l:T addNewItem.templateCategories}" />
      <DockPanel Grid.Column="1" Margin="8,0">
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding IsLoading}" />
        <ListBox x:Name="TemplateList" ItemsSource="{Binding Templates}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:T addNewItem.itemTemplates}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ItemTemplateRowViewModel">
              <Grid ColumnDefinitions="Auto,*" Margin="0,2" AutomationProperties.Name="{Binding AccessibleName}">
                <controls:Icon Kind="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Detail}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <Border Grid.Column="2" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="{Binding PreviewTitle}" Margin="0,0,0,6" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Text="{Binding Selected.Description}" Margin="0,0,0,8" />
          <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12"
                   Text="{Binding Preview}" AutomationProperties.Name="{l:T addNewItem.preview}" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</local:LoadingView>
