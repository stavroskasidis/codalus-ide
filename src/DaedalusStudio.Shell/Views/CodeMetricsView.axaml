<UserControl xmlns:l="using:DaedalusStudio.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             x:Class="DaedalusStudio.Shell.Views.CodeMetricsView"
             x:DataType="vm:CodeMetricsViewModel">
  <DockPanel>
    <controls:ToolbarPanel DockPanel.Dock="Top">
      <Button Classes="toolbar" Command="{Binding SolutionCommand}" ToolTip.Tip="{l:T codeMetrics.calculateCodeMetricsForSolution}" AutomationProperties.Name="{l:T codeMetrics.calculateCodeMetricsForSolution}">
        <StackPanel Orientation="Horizontal" Spacing="4"><controls:Icon Kind="solution" /><TextBlock Text="{l:T codeMetrics.solution}" /></StackPanel>
      </Button>
      <Button Classes="toolbar" Command="{Binding ProjectCommand}" ToolTip.Tip="{l:T codeMetrics.calculateCodeMetricsForTheActive}" AutomationProperties.Name="{l:T codeMetrics.calculateCodeMetricsForProject}">
        <StackPanel Orientation="Horizontal" Spacing="4"><controls:Icon Kind="project" /><TextBlock Text="{l:T codeMetrics.project}" /></StackPanel>
      </Button>
      <Button Classes="toolbar" Command="{Binding CopyCommand}" ToolTip.Tip="{l:T codeMetrics.copyTheResultsAsTabSeparated}" AutomationProperties.Name="{l:T codeMetrics.copyResults}">
        <controls:Icon Kind="file-data" />
      </Button>
    </controls:ToolbarPanel>
    <!-- The table fills the pane; below its minimum width the columns keep their widths and scroll sideways together (M34d). -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <DockPanel MinWidth="640" Width="{Binding $parent[ScrollViewer].Bounds.Width}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,90,90,80,80,80,90" Margin="8,2,24,2">
          <TextBlock Classes="muted" Text="{l:T codeMetrics.hierarchy}" />
          <TextBlock Grid.Column="1" Classes="muted" Text="{l:T codeMetrics.maintainability}" HorizontalAlignment="Right" ToolTip.Tip="{l:T codeMetrics.maintainabilityIndex20100Good10}" />
          <TextBlock Grid.Column="2" Classes="muted" Text="{l:T codeMetrics.complexity}" HorizontalAlignment="Right" ToolTip.Tip="{l:T codeMetrics.cyclomaticComplexity}" />
          <TextBlock Grid.Column="3" Classes="muted" Text="{l:T codeMetrics.inheritance}" HorizontalAlignment="Right" ToolTip.Tip="{l:T codeMetrics.depthOfInheritance}" />
          <TextBlock Grid.Column="4" Classes="muted" Text="{l:T codeMetrics.coupling}" HorizontalAlignment="Right" ToolTip.Tip="{l:T codeMetrics.classCoupling}" />
          <TextBlock Grid.Column="5" Classes="muted" Text="{l:T codeMetrics.source}" HorizontalAlignment="Right" ToolTip.Tip="{l:T codeMetrics.linesOfSourceCode}" />
          <TextBlock Grid.Column="6" Classes="muted" Text="{l:T codeMetrics.executable}" HorizontalAlignment="Right" ToolTip.Tip="{l:T codeMetrics.linesOfExecutableCode}" />
        </Grid>
        <Grid>
          <TextBlock Classes="emptyState" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
          <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" Background="Transparent" AutomationProperties.Name="{l:T codeMetrics.codeMetricsResults}">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:MetricsNodeViewModel">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                <Setter Property="MinHeight" Value="20" />
              </Style>
              <!-- Stretch the header so the metric columns line up at the right whatever the depth. -->
              <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:MetricsNodeViewModel" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="*,90,90,80,80,80,90" Background="Transparent">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:Icon Kind="{Binding Icon}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Panel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Maintainability}" VerticalAlignment="Center" IsVisible="{Binding !IsLow}" />
                    <TextBlock Text="{Binding Maintainability}" VerticalAlignment="Center" Foreground="{DynamicResource Shell.Error}" FontWeight="SemiBold" IsVisible="{Binding IsLow}" />
                  </Panel>
                  <TextBlock Grid.Column="2" Text="{Binding Complexity}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Depth}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="{Binding Coupling}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="{Binding SourceLines}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="6" Text="{Binding ExecutableLines}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </Grid>
      </DockPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
