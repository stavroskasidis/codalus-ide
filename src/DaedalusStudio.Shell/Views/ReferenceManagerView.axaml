<local:LoadingView xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
                   xmlns:local="using:DaedalusStudio.Shell.Views"
                   x:Class="DaedalusStudio.Shell.Views.ReferenceManagerView"
                   x:DataType="vm:ReferenceManagerViewModel">
  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock Classes="heading" Text="{Binding Title}" />
      <TextBlock Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
    <TabControl>
      <TabItem Header="Projects">
        <DockPanel Margin="0,8,0,0">
          <TextBox DockPanel.Dock="Top" Text="{Binding Filter}" PlaceholderText="Filter projects" Margin="0,0,0,6" AutomationProperties.Name="Filter projects" />
          <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0" Content="Apply" Command="{Binding ApplyCommand}" AutomationProperties.Name="Apply project references" />
          <ListBox ItemsSource="{Binding VisibleProjects}" AutomationProperties.Name="Projects">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ReferenceChoiceViewModel">
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="Assemblies and analyzers">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <Button Content="Add Assembly…" Command="{Binding AddAssemblyCommand}" />
            <Button Content="Add Analyzer…" Command="{Binding AddAnalyzerCommand}" />
            <Button Content="Remove" Command="{Binding RemoveFileCommand}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" AutomationProperties.Name="Assembly and analyzer references">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FileReferenceRow">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="muted" Width="70" Text="{Binding Kind}" />
                  <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</local:LoadingView>
