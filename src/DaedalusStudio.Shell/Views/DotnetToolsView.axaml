<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DaedalusStudio.Shell.ViewModels"
             xmlns:controls="using:DaedalusStudio.Shell.Controls"
             x:Class="DaedalusStudio.Shell.Views.DotnetToolsView"
             x:DataType="vm:DotnetToolsViewModel">
  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Classes="heading" Text=".NET Tools" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding ManifestText}" />
        <Button Grid.Column="1" Classes="link" Content="Open Manifest" Command="{Binding OpenManifestCommand}" IsVisible="{Binding HasManifest}" />
      </Grid>
      <WrapPanel Orientation="Horizontal">
        <Button Margin="0,0,6,4" Content="Install Local Tool…" Command="{Binding InstallLocalCommand}" />
        <Button Margin="0,0,6,4" Content="Install Global Tool…" Command="{Binding InstallGlobalCommand}" />
        <Button Margin="0,0,6,4" Content="Update" Command="{Binding UpdateCommand}" />
        <Button Margin="0,0,6,4" Content="Uninstall" Command="{Binding UninstallCommand}" />
        <Button Margin="0,0,6,4" Content="Restore Local Tools" Command="{Binding RestoreCommand}" />
        <Button Margin="0,0,6,4" Content="Create Manifest" Command="{Binding CreateManifestCommand}" />
        <Button Classes="toolbar" Margin="0,0,6,4" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" AutomationProperties.Name="Refresh">
          <controls:Icon Kind="refresh" />
        </Button>
      </WrapPanel>
      <ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding IsBusy}" />
    </StackPanel>
    <TextBox DockPanel.Dock="Bottom" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" Text="{Binding Output}" IsVisible="{Binding HasOutput}"
             FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" AutomationProperties.Name="dotnet tool output" />
    <Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,120,*,80" Margin="8,2">
        <TextBlock Classes="muted" Text="Package id" />
        <TextBlock Grid.Column="1" Classes="muted" Text="Version" />
        <TextBlock Grid.Column="2" Classes="muted" Text="Commands" />
        <TextBlock Grid.Column="3" Classes="muted" Text="Scope" />
      </Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding Tools}" SelectedItem="{Binding Selected}" AutomationProperties.Name=".NET tools">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DotnetToolRow">
            <Grid ColumnDefinitions="*,120,*,80">
              <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding Version}" />
              <TextBlock Grid.Column="2" Text="{Binding Commands}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Classes="muted" Text="{Binding Scope}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</UserControl>
