<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DaedalusStudio.Shell.Controls"
        xmlns:core="using:Dock.Model.Core"
        xmlns:docking="using:DaedalusStudio.Shell.Docking">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Shell.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    <!-- A classic IDE's density: 9 pt UI text (M29, the Shell.FontSize tokens since M34d). -->
    <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Body}" />
  </Style>

  <!-- Dock tab headers show the dockable title; preview tabs in italics, pinned tabs with a pin (M34d). -->
  <Style Selector="DocumentControl">
    <Setter Property="HeaderTemplate">
      <DataTemplate DataType="docking:ShellDocument">
        <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding FilePath}">
          <controls:Icon Kind="{Binding TabIcon}" IsVisible="{Binding HasTabIcon}" Width="14" Height="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Title}" FontStyle="{Binding TitleFontStyle}" VerticalAlignment="Center" Padding="2" />
          <controls:Icon Kind="pin" IsVisible="{Binding IsPinned}" Width="12" Height="12" VerticalAlignment="Center" AutomationProperties.Name="Pinned" />
        </StackPanel>
      </DataTemplate>
    </Setter>
  </Style>
  <!--
    Tool window tabs fit their pane (FittingTabPanel): the widest shrink first and end in an ellipsis; tabs with no room
    left for a title show only their icon. The tooltip has the name.
  -->
  <Style Selector="ToolControl">
    <Setter Property="HeaderTemplate">
      <DataTemplate DataType="docking:ToolWindowDockable">
        <StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding Title}">
          <controls:Icon Classes="tabIcon" Kind="{Binding TabIcon}" IsVisible="{Binding HasTabIcon}" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,0,0" />
          <!-- The title's left margin (not the panel's spacing) keeps a tab's other parts the same width with or without it. -->
          <TextBlock Classes="tabTitle" Text="{Binding Title}" Padding="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     Margin="{Binding HasTabIcon, Converter={x:Static controls:FittingTabPanel.TitleMarginConverter}}"
                     IsVisible="{Binding !$parent[ToolTabStripItem].(controls:FittingTabPanel.IconOnly)}"
                     MaxWidth="{Binding $parent[ToolTabStripItem].(controls:FittingTabPanel.TitleMaxWidth)}" />
        </StackPanel>
      </DataTemplate>
    </Setter>
  </Style>
  <Style Selector="ToolTabStrip">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <controls:FittingTabPanel />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <!-- Dock scrolls the tabs sideways (hidden scroll bar), which gives them unlimited width: the panel needs the pane's. -->
  <Style Selector="ToolTabStrip /template/ ScrollViewer#PART_ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!--
    Document tabs (M34d): Dock's template, our colors in every state. Unselected tabs take Shell.Tab.Inactive (Blue's
    dark tabs), the selected tab of a pane without the focus Shell.Tab.Selected (its title was white on light gray in
    Light and black on black in High Contrast), the active one Shell.Tab.Active, or Shell.Tab.Preview when it previews.
    A tab colored by project has a stripe along its bottom edge. Styles outrank the control theme in any state, so
    every state is restated here, in order.
  -->
  <Style Selector="DocumentTabStripItem" x:DataType="docking:ShellDocument">
    <Setter Property="Background" Value="{DynamicResource Shell.Tab.Inactive}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Tab.Inactive.Foreground}" />
    <Setter Property="(controls:DocumentTab.IsPreview)" Value="{Binding IsPreview}" />
    <Setter Property="(controls:DocumentTab.IsPinned)" Value="{Binding IsPinned}" />
    <Setter Property="BorderBrush" Value="{Binding TabAccent}" />
    <Setter Property="BorderThickness" Value="{Binding TabAccentThickness}" />
  </Style>
  <Style Selector="DocumentTabStripItem:pointerover:not(:selected)">
    <Setter Property="Background" Value="{DynamicResource Shell.Tab.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Tab.Hover.Foreground}" />
  </Style>
  <Style Selector="DocumentTabStripItem:selected">
    <Setter Property="Background" Value="{DynamicResource Shell.Tab.Selected}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Tab.Selected.Foreground}" />
  </Style>
  <Style Selector="DocumentTabStripItem:active:selected">
    <Setter Property="Background" Value="{DynamicResource Shell.Tab.Active}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Tab.Active.Foreground}" />
  </Style>
  <Style Selector="DocumentTabStripItem:active:selected[(controls|DocumentTab.IsPreview)=True]">
    <Setter Property="Background" Value="{DynamicResource Shell.Tab.Preview}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Tab.Preview.Foreground}" />
  </Style>

  <!-- Tool window tabs: a hover that keeps its text readable, and the selected tab's title in the link color. -->
  <Style Selector="ToolTabStripItem:pointerover:not(:selected)">
    <Setter Property="Background" Value="{DynamicResource Shell.Tab.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Tab.Hover.Foreground}" />
  </Style>
  <Style Selector="ToolTabStripItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Link}" />
  </Style>

  <!-- Tool window captions: Shell.Caption.Active with the focus, Shell.Caption.Inactive without (M34d). -->
  <Style Selector="ToolChromeControl /template/ Grid#PART_Grip">
    <Setter Property="Background" Value="{DynamicResource Shell.Caption.Inactive}" />
  </Style>
  <Style Selector="ToolChromeControl /template/ TextBlock#PART_Title">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Caption.Inactive.Foreground}" />
  </Style>
  <Style Selector="ToolChromeControl /template/ Path">
    <Setter Property="Fill" Value="{DynamicResource Shell.Caption.Inactive.Foreground}" />
  </Style>
  <Style Selector="ToolChromeControl:active /template/ Grid#PART_Grip">
    <Setter Property="Background" Value="{DynamicResource Shell.Caption.Active}" />
  </Style>
  <Style Selector="ToolChromeControl:active /template/ TextBlock#PART_Title">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Caption.Active.Foreground}" />
  </Style>
  <Style Selector="ToolChromeControl:active /template/ Path">
    <Setter Property="Fill" Value="{DynamicResource Shell.Caption.Active.Foreground}" />
  </Style>

  <!-- Type (M34d): body text is the window's 12 px; .small for secondary text, .subheading and .heading for titles. -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Small}" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.subheading">
    <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="SelectableTextBlock.subheading">
    <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- An empty or error state's message: muted, wrapped, with room around it; a next step goes below it. -->
  <Style Selector="TextBlock.emptyState">
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="{DynamicResource Shell.Padding.EmptyState}" />
  </Style>

  <!-- Tool window toolbars (M34d): one row that never wraps (ToolbarPanel), 24 px buttons with 16 px icons. -->
  <Style Selector="controls|ToolbarPanel">
    <Setter Property="Margin" Value="{DynamicResource Shell.Padding.Toolbar}" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
  </Style>
  <Style Selector="controls|ToolbarPanel > TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Input}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|ToolbarPanel > ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Input}" />
    <Setter Property="Height" Value="{DynamicResource Shell.Size.Input}" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="controls|ToolbarPanel > Button:not(.toolbar)">
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <Style Selector="Button.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="{DynamicResource Shell.Padding.ToolbarButton}" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
    <Setter Property="MinWidth" Value="{DynamicResource Shell.Size.ToolbarButton}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.CornerRadius}" />
  </Style>
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
  </Style>
  <!-- A disabled toolbar button is a dimmed icon, not a gray box. -->
  <Style Selector="Button.toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToggleButton.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="{DynamicResource Shell.Padding.ToolbarButton}" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
    <Setter Property="MinWidth" Value="{DynamicResource Shell.Size.ToolbarButton}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.CornerRadius}" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Body}" />
  </Style>

  <!-- The status bar's color says the state: purple without a solution, the accent with one, orange while debugging. -->
  <Style Selector="Border#StatusBarHost">
    <Setter Property="Background" Value="{DynamicResource Shell.StatusBar}" />
  </Style>
  <Style Selector="Border#StatusBarHost.empty">
    <Setter Property="Background" Value="{DynamicResource Shell.StatusBar.Empty}" />
  </Style>
  <Style Selector="Border#StatusBarHost.debugging">
    <Setter Property="Background" Value="{DynamicResource Shell.StatusBar.Debugging}" />
  </Style>

  <!-- The title row, the standard toolbar and the search box (M29). -->
  <Style Selector="Border.titleBar">
    <Setter Property="Background" Value="{DynamicResource Shell.TitleBar}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.TitleBar.Foreground}" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="Border.titleBar Menu">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Avalonia's drawn decorations write the window's title over the client area; our title row has the menu there
       (the solution's name is shown next to the search box). A trigger selector outranks the template's binding. -->
  <Style Selector="WindowDrawnDecorations:not(:fullscreen) /template/ Panel#PART_TitleTextPanel">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.standardToolbar">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.toolbarSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="4,4" />
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Border}" />
  </Style>
  <Style Selector="ComboBox.toolbar">
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Input}" />
    <Setter Property="Height" Value="{DynamicResource Shell.Size.Input}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The editor's navigation bar (M34a): flat pickers, a border only on hover, a small chevron, the tabs' height. -->
  <Style Selector="Border.navigationBar">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="2,1" />
  </Style>
  <Style Selector="ComboBox.navigationBar">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="6,0,4,0" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.navigationBar /template/ Border#Background">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ComboBox.navigationBar:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Shell.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
  </Style>
  <Style Selector="ComboBox.navigationBar:dropdownopen /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Shell.Selection}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Focus}" />
  </Style>
  <Style Selector="ComboBox.navigationBar:focus-visible /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Focus}" />
  </Style>
  <Style Selector="ComboBox.navigationBar /template/ PathIcon#DropDownGlyph">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
  </Style>
  <Style Selector="ComboBox.navigationBar /template/ TextBlock#PlaceholderTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
  </Style>
  <Style Selector="ComboBox.navigationBar ComboBoxItem">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="controls|Icon.start">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Run}" />
  </Style>
  <Style Selector="controls|Icon.stop">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Stop}" />
  </Style>

  <!-- Command families color their icons (M34a, D24): the tokens are monochrome in High Contrast. -->
  <Style Selector="controls|Icon.accent-run">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Run}" />
  </Style>
  <Style Selector="controls|Icon.accent-stop">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Stop}" />
  </Style>
  <Style Selector="controls|Icon.accent-save">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Save}" />
  </Style>
  <Style Selector="controls|Icon.accent-open">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Open}" />
  </Style>
  <Style Selector="controls|Icon.accent-build">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Build}" />
  </Style>
  <Style Selector="controls|Icon.accent-git">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Git}" />
  </Style>
  <Style Selector="controls|Icon.accent-test">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Test}" />
  </Style>
  <Style Selector="controls|Icon.accent-navigate">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Navigate}" />
  </Style>
  <!-- Disabled commands dim their icons, colored or not. -->
  <Style Selector="MenuItem:disabled controls|Icon">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button:disabled controls|Icon">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.searchBox">
    <Setter Property="Background" Value="{DynamicResource Shell.Search}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Search.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.solutionName">
    <Setter Property="Background" Value="{DynamicResource Shell.Hover}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="4,0" />
  </Style>

  <!-- Status bar entries. -->
  <Style Selector="Button.statusbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.StatusBar.Foreground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.statusbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.StatusBar.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.StatusBar.Foreground}" />
  </Style>
  <Style Selector="Button.statusbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.StatusBar.Hover}" />
  </Style>
  <!-- Items without a command are plain text, not disabled buttons. -->
  <Style Selector="Button.statusbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.StatusBar.Foreground}" />
  </Style>

  <!-- Links (Settings UI, Markdown views). -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Link}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Link}" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>

  <!-- Floating surfaces: command palette and toasts. -->
  <Style Selector="Border.overlay">
    <Setter Property="Background" Value="{DynamicResource Shell.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Overlay.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BoxShadow" Value="0 6 18 0 #40000000" />
  </Style>

  <Style Selector="controls|Icon.info">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Info}" />
  </Style>
  <Style Selector="controls|Icon.warning">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Warning}" />
  </Style>
  <Style Selector="controls|Icon.error">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Error}" />
  </Style>
  <!-- Test outcomes: color and shape both carry the outcome (accessibility). -->
  <Style Selector="controls|Icon.passed">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Diff.Added}" />
  </Style>
  <Style Selector="controls|Icon.failed">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Error}" />
  </Style>
  <Style Selector="controls|Icon.skipped">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Warning}" />
  </Style>
  <Style Selector="controls|Icon.running">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Info}" />
  </Style>
  <Style Selector="controls|Icon.none">
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
  </Style>
  <!-- Tabs inside documents and dialogs (dumps, HTTP responses, Reference Manager): body-sized headers, not Fluent's 24 pt. -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <!-- Quick Info and diagnostics popup in the editor. -->
  <Style Selector="Border.editorHover">
    <Setter Property="Background" Value="{DynamicResource Shell.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Overlay.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
</Styles>
