    <ResourceDictionary x:Key="{x:Static theming:ThemeService.HighContrast}">
      <SolidColorBrush x:Key="Shell.Background" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.MutedForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Panel" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Hover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Selection" Color="#0E4A7B" />
      <SolidColorBrush x:Key="Shell.Accent" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.AccentForeground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Focus" Color="#F38518" />
      <SolidColorBrush x:Key="Shell.StatusBar" Color="#000000" />
      <SolidColorBrush x:Key="Shell.StatusBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Hover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.StatusBar.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Overlay" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Overlay.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Match" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Info" Color="#75BEFF" />
      <SolidColorBrush x:Key="Shell.Warning" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.Error" Color="#F48771" />
      <SolidColorBrush x:Key="Shell.Link" Color="#21A6FF" />
      <SolidColorBrush x:Key="Shell.Modified" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.Editor.Background" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Editor.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers" Color="#FFFFFF" />
      <!-- Fluent colors (palettes cannot target custom variants). The accent fills selected tabs and checkboxes
           under white text, so it is a blue with about 5:1 contrast against white rather than cyan. -->
      <Color x:Key="SystemAccentColor">#0F6CBD</Color>
      <Color x:Key="SystemRegionColor">#000000</Color>
      <Color x:Key="SystemAltHighColor">#000000</Color>
      <Color x:Key="SystemBaseHighColor">#FFFFFF</Color>
      <Color x:Key="SystemBaseMediumColor">#FFFFFF</Color>
      <Color x:Key="SystemChromeLowColor">#000000</Color>
      <Color x:Key="SystemChromeMediumColor">#000000</Color>
      <Color x:Key="SystemChromeMediumLowColor">#000000</Color>
      <Color x:Key="SystemListLowColor">#1F1F1F</Color>
      <Color x:Key="SystemListMediumColor">#0E4A7B</Color>
      <SolidColorBrush x:Key="SystemRegionBrush" Color="#000000" />
      <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#000000" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#0F6CBD" />
      <!-- M34d: menus, drop-downs, flyouts and tooltips are black like High Contrast's other surfaces (Fluent's are dark
           gray, and its resources take their colors by StaticResource, so the keys the controls use are overridden). -->
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#000000" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#0E4A7B" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#0E4A7B" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="#0E4A7B" />
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#000000" />
      <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="ToolTipBackground" Color="#000000" />
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF" />
      <!-- Buttons and combo boxes: black with a white outline, not Fluent's dark gray (buttons) or accent fill (combo boxes). -->
      <SolidColorBrush x:Key="ButtonBackground" Color="#000000" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1F1F1F" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0E4A7B" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#F38518" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1F1F1F" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#0E4A7B" />
      <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#F38518" />
      <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#FFFFFF" />
      <!-- Fluent focus rectangles. -->
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#F38518" />
      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Diff.Added" Color="#00FF00" />
      <SolidColorBrush x:Key="Shell.Diff.Removed" Color="#FF6B6B" />
      <SolidColorBrush x:Key="Shell.Editor.Fold" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.Fold.Hover" Color="#0E4A7B" />
      <!-- High Contrast keeps icons monochrome: shape carries the meaning, not color. -->
      <SolidColorBrush x:Key="Shell.Icon.Run" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Stop" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Save" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Open" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Build" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Git" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Test" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Navigate" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.InlayHint.Foreground" Color="#D0D0D0" />
      <SolidColorBrush x:Key="Shell.Editor.InlayHint.Background" Color="#1A1A1A" />
      <SolidColorBrush x:Key="Shell.Editor.Guide" Color="#7F7F7F" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket1" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket2" Color="#DA70D6" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket3" Color="#87CEFA" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty" Color="#000000" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging" Color="#000000" />
      <SolidColorBrush x:Key="Shell.TitleBar" Color="#000000" />
      <SolidColorBrush x:Key="Shell.TitleBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Toolbar" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Toolbar.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Search" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Search.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Tab.Active" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Tab.Active.Foreground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Caption.Active" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Caption.Active.Foreground" Color="#000000" />
      <!-- M34d: the selected tab of a pane without the focus, hover, the preview tab, captions without the focus. -->
      <SolidColorBrush x:Key="Shell.Tab.Selected" Color="#0E4A7B" />
      <SolidColorBrush x:Key="Shell.Tab.Selected.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Tab.Hover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Tab.Hover.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Tab.Preview" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Tab.Preview.Foreground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive.Foreground" Color="#FFFFFF" />
      <!-- Tabs colored by project (M34d): eight stripes, at least 3:1 against the tabs. -->
      <SolidColorBrush x:Key="Shell.TabColor.1" Color="#75BEFF" />
      <SolidColorBrush x:Key="Shell.TabColor.2" Color="#00FF00" />
      <SolidColorBrush x:Key="Shell.TabColor.3" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.TabColor.4" Color="#DA70D6" />
      <SolidColorBrush x:Key="Shell.TabColor.5" Color="#FF8C00" />
      <SolidColorBrush x:Key="Shell.TabColor.6" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.TabColor.7" Color="#FF69B4" />
      <SolidColorBrush x:Key="Shell.TabColor.8" Color="#FFFFFF" />
      <!-- Dock's document well and tool window captions. -->
      <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#1AEBFF" />
      <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#1AEBFF" />
      <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#1AEBFF" />
      <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSeparatorBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#6FC3DF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!--
    Spacing, sizes and type (M34d, docs/ui-guidelines.md). The same in every theme. Spacing is a 4 px grid (2 for
    hairlines); toolbars are one height with one icon size; UI text is 9 pt (12 px), secondary text 11 px, and there
    are two heading sizes. Views take these through the classes in ShellStyles.axaml or {DynamicResource}.
  -->
  <x:Double x:Key="Shell.Space.XS">2</x:Double>
  <x:Double x:Key="Shell.Space.S">4</x:Double>
  <x:Double x:Key="Shell.Space.M">8</x:Double>
  <x:Double x:Key="Shell.Space.L">12</x:Double>
  <x:Double x:Key="Shell.Space.XL">16</x:Double>
  <x:Double x:Key="Shell.Size.Toolbar">28</x:Double>
  <x:Double x:Key="Shell.Size.ToolbarButton">24</x:Double>
  <x:Double x:Key="Shell.Size.Input">24</x:Double>
  <x:Double x:Key="Shell.Size.Icon">16</x:Double>
  <x:Double x:Key="Shell.Size.IconSmall">12</x:Double>
  <x:Double x:Key="Shell.Size.Row">22</x:Double>
  <x:Double x:Key="Shell.Size.ToolWindowMinWidth">280</x:Double>
  <x:Double x:Key="Shell.FontSize.Body">12</x:Double>
  <x:Double x:Key="Shell.FontSize.Small">11</x:Double>
  <x:Double x:Key="Shell.FontSize.Heading">14</x:Double>
  <x:Double x:Key="Shell.FontSize.Title">18</x:Double>
  <Thickness x:Key="Shell.Padding.Toolbar">4,2</Thickness>
  <Thickness x:Key="Shell.Padding.ToolbarButton">4,3</Thickness>
  <Thickness x:Key="Shell.Padding.Panel">8,6</Thickness>
  <Thickness x:Key="Shell.Padding.EmptyState">12</Thickness>
  <Thickness x:Key="Shell.Padding.Page">16</Thickness>
  <Thickness x:Key="Shell.Padding.Row">0,1</Thickness>
  <CornerRadius x:Key="Shell.CornerRadius">3</CornerRadius>
  <CornerRadius x:Key="Shell.CornerRadius.Overlay">6</CornerRadius>

  <!-- Menu density (M34a): rows of about 24 px at 9 pt, as in a classic IDE, so the menus fit a 1080p screen. -->
  <Thickness x:Key="MenuFlyoutItemThemePadding">8,4,12,4</Thickness>
  <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">8,4,12,4</Thickness>
  <Thickness x:Key="MenuFlyoutSeparatorThemePadding">-4,2,-4,2</Thickness>
</ResourceDictionary>
