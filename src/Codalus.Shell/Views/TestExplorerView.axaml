<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.TestExplorerView"
             x:DataType="vm:TestExplorerViewModel">
  <DockPanel>
    <!-- Toolbar: run, debug, repeat, cancel; grouping and playlist. One row: what doesn't fit goes to the overflow menu (M34d). -->
    <controls:ToolbarPanel DockPanel.Dock="Top">
      <Button Classes="toolbar" Command="{Binding RunAllCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{l:T testExplorer.runAllTestsCtrlRA}" AutomationProperties.Name="{l:T testExplorer.runAllTests}">
        <controls:Icon Kind="run-all" />
      </Button>
      <Button Classes="toolbar" Command="{Binding RunSelectedCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{l:T testExplorer.runSelectedTests}" AutomationProperties.Name="{l:T testExplorer.runSelectedTests}">
        <controls:Icon Kind="play" />
      </Button>
      <Button Classes="toolbar" Command="{Binding DebugSelectedCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{l:T testExplorer.debugSelectedTests}" AutomationProperties.Name="{l:T testExplorer.debugSelectedTests}">
        <controls:Icon Kind="debug" />
      </Button>
      <Button Classes="toolbar" Command="{Binding CoverSelectedCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{l:T testExplorer.runSelectedTestsWithCoverage}" AutomationProperties.Name="{l:T testExplorer.runSelectedTestsWithCoverage}">
        <controls:Icon Kind="coverage" />
      </Button>
      <Button Classes="toolbar" Command="{Binding RunFailedCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{l:T testExplorer.runFailedTests}" AutomationProperties.Name="{l:T testExplorer.runFailedTests}">
        <controls:Icon Kind="test-failed" Classes="failed" />
      </Button>
      <Button Classes="toolbar" Command="{Binding RunNotRunCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{l:T testExplorer.runTestsThatHaveNotRun}" AutomationProperties.Name="{l:T testExplorer.runTestsThatHaveNotRun}">
        <controls:Icon Kind="test-none" Classes="none" />
      </Button>
      <Button Classes="toolbar" Command="{Binding RepeatLastCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{l:T testExplorer.repeatLastRunCtrlRL}" AutomationProperties.Name="{l:T testExplorer.repeatLastRun}">
        <controls:Icon Kind="history" />
      </Button>
      <Button Classes="toolbar" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" ToolTip.Tip="{l:T testExplorer.cancel}" AutomationProperties.Name="{l:T testExplorer.cancelTestRun}">
        <controls:Icon Kind="stop" />
      </Button>
      <Button Classes="toolbar" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsIdle}" ToolTip.Tip="{l:T testExplorer.refreshBuildAndDiscoverTests}" AutomationProperties.Name="{l:T testExplorer.refreshTests}">
        <controls:Icon Kind="refresh" />
      </Button>
      <Button Classes="toolbar" Command="{Binding CollapseAllCommand}" ToolTip.Tip="{l:T testExplorer.collapseAll}" AutomationProperties.Name="{l:T testExplorer.collapseAll}">
        <controls:Icon Kind="collapse-all" />
      </Button>
      <Border Classes="toolbarSeparator" />
      <ComboBox Classes="toolbar" ItemsSource="{Binding Groupings}" SelectedIndex="{Binding GroupingIndex}" Width="176" ToolTip.Tip="{l:T testExplorer.groupBy}" AutomationProperties.Name="{l:T testExplorer.groupBy}" />
      <ComboBox Classes="toolbar" ItemsSource="{Binding PlaylistNames}" SelectedIndex="{Binding PlaylistIndex}" Width="110" ToolTip.Tip="{l:T testExplorer.playlist}" AutomationProperties.Name="{l:T testExplorer.playlist}" />
      <ComboBox Classes="toolbar" ItemsSource="{Binding EnvironmentNames}" SelectedIndex="{Binding EnvironmentIndex}" Width="120" IsVisible="{Binding HasEnvironments}" ToolTip.Tip="{l:T testExplorer.targetEnvironment}" AutomationProperties.Name="{l:T testExplorer.targetEnvironment}" />
    </controls:ToolbarPanel>
    <!-- The search box has its own row, the pane's width. -->
    <TextBox x:Name="Filter" DockPanel.Dock="Top" Margin="4,0,4,4" Text="{Binding FilterText}" PlaceholderText="{l:T testExplorer.searchTestExplorer}"
             ToolTip.Tip="{l:T testExplorer.searchOutcomeFailedTraitCategoryMath}" AutomationProperties.Name="{l:T testExplorer.searchTestExplorer}" />
    <TextBlock DockPanel.Dock="Top" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Margin="8,0,8,3" TextWrapping="Wrap" Text="{Binding Summary}" />

    <Grid RowDefinitions="*,Auto,Auto">
      <Grid>
        <TextBlock Classes="emptyState" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />
        <ListBox x:Name="List"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding Selected}"
                 IsVisible="{Binding HasTests}"
                 Background="Transparent"
                 AutomationProperties.Name="{l:T testExplorer.testExplorer}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="vm:TestRowViewModel">
              <Setter Property="Padding" Value="0,1" />
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TestRowViewModel">
              <!-- The label trims with an ellipsis in a narrow pane; the row's tooltip has the full text (M34d). -->
              <DockPanel Margin="{Binding Indent}" Background="Transparent" ToolTip.Tip="{Binding Tooltip}">
                <Border DockPanel.Dock="Left" Classes="chevron" Width="16" Height="18" Background="Transparent">
                  <controls:Icon Kind="{Binding Chevron}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <controls:Icon DockPanel.Dock="Left" Margin="4,0" Kind="{Binding OutcomeIcon}" VerticalAlignment="Center"
                               Classes.passed="{Binding Style.IsPassed}" Classes.failed="{Binding Style.IsFailed}" Classes.skipped="{Binding Style.IsSkipped}"
                               Classes.running="{Binding Style.IsRunning}" Classes.none="{Binding Style.IsNone}" />
                <controls:Icon DockPanel.Dock="Right" Margin="4,0" Kind="warning" Classes="warning" IsVisible="{Binding HasError}" ToolTip.Tip="{Binding Error}" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Label}" />
                  <Run Text="{Binding Detail}" FontSize="{DynamicResource Shell.FontSize.Small}" Classes="muted" />
                </TextBlock>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Background="{DynamicResource Shell.Border}" IsVisible="{Binding HasDetails}" />

      <!-- Details of the selected test. -->
      <ScrollViewer Grid.Row="2" MaxHeight="320" IsVisible="{Binding HasDetails}" AutomationProperties.Name="{l:T testExplorer.testDetails}">
        <StackPanel Margin="10,6" Spacing="6">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:Icon Kind="{Binding DetailsIcon}"
                           Classes.passed="{Binding DetailsStyle.IsPassed}" Classes.failed="{Binding DetailsStyle.IsFailed}" Classes.skipped="{Binding DetailsStyle.IsSkipped}"
                           Classes.running="{Binding DetailsStyle.IsRunning}" Classes.none="{Binding DetailsStyle.IsNone}" />
            <SelectableTextBlock Text="{Binding DetailsTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Classes="muted" Text="{Binding DetailsOutcome}" />
          <Button Classes="link" Content="{Binding DetailsSource}" IsVisible="{Binding HasSource}" Click="OnOpenSource" AutomationProperties.Name="{l:T testExplorer.openTheTestSSource}" />
          <StackPanel IsVisible="{Binding HasMessage}" Spacing="2">
            <TextBlock Classes="muted" Text="{l:T testExplorer.message}" />
            <SelectableTextBlock Text="{Binding DetailsMessage}" TextWrapping="Wrap" />
          </StackPanel>
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" IsVisible="{Binding HasExpected}">
            <TextBlock Classes="muted" Text="{l:T testExplorer.expected}" />
            <SelectableTextBlock Grid.Column="1" Text="{Binding DetailsExpected}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="1" Classes="muted" Text="{l:T testExplorer.actual}" />
            <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailsActual}" TextWrapping="Wrap" />
          </Grid>
          <StackPanel IsVisible="{Binding HasFrames}" Spacing="1">
            <TextBlock Classes="muted" Text="{l:T testExplorer.stackTrace}" />
            <ItemsControl ItemsSource="{Binding DetailsFrames}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StackFrameRow">
                  <Panel>
                    <Button Classes="link" IsVisible="{Binding HasLocation}" Click="OnOpenFrame" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Text}">
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                    </Button>
                    <TextBlock Classes="muted" IsVisible="{Binding !HasLocation}" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" />
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel IsVisible="{Binding HasOutput}" Spacing="2">
            <TextBlock Classes="muted" Text="{l:T testExplorer.output}" />
            <SelectableTextBlock Text="{Binding DetailsOutput}" TextWrapping="Wrap" FontSize="12" />
          </StackPanel>
          <StackPanel IsVisible="{Binding HasHistory}" Spacing="1">
            <TextBlock Classes="muted" Text="{l:T testExplorer.history}" />
            <ItemsControl ItemsSource="{Binding DetailsHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryRow">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:Icon Kind="{Binding Icon}"
                                   Classes.passed="{Binding Style.IsPassed}" Classes.failed="{Binding Style.IsFailed}" Classes.skipped="{Binding Style.IsSkipped}"
                                   Classes.none="{Binding Style.IsNone}" />
                    <TextBlock Text="{Binding Outcome}" MinWidth="60" />
                    <TextBlock Classes="muted" Text="{Binding When}" />
                    <TextBlock Classes="muted" Text="{Binding Duration}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
