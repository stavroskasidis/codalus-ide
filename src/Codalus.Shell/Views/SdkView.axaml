<local:LoadingView xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:Codalus.Shell.ViewModels"
                   xmlns:local="using:Codalus.Shell.Views"
                   xmlns:protocol="using:Codalus.Projects.Protocol"
                   x:Class="Codalus.Shell.Views.SdkView"
                   x:DataType="vm:SdkViewModel">
  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock Classes="heading" Text="{l:T sdk.netSdks}" />
      <TextBlock TextWrapping="Wrap" Text="{Binding ResolvedText}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding GlobalJsonText}" />
      <TextBlock Foreground="{DynamicResource Shell.Warning.Foreground}" TextWrapping="Wrap" Text="{Binding Warning}" IsVisible="{Binding HasWarning}" />
      <TextBlock Foreground="{DynamicResource Shell.Error.Foreground}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
    <Grid ColumnDefinitions="*,16,*">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4" Text="{l:T sdk.installedSdks}" />
        <!-- Wraps rather than clipping when the column is narrow (M34's checklist). -->
        <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" Margin="0,8,0,0">
          <Button Content="{l:T sdk.useThisSdk}" Command="{Binding PinCommand}" ToolTip.Tip="{l:T sdk.writesGlobalJsonNextToThe}" />
          <TextBlock VerticalAlignment="Center" Text="{l:T sdk.rollForward}" />
          <ComboBox MinWidth="130" ItemsSource="{x:Static vm:SdkViewModel.RollForwardOptions}" SelectedItem="{Binding RollForward}" AutomationProperties.Name="{l:T sdk.rollForward2}" />
          <Button Content="{l:T sdk.removePin}" Command="{Binding UnpinCommand}" />
          <Button Classes="link" Content="{l:T sdk.refresh}" Command="{Binding RefreshCommand}" />
        </WrapPanel>
        <ListBox ItemsSource="{Binding Sdks}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:T sdk.installedSdks}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SdkRow">
              <StackPanel>
                <TextBlock Text="{Binding Display}" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Support}" IsVisible="{Binding !IsOutOfSupport}" />
                <TextBlock Foreground="{DynamicResource Shell.Warning.Foreground}" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Support}" IsVisible="{Binding IsOutOfSupport}" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Path}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4" Text="{l:T sdk.workloads}" />
        <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{l:T sdk.noWorkloadsAreInstalled}" IsVisible="{Binding !HasWorkloads}" />
        <ListBox ItemsSource="{Binding Workloads}" AutomationProperties.Name="{l:T sdk.workloads}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="protocol:DotnetWorkload">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Id}" />
                <TextBlock Classes="muted" Text="{Binding Version}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</local:LoadingView>
