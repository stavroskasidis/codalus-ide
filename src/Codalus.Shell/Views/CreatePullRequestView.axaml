<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.CreatePullRequestView"
             x:DataType="vm:CreatePullRequestViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,18" Spacing="10" MaxWidth="780" HorizontalAlignment="Left">
      <TextBlock Classes="heading" Text="{Binding Header}" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4">
        <TextBlock Text="{l:T createPullRequest.from}" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" />
        <TextBlock Grid.Column="1" Text="{Binding SourceBranch}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Text="{l:T createPullRequest.into}" Classes="muted" VerticalAlignment="Center" Margin="0,6,12,0" />
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" MinWidth="220" Margin="0,6,0,0" AutomationProperties.Name="{l:T createPullRequest.branchToMergeInto}" />
      </Grid>
      <TextBlock Text="{l:T createPullRequest.title}" Classes="muted" />
      <TextBox x:Name="TitleBox" Text="{Binding Title}" AutomationProperties.Name="{l:T createPullRequest.pullRequestTitle}" />
      <TextBlock Text="{l:T createPullRequest.descriptionMarkdown}" Classes="muted" />
      <TextBox Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" AutomationProperties.Name="{l:T createPullRequest.pullRequestDescription}" />
      <CheckBox Content="{l:T createPullRequest.createAsADraft}" IsChecked="{Binding IsDraft}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="{l:T createPullRequest.createPullRequest}" Command="{Binding CreateCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Content="{l:T createPullRequest.writeWithAi}" Command="{Binding WriteWithAiCommand}" IsEnabled="{Binding !IsBusy}" IsVisible="{Binding IsEnabled, Source={x:Static l:AiUi.Current}}" AutomationProperties.Name="{l:T createPullRequest.writeTheTitleAndDescriptionWithAi}" />
        <TextBlock Text="{l:T createPullRequest.pushingTheBranchAndCreatingThe}" Classes="muted" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Created}" IsVisible="{Binding HasCreated}" FontWeight="SemiBold" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
