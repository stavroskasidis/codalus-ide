<local:LoadingView xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:Codalus.Shell.ViewModels"
                   xmlns:local="using:Codalus.Shell.Views"
                   xmlns:controls="using:Codalus.Shell.Controls"
                   x:Class="Codalus.Shell.Views.BinaryLogView"
                   x:DataType="vm:BinaryLogViewModel">
  <DockPanel Margin="12,10">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Classes="heading" Text="{Binding Title}" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Path}" />
        </StackPanel>
        <Button Classes="iconText" controls:ButtonIcon.Kind="link-external" Grid.Column="1" Content="{l:T binaryLog.openFile}" Command="{Binding OpenCommand}" VerticalAlignment="Top" ToolTip.Tip="{l:T binaryLog.openTheSelectedNodeSFile}" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="SearchBox" Classes="search" Text="{Binding Query}" PlaceholderText="{l:T binaryLog.searchTheLogProjectsTargetsTasks}" AutomationProperties.Name="{l:T binaryLog.searchTheBinaryLog}" />
        <Button Grid.Column="1" Margin="6,0,0,0" Content="{l:T binaryLog.search}" Command="{Binding SearchCommand}" IsDefault="True" />
      </Grid>
      <TextBlock Classes="muted" Text="{Binding Summary}" />
      <TextBlock Foreground="{DynamicResource Shell.Error.Foreground}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
    <Grid ColumnDefinitions="*,Auto,*">
      <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="{l:T binaryLog.binaryLogTree}">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:BinaryLogNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="MinHeight" Value="22" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="vm:BinaryLogNodeViewModel" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
              <controls:Icon Kind="{Binding Icon}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Text}" VerticalAlignment="Center" MaxWidth="900" MaxLines="1" TextTrimming="CharacterEllipsis" Classes.muted="{Binding IsPlaceholder}" />
              <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Duration}" IsVisible="{Binding HasDuration}" VerticalAlignment="Center" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <GridSplitter Grid.Column="1" Width="4" IsVisible="{Binding HasResults}" />
      <ListBox Grid.Column="2" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" IsVisible="{Binding HasResults}" AutomationProperties.Name="{l:T binaryLog.searchResults}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:BinaryLogSearchRowViewModel">
            <StackPanel AutomationProperties.Name="{Binding AccessibleName}">
              <TextBlock Text="{Binding Text}" MaxLines="1" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Kind}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</local:LoadingView>
