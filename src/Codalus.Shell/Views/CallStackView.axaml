<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:dap="using:Codalus.Debugging"
             x:Class="Codalus.Shell.Views.CallStackView"
             x:DataType="vm:CallStackViewModel">
  <DockPanel>
    <!-- The thread picker takes the rest of the row (M34g on M43: a fixed 220 px ran off a 280 px pane). -->
    <DockPanel DockPanel.Dock="Top" Margin="6,4">
      <TextBlock DockPanel.Dock="Left" Text="{l:T callStack.thread}" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox ItemsSource="{Binding Threads}" SelectedItem="{Binding SelectedThread}" MinWidth="120" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T callStack.thread2}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="dap:DapThread">
            <TextBlock TextTrimming="CharacterEllipsis">
              <Run Text="{Binding Id}" />
              <Run Text="{Binding Name}" />
            </TextBlock>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{l:T callStack.theCallStackAppearsHereWhile}" IsVisible="{Binding IsEmpty}" />
    <ListBox x:Name="List" ItemsSource="{Binding Frames}" Background="Transparent" AutomationProperties.Name="{l:T callStack.callStack}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:FrameRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
        <Style Selector="TextBlock.label">
          <Setter Property="FontStyle" Value="Italic" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FrameRow">
          <!-- The name and the location share the row (M34g on M43: a fixed 220 px location left a desktop-CLR frame's name 40 px). -->
          <Grid ColumnDefinitions="20,3*,2*">
            <TextBlock Text="{Binding Marker}" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}"
                       Classes.muted="{Binding IsDimmed}" Classes.label="{Binding IsLabel}" />
            <TextBlock Grid.Column="2" Margin="6,0,0,0" Text="{Binding Location}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LocationTip}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
