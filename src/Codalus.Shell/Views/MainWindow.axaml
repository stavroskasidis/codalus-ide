<Window xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="using:Codalus.Shell"
        xmlns:vm="using:Codalus.Shell.ViewModels"
        xmlns:views="using:Codalus.Shell.Views"
        xmlns:controls="using:Codalus.Shell.Controls"
        x:Class="Codalus.Shell.Views.MainWindow"
        x:DataType="shell:ShellHost"
        Title="{l:T main.codalusStudio}"
        Icon="avares://codalus/Assets/codalus.ico"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="{l:T main.codalusStudio}">

  <Window.Resources>
    <DataTemplate x:Key="StatusItemTemplate" x:DataType="vm:StatusItemViewModel">
      <Button Classes="statusbar"
              Command="{Binding Command}"
              IsTabStop="{Binding IsInteractive}"
              ToolTip.Tip="{Binding Tooltip}"
              AutomationProperties.Name="{Binding AccessibleName}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <controls:Icon Kind="{Binding Icon}" IsVisible="{Binding HasIcon}" Width="14" Height="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Text}" IsVisible="{Binding HasText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <!-- The title row (M29): the menu, the search box and the solution's name. On Windows it is the window's title
         bar (the client area extends into it); elsewhere it sits under the system's title bar. In a narrow window
         (0.6.0) the name trims, the search box shrinks to its icon, then the menu wraps onto a second row with the
         search box at its end; the caption buttons' room stays clear at the first row's right end (TitleBarPanel). -->
    <Border x:Name="TitleBar" DockPanel.Dock="Top" Classes="titleBar">
      <controls:TitleBarPanel x:Name="TitleRow">
        <Image x:Name="TitleIcon" controls:TitleBarPanel.Role="Icon" Width="16" Height="16" Margin="10,0,2,0" VerticalAlignment="Center" IsVisible="False"
               Source="avares://codalus/Assets/codalus.ico" />
        <!-- Its height is its rows' (the theme's is one row's, 32 px): TitleMenuPanel keeps one row 32 px tall. -->
        <Menu x:Name="MenuBar" controls:TitleBarPanel.Role="Menu" Height="NaN" VerticalAlignment="Center" AutomationProperties.Name="{l:T main.menuBar}">
          <Menu.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:TitleMenuPanel />
            </ItemsPanelTemplate>
          </Menu.ItemsPanel>
        </Menu>
        <Button x:Name="SearchBox" controls:TitleBarPanel.Role="Search" Classes="searchBox" Command="{Binding Toolbar.SearchCommand}" Margin="8,3"
                ToolTip.Tip="{l:T main.searchCommandsSettingsFilesAndCode}" AutomationProperties.Name="{l:T main.searchCtrlQ}">
          <Grid ColumnDefinitions="Auto,*">
            <controls:Icon Kind="search" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="searchText" Text="{l:T main.searchCtrlQ}" Margin="6,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </Button>
        <Border controls:TitleBarPanel.Role="Name" Classes="solutionName" IsVisible="{Binding Toolbar.HasSolution}" VerticalAlignment="Center"
                ToolTip.Tip="{Binding Toolbar.SolutionName}">
          <TextBlock Text="{Binding Toolbar.SolutionName}" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{l:T main.solutionName}" />
        </Border>
        <Panel x:Name="TitleDragArea" controls:TitleBarPanel.Role="DragArea" Background="Transparent" ZIndex="-1" />
        <Panel x:Name="CaptionButtonsSpace" controls:TitleBarPanel.Role="Caption" Width="0" />
      </controls:TitleBarPanel>
    </Border>
    <views:StandardToolbar DockPanel.Dock="Top" DataContext="{Binding Toolbar}" IsVisible="{Binding IsVisible}" />

    <Border x:Name="StatusBarHost"
            DockPanel.Dock="Bottom"
            Classes.empty="{Binding StatusBar.IsEmptyState}"
            Classes.debugging="{Binding StatusBar.IsDebugging}"
            BorderBrush="{DynamicResource Shell.StatusBar.Border}"
            BorderThickness="0,1,0,0"
            MinHeight="24"
            IsVisible="{Binding StatusBar.IsVisible}"
            AutomationProperties.Name="{l:T main.statusBar}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <StackPanel Orientation="Horizontal">
          <!-- Ember's state dot (M45, Shell.StatusBar.ShowDot): its bar is the window's color, the dot says the state. -->
          <Ellipse Classes="statusDot" Width="8" Height="8" Margin="10,0,2,0" VerticalAlignment="Center" />
          <ItemsControl ItemsSource="{Binding StatusBar.Left}" ItemTemplate="{StaticResource StatusItemTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Classes="statusMessage"
                   Text="{Binding StatusBar.DisplayMessage}"
                   FontSize="12"
                   Margin="12,0"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding StatusBar.ProgressTooltip}"
                   AutomationProperties.LiveSetting="Polite" />
        <!-- A running task (loading projects, a build, a plugin's): its progress and, when it allows it, cancel. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding StatusBar.HasProgress}">
          <ProgressBar x:Name="StatusProgress" Width="100" Height="10" MinHeight="10" Minimum="0" Maximum="100"
                       Value="{Binding StatusBar.ProgressValue}" IsIndeterminate="{Binding StatusBar.IsProgressIndeterminate}"
                       ToolTip.Tip="{Binding StatusBar.ProgressTooltip}" AutomationProperties.Name="{l:T main.taskProgress}" />
          <Button Classes="statusCancel" Content="✕" Padding="4,0" Command="{Binding StatusBar.CancelProgressCommand}" IsVisible="{Binding StatusBar.CanCancelProgress}"
                  ToolTip.Tip="{l:T main.cancelTask}" AutomationProperties.Name="{l:T main.cancelTask}" />
          <Button Classes="statusCancel" Content="…" Padding="4,0" Command="{Binding StatusBar.ShowTasksCommand}"
                  ToolTip.Tip="{l:T main.showRunningTasks}" AutomationProperties.Name="{l:T main.showRunningTasks}" />
        </StackPanel>
        <ItemsControl Grid.Column="3" ItemsSource="{Binding StatusBar.Right}" ItemTemplate="{StaticResource StatusItemTemplate}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </Grid>
    </Border>

    <Grid>
      <!-- InitializeFactory gives the factory this control's host window locators: without them a floated tool
           window or document gets a window with no host, never shown. Classic keeps 6 px of window around the dock
           area (Shell.Dock.Margin, D46); floating windows fill their frame. -->
      <DockControl x:Name="Dock" Layout="{Binding Layout.Root}" Factory="{Binding Layout.Factory}" InitializeFactory="True"
                   Margin="{DynamicResource Shell.Dock.Margin}" />

      <ItemsControl x:Name="Toasts"
                    ItemsSource="{Binding Notifications.Toasts}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Width="440"
                    Margin="0,0,14,14"
                    AutomationProperties.Name="{l:T main.notificationToasts}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NotificationViewModel">
            <views:NotificationCard Margin="0,8,0,0" Floating="True" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Find and Replace (Ctrl+Shift+F): floats over the documents' top right and isn't modal, so the layer has no
           background and lets clicks through. -->
      <Panel x:Name="FindLayer" IsVisible="{Binding FindReplace.IsOpen}" ZIndex="1">
        <views:FindReplaceView x:Name="FindReplace" DataContext="{Binding FindReplace}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,36,28,0" />
      </Panel>

      <!-- Connect to <agent> (D43): the in-window dialog frame at its widest, under the dialog layer (its confirmations go over it). -->
      <Panel x:Name="ConnectAgentLayer" Background="{DynamicResource Shell.Dialog.Scrim}" IsVisible="{Binding ConnectAgent.IsOpen}" ZIndex="2">
        <views:ConnectAgentView x:Name="ConnectAgentView" DataContext="{Binding ConnectAgent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>

      <!-- The window behind an in-window dialog is dimmed by Shell.Dialog.Scrim (M34h). -->
      <Panel x:Name="DialogLayer" Background="{DynamicResource Shell.Dialog.Scrim}" IsVisible="{Binding Dialogs.IsOpen}" ZIndex="2">
        <views:DialogView DataContext="{Binding Dialogs}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>

      <Panel x:Name="SwitcherLayer" Background="Transparent" IsVisible="{Binding Switcher.IsOpen}" ZIndex="1">
        <views:DocumentSwitcherView DataContext="{Binding Switcher}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Panel>

      <!-- Code Search and Feature Search (M47): floats over the editor, centered under the title row. A click outside
           closes it unless it is pinned (then clicks go through). -->
      <Panel x:Name="CodeSearchLayer" Background="Transparent" IsVisible="{Binding CodeSearch.IsFloatingOpen}" ZIndex="1">
        <views:CodeSearchView x:Name="CodeSearch"
                              DataContext="{Binding CodeSearch}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Margin="0,6,0,0" />
      </Panel>

      <Panel x:Name="PaletteLayer" Background="Transparent" IsVisible="{Binding Palette.IsOpen}">
        <views:QuickPickView x:Name="Palette"
                             DataContext="{Binding Palette}"
                             Width="640"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Margin="0,6,0,0" />
      </Panel>
    </Grid>
  </DockPanel>
</Window>
