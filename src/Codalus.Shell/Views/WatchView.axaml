<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.WatchView"
             x:DataType="vm:WatchViewModel">
  <DockPanel>
    <TextBox x:Name="Input" DockPanel.Dock="Top" Margin="6,4" Text="{Binding NewExpression}" PlaceholderText="{l:T watch.addAWatchExpressionEnter}" AutomationProperties.Name="{l:T watch.addWatchExpression}" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" Background="Transparent" AutomationProperties.Name="{l:T watch.watch}">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:VariableNode">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="vm:VariableNode" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Value}" Classes.error="{Binding IsError}" TextTrimming="CharacterEllipsis" MaxWidth="600" ToolTip.Tip="{Binding Value}" />
            <TextBlock Text="{Binding Type}" Classes="muted" IsVisible="{Binding HasType}" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
