<local:LoadingView xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codalus.Shell.Controls"
                   xmlns:vm="using:Codalus.Shell.ViewModels"
                   xmlns:local="using:Codalus.Shell.Views"
                   x:Class="Codalus.Shell.Views.TemplateManagerView"
                   x:DataType="vm:TemplateManagerViewModel">
  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
      <TextBlock Classes="heading" Text="{l:T templateManager.templates}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T templateManager.theDotnetNewTemplatePackagesInstalled}" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBox x:Name="PackageBox" Text="{Binding Package}" PlaceholderText="{l:T templateManager.aPackageIdIdOrId}" AutomationProperties.Name="{l:T templateManager.templatePackageToInstall}" />
        <Button Classes="iconText" controls:ButtonIcon.Kind="download" Grid.Column="1" Margin="6,0,0,0" Content="{l:T templateManager.install}" Command="{Binding InstallCommand}" AutomationProperties.Name="{l:T templateManager.installTemplatePackage}" />
      </Grid>
      <!-- A dock, not a horizontal stack: the status gets the width that's left and trims at the document's minimum size. -->
      <DockPanel>
        <Button DockPanel.Dock="Left" Margin="0,0,6,0" Classes="icon" controls:ButtonIcon.Kind="trash" Command="{Binding UninstallCommand}" ToolTip.Tip="{l:T templateManager.uninstall}" AutomationProperties.Name="{l:T templateManager.uninstall}" />
        <Button DockPanel.Dock="Left" Margin="0,0,6,0" Classes="icon" controls:ButtonIcon.Kind="update" Command="{Binding CheckUpdatesCommand}" ToolTip.Tip="{l:T templateManager.checkForUpdates}" AutomationProperties.Name="{l:T templateManager.checkForUpdates}" />
        <Button DockPanel.Dock="Left" Margin="0,0,6,0" Classes="iconText" controls:ButtonIcon.Kind="upload" Content="{l:T templateManager.updateAll}" Command="{Binding UpdateAllCommand}" />
        <Button DockPanel.Dock="Left" Margin="0,0,6,0" Classes="icon" controls:ButtonIcon.Kind="refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:T templateManager.refresh}" AutomationProperties.Name="{l:T templateManager.refresh}" />
        <ProgressBar DockPanel.Dock="Left" Margin="0,0,6,0" IsIndeterminate="True" Width="80" Height="2" MinHeight="2" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
      </DockPanel>
    </StackPanel>
    <TextBox DockPanel.Dock="Bottom" Height="110" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Output}"
             FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" AutomationProperties.Name="{l:T templateManager.dotnetNewOutput}" />
    <Grid ColumnDefinitions="*,*">
      <ListBox ItemsSource="{Binding Packages}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:T templateManager.installedTemplatePackages}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TemplatePackageRowViewModel">
            <StackPanel Margin="0,2" AutomationProperties.Name="{Binding AccessibleName}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{Binding Id}" />
                <TextBlock Classes="muted" Text="{Binding Version}" />
                <TextBlock Foreground="{DynamicResource Shell.Link}" Text="{Binding Latest, StringFormat='update: {0}'}" IsVisible="{Binding HasUpdate}" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Detail}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="1" Margin="8,0,0,0" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}">
        <StackPanel Spacing="4">
          <TextBlock FontWeight="SemiBold" Text="{Binding Selected.Id}" />
          <TextBlock Classes="muted" Text="{l:T templateManager.templates2}" />
          <TextBlock TextWrapping="Wrap" Text="{Binding Selected.TemplatesText}" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</local:LoadingView>
