<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.AndroidSdkManagerView"
             x:DataType="vm:AndroidSdkManagerViewModel">
  <!-- The Android SDK Manager (ADR 0104): check to install, uncheck to uninstall, then Apply Changes. -->
  <DockPanel Grid.IsSharedSizeScope="True">
    <controls:ToolbarPanel DockPanel.Dock="Top">
      <ComboBox x:Name="CategoryBox" Classes="toolbar" ItemsSource="{Binding Categories}" SelectedIndex="{Binding Category}" MinWidth="130"
                ToolTip.Tip="{l:T androidSdkManager.kindOfPackage}" AutomationProperties.Name="{l:T androidSdkManager.kindOfPackage}" />
      <TextBox x:Name="SearchBox" Text="{Binding Search}" Width="200" MinHeight="{DynamicResource Shell.Size.Input}" Padding="6,3" VerticalContentAlignment="Center"
               PlaceholderText="{l:T androidSdkManager.searchPackages}" AutomationProperties.Name="{l:T androidSdkManager.searchPackages}" />
      <ToggleButton Classes="toolbar iconText" controls:ButtonIcon.Kind="filter" IsChecked="{Binding InstalledOnly}" Content="{l:T androidSdkManager.installed}" ToolTip.Tip="{l:T androidSdkManager.onlyInstalledPackages}" AutomationProperties.Name="{l:T androidSdkManager.onlyInstalledPackages}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:T androidSdkManager.refresh}" AutomationProperties.Name="{l:T androidSdkManager.readThePackagesAgain}" />
      <Border Classes="toolbarSeparator" />
      <Button Classes="toolbar iconText" controls:ButtonIcon.Kind="check" Content="{l:T androidSdkManager.applyChanges}" Command="{Binding ApplyCommand}"
              ToolTip.Tip="{l:T androidSdkManager.installTheCheckedPackagesAndUninstall}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="undo" Command="{Binding RevertCommand}" IsEnabled="{Binding HasPending}"
              ToolTip.Tip="{l:T androidSdkManager.undoTheChanges}" AutomationProperties.Name="{l:T androidSdkManager.undoTheChanges}" />
      <Button Classes="toolbar iconText" controls:ButtonIcon.Kind="download" Content="{l:T androidSdkManager.updateAll}" Command="{Binding UpdateAllCommand}"
              ToolTip.Tip="{l:T androidSdkManager.updateEveryInstalledPackageThatHas}" />
      <Button Classes="toolbar iconText" controls:ButtonIcon.Kind="download" Content="{l:T androidSdkManager.install}" Command="{Binding InstallToolsCommand}" IsVisible="{Binding CanInstallTools}"
              ToolTip.Tip="{l:T androidSdkManager.installTheAndroidSdkAndIts}" />
    </controls:ToolbarPanel>
    <StackPanel DockPanel.Dock="Top" Margin="8,2,8,6" Spacing="2">
      <TextBlock Classes="muted small" Text="{Binding Location}" TextWrapping="Wrap" IsVisible="{Binding Location, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="small" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <Border DockPanel.Dock="Top" Classes="gridHeader">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="3*" />
          <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="sdkVersion" />
          <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="sdkStatus" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Text="{l:T androidSdkManager.name}" />
        <TextBlock Grid.Column="2" Text="{l:T androidSdkManager.package}" />
        <TextBlock Grid.Column="3" Text="{l:T androidSdkManager.version}" />
        <TextBlock Grid.Column="4" Text="{l:T androidSdkManager.status}" Margin="6,0,0,0" />
      </Grid>
    </Border>
    <ListBox x:Name="PackageList" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T androidSdkManager.androidSdkPackages}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:SdkPackageRow">
          <Setter Property="Padding" Value="4,1" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SdkPackageRow">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="28" />
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="Auto" MinWidth="80" SharedSizeGroup="sdkVersion" />
              <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="sdkStatus" />
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsChecked}" MinWidth="0" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding AccessibleName}" />
            <TextBlock Grid.Column="1" Text="{Binding Description}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Description}" />
            <TextBlock Grid.Column="2" Text="{Binding Path}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding Path}" />
            <TextBlock Grid.Column="3" Text="{Binding Version}" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock Grid.Column="4" Text="{Binding Status}" Classes="muted" Classes.accent="{Binding HasUpdate}" VerticalAlignment="Center" Margin="6,0,0,0" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
