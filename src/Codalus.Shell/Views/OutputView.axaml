<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:output="using:Codalus.Workbench.Output"
             xmlns:controls="using:Codalus.Shell.Controls"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="Codalus.Shell.Views.OutputView"
             x:DataType="vm:OutputViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="6,4">
      <ComboBox x:Name="Channels"
                MinWidth="220"
                ItemsSource="{Binding Channels}"
                SelectedItem="{Binding Selected}"
                AutomationProperties.Name="{l:T output.outputChannel}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="output:OutputChannel">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Classes="toolbar" Command="{Binding ClearCommand}" ToolTip.Tip="{l:T output.clearOutput}" AutomationProperties.Name="{l:T output.clearOutput2}">
        <controls:Icon Kind="clear-all" />
      </Button>
      <ToggleButton Classes="toolbar" IsChecked="{Binding ScrollLock}" ToolTip.Tip="{l:T output.scrollLock}" AutomationProperties.Name="{l:T output.scrollLock2}">
        <controls:Icon Kind="lock" />
      </ToggleButton>
    </StackPanel>
    <ae:TextEditor x:Name="Editor"
                   IsReadOnly="True"
                   ShowLineNumbers="False"
                   WordWrap="{Binding WordWrap}"
                   FontFamily="{Binding Font.Family}"
                   FontSize="{Binding Font.Size}"
                   Background="{DynamicResource Shell.Editor.Background}"
                   Foreground="{DynamicResource Shell.Editor.Foreground}"
                   Padding="6,2"
                   AutomationProperties.Name="{l:T output.outputText}" />
  </DockPanel>
</UserControl>
