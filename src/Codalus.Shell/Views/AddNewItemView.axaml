<local:LoadingView xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:Codalus.Shell.ViewModels"
                   xmlns:local="using:Codalus.Shell.Views"
                   xmlns:controls="using:Codalus.Shell.Controls"
                   x:Class="Codalus.Shell.Views.AddNewItemView"
                   x:DataType="vm:AddNewItemViewModel">
  <DockPanel Margin="16,12">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
      <StackPanel Spacing="2">
        <TextBlock Classes="heading" Text="{Binding Title}" />
        <TextBlock Classes="muted" Text="{Binding Location, StringFormat='Adds to {0}'}" />
      </StackPanel>
      <TextBox Grid.Column="1" x:Name="SearchBox" Width="280" VerticalAlignment="Center" Text="{Binding Search}" PlaceholderText="{l:T addNewItem.searchItemTemplates}" AutomationProperties.Name="{l:T addNewItem.searchItemTemplates}" />
    </Grid>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,10,0,0">
      <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:T addNewItem.name}" />
      <TextBox Grid.Column="1" x:Name="NameBox" Text="{Binding Name}" AutomationProperties.Name="{l:T addNewItem.name2}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
        <Button Classes="accent" Content="{l:T addNewItem.add}" Command="{Binding AddCommand}" IsDefault="True" AutomationProperties.Name="{l:T addNewItem.addItem}" />
        <Button Content="{l:T addNewItem.cancel}" Command="{Binding CancelCommand}" />
      </StackPanel>
      <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
        <CheckBox Content="{l:T addNewItem.showTemplatesForEveryKindOf}" IsChecked="{Binding ShowAll}" />
        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Shell.Error.Foreground}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      </StackPanel>
    </Grid>

    <!-- M34h: the lists' rows are the shared row height (Shell.Size.Row, Shell.Padding.Row): one line each, the template's
         detail on its right, as Solution Explorer's rows (they were two lines with Fluent's 9 px above and below). -->
    <Grid ColumnDefinitions="150,2*,1.5*">
      <Grid.Styles>
        <Style Selector="ListBox.rows ListBoxItem">
          <Setter Property="Padding" Value="{DynamicResource Shell.Padding.Row}" />
          <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Row}" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
      </Grid.Styles>
      <ListBox Classes="rows" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Background="Transparent" AutomationProperties.Name="{l:T addNewItem.templateCategories}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="x:String">
            <TextBlock Margin="8,0" Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <DockPanel Grid.Column="1" Margin="8,0">
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding IsLoading}" />
        <ListBox x:Name="TemplateList" Classes="rows" ItemsSource="{Binding Templates}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:T addNewItem.itemTemplates}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="vm:ItemTemplateRowViewModel">
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ItemTemplateRowViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,0" AutomationProperties.Name="{Binding AccessibleName}">
                <controls:Icon Kind="{Binding Icon}" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                <TextBlock Grid.Column="2" Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource Shell.FontSize.Small}"
                           MaxWidth="{Binding $parent[ListBoxItem].Bounds.Width, Converter={x:Static vm:QuickPickRow.HalfWidth}}"
                           Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
      <Border Grid.Column="2" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="{Binding PreviewTitle}" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PreviewTitle}" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Text="{Binding Selected.Description}" Margin="0,0,0,8" />
          <!-- The new file in the editor's colors in the current theme (M34h: it was plain text in a text box). -->
          <Border x:Name="PreviewHost" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</local:LoadingView>
