<local:LoadingView xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:Codalus.Shell.ViewModels"
                   xmlns:local="using:Codalus.Shell.Views"
                   xmlns:controls="using:Codalus.Shell.Controls"
                   x:Class="Codalus.Shell.Views.ProfilingReportView"
                   x:DataType="vm:ProfilingReportViewModel">
  <local:LoadingView.Styles>
    <Style Selector="TreeView.cpu TreeViewItem" x:DataType="vm:CpuTreeNodeViewModel">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
      <Setter Property="MinHeight" Value="20" />
    </Style>
    <Style Selector="TreeView.heap TreeViewItem" x:DataType="vm:HeapReferrerNodeViewModel">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
      <Setter Property="MinHeight" Value="20" />
    </Style>
  </local:LoadingView.Styles>
  <DockPanel Margin="12,10">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Classes="heading" Text="{Binding Title}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Summary}" />
      <TextBlock Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
      <StackPanel IsVisible="{Binding HasCpu}" Spacing="4">
        <controls:SampleTimeline x:Name="Timeline" Samples="{Binding Timeline}" Height="56"
                                 SelectionStart="{Binding SelectionStart, Mode=TwoWay}" SelectionEnd="{Binding SelectionEnd, Mode=TwoWay}"
                                 BarBrush="{DynamicResource Shell.Accent}" SelectionBrush="{DynamicResource Shell.Focus}"
                                 AutomationProperties.Name="{l:T profilingReport.cpuSamplesOverTimeDragTo}" />
        <WrapPanel Orientation="Horizontal">
          <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{Binding RangeText}" />
          <Button Content="{l:T profilingReport.clearRange}" Command="{Binding ClearRangeCommand}" IsVisible="{Binding HasRange}" Margin="0,0,12,0" />
          <ComboBox ItemsSource="{Binding Threads}" SelectedItem="{Binding SelectedThread}" MinWidth="220" Margin="0,0,12,0" AutomationProperties.Name="{l:T profilingReport.thread}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ThreadChoice">
                <TextBlock Text="{Binding Text}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinWidth="200" Margin="0,0,12,0" IsVisible="{Binding HasProfiles}" AutomationProperties.Name="{l:T profilingReport.stacksOf}" ToolTip.Tip="{l:T profilingReport.whatTheCallTreeBottomUp}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ProfileChoice">
                <TextBlock Text="{Binding Text}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox Content="{l:T profilingReport.includeNativeCodeAndWaiting}" IsChecked="{Binding IncludeExternal}" Margin="0,0,12,0" ToolTip.Tip="{l:T profilingReport.eventpipeSamplesEveryManagedThreadSamples}" />
          <CheckBox Content="{l:T profilingReport.showHotLinesInTheEditor}" IsChecked="{Binding ShowHotLines}" />
        </WrapPanel>
        <TextBlock Classes="muted" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </StackPanel>
    <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab}" Padding="0,6,0,0">
      <TabItem Header="{l:T profilingReport.callTree}" IsVisible="{Binding HasCpu}">
        <TreeView x:Name="CallTreeView" Classes="cpu" ItemsSource="{Binding CallTree}" AutomationProperties.Name="{l:T profilingReport.callTreeTopDown}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:CpuTreeNodeViewModel" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Inclusive}" Width="56" TextAlignment="Right" ToolTip.Tip="{l:T profilingReport.totalSamplesWithThisCallOn}" />
                <TextBlock Text="{Binding Exclusive}" Width="56" TextAlignment="Right" Classes="muted" ToolTip.Tip="{l:T profilingReport.selfSamplesRunningInIt}" />
                <TextBlock Text="{Binding Name}" MaxWidth="900" TextTrimming="CharacterEllipsis" Classes.muted="{Binding IsPlaceholder}" />
                <TextBlock Text="{Binding Module}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </TabItem>
      <TabItem Header="{l:T profilingReport.bottomUp}" IsVisible="{Binding HasCpu}">
        <TreeView x:Name="BottomUpView" Classes="cpu" ItemsSource="{Binding BottomUp}" AutomationProperties.Name="{l:T profilingReport.hotFunctionsAndTheirCallersBottom}">
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:CpuTreeNodeViewModel" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding Inclusive}" Width="56" TextAlignment="Right" ToolTip.Tip="{l:T profilingReport.samplesRunningInTheHotFunction}" />
                <TextBlock Text="{Binding Name}" MaxWidth="900" TextTrimming="CharacterEllipsis" Classes.muted="{Binding IsPlaceholder}" />
                <TextBlock Text="{Binding Module}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </TabItem>
      <TabItem Header="{l:T profilingReport.functions}" IsVisible="{Binding HasCpu}">
        <Grid ColumnDefinitions="3*,4,2*">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
              <TextBox Text="{Binding Search}" PlaceholderText="{l:T profilingReport.searchFunctions}" AutomationProperties.Name="{l:T profilingReport.searchFunctions}" />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="{l:T profilingReport.search}" Command="{Binding SearchCommand}" IsDefault="True" />
            </Grid>
            <ListBox x:Name="FunctionList" ItemsSource="{Binding Functions}" SelectedItem="{Binding SelectedFunction}" AutomationProperties.Name="{l:T profilingReport.functionsBySelfTime}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:CpuFunctionRowViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{Binding AccessibleName}">
                    <TextBlock Text="{Binding Exclusive}" Width="56" TextAlignment="Right" ToolTip.Tip="{l:T profilingReport.self}" />
                    <TextBlock Text="{Binding Inclusive}" Width="56" TextAlignment="Right" Classes="muted" ToolTip.Tip="{l:T profilingReport.total}" />
                    <TextBlock Text="{Binding Name}" MaxWidth="700" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Location}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
          <DockPanel Grid.Column="2" Margin="6,0,0,0">
            <StackPanel DockPanel.Dock="Top" Spacing="4" IsVisible="{Binding HasCurrentFunction}">
              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CurrentFunction.Name, FallbackValue=''}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="muted" Text="{Binding CurrentFunction.Inclusive, StringFormat='Total {0}', FallbackValue=''}" />
                <TextBlock Classes="muted" Text="{Binding CurrentFunction.Exclusive, StringFormat='Self {0}', FallbackValue=''}" />
                <Button Content="{l:T profilingReport.goToSource}" Command="{Binding GoToSourceCommand}" Padding="8,2" />
              </StackPanel>
            </StackPanel>
            <Grid RowDefinitions="Auto,*,Auto,*" Margin="0,6,0,0">
              <TextBlock FontWeight="SemiBold" Text="{l:T profilingReport.calledBy}" />
              <ListBox x:Name="CallerList" Grid.Row="1" ItemsSource="{Binding Callers}" AutomationProperties.Name="{l:T profilingReport.callers}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CpuFunctionRowViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{Binding AccessibleName}">
                      <TextBlock Text="{Binding Inclusive}" Width="56" TextAlignment="Right" />
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="{l:T profilingReport.calls}" Margin="0,6,0,0" />
              <ListBox x:Name="CalleeList" Grid.Row="3" ItemsSource="{Binding Callees}" AutomationProperties.Name="{l:T profilingReport.callees}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CpuFunctionRowViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{Binding AccessibleName}">
                      <TextBlock Text="{Binding Inclusive}" Width="56" TextAlignment="Right" />
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </DockPanel>
        </Grid>
      </TabItem>
      <TabItem Header="{l:T profilingReport.flameGraph}" IsVisible="{Binding HasCpu}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="{l:T profilingReport.back}" Command="{Binding ZoomOutCommand}" ToolTip.Tip="{l:T profilingReport.thePreviousZoomBackspace}" />
              <Button Content="{l:T profilingReport.allSamples}" Command="{Binding ResetZoomCommand}" />
              <TextBlock VerticalAlignment="Center" Text="{Binding FlamePath}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SelectedFlameText}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <controls:FlameGraph x:Name="Flame" Frames="{Binding FlameFrames}" Total="{Binding FlameTotal}"
                                 SelectedFrame="{Binding SelectedFlameFrame, Mode=TwoWay}" HighlightBrush="{DynamicResource Shell.Focus}" VerticalAlignment="Top"
                                 AutomationProperties.Name="{l:T profilingReport.flameGraphArrowKeysMoveBetween}" />
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:T profilingReport.hotFiles}" IsVisible="{Binding HasCpu}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6" Text="{l:T profilingReport.sourceFilesWithSamplesFromThe}" />
          <ListBox x:Name="HotFileList" ItemsSource="{Binding HotFiles}" AutomationProperties.Name="{l:T profilingReport.hotFiles2}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:HotFileRow">
                <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{Binding AccessibleName}">
                  <TextBlock Text="{Binding Share}" Width="56" TextAlignment="Right" />
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Path}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:T profilingReport.counters}" IsVisible="{Binding HasCounters}">
        <ListBox ItemsSource="{Binding CounterSummaries}" AutomationProperties.Name="{l:T profilingReport.countersAverageMinimumMaximumAndLast}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CounterSummaryRow">
              <Grid ColumnDefinitions="260,90,90,90,90,*" AutomationProperties.Name="{Binding AccessibleName}">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Provider}" />
                <TextBlock Grid.Column="1" Text="{Binding Average, StringFormat='avg {0}'}" />
                <TextBlock Grid.Column="2" Text="{Binding Minimum, StringFormat='min {0}'}" Classes="muted" />
                <TextBlock Grid.Column="3" Text="{Binding Maximum, StringFormat='max {0}'}" Classes="muted" />
                <TextBlock Grid.Column="4" Text="{Binding Last, StringFormat='last {0}'}" Classes="muted" />
                <TextBlock Grid.Column="5" Text="{Binding Unit}" Classes="muted" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
      <TabItem Header="{l:T profilingReport.allocations}" IsVisible="{Binding HasAllocations}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6" Text="{l:T profilingReport.theTypesAllocatedByTheKb}" />
          <TreeView x:Name="AllocationTree" Classes="cpu" ItemsSource="{Binding AllocationTypes}" AutomationProperties.Name="{l:T profilingReport.allocatedTypesAndTheirAllocatingStacks}">
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:CpuTreeNodeViewModel" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Inclusive}" Width="56" TextAlignment="Right" ToolTip.Tip="{l:T profilingReport.shareOfTheKbAllocated}" />
                  <TextBlock Text="{Binding Samples, StringFormat='{}{0} KB'}" Width="90" TextAlignment="Right" Classes="muted" />
                  <TextBlock Text="{Binding Name}" MaxWidth="900" TextTrimming="CharacterEllipsis" Classes.muted="{Binding IsPlaceholder}" />
                  <TextBlock Text="{Binding Module}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:T profilingReport.memory}" IsVisible="{Binding HasMemory}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,6">
            <WrapPanel Orientation="Horizontal">
              <ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" MinWidth="280" Margin="0,0,8,0" AutomationProperties.Name="{l:T profilingReport.heapSnapshot}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:HeapSnapshotRow">
                    <TextBlock Text="{Binding Text}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox ItemsSource="{Binding Baselines}" SelectedItem="{Binding SelectedBaseline}" MinWidth="260" Margin="0,0,8,0" AutomationProperties.Name="{l:T profilingReport.compareWith}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:HeapBaselineChoice">
                    <TextBlock Text="{Binding Text}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Text="{Binding HeapSearch}" PlaceholderText="{l:T profilingReport.searchTypes}" MinWidth="180" Margin="0,0,6,0" AutomationProperties.Name="{l:T profilingReport.searchTypes}" />
              <Button Content="{l:T profilingReport.search}" Command="{Binding SearchHeapCommand}" Margin="0,0,12,0" />
              <Button Content="{l:T profilingReport.inspectObjectsInTheFullDump}" Command="{Binding InspectDumpCommand}" IsVisible="{Binding HasDump}" />
            </WrapPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding HeapSummary}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <Grid ColumnDefinitions="3*,4,2*">
            <ListBox x:Name="HeapTypeList" ItemsSource="{Binding HeapTypes}" SelectedItem="{Binding SelectedHeapType}" AutomationProperties.Name="{l:T profilingReport.typesInTheSnapshot}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:HeapTypeRow">
                  <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{Binding AccessibleName}">
                    <TextBlock Text="{Binding Size}" Width="80" TextAlignment="Right" />
                    <TextBlock Text="{Binding Count}" Width="80" TextAlignment="Right" Classes="muted" />
                    <TextBlock Text="{Binding SizeDiff}" Width="80" TextAlignment="Right" Foreground="{DynamicResource Shell.Error}" IsVisible="{Binding SizeDiff, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding CountDiff}" Width="70" TextAlignment="Right" Classes="muted" IsVisible="{Binding CountDiff, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding Name}" MaxWidth="700" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
            <DockPanel Grid.Column="2" Margin="6,0,0,0">
              <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="{l:T profilingReport.pathsToRootsWhatKeepsThem}" Margin="0,0,0,4" />
              <TreeView x:Name="RootsTree" Classes="heap" ItemsSource="{Binding Referrers}" AutomationProperties.Name="{l:T profilingReport.pathsToRootsOfTheSelected}">
                <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="vm:HeapReferrerNodeViewModel" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Count}" Width="100" TextAlignment="Right" />
                      <TextBlock Text="{Binding Name}" FontWeight="{Binding IsRoot, Converter={x:Static local:ProfilingReportView.BoldWhen}}" MaxWidth="600" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Size}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" />
                    </StackPanel>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </DockPanel>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:T profilingReport.netAsync}" IsVisible="{Binding HasAsync}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding TaskSearch}" PlaceholderText="{l:T profilingReport.searchTasksAndAsyncMethods}" AutomationProperties.Name="{l:T profilingReport.searchTasks}" />
              <Button Grid.Column="1" Margin="6,0,0,0" Content="{l:T profilingReport.search}" Command="{Binding SearchTasksCommand}" />
            </Grid>
            <TextBlock Classes="muted" Text="{Binding AsyncSummary}" />
          </StackPanel>
          <Grid ColumnDefinitions="3*,4,2*">
            <ListBox x:Name="TaskList" ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask}" AutomationProperties.Name="{l:T profilingReport.tasksAndAsyncMethodsTheLongest}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AsyncTaskRow">
                  <Grid ColumnDefinitions="90,200,*" AutomationProperties.Name="{Binding AccessibleName}">
                    <TextBlock Text="{Binding Duration}" TextAlignment="Right" Margin="0,0,8,0" />
                    <controls:SpanBar Grid.Column="1" Start="{Binding BarStart}" Length="{Binding BarLength}" Fill="{DynamicResource Shell.Accent}" Height="14" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
            <DockPanel Grid.Column="2" Margin="6,0,0,0">
              <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="{l:T profilingReport.startedFrom}" Margin="0,0,0,4" />
              <ListBox ItemsSource="{Binding TaskStack}" AutomationProperties.Name="{l:T profilingReport.theStackThatStartedTheTask}" />
            </DockPanel>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:T profilingReport.threads}" IsVisible="{Binding HasThreads}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,6" Text="{Binding ThreadsSummary}" />
          <Grid RowDefinitions="2*,4,*">
            <ListBox x:Name="ThreadList" ItemsSource="{Binding ThreadRows}" AutomationProperties.Name="{l:T profilingReport.threadsAndTheirStatesOverTime}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThreadTimelineRow">
                  <Grid ColumnDefinitions="220,*,300" AutomationProperties.Name="{Binding AccessibleName}">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <controls:StateStrip Grid.Column="1" States="{Binding States}" Height="16" Margin="8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Summary}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
            <Grid Grid.Row="2" ColumnDefinitions="*,4,*">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="{l:T profilingReport.lockContentionTheWaitingStacks}" Margin="0,4" />
                <TreeView Classes="cpu" ItemsSource="{Binding ContentionTree}" AutomationProperties.Name="{l:T profilingReport.lockContentionAndTheStacksThat}">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:CpuTreeNodeViewModel" ItemsSource="{Binding Children}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Inclusive}" Width="56" TextAlignment="Right" ToolTip.Tip="{l:T profilingReport.shareOfTheTimeWaited}" />
                        <TextBlock Text="{Binding Name}" MaxWidth="700" TextTrimming="CharacterEllipsis" Classes.muted="{Binding IsPlaceholder}" />
                      </StackPanel>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </DockPanel>
              <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
              <DockPanel Grid.Column="2" Margin="6,0,0,0">
                <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="{l:T profilingReport.threadPool}" Margin="0,4" />
                <ListBox ItemsSource="{Binding PoolEvents}" AutomationProperties.Name="{l:T profilingReport.threadPoolInjectionsAndRetirements}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThreadPoolRow">
                      <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{Binding AccessibleName}">
                        <TextBlock Text="{Binding Time}" Width="70" Classes="muted" />
                        <TextBlock Text="{Binding Text}" FontWeight="{Binding IsStarvation, Converter={x:Static local:ProfilingReportView.BoldWhen}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Grid>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:T profilingReport.exceptions}" IsVisible="{Binding HasExceptions}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
            <TextBlock Classes="muted" Text="{Binding ExceptionsSummary}" />
            <controls:SampleTimeline Samples="{Binding ExceptionTimeline}" Height="40" BarBrush="{DynamicResource Shell.Error}" SelectionBrush="{DynamicResource Shell.Focus}"
                                     AutomationProperties.Name="{l:T profilingReport.exceptionsOverTime}" />
          </StackPanel>
          <Grid RowDefinitions="2*,4,*">
            <ListBox x:Name="ExceptionGroupList" ItemsSource="{Binding ExceptionGroups}" AutomationProperties.Name="{l:T profilingReport.exceptionsByTypeAndThrowSite}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ExceptionGroupRow">
                  <StackPanel AutomationProperties.Name="{Binding AccessibleName}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Count}" Width="56" TextAlignment="Right" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Type}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ThrowSite, StringFormat='thrown by {0}'}" TextTrimming="CharacterEllipsis" MaxWidth="700" />
                      <TextBlock Text="{Binding Location}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Margin="64,0,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
            <ListBox Grid.Row="2" ItemsSource="{Binding RecentExceptions}" AutomationProperties.Name="{l:T profilingReport.theLastExceptionsThrown}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ExceptionEventRow">
                  <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{Binding AccessibleName}">
                    <TextBlock Text="{Binding Time}" Width="70" Classes="muted" />
                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:T profilingReport.fileIO}" IsVisible="{Binding HasFileIo}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="{Binding IoSummary}" AutomationProperties.LiveSetting="Polite" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding IoSource}" />
          <controls:TimeSeriesChart Caption="Read" Unit="KB/s" Points="{Binding IoRead}" WindowSeconds="{Binding IoWindow}" Height="90"
                                    Stroke="{DynamicResource Shell.Info}" Foreground="{DynamicResource Shell.MutedForeground}" GridBrush="{DynamicResource Shell.Border}"
                                    AutomationProperties.Name="{l:T profilingReport.bytesReadPerSecondOverThe}" />
          <controls:TimeSeriesChart Caption="Written" Unit="KB/s" Points="{Binding IoWrite}" WindowSeconds="{Binding IoWindow}" Height="90"
                                    Stroke="{DynamicResource Shell.Modified}" Foreground="{DynamicResource Shell.MutedForeground}" GridBrush="{DynamicResource Shell.Border}"
                                    AutomationProperties.Name="{l:T profilingReport.bytesWrittenPerSecondOverThe}" />
        </StackPanel>
      </TabItem>
      <TabItem Header="{l:T profilingReport.activities}" IsVisible="{Binding HasActivities}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ComboBox SelectedIndex="{Binding ActivityKind}" MinWidth="200" AutomationProperties.Name="{l:T profilingReport.activitiesToShow}">
                <ComboBoxItem Content="{l:T profilingReport.httpRequests}" />
                <ComboBoxItem Content="{l:T profilingReport.databaseCommands}" />
                <ComboBoxItem Content="{l:T profilingReport.activitySpans}" />
              </ComboBox>
              <CheckBox Content="{l:T profilingReport.inTimeOrder}" IsChecked="{Binding ActivitiesByTime}" />
            </StackPanel>
            <TextBlock Classes="muted" Text="{Binding ActivitiesSummary}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <ListBox x:Name="ActivityList" ItemsSource="{Binding Activities}" AutomationProperties.Name="{l:T profilingReport.requestsCommandsOrSpans}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ActivityRow">
                <Grid ColumnDefinitions="90,240,*" AutomationProperties.Name="{Binding AccessibleName}">
                  <TextBlock Text="{Binding Duration}" TextAlignment="Right" Margin="0,0,8,0" Foreground="{DynamicResource Shell.Error}" IsVisible="{Binding Failed}" />
                  <TextBlock Text="{Binding Duration}" TextAlignment="Right" Margin="0,0,8,0" IsVisible="{Binding !Failed}" />
                  <controls:SpanBar Grid.Column="1" Start="{Binding BarStart}" Length="{Binding BarLength}" Fill="{DynamicResource Shell.Info}" Height="14" Margin="0,0,8,0" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="{Binding Indent}">
                    <TextBlock Text="{Binding Name}" MaxWidth="700" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" MaxWidth="500" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:T profilingReport.events}" IsVisible="{Binding HasEvents}">
        <Grid ColumnDefinitions="2*,4,5*">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="{l:T profilingReport.eventsByProviderDoubleClickTo}" Margin="0,0,0,4" />
            <ListBox x:Name="EventCountList" ItemsSource="{Binding EventCounts}" AutomationProperties.Name="{l:T profilingReport.eventCountsByProviderAndName}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EventCountRow">
                  <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{Binding AccessibleName}">
                    <TextBlock Text="{Binding Text}" Width="70" TextAlignment="Right" />
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
          <DockPanel Grid.Column="2" Margin="6,0,0,0">
            <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
              <WrapPanel Orientation="Horizontal">
                <TextBox Text="{Binding EventProvider}" PlaceholderText="{l:T profilingReport.providers}" MinWidth="180" Margin="0,0,6,0" AutomationProperties.Name="{l:T profilingReport.providersCommaSeparated}" />
                <TextBox Text="{Binding EventName}" PlaceholderText="{l:T profilingReport.eventNames}" MinWidth="160" Margin="0,0,6,0" AutomationProperties.Name="{l:T profilingReport.eventNamesCommaSeparated}" />
                <TextBox Text="{Binding EventText}" PlaceholderText="{l:T profilingReport.textInThePayload}" MinWidth="160" Margin="0,0,6,0" AutomationProperties.Name="{l:T profilingReport.textInThePayload}" />
                <Button Content="{l:T profilingReport.filter}" Command="{Binding FilterEventsCommand}" Margin="0,0,12,0" />
                <Button Content="{l:T profilingReport.exportForSpeedscope}" Command="{Binding ExportSpeedscopeCommand}" Margin="0,0,6,0" ToolTip.Tip="{l:T profilingReport.theCurrentStackProfileAndFilter}" />
                <Button Content="{l:T profilingReport.exportChromiumTrace}" Command="{Binding ExportChromiumCommand}" Margin="0,0,6,0" ToolTip.Tip="{l:T profilingReport.theCurrentStackProfileAndThe}" />
                <Button Content="{l:T profilingReport.saveTraceAs}" Command="{Binding SaveTraceCommand}" />
              </WrapPanel>
              <TextBlock Classes="muted" Text="{Binding EventsSummary}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Content="{l:T profilingReport.showMore}" Command="{Binding MoreEventsCommand}" IsVisible="{Binding HasMoreEvents}" HorizontalAlignment="Left" Margin="0,4,0,0" />
            <ListBox ItemsSource="{Binding Events}" AutomationProperties.Name="{l:T profilingReport.events}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:TraceEventRowViewModel">
                  <StackPanel AutomationProperties.Name="{Binding AccessibleName}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Time}" Width="100" Classes="muted" />
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Thread, StringFormat='thread {0}'}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Payload}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Margin="108,0,0,0" TextWrapping="Wrap" MaxHeight="48" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</local:LoadingView>
