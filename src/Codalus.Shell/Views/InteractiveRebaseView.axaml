<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codalus.Shell.Controls"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.InteractiveRebaseView"
             x:DataType="vm:InteractiveRebaseViewModel">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="{l:T interactiveRebase.pickKeepsACommitRewordKeeps}" />
      <TextBlock Foreground="{DynamicResource Shell.Error.Foreground}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
      <Button Classes="accent" Content="{l:T interactiveRebase.startRebase}" Command="{Binding StartCommand}" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Spacing="4" Margin="8,0,0,0">
      <Button Classes="icon" controls:ButtonIcon.Kind="arrow-up" Command="{Binding MoveUpCommand}" AutomationProperties.Name="{l:T interactiveRebase.moveUp}" ToolTip.Tip="{l:T interactiveRebase.up}" />
      <Button Classes="icon" controls:ButtonIcon.Kind="arrow-down" Command="{Binding MoveDownCommand}" AutomationProperties.Name="{l:T interactiveRebase.moveDown}" ToolTip.Tip="{l:T interactiveRebase.down}" />
    </StackPanel>
    <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:T interactiveRebase.commitsToRebase}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:RebaseStepRow">
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:RebaseStepRow">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ComboBox ItemsSource="{x:Static vm:RebaseStepRow.Actions}" SelectedItem="{Binding Action}" MinWidth="100" AutomationProperties.Name="{l:T interactiveRebase.action}" />
              <TextBlock Text="{Binding ShortHash}" Classes="muted" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
              <TextBlock Text="{Binding Subject}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBox Text="{Binding Message}" IsVisible="{Binding IsReword}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" Margin="108,0,0,0"
                     PlaceholderText="{l:T interactiveRebase.theNewCommitMessage}" AutomationProperties.Name="{l:T interactiveRebase.newMessage}" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
