<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.EnvironmentView"
             x:DataType="vm:EnvironmentViewModel">
  <DockPanel Margin="12,8">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock Classes="heading" Text="{l:T environment.checkEnvironment}" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="{l:T environment.theToolsCodalusUsesAs}" />
      <controls:ToolbarPanel>
        <Button x:Name="CheckButton" Content="{l:T environment.checkAgain}" Command="{Binding CheckCommand}" />
        <TextBlock Classes="muted" Text="{l:T environment.checking}" IsVisible="{Binding IsChecking}" VerticalAlignment="Center" />
      </controls:ToolbarPanel>
    </StackPanel>
    <ListBox ItemsSource="{Binding Rows}" Background="Transparent" Margin="0,6,0,0" AutomationProperties.Name="{l:T environment.tools}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ToolRowViewModel">
          <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ToolRowViewModel">
          <Grid ColumnDefinitions="Auto,180,*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
            <controls:Icon Kind="{Binding Icon}" VerticalAlignment="Top" Margin="0,2,8,0" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="{Binding State}" />
            <Button Grid.Column="3" Grid.RowSpan="2" Content="{Binding FixTitle}" Command="{Binding FixCommand}" IsVisible="{Binding CanFix}"
                    ToolTip.Tip="{Binding Command}" VerticalAlignment="Top" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="muted" Text="{Binding NeededFor}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Classes="muted" Text="{Binding Details}" IsVisible="{Binding HasDetails}"
                       FontSize="{DynamicResource Shell.FontSize.Small}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
