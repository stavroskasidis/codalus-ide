<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.PluginsView"
             x:DataType="vm:PluginsViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState"
               Text="{l:T plugins.noPluginsAreInstalledPutPlugins}"
               IsVisible="{Binding IsEmpty}" />
    <ListBox x:Name="List" ItemsSource="{Binding Plugins}" Background="Transparent" AutomationProperties.Name="{l:T plugins.installedPlugins}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:PluginRowViewModel">
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:PluginRowViewModel">
          <StackPanel Spacing="2" Margin="2,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:Icon Kind="extensions" VerticalAlignment="Center" />
              <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
              <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding State}" VerticalAlignment="Center" />
              <Button Classes="link" Content="{Binding ToggleTitle}" Command="{Binding ToggleCommand}" IsVisible="{Binding CanToggle}"
                      AutomationProperties.Name="{Binding ToggleTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Details}" TextWrapping="Wrap" />
            <TextBlock Foreground="{DynamicResource Shell.Error.Foreground}" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
