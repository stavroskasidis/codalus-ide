<Window xmlns:l="using:Codalus.Shell.Infrastructure"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Codalus.Shell.ViewModels"
        xmlns:views="using:Codalus.Shell.Views"
        xmlns:controls="using:Codalus.Shell.Controls"
        x:Class="Codalus.Shell.Views.SetupWindow"
        x:DataType="vm:SetupViewModel"
        Title="{l:T setupWindow.title}"
        Width="1120" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Shell.Panel}">
  <!--
    The first-run setup (M46, design/shell-themes/Setup.dc.html): the steps on the left, the current page on the right
    (the welcome page at a first start, a step, or the summary), Skip setup, Back and Next below. Every color is a token,
    so the window repaints in the theme being chosen.
  -->
  <Window.Styles>
    <Style Selector="Border.step">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.step.current">
      <Setter Property="Background" Value="{DynamicResource Shell.Selection}" />
    </Style>
    <Style Selector="Border.step.current TextBlock.stepTitle">
      <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Foreground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.stepDot">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
    </Style>
    <Style Selector="Border.stepDot TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
    </Style>
    <Style Selector="Border.step.current Border.stepDot">
      <Setter Property="Background" Value="{DynamicResource Shell.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
    </Style>
    <Style Selector="Border.step.current Border.stepDot TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Shell.AccentForeground}" />
    </Style>
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.lead">
      <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxWidth" Value="640" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,0,22" />
    </Style>
    <!-- The mode picker: a segmented row, the chosen mode filled with the accent. -->
    <Style Selector="ToggleButton.segment">
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Shell.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.AccentForeground}" />
      <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>
    <!-- Cards: a family, a keyboard scheme; the chosen one outlined in the accent. -->
    <Style Selector="ToggleButton.setupCard">
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,12,12" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Shell.Editor.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.setupCard:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Shell.Editor.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    </Style>
    <Style Selector="ToggleButton.setupCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Shell.Editor.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    </Style>
    <Style Selector="Border.section">
      <Setter Property="Padding" Value="14,12" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Shell.Editor.Background}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
    </Style>
    <!-- The importer the welcome page's "coming from" points at. -->
    <Style Selector="Border.section.suggested">
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.subheading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,8" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="240,*">
    <!-- The steps. -->
    <Border Background="{DynamicResource Shell.Background}" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="0,0,1,0" Padding="20,28">
      <StackPanel Spacing="24">
        <ItemsControl ItemsSource="{Binding Steps}" AutomationProperties.Name="{l:T setupWindow.setupSteps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SetupStepViewModel">
              <Border Classes="step" Classes.current="{Binding IsCurrent}" AutomationProperties.Name="{Binding AccessibleName}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                  <Border Classes="stepDot">
                    <TextBlock Text="{Binding Number}" FontSize="{DynamicResource Shell.FontSize.Body}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Classes="stepTitle" Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="muted small" TextWrapping="Wrap" Margin="4,0" Text="{l:T setupWindow.runsOnceTheFirstTime}" />
      </StackPanel>
    </Border>

    <!-- The current step, with Skip setup, Back and Next. -->
    <DockPanel Grid.Column="1" Margin="36,28,36,20">
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button x:Name="BackButton" Content="{l:T setupWindow.back}" Command="{Binding BackCommand}" ToolTip.Tip="{l:T setupWindow.backAltLeft}" MinWidth="72" />
            <Button x:Name="NextButton" Classes="accent" Content="{Binding NextTitle}" Command="{Binding NextCommand}"
                    ToolTip.Tip="{l:T setupWindow.nextAltRight}" AutomationProperties.Name="{Binding NextTitle}" FontWeight="SemiBold" MinWidth="96" />
          </StackPanel>
          <Button x:Name="SkipButton" Classes="link" Content="{Binding SkipTitle}" Command="{Binding SkipCommand}" IsVisible="{Binding CanSkip}"
                  ToolTip.Tip="{l:T setupWindow.skipSetupTip}" AutomationProperties.Name="{Binding SkipTitle}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0" />
        </DockPanel>
      </Border>

      <Panel>
        <!-- Welcome, at a first start: what the setup covers, and where the user comes from (it preselects, nothing more). -->
        <ScrollViewer IsVisible="{Binding IsWelcome}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
              <Image Width="56" Height="56" Source="avares://codalus/Assets/codalus-128.png" AutomationProperties.Name="{l:T setupWindow.logo}" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Classes="pageTitle" Margin="0,0,0,2" Text="{l:T setupWindow.welcomeToCodalusIde}" />
                <TextBlock Classes="muted" Text="{l:T setupWindow.welcomeTagline}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
            <TextBlock Classes="lead" Text="{l:T setupWindow.welcomeLead}" />
            <TextBlock Text="{l:T setupWindow.imComingFrom}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Classes="muted small" Text="{l:T setupWindow.comingFromLead}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <ItemsControl x:Name="OriginList" ItemsSource="{Binding Origins}" AutomationProperties.Name="{l:T setupWindow.imComingFrom}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SetupChoice">
                  <ToggleButton Classes="setupCard" HorizontalAlignment="Stretch" Margin="0,0,0,10" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}"
                                AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource Shell.FontSize.Heading}" />
                      <controls:Icon Grid.Column="1" Grid.RowSpan="2" Kind="check-circle" IsVisible="{Binding IsSelected}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </Grid>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- 1. Appearance. -->
        <ScrollViewer IsVisible="{Binding IsAppearance}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Classes="pageTitle" Text="{l:T setupWindow.chooseHowCodalusIdeLooks}" />
            <TextBlock Classes="lead" Text="{l:T setupWindow.pickAThemeAndAMode}" />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
              <TextBlock Text="{l:T setupWindow.mode}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Border Background="{DynamicResource Shell.Background}" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" CornerRadius="8" Padding="3">
                <ItemsControl x:Name="ModeList" ItemsSource="{Binding Modes}" AutomationProperties.Name="{l:T setupWindow.mode}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SetupChoice">
                      <ToggleButton Classes="segment" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}"
                                    Content="{Binding Title}" AutomationProperties.Name="{Binding Title}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
            <TextBlock Classes="muted small" MinHeight="18" Margin="0,0,0,18" TextWrapping="Wrap"
                       Text="{l:T setupWindow.followsYourSystem}" IsVisible="{Binding IsMatchSystem}" />
            <TextBlock Classes="muted small" MinHeight="18" Margin="0,0,0,18" TextWrapping="Wrap"
                       Text="{l:T setupWindow.classicBlueIsInOptions}" IsVisible="{Binding IsClassicBlue}" />
            <ItemsControl x:Name="FamilyList" ItemsSource="{Binding Families}" AutomationProperties.Name="{l:T setupWindow.theme}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <!-- 148 px: the five cards (Classic first, D36) fit one row at the window's 1120 px. -->
                <DataTemplate x:DataType="vm:SetupFamilyOption">
                  <ToggleButton Classes="setupCard" Width="148" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}"
                                AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
                    <StackPanel Spacing="10">
                      <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch">
                        <views:ThemePictureView DataContext="{Binding Picture}" />
                      </Viewbox>
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource Shell.FontSize.Heading}" VerticalAlignment="Center" />
                        <controls:Icon Grid.Column="1" Kind="check-circle" IsVisible="{Binding IsSelected}" />
                      </Grid>
                      <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- The editor's font size, on a sample in the previewed theme's syntax colors; saved with the step. -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,8">
              <TextBlock Text="{l:T setupWindow.editorFontSize}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
              <Button x:Name="FontSmallerButton" Content="−" MinWidth="32" HorizontalContentAlignment="Center" Command="{Binding DecreaseFontSizeCommand}"
                      ToolTip.Tip="{l:T setupWindow.smallerFont}" AutomationProperties.Name="{l:T setupWindow.smallerFont}" />
              <TextBlock x:Name="FontSizeValue" Text="{Binding FontSizeText}" MinWidth="48" TextAlignment="Center" VerticalAlignment="Center"
                         AutomationProperties.Name="{l:T setupWindow.editorFontSize}" AutomationProperties.LiveSetting="Polite" />
              <Button x:Name="FontLargerButton" Content="+" MinWidth="32" HorizontalContentAlignment="Center" Command="{Binding IncreaseFontSizeCommand}"
                      ToolTip.Tip="{l:T setupWindow.largerFont}" AutomationProperties.Name="{l:T setupWindow.largerFont}" />
            </StackPanel>
            <Border Classes="section" HorizontalAlignment="Left" MinWidth="420" Padding="12,10" ClipToBounds="True">
              <ItemsControl x:Name="CodeSample" ItemsSource="{Binding CodeSample}" TextElement.FontFamily="{Binding EditorFontFamily}"
                            TextElement.FontSize="{Binding FontSize}" AutomationProperties.Name="{l:T setupWindow.fontSample}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThemePictureCodeLine">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock MinWidth="24" Margin="0,0,14,0" Text="{Binding Number}" TextAlignment="Right" Foreground="{DynamicResource Shell.Editor.LineNumbers}" />
                      <ItemsControl ItemsSource="{Binding Segments}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ThemePictureSegment">
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- 2. Keyboard. -->
        <ScrollViewer IsVisible="{Binding IsKeyboard}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Classes="pageTitle" Text="{l:T setupWindow.chooseYourKeyboardShortcuts}" />
            <TextBlock Classes="lead" Text="{l:T setupWindow.theSchemeDecidesWhatTheKeysDo}" />
            <ItemsControl x:Name="SchemeList" ItemsSource="{Binding Schemes}" AutomationProperties.Name="{l:T setupWindow.keyboardScheme}" MaxWidth="640" HorizontalAlignment="Left">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SetupChoice">
                  <ToggleButton Classes="setupCard" HorizontalAlignment="Stretch" Margin="0,0,0,10" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}"
                                AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource Shell.FontSize.Heading}" />
                      <controls:Icon Grid.Column="1" Grid.RowSpan="2" Kind="check-circle" IsVisible="{Binding IsSelected}" VerticalAlignment="Center" />
                      <TextBlock Grid.Row="1" Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </Grid>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <!-- 3. Your settings. -->
        <ScrollViewer IsVisible="{Binding IsSettings}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Classes="pageTitle" Text="{l:T setupWindow.bringYourSettings}" />
            <TextBlock Classes="lead" Text="{l:T setupWindow.importFromAnotherEditor}" />
            <!-- The importer the welcome page's "coming from" points at is outlined and says so; nothing imports before its button. -->
            <Border x:Name="VsCodeSection" Classes="section" Classes.suggested="{Binding SuggestsVsCode}">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Text="{l:T setupWindow.fromVsCode}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Classes="muted small" Text="{Binding VsCodeText}" TextWrapping="Wrap" Margin="0,4,12,0" />
                <TextBlock Grid.Row="2" Classes="small" Text="{l:T setupWindow.suggestedForYou}" IsVisible="{Binding SuggestsVsCode}" TextWrapping="Wrap" Margin="0,4,12,0" />
                <Button x:Name="ImportVsCodeButton" Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Center" Content="{l:T setupWindow.importFromVsCode}" Command="{Binding ImportVsCodeCommand}" />
              </Grid>
            </Border>
            <Border x:Name="VsSettingsSection" Classes="section" Classes.suggested="{Binding SuggestsVsSettings}">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                <TextBlock Text="{l:T setupWindow.fromAVssettingsFile}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Classes="muted small" Text="{l:T setupWindow.fontsColorsEditorOptionsAndShortcuts}" TextWrapping="Wrap" Margin="0,4,12,0" />
                <TextBlock Grid.Row="2" Classes="small" Text="{l:T setupWindow.suggestedForYou}" IsVisible="{Binding SuggestsVsSettings}" TextWrapping="Wrap" Margin="0,4,12,0" />
                <Button x:Name="ImportVsSettingsButton" Grid.Column="1" Grid.RowSpan="3" VerticalAlignment="Center" Content="{l:T setupWindow.chooseAVssettingsFile}" Command="{Binding ImportVsSettingsCommand}" />
              </Grid>
            </Border>
            <Border Classes="section">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Text="{l:T setupWindow.fromAnotherCodalusIde}" FontWeight="SemiBold" />
                <TextBlock Grid.Row="1" Classes="muted small" Text="{l:T setupWindow.aFileExportedWithExportSettings}" TextWrapping="Wrap" Margin="0,4,12,0" />
                <Button Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Content="{l:T setupWindow.chooseAFile}" Command="{Binding ImportExportCommand}" />
              </Grid>
            </Border>
            <Border Classes="section">
              <StackPanel Spacing="8">
                <TextBlock Text="{l:T setupWindow.settingsSync}" FontWeight="SemiBold" />
                <TextBlock Classes="muted small" Text="{l:T setupWindow.keepYourSettingsInAFolder}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                  <Button Content="{l:T setupWindow.syncWithAFolder}" Command="{Binding SyncFolderCommand}" />
                  <TextBox Grid.Column="1" Text="{Binding SyncUrl}" PlaceholderText="{l:T setupWindow.aGitRepositorysUrl}" AutomationProperties.Name="{l:T setupWindow.aGitRepositorysUrl}" />
                  <Button Grid.Column="2" Content="{l:T setupWindow.syncWithTheRepository}" Command="{Binding SyncRepositoryCommand}" />
                </Grid>
              </StackPanel>
            </Border>
            <TextBlock Text="{Binding SettingsStatus}" IsVisible="{Binding HasSettingsStatus}" TextWrapping="Wrap" Margin="2,4,0,0" />
          </StackPanel>
        </ScrollViewer>

        <!-- 4. Tools. -->
        <DockPanel IsVisible="{Binding IsTools}">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Classes="pageTitle" Text="{l:T setupWindow.checkYourTools}" />
            <TextBlock Classes="lead" Text="{l:T setupWindow.codalusIdeNeedsTheDotnetSdk}" />
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
              <Button Content="{l:T setupWindow.checkAgain}" Command="{Binding CheckToolsCommand}" />
              <TextBlock Classes="muted" Text="{l:T setupWindow.checking}" IsVisible="{Binding IsChecking}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <Button DockPanel.Dock="Bottom" Classes="link" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{l:T setupWindow.everythingElseCheckEnvironment}" Command="{Binding OpenCheckEnvironmentCommand}" />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Tools}" AutomationProperties.Name="{l:T setupWindow.tools}" MaxWidth="720" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SetupToolRowViewModel">
                    <Border Classes="section" AutomationProperties.Name="{Binding Title}">
                      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                        <controls:Icon Kind="{Binding Icon}" VerticalAlignment="Top" Margin="0,2,10,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding State}" />
                        </StackPanel>
                        <Button Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Top" Content="{Binding InstallTitle}" Command="{Binding InstallCommand}"
                                IsVisible="{Binding CanInstall}" ToolTip.Tip="{Binding Confirmation}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted small" Text="{Binding NeededFor}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted small" Text="{Binding Details}" IsVisible="{Binding HasDetails}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Spacing="8" Margin="0,10,0,0" IsVisible="{Binding IsConfirming}">
                          <TextBlock Text="{Binding Confirmation}" TextWrapping="Wrap" />
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="accent" Content="{Binding ConfirmTitle}" Command="{Binding ConfirmCommand}" />
                            <Button Content="{l:T setupWindow.cancel}" Command="{Binding CancelCommand}" />
                          </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="3" Grid.Column="1" Classes="muted" Text="{l:T setupWindow.installing}" IsVisible="{Binding IsInstalling}" Margin="0,10,0,0" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <!-- System Integration (M51, ADR 0084): off until chosen; leaving the step registers what's checked. -->
              <TextBlock Text="{l:T setupWindow.yourSystem}" FontWeight="SemiBold" Margin="0,18,0,4" />
              <TextBlock Classes="muted" Text="{l:T setupWindow.yourSystemLead}" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding Integrations}" AutomationProperties.Name="{l:T setupWindow.systemIntegration}" MaxWidth="720" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SetupIntegrationChoice">
                    <Border Classes="section">
                      <StackPanel Spacing="4">
                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsAvailable}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" Margin="26,0,0,0" />
                        <TextBlock Classes="muted small" Text="{Binding Note}" IsVisible="{Binding HasNote}" TextWrapping="Wrap" Margin="26,0,0,0" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>

        <!--
          5. AI (ADR 0096): three paths as cards with the same four facts each, so they compare side by side; No AI is
          chosen unless the user chooses another. The chosen path's own choices follow below. Nothing here is applied
          before the summary's button ends the setup.
        -->
        <ScrollViewer IsVisible="{Binding IsAi}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Classes="pageTitle" Text="{l:T setupWindow.chooseYourAiExperience}" />
            <TextBlock Classes="lead" Text="{l:T setupWindow.aiLead}" />
            <ItemsControl x:Name="AiPathList" ItemsSource="{Binding AiPaths}" AutomationProperties.Name="{l:T setupWindow.aiExperience}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <!-- 252 px: the three cards fit one row at the window's 1120 px, and wrap in a narrower one. -->
                <DataTemplate x:DataType="vm:SetupAiPathOption">
                  <ToggleButton Classes="setupCard" Width="252" Padding="14,12" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}"
                                AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding HelpText}">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource Shell.FontSize.Heading}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <controls:Icon Grid.Column="1" Kind="check-circle" IsVisible="{Binding IsSelected}" />
                      </Grid>
                      <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,0,0,4" />
                      <ItemsControl ItemsSource="{Binding Facts}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:SetupSummaryRow">
                            <StackPanel Margin="0,6,0,0">
                              <TextBlock Classes="small" Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Classes="muted small" Text="{Binding Value}" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A coding agent: which one, why run it from the IDE, and its two windows. -->
            <StackPanel x:Name="AiAgentPanel" IsVisible="{Binding IsAiAgent}" MaxWidth="780" HorizontalAlignment="Left">
              <TextBlock Classes="subheading" Text="{l:T setupWindow.whichAgent}" />
              <ItemsControl x:Name="AiAgentList" ItemsSource="{Binding AiAgents}" IsEnabled="{Binding !AreAgentsBlocked}" AutomationProperties.Name="{l:T setupWindow.whichAgent}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SetupChoice">
                    <ToggleButton Classes="setupCard" Width="144" Margin="0,0,10,10" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}"
                                  AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="muted small" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                      </StackPanel>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding AgentsBlockedReason}" IsVisible="{Binding AreAgentsBlocked}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBlock Classes="muted small" Text="{l:T setupWindow.agentConnectsAfter}" TextWrapping="Wrap" />
              <TextBlock Classes="subheading" Text="{l:T setupWindow.whyRunItFromCodalusIde}" Margin="0,16,0,8" />
              <ItemsControl x:Name="AgentBenefitList" ItemsSource="{Binding AgentBenefits}" AutomationProperties.Name="{l:T setupWindow.whyRunItFromCodalusIde}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,6">
                      <controls:Icon Kind="check" VerticalAlignment="Top" Margin="0,2,8,0" />
                      <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="subheading" Text="{l:T setupWindow.twoWindowsForAnAgent}" Margin="0,10,0,8" />
              <ItemsControl x:Name="AgentWindowList" ItemsSource="{Binding AgentWindows}" AutomationProperties.Name="{l:T setupWindow.twoWindowsForAnAgent}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SetupSummaryRow">
                    <Border Classes="section">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        <TextBlock Classes="muted small" Text="{Binding Value}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- The built-in assistant: which provider, and the two as-you-type switches, each off unless ticked. -->
            <StackPanel x:Name="AiAssistantPanel" IsVisible="{Binding IsAiAssistant}" MaxWidth="780" HorizontalAlignment="Left">
              <TextBlock Classes="subheading" Text="{l:T setupWindow.whichProvider}" />
              <ItemsControl x:Name="AiProviderList" ItemsSource="{Binding AiProviders}" AutomationProperties.Name="{l:T setupWindow.whichProvider}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SetupChoice">
                    <ToggleButton Classes="setupCard" Width="236" Margin="0,0,10,10" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}"
                                  AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="muted small" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                      </StackPanel>
                    </ToggleButton>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{l:T setupWindow.noProviderPlugin}" IsVisible="{Binding HasNoProviders}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBlock Classes="muted small" Text="{l:T setupWindow.providerSetUpAfter}" TextWrapping="Wrap" />
              <TextBlock Classes="subheading" Text="{l:T setupWindow.suggestionsAsYouType}" Margin="0,16,0,8" />
              <Border Classes="section">
                <StackPanel Spacing="4">
                  <CheckBox x:Name="InlineSuggestionsBox" IsChecked="{Binding AiInlineSuggestions}" AutomationProperties.Name="{l:T setupWindow.inlineSuggestions}" AutomationProperties.HelpText="{l:T setupWindow.inlineSuggestionsDescription}">
                    <TextBlock Text="{l:T setupWindow.inlineSuggestions}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </CheckBox>
                  <TextBlock Classes="muted small" Text="{l:T setupWindow.inlineSuggestionsDescription}" TextWrapping="Wrap" Margin="26,0,0,0" />
                </StackPanel>
              </Border>
              <Border Classes="section">
                <StackPanel Spacing="4">
                  <CheckBox x:Name="NextEditBox" IsChecked="{Binding AiNextEditSuggestions}" AutomationProperties.Name="{l:T setupWindow.nextEditSuggestions}" AutomationProperties.HelpText="{l:T setupWindow.nextEditSuggestionsDescription}">
                    <TextBlock Text="{l:T setupWindow.nextEditSuggestions}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  </CheckBox>
                  <TextBlock Classes="muted small" Text="{l:T setupWindow.nextEditSuggestionsDescription}" TextWrapping="Wrap" Margin="26,0,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- The summary: what was chosen, a few keys in the chosen scheme, and what the button does next. -->
        <ScrollViewer IsVisible="{Binding IsFinish}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Classes="pageTitle" Text="{l:T setupWindow.youreAllSet}" />
            <TextBlock Classes="lead" Text="{l:T setupWindow.allSetLead}" />
            <Border Classes="section">
              <ItemsControl x:Name="SummaryList" ItemsSource="{Binding Summary}" AutomationProperties.Name="{l:T setupWindow.whatYouChose}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SetupSummaryRow">
                    <Grid ColumnDefinitions="150,*" Margin="0,3">
                      <TextBlock Classes="muted" Text="{Binding Label}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <TextBlock x:Name="AiNextText" Text="{Binding AiNext}" IsVisible="{Binding HasAiNext}" TextWrapping="Wrap" Margin="2,2,0,10" />
            <StackPanel IsVisible="{Binding HasShortcuts}">
              <TextBlock Classes="subheading" Text="{Binding ShortcutsTitle}" />
              <Border Classes="section">
                <ItemsControl x:Name="ShortcutList" ItemsSource="{Binding Shortcuts}" AutomationProperties.Name="{Binding ShortcutsTitle}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SetupShortcutRow">
                      <Grid ColumnDefinitions="150,*" Margin="0,3">
                        <TextBlock Text="{Binding Keys}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
            <TextBlock Classes="muted" Text="{l:T setupWindow.changeAnythingLater}" TextWrapping="Wrap" Margin="2,6,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </DockPanel>
  </Grid>
</Window>
