<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.TaskRunnerView"
             x:DataType="vm:TaskRunnerViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6,4">
      <Button x:Name="Run" Content="{l:T taskRunner.run}" AutomationProperties.Name="{l:T taskRunner.runTheSelectedScript}" />
      <Button x:Name="Restore" Content="{l:T taskRunner.restorePackages}" AutomationProperties.Name="{l:T taskRunner.restoreTheSelectedPackageJsonS}" />
      <Button x:Name="Refresh" Content="{l:T taskRunner.refresh}" AutomationProperties.Name="{l:T taskRunner.refreshTheNpmScripts}" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{Binding Status}" IsVisible="{Binding HasStatus}" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T taskRunner.npmScripts}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:TaskRunnerRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:TaskRunnerRow">
          <Panel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsHeader}">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail}" Classes="muted" />
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !IsHeader}" Margin="12,0,0,0">
              <TextBlock Text="{Binding Label}" Classes="accent" MinWidth="120" />
              <TextBlock Grid.Column="1" Text="{Binding Detail}" Classes="muted" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Panel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
