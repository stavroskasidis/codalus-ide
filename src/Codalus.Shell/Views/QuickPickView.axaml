<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.QuickPickView"
             x:DataType="vm:QuickPickViewModel">
  <Border Classes="overlay" Padding="6" MaxHeight="480">
    <DockPanel>
      <TextBox x:Name="Input"
               DockPanel.Dock="Top"
               Text="{Binding Query}"
               PlaceholderText="{Binding Placeholder}"
               AutomationProperties.Name="{Binding Placeholder}" />
      <TextBlock DockPanel.Dock="Top"
                 Classes="muted"
                 Text="{l:T quickPick.noMatchingResults}"
                 Margin="8"
                 IsVisible="{Binding IsEmpty}" />
      <TextBlock DockPanel.Dock="Bottom"
                 Classes="muted"
                 FontSize="{DynamicResource Shell.FontSize.Small}"
                 Text="{Binding MoreText}"
                 Margin="8,4,8,0"
                 IsVisible="{Binding HasMore}" />
      <ListBox x:Name="List"
               Margin="0,6,0,0"
               Background="Transparent"
               ItemsSource="{Binding Rows}"
               SelectedIndex="{Binding SelectedIndex}"
               AutomationProperties.Name="{l:T quickPick.results}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:QuickPickRow">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:QuickPickRow">
            <!--
              M34g on M43: the label and its detail share what the right column leaves and trim with tooltips; the right
              column takes at most half the row. In a stack panel, New Project's ".NET Framework" detail ran under
              "C# · Windows only: …" on the right.
            -->
            <Grid ColumnDefinitions="*,Auto">
              <DockPanel>
                <controls:Icon DockPanel.Dock="Left" Margin="0,0,8,0" Kind="{Binding Icon}" IsVisible="{Binding HasIcon}" VerticalAlignment="Center" />
                <controls:HighlightedText DockPanel.Dock="Left" Source="{Binding Label}" Highlights="{Binding Highlights}" VerticalAlignment="Center"
                                          TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                <TextBlock Classes="muted" Margin="8,0,0,0" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Detail}" IsVisible="{Binding HasDetail}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
              </DockPanel>
              <TextBlock Grid.Column="1"
                         Classes="muted"
                         FontSize="{DynamicResource Shell.FontSize.Small}"
                         Margin="16,0,0,0"
                         VerticalAlignment="Center"
                         MaxWidth="{Binding $parent[ListBoxItem].Bounds.Width, Converter={x:Static vm:QuickPickRow.HalfWidth}}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding KeyLabel}"
                         Text="{Binding KeyLabel}"
                         IsVisible="{Binding HasKeyLabel}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
