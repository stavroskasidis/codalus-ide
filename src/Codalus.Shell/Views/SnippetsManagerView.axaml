<local:LoadingView xmlns:l="using:Codalus.Shell.Infrastructure"
                   xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codalus.Shell.Controls"
                   xmlns:vm="using:Codalus.Shell.ViewModels"
                   xmlns:local="using:Codalus.Shell.Views"
                   x:Class="Codalus.Shell.Views.SnippetsManagerView"
                   x:DataType="vm:SnippetsManagerViewModel">
  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
      <TextBlock Classes="heading" Text="{l:T snippetsManager.codeSnippets}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T snippetsManager.description}" />
      <Grid ColumnDefinitions="Auto,180,*">
        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="{l:T snippetsManager.language}" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T snippetsManager.language}" />
        <TextBox Grid.Column="2" Margin="8,0,0,0" Classes="search" Text="{Binding Search}" PlaceholderText="{l:T snippetsManager.searchNamesPrefixesAndDescriptions}" AutomationProperties.Name="{l:T snippetsManager.searchSnippets}" />
      </Grid>
      <WrapPanel Orientation="Horizontal">
        <Button Classes="iconText" controls:ButtonIcon.Kind="folder-open" Margin="0,0,6,6" Content="{l:T snippetsManager.openYourSnippets}" Command="{Binding OpenUserSnippetsCommand}" />
        <Button Classes="icon" controls:ButtonIcon.Kind="import" Margin="0,0,6,6" Command="{Binding ImportCommand}" ToolTip.Tip="{l:T snippetsManager.import}" AutomationProperties.Name="{l:T snippetsManager.import}" />
        <Button Classes="icon" controls:ButtonIcon.Kind="copy" Margin="0,0,6,6" Command="{Binding CopyToUserCommand}" ToolTip.Tip="{l:T snippetsManager.copyToYourSnippets}" AutomationProperties.Name="{l:T snippetsManager.copyToYourSnippets}" />
        <Button Classes="icon" controls:ButtonIcon.Kind="trash" Margin="0,0,6,6" Command="{Binding RemoveCommand}" ToolTip.Tip="{l:T snippetsManager.remove}" AutomationProperties.Name="{l:T snippetsManager.remove}" />
        <TextBlock Classes="muted" VerticalAlignment="Center" Margin="0,0,0,6" Text="{Binding Status}" TextWrapping="Wrap" />
      </WrapPanel>
    </StackPanel>
    <Grid ColumnDefinitions="*,*">
      <ListBox ItemsSource="{Binding Snippets}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:T snippetsManager.snippets}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:SnippetRowViewModel">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SnippetRowViewModel">
            <StackPanel Margin="0,2">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="muted" Text="{Binding Prefixes}" TextTrimming="CharacterEllipsis" />
                <TextBlock Foreground="{DynamicResource Shell.Link}" Text="{Binding Source}" />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border Grid.Column="1" Margin="8,0,0,0" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="{Binding Selected.Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="0,2,0,6" Text="{Binding Selected.Source}" />
          <TextBox IsReadOnly="True" AcceptsReturn="True" Text="{Binding Body}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Noto Sans Mono, Ubuntu Mono, Liberation Mono, Noto Mono, monospace" FontSize="12"
                   AutomationProperties.Name="{l:T snippetsManager.body}" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</local:LoadingView>
