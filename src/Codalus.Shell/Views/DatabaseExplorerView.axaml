<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.DatabaseExplorerView"
             x:DataType="vm:DatabaseExplorerViewModel">
  <DockPanel>
    <controls:ToolbarPanel DockPanel.Dock="Top">
      <Button Classes="toolbar" Command="{Binding AddCommand}" ToolTip.Tip="{l:T databaseExplorer.addAConnection}" AutomationProperties.Name="{l:T databaseExplorer.addConnection}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <controls:Icon Kind="database" />
          <TextBlock Text="{l:T databaseExplorer.addConnection2}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="file-code" Command="{Binding NewQueryCommand}" ToolTip.Tip="{l:T databaseExplorer.aNewSqlEditorOnThe}" AutomationProperties.Name="{l:T databaseExplorer.newQuery}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="table" Command="{Binding ViewDataCommand}" ToolTip.Tip="{l:T databaseExplorer.showAndEditTheSelectedTable}" AutomationProperties.Name="{l:T databaseExplorer.viewData}" />
      <Button Classes="toolbar" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:T databaseExplorer.refreshTheSelectedConnection}" AutomationProperties.Name="{l:T databaseExplorer.refresh}">
        <controls:Icon Kind="refresh" />
      </Button>
    </controls:ToolbarPanel>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="{l:T databaseExplorer.databaseExplorer}">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:DbNodeViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          <Setter Property="MinHeight" Value="22" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="vm:DbNodeViewModel" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" ToolTip.Tip="{Binding Tooltip}">
            <controls:Icon Kind="{Binding Icon}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Classes.muted="{Binding IsPlaceholder}" />
            <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Description}" IsVisible="{Binding HasDescription}" VerticalAlignment="Center" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
