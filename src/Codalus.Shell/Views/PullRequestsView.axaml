<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.PullRequestsView"
             x:DataType="vm:PullRequestsViewModel">
  <DockPanel>
    <controls:ToolbarPanel DockPanel.Dock="Top">
      <Button Classes="toolbar" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:T pullRequests.refresh}" AutomationProperties.Name="{l:T pullRequests.refreshPullRequests}">
        <controls:Icon Kind="refresh" />
      </Button>
      <Button Classes="toolbar" Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}" ToolTip.Tip="{l:T pullRequests.createPullRequest}" AutomationProperties.Name="{l:T pullRequests.createPullRequest}">
        <controls:Icon Kind="pull-request" />
      </Button>
      <ComboBox ItemsSource="{x:Static vm:PullRequestsViewModel.Filters}" SelectedIndex="{Binding FilterIndex}" MinWidth="150" Margin="4,0" AutomationProperties.Name="{l:T pullRequests.filterPullRequests}" />
      <TextBlock Text="{Binding RepositoryText}" Classes="muted" VerticalAlignment="Center" Margin="6,0" />
    </controls:ToolbarPanel>
    <StackPanel DockPanel.Dock="Top" Margin="12,8" Spacing="8" IsVisible="{Binding HasMessage}">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="muted" />
      <Button Classes="accent" Content="{Binding SignInLabel}" Command="{Binding SignInCommand}" IsVisible="{Binding CanSignIn}" HorizontalAlignment="Left" />
    </StackPanel>
    <Grid RowDefinitions="*,Auto,2*">
      <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="{l:T pullRequests.pullRequests}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:PullRequestRow">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PullRequestRow">
            <StackPanel Spacing="1">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:Icon Kind="pull-request" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Reference}" Classes="muted" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border IsVisible="{Binding IsCurrent}" Background="{DynamicResource Shell.Accent}" CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                  <TextBlock Text="{l:T pullRequests.currentBranch}" FontSize="{DynamicResource Shell.FontSize.Small}" Foreground="{DynamicResource Shell.AccentForeground}" />
                </Border>
              </StackPanel>
              <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Margin="22,0,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <GridSplitter Grid.Row="1" Height="4" ResizeDirection="Rows" Background="{DynamicResource Shell.Border}" IsVisible="{Binding HasDetails}" />

      <ScrollViewer Grid.Row="2" IsVisible="{Binding HasDetails}" AutomationProperties.Name="{l:T pullRequests.pullRequestDetails}">
        <StackPanel Margin="10,6" Spacing="8">
          <SelectableTextBlock Text="{Binding DetailsTitle}" Classes="subheading" TextWrapping="Wrap" />
          <TextBlock Text="{Binding DetailsMeta}" Classes="muted" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Classes="accent" Content="{l:T pullRequests.checkOut}" Command="{Binding CheckOutCommand}" ToolTip.Tip="{l:T pullRequests.fetchThePullRequestSBranch}" />
            <Button Classes="iconText" controls:ButtonIcon.Kind="globe" Content="{l:T pullRequests.openInBrowser}" Command="{Binding OpenInBrowserCommand}" />
          </StackPanel>
          <Border BorderBrush="{DynamicResource Shell.Border}" BorderThickness="0,1,0,0">
            <ContentControl x:Name="DescriptionHost" />
          </Border>
          <TextBlock Text="{l:T pullRequests.reviewComments}" FontWeight="SemiBold" IsVisible="{Binding HasThreads}" />
          <ItemsControl ItemsSource="{Binding Threads}" AutomationProperties.Name="{l:T pullRequests.reviewComments}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ReviewThreadRow">
                <Border BorderBrush="{DynamicResource Shell.Border}" BorderThickness="1" CornerRadius="3" Padding="8,6" Margin="0,0,0,6" AutomationProperties.Name="{Binding AccessibleName}">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <controls:Icon Kind="comment" VerticalAlignment="Center" />
                      <Button Classes="link" Content="{Binding Location}" Click="OnOpenThread" ToolTip.Tip="{l:T pullRequests.openTheFileAtThisLine}" />
                      <TextBlock Text="{Binding State}" Classes="muted" IsVisible="{Binding HasState}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Comments}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReviewCommentRow">
                          <StackPanel Spacing="1" Margin="22,2,0,2">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Author}" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding When}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" />
                            </StackPanel>
                            <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{l:T pullRequests.conversation}" FontWeight="SemiBold" IsVisible="{Binding HasComments}" />
          <ItemsControl ItemsSource="{Binding Comments}" AutomationProperties.Name="{l:T pullRequests.conversation}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ReviewCommentRow">
                <StackPanel Spacing="1" Margin="0,2">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Author}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding When}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" />
                  </StackPanel>
                  <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
