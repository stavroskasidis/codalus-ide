<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.ThreadsView"
             x:DataType="vm:ThreadsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6,4">
      <CheckBox IsChecked="{Binding FlaggedOnly}" Content="{l:T threads.showFlaggedThreadsOnly}" AutomationProperties.Name="{l:T threads.showFlaggedThreadsOnly}" />
    </StackPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="20,28,80,200,70,*" Margin="8,2" IsVisible="{Binding !IsEmpty}">
      <TextBlock Grid.Column="2" Text="{l:T threads.id}" Classes="muted" />
      <TextBlock Grid.Column="3" Text="{l:T threads.name}" Classes="muted" />
      <TextBlock Grid.Column="5" Text="{l:T threads.location}" Classes="muted" />
    </Grid>
    <TextBlock DockPanel.Dock="Bottom" Classes="muted" Margin="8,2" Text="{Binding FreezeProblem}" IsVisible="{Binding FreezeProblem, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{l:T threads.threadsAppearHereWhileTheProgram}" IsVisible="{Binding IsEmpty}" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T threads.threads}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ThreadRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ThreadRow">
          <Grid ColumnDefinitions="20,28,80,200,70,*">
            <TextBlock Text="{Binding Marker}" />
            <CheckBox Grid.Column="1" IsChecked="{Binding IsFlagged}" ToolTip.Tip="{l:T threads.flag}" AutomationProperties.Name="{l:T threads.flag}" Padding="0" MinWidth="0" />
            <TextBlock Grid.Column="2" Text="{Binding IdText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="4" Text="{Binding FrozenText}" VerticalAlignment="Center" Classes="muted" />
            <TextBlock Grid.Column="5" Text="{Binding Location}" VerticalAlignment="Center" Classes="muted" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
      <ListBox.ContextMenu>
        <ContextMenu x:Name="ThreadMenu">
          <MenuItem controls:MenuEntry.Icon="go-to" Header="{l:T threads.switchToThread}" Tag="switch" Click="OnThreadAction" FontWeight="SemiBold" />
          <Separator />
          <MenuItem x:Name="FreezeItem" controls:MenuEntry.Icon="pause" Header="{l:T threads.freeze}" Tag="freeze" Click="OnThreadAction" />
          <MenuItem x:Name="ThawItem" controls:MenuEntry.Icon="play-outline" Header="{l:T threads.thaw}" Tag="thaw" Click="OnThreadAction" />
        </ContextMenu>
      </ListBox.ContextMenu>
    </ListBox>
  </DockPanel>
</UserControl>
