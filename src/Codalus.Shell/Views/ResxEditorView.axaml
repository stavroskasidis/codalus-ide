<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Codalus.Shell.Views"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.ResxEditorView"
             x:DataType="views:ResxEditorDocument">
  <DockPanel>
    <controls:ToolbarPanel DockPanel.Dock="Top">
      <Button Classes="toolbar" Command="{Binding AddCommand}" ToolTip.Tip="{l:T resxEditor.addResource}" AutomationProperties.Name="{l:T resxEditor.addResource}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <controls:Icon Kind="new" />
          <TextBlock Text="{l:T resxEditor.addResource}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="toolbar" Command="{Binding RemoveCommand}" ToolTip.Tip="{l:T resxEditor.removeResource}" AutomationProperties.Name="{l:T resxEditor.removeResource}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <controls:Icon Kind="trash" />
          <TextBlock Text="{l:T resxEditor.removeResource}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="toolbar" Command="{Binding ViewCodeCommand}" ToolTip.Tip="{l:T resxEditor.viewCode}" AutomationProperties.Name="{l:T resxEditor.viewCode}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <controls:Icon Kind="file-code" />
          <TextBlock Text="{l:T resxEditor.viewCode}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <TextBox Text="{Binding Filter}" PlaceholderText="{l:T resxEditor.search}" MinWidth="160" AutomationProperties.Name="{l:T resxEditor.search}" />
    </controls:ToolbarPanel>
    <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource Shell.Error}" Text="{Binding Error}" TextWrapping="Wrap" IsVisible="{Binding HasError}" Margin="8,4" />
    <Grid DockPanel.Dock="Top" ColumnDefinitions="220,*,220" Margin="10,4,10,2">
      <TextBlock Classes="muted" Text="{l:T resxEditor.name}" />
      <TextBlock Grid.Column="1" Classes="muted" Text="{l:T resxEditor.value}" Margin="6,0,0,0" />
      <TextBlock Grid.Column="2" Classes="muted" Text="{l:T resxEditor.comment}" Margin="6,0,0,0" />
    </Grid>
    <ListBox x:Name="List" ItemsSource="{Binding Visible}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="{l:T resxEditor.resources}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="views:ResxRowViewModel">
          <Setter Property="Padding" Value="4,1" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="views:ResxRowViewModel">
          <Grid ColumnDefinitions="220,*,220">
            <TextBox Text="{Binding Name}" IsReadOnly="{Binding IsReadOnly}" AutomationProperties.Name="{l:T resxEditor.name}" />
            <TextBox Grid.Column="1" Margin="6,0,0,0" Text="{Binding Value}" IsReadOnly="{Binding IsReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" AutomationProperties.Name="{l:T resxEditor.value}" />
            <TextBox Grid.Column="2" Margin="6,0,0,0" Text="{Binding Comment}" IsReadOnly="{Binding IsReadOnly}" AutomationProperties.Name="{l:T resxEditor.comment}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
