<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:dt="using:Codalus.Shell.Views.DataTips"
             x:Class="Codalus.Shell.Views.VariablesView"
             x:DataType="vm:VariablesViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{l:T variables.variablesAppearHereWhileTheProgram}" IsVisible="{Binding IsEmpty}" />
    <dt:VariableRowList x:Name="Rows" AutomationProperties.Name="{l:T variables.variables}" />
  </DockPanel>
</UserControl>
