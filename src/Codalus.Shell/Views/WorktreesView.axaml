<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.WorktreesView"
             x:DataType="vm:WorktreesViewModel">
  <DockPanel>
    <!-- The standard toolbar (M34h, docs/design/controls/ToolWindowToolbars.dc.html): Add… labelled, the rest icons. -->
    <controls:ToolbarPanel DockPanel.Dock="Top">
      <Button Classes="toolbar iconText" controls:ButtonIcon.Kind="add" Content="{l:T worktrees.add}" Command="{Binding AddCommand}" ToolTip.Tip="{l:T worktrees.addAWorktreeForANew}" />
      <Border Classes="toolbarSeparator" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="folder-open" Command="{Binding OpenCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:T worktrees.openTheWorktreeSSolutionIn}" AutomationProperties.Name="{l:T worktrees.open}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="window-new" Command="{Binding OpenNewWindowCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:T worktrees.openInNewWindow}" AutomationProperties.Name="{l:T worktrees.openInNewWindow}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="{Binding LockIcon}" Command="{Binding LockCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{Binding LockTip}" AutomationProperties.Name="{Binding LockText}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="trash" Command="{Binding RemoveCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:T worktrees.remove}" AutomationProperties.Name="{l:T worktrees.remove}" />
      <Border Classes="toolbarSeparator" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="broom" Command="{Binding PruneCommand}" ToolTip.Tip="{l:T worktrees.pruneForgetWorktreesWhoseFolders}" AutomationProperties.Name="{l:T worktrees.pruneForgetWorktreesWhoseFolders}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:T worktrees.refresh}" AutomationProperties.Name="{l:T worktrees.refreshWorktrees}" />
    </controls:ToolbarPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" IsVisible="{Binding HasMessage}" Classes="muted" TextWrapping="Wrap" Margin="12,6" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="{l:T worktrees.worktrees}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:WorktreeRow">
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:WorktreeRow">
          <Grid ColumnDefinitions="Auto,*" Margin="0,2">
            <controls:Icon Kind="worktree" VerticalAlignment="Top" Margin="0,2,8,0" />
            <StackPanel Grid.Column="1" Spacing="1">
              <!-- The name, its branch, and the states as chips (current, main, locked, missing; M34h). -->
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                <controls:Icon Kind="branch" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding Branch}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Border Classes="chip" IsVisible="{Binding IsCurrent}" Margin="0,0,4,0"><TextBlock Text="{l:T worktrees.current}" /></Border>
                <Border Classes="chip" IsVisible="{Binding IsMain}" Margin="0,0,4,0"><TextBlock Text="{l:T worktrees.main}" /></Border>
                <Border Classes="chip" IsVisible="{Binding IsLocked}" ToolTip.Tip="{Binding LockReason}" Margin="0,0,4,0">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <controls:Icon Kind="lock" VerticalAlignment="Center" />
                    <TextBlock Text="{l:T worktrees.locked}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Classes="chip warning" IsVisible="{Binding IsPrunable}" Margin="0,0,4,0"><TextBlock Text="{l:T worktrees.missingPrunable}" /></Border>
              </WrapPanel>
              <TextBlock Text="{Binding Location}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
