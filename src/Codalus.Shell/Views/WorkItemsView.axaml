<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.WorkItemsView"
             x:DataType="vm:WorkItemsViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="4,3">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
        <Button Classes="toolbar" Command="{Binding MentionCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:T workItems.mentionInTheCommitMessage}" AutomationProperties.Name="{l:T workItems.mentionInCommitMessage}">
          <controls:Icon Kind="edit" />
        </Button>
        <Button Classes="toolbar" Command="{Binding OpenCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:T workItems.openInBrowser}" AutomationProperties.Name="{l:T workItems.openInBrowser}">
          <controls:Icon Kind="link-external" />
        </Button>
        <Button Classes="toolbar" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:T workItems.refresh}" AutomationProperties.Name="{l:T workItems.refreshWorkItems}">
          <controls:Icon Kind="refresh" />
        </Button>
      </StackPanel>
      <TextBox Text="{Binding Search}" PlaceholderText="{l:T workItems.searchByNumberOrWordsEmpty}" AutomationProperties.Name="{l:T workItems.searchWorkItems}" />
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" FontWeight="SemiBold" Margin="8,4,8,2" />
    <StackPanel DockPanel.Dock="Top" Margin="12,6" Spacing="8" IsVisible="{Binding HasMessage}">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="muted" />
      <Button Classes="accent" Content="{Binding SignInLabel}" Command="{Binding SignInCommand}" IsVisible="{Binding CanSignIn}" HorizontalAlignment="Left" />
    </StackPanel>
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="{l:T workItems.workItems}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:WorkItemRow">
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:WorkItemRow">
          <StackPanel Spacing="1">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <controls:Icon Kind="issue" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Reference}" Classes="muted" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Margin="22,0,0,0" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
