<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.DeviceLogView"
             x:DataType="vm:DeviceLogViewModel">
  <!-- The Device Log (ADR 0104): a device's log as it comes, filtered; errors and warnings in their text colors, debug and verbose muted. -->
  <DockPanel Grid.IsSharedSizeScope="True">
    <controls:ToolbarPanel DockPanel.Dock="Top">
      <ComboBox x:Name="SourceBox" Classes="toolbar" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" MinWidth="200" MaxWidth="320"
                PlaceholderText="{l:T deviceLog.noRunningDevice}" ToolTip.Tip="{l:T deviceLog.theDeviceWhoseLogToFollow}" AutomationProperties.Name="{l:T deviceLog.device}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="refresh" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:T deviceLog.refreshTheDevices}" AutomationProperties.Name="{l:T deviceLog.refreshTheDevices}" />
      <Border Classes="toolbarSeparator" />
      <ComboBox Classes="toolbar" ItemsSource="{Binding Levels}" SelectedIndex="{Binding Level}" MinWidth="100" ToolTip.Tip="{l:T deviceLog.theLowestLevelShown}" AutomationProperties.Name="{l:T deviceLog.lowestLevel}" />
      <TextBox Text="{Binding Search}" Width="200" MinHeight="{DynamicResource Shell.Size.Input}" Padding="6,3" VerticalContentAlignment="Center"
               PlaceholderText="{l:T deviceLog.searchTagsAndMessages}" AutomationProperties.Name="{l:T deviceLog.searchTagsAndMessages}" />
      <ToggleButton Classes="toolbar iconText" controls:ButtonIcon.Kind="phone" IsChecked="{Binding OnlyMyApp}" Content="{l:T deviceLog.myApp}" ToolTip.Tip="{Binding AppDescription}" AutomationProperties.Name="{l:T deviceLog.onlyTheStartupProjectSApp}" />
      <Border Classes="toolbarSeparator" />
      <ToggleButton Classes="toolbar" IsChecked="{Binding Paused}" ToolTip.Tip="{l:T deviceLog.pause}" AutomationProperties.Name="{l:T deviceLog.pauseTheLog}">
        <controls:Icon Kind="pause" />
      </ToggleButton>
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="clear-all" Command="{Binding ClearCommand}" ToolTip.Tip="{l:T deviceLog.clear}" AutomationProperties.Name="{l:T deviceLog.clearTheLog}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="save" Command="{Binding SaveCommand}" ToolTip.Tip="{l:T deviceLog.saveTheEntriesShown}" AutomationProperties.Name="{l:T deviceLog.saveTheEntriesShown}" />
    </controls:ToolbarPanel>
    <TextBlock DockPanel.Dock="Top" Classes="muted small" Margin="8,2,8,4" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <Border DockPanel.Dock="Top" Classes="gridHeader">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="logTime" />
          <ColumnDefinition Width="24" />
          <ColumnDefinition Width="Auto" MinWidth="70" SharedSizeGroup="logProcess" />
          <ColumnDefinition Width="160" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{l:T deviceLog.time}" />
        <TextBlock Grid.Column="1" Text="{l:T deviceLog.level}" />
        <TextBlock Grid.Column="2" Text="{l:T deviceLog.process}" Margin="6,0,0,0" />
        <TextBlock Grid.Column="3" Text="{l:T deviceLog.tag}" Margin="6,0,0,0" />
        <TextBlock Grid.Column="4" Text="{l:T deviceLog.message}" Margin="6,0,0,0" />
      </Grid>
    </Border>
    <ListBox x:Name="LogList" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T deviceLog.deviceLog}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:DeviceLogRow">
          <Setter Property="Padding" Value="4,0" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:DeviceLogRow">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="140" SharedSizeGroup="logTime" />
              <ColumnDefinition Width="24" />
              <ColumnDefinition Width="Auto" MinWidth="70" SharedSizeGroup="logProcess" />
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Time}" Classes="muted" />
            <TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="SemiBold" Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" Classes.muted="{Binding IsQuiet}" />
            <TextBlock Grid.Column="2" Text="{Binding Process}" Classes="muted" Margin="6,0,0,0" />
            <TextBlock Grid.Column="3" Text="{Binding Tag}" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" ToolTip.Tip="{Binding Tag}" />
            <SelectableTextBlock Grid.Column="4" Text="{Binding Message}" TextWrapping="Wrap" Margin="6,0,0,0" Classes.error="{Binding IsError}" Classes.warning="{Binding IsWarning}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
