<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codalus.Shell.Controls"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.BenchmarksView"
             x:DataType="vm:BenchmarksViewModel">
  <DockPanel>
    <!-- The control set's toolbar (M34h): Run All keeps its label, the rest are icons; the job's label is inside its combo box; In process is a toggle. -->
    <controls:ToolbarPanel DockPanel.Dock="Top">
      <Button x:Name="RunAllButton" Classes="toolbar iconText" controls:ButtonIcon.Kind="run-all" Content="{l:T benchmarks.runAll}" Command="{Binding RunAllCommand}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="play" Command="{Binding RunSelectedCommand}" ToolTip.Tip="{l:T benchmarks.runSelected}" AutomationProperties.Name="{l:T benchmarks.runSelected}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="stop" Command="{Binding StopCommand}" ToolTip.Tip="{l:T benchmarks.stop}" AutomationProperties.Name="{l:T benchmarks.stop}" />
      <Border Classes="toolbarSeparator" />
      <ComboBox ItemsSource="{Binding Jobs}" SelectedItem="{Binding Job}" MinWidth="130" AutomationProperties.Name="{l:T benchmarks.benchmarkdotnetJob}" ToolTip.Tip="{l:T benchmarks.benchmarkdotnetJob}">
        <ComboBox.SelectionBoxItemTemplate>
          <DataTemplate x:DataType="x:String">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Classes="muted" Text="{l:T benchmarks.job}" />
              <TextBlock Text="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.SelectionBoxItemTemplate>
      </ComboBox>
      <ToggleButton Classes="toolbar iconText" controls:ButtonIcon.Kind="cube" Content="{l:T benchmarks.inProcess}" IsChecked="{Binding InProcess}" ToolTip.Tip="{l:T benchmarks.runInTheBenchmarkProjectS}" />
    </controls:ToolbarPanel>
    <TextBlock DockPanel.Dock="Top" Classes="muted small" Margin="8,2,8,6" TextWrapping="Wrap" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
    <!-- The results' fixed columns need room: narrower, they spilled over the History header (seen on the Mac). -->
    <!-- The table fills the pane; below its minimum width the columns keep their widths and scroll sideways together (M34d). -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <DockPanel MinWidth="900" Width="{Binding $parent[ScrollViewer].Bounds.Width}" Margin="0,0,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="2*" MinWidth="480" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <DockPanel>
            <Border DockPanel.Dock="Top" Classes="gridHeader"><TextBlock Text="{l:T benchmarks.benchmarks}" /></Border>
            <ListBox x:Name="BenchmarkList" ItemsSource="{Binding Benchmarks}" SelectedItem="{Binding SelectedBenchmark}" AutomationProperties.Name="{l:T benchmarks.benchmarksInTheSolutionDoubleClick}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BenchmarkRowViewModel">
                  <StackPanel AutomationProperties.Name="{Binding AccessibleName}">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
          <DockPanel Grid.Column="2" ClipToBounds="True">
            <Border DockPanel.Dock="Top" Classes="gridHeader" Padding="12,0,12,0">
              <Grid ColumnDefinitions="*,90,80,90,80,60">
                <TextBlock Text="{l:T benchmarks.method}" />
                <TextBlock Grid.Column="1" Text="{l:T benchmarks.mean}" TextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="{l:T benchmarks.error}" TextAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{l:T benchmarks.stddev}" TextAlignment="Right" />
                <TextBlock Grid.Column="4" Text="{l:T benchmarks.allocated}" TextAlignment="Right" />
                <TextBlock Grid.Column="5" Text="{l:T benchmarks.ratio}" TextAlignment="Right" />
              </Grid>
            </Border>
            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" AutomationProperties.Name="{l:T benchmarks.theLastRunSResults}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BenchmarkResultRowViewModel">
                  <Grid ColumnDefinitions="*,90,80,90,80,60" AutomationProperties.Name="{Binding AccessibleName}">
                    <TextBlock Text="{Binding Method}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Mean}" TextAlignment="Right" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{Binding Error}" TextAlignment="Right" Classes="muted" />
                    <TextBlock Grid.Column="3" Text="{Binding StandardDeviation}" TextAlignment="Right" Classes="muted" />
                    <TextBlock Grid.Column="4" Text="{Binding Allocated}" TextAlignment="Right" />
                    <TextBlock Grid.Column="5" Text="{Binding Ratio}" TextAlignment="Right" Classes="muted" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <GridSplitter Grid.Column="3" ResizeDirection="Columns" />
          <DockPanel Grid.Column="4">
            <Border DockPanel.Dock="Top" Classes="gridHeader"><TextBlock Text="{l:T benchmarks.history}" /></Border>
            <ListBox ItemsSource="{Binding History}" AutomationProperties.Name="{l:T benchmarks.theSelectedBenchmarkSEarlierRuns}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BenchmarkHistoryRowViewModel">
                  <StackPanel AutomationProperties.Name="{Binding AccessibleName}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Mean}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Change}" Classes="muted" />
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Time}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Grid>
      </DockPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
