<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.ConnectionView"
             x:DataType="vm:ConnectionFormViewModel">
  <ScrollViewer>
    <StackPanel Margin="24,18" Spacing="8" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Classes="heading" Text="{l:T connection.databaseConnection}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T connection.connectionsAreKeptForYourUser}" />
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,4">
        <TextBlock Text="{l:T connection.database}" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox x:Name="EngineBox" Grid.Column="1" ItemsSource="{Binding Engines}" SelectedItem="{Binding EngineName}" MinWidth="240" AutomationProperties.Name="{l:T connection.databaseEngine}" />
        <TextBlock Grid.Row="1" Text="{l:T connection.name}" Classes="muted" VerticalAlignment="Center" Margin="0,6,12,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Name}" PlaceholderText="{l:T connection.fromTheServerAndDatabase}" AutomationProperties.Name="{l:T connection.connectionName}" />
      </Grid>
      <CheckBox Content="{l:T connection.enterAConnectionStringInstead}" IsChecked="{Binding UseConnectionString}" />
      <TextBox Text="{Binding ConnectionString}" IsVisible="{Binding UseConnectionString}" AutomationProperties.Name="{l:T connection.connectionString}" PlaceholderText="{l:T connection.serverLocalhostDatabaseShopUserId}" />
      <StackPanel Spacing="8" IsVisible="{Binding UseFields}">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto" IsVisible="{Binding IsSqlite}">
          <TextBlock Text="{l:T connection.file}" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="80" />
          <controls:PathBox Grid.Column="1" Kind="File" Patterns="*.db;*.sqlite;*.sqlite3;*.db3" Text="{Binding File}" PlaceholderText="{l:T connection.pathToTheDbFile}" AutomationProperties.Name="{l:T connection.databaseFile}" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" IsVisible="{Binding IsServer}">
          <TextBlock Text="{l:T connection.server}" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="80" />
          <TextBox Grid.Column="1" Text="{Binding Host}" AutomationProperties.Name="{l:T connection.server}" />
          <TextBlock Grid.Column="2" Text="{l:T connection.port}" Classes="muted" VerticalAlignment="Center" Margin="12,0" />
          <TextBox Grid.Column="3" Width="90" Text="{Binding Port}" PlaceholderText="{l:T connection.default}" AutomationProperties.Name="{l:T connection.port}" />
          <TextBlock Grid.Row="1" Text="{l:T connection.database}" Classes="muted" VerticalAlignment="Center" Margin="0,6,12,0" />
          <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Text="{Binding Database}" PlaceholderText="{l:T connection.theServerSDefault}" AutomationProperties.Name="{l:T connection.databaseName}" />
        </Grid>
        <CheckBox Content="{l:T connection.windowsAuthenticationIntegratedSecurity}" IsChecked="{Binding Integrated}" IsVisible="{Binding IsSqlServer}" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" IsVisible="{Binding UsesPassword}">
          <TextBlock Text="{l:T connection.user}" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="80" />
          <TextBox Grid.Column="1" Text="{Binding User}" AutomationProperties.Name="{l:T connection.userName}" />
          <TextBlock Grid.Row="1" Text="{l:T connection.password}" Classes="muted" VerticalAlignment="Center" Margin="0,6,12,0" />
          <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Password}" PasswordChar="●" AutomationProperties.Name="{l:T connection.password}" />
        </Grid>
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
          <TextBlock Text="{l:T connection.options}" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="80" />
          <TextBox Grid.Column="1" Text="{Binding Options}" PlaceholderText="{l:T connection.moreKeywordsSuchAsTrustservercertificateTrue}" AutomationProperties.Name="{l:T connection.connectionOptions}" />
        </Grid>
      </StackPanel>
      <CheckBox Content="{l:T connection.saveThePasswordInTheOperating}" IsChecked="{Binding SavePassword}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="{l:T connection.save}" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Content="{l:T connection.testConnection}" Command="{Binding TestCommand}" IsEnabled="{Binding !IsBusy}" />
        <TextBlock Text="{l:T connection.connecting}" Classes="muted" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{Binding Result}" IsVisible="{Binding HasResult}" TextWrapping="Wrap" FontWeight="SemiBold" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
