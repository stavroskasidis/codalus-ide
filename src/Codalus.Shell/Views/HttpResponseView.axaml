<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codalus.Shell.Controls"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.HttpResponseView"
             x:DataType="vm:HttpResponseViewModel">
  <!-- The control set's design (M34h, docs/design/controls/HttpResponse.dc.html): the status as a chip with the version,
       time and size; the request line with a link to its .http file; Body, Headers and Request as tabs with count
       badges, the body Pretty or Raw; the history with method and status chips. -->
  <UserControl.Styles>
    <Style Selector="Border.chip.large">
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="TextElement.FontSize" Value="{DynamicResource Shell.FontSize.Body}" />
    </Style>
    <Style Selector="Border.chip.mono > TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Noto Sans Mono, Ubuntu Mono, Liberation Mono, Noto Mono, monospace" />
    </Style>
    <Style Selector="TextBlock.meta">
      <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="controls|Icon.meta">
      <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="0,0,5,0" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="3" />
      <Setter Property="Height" Value="3" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="Fill" Value="{DynamicResource Shell.MutedForeground}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- The history: two-line rows, the selected one with the accent on its left edge. -->
    <Style Selector="ListBox#HistoryList ListBoxItem">
      <Setter Property="Padding" Value="10,4,12,4" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#HistoryList ListBoxItem:selected">
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
    </Style>
    <Style Selector="ListBox#HistoryList ListBoxItem:selected TextBlock.meta">
      <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Foreground}" />
    </Style>
    <Style Selector="ListBox#HistoryList:not(:focus-within) ListBoxItem:selected TextBlock.meta">
      <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Inactive.Foreground}" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="Root" ColumnDefinitions="*,5,360">
    <!-- The selected exchange. -->
    <DockPanel MinWidth="0">
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="12,10,12,8" IsVisible="{Binding HasExchange}">
        <DockPanel>
          <controls:ToolbarPanel DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center">
            <Button Classes="toolbar iconText" controls:ButtonIcon.Kind="play" Content="{l:T httpResponse.sendAgain}" Command="{Binding SendAgainCommand}" ToolTip.Tip="{l:T httpResponse.sendTheRequestAgainFromIts}" />
            <Border Classes="toolbarSeparator" />
            <Button x:Name="CopyBody" Classes="toolbar icon" controls:ButtonIcon.Kind="copy" IsEnabled="{Binding HasBody}" ToolTip.Tip="{l:T httpResponse.copyResponseBody}" AutomationProperties.Name="{l:T httpResponse.copyResponseBody}" />
            <Button Classes="toolbar icon" controls:ButtonIcon.Kind="save" Command="{Binding SaveBodyCommand}" ToolTip.Tip="{l:T httpResponse.saveResponseBody}" AutomationProperties.Name="{l:T httpResponse.saveResponseBody}" />
            <Button Classes="toolbar icon" controls:ButtonIcon.Kind="link-external" Command="{Binding OpenBodyCommand}" ToolTip.Tip="{l:T httpResponse.openInEditor}" AutomationProperties.Name="{l:T httpResponse.openInEditor}" />
          </controls:ToolbarPanel>
          <Border DockPanel.Dock="Left" Classes="chip large" Classes.success="{Binding IsStatusSuccess}" Classes.warning="{Binding IsStatusRedirect}"
                  Classes.error="{Binding IsStatusError}" Classes.info="{Binding IsStatusInfo}" Margin="0,0,10,0">
            <TextBlock x:Name="StatusChip" Text="{Binding StatusText}" AutomationProperties.LiveSetting="Polite" />
          </Border>
          <WrapPanel VerticalAlignment="Center" IsVisible="{Binding HasResponse}">
            <TextBlock Classes="meta" Text="{Binding Version}" />
            <Ellipse Classes="dot" />
            <StackPanel Orientation="Horizontal" ToolTip.Tip="{l:T httpResponse.time}">
              <controls:Icon Classes="meta" Kind="clock" />
              <TextBlock Classes="meta" Text="{Binding Elapsed}" />
            </StackPanel>
            <Ellipse Classes="dot" />
            <StackPanel Orientation="Horizontal" ToolTip.Tip="{l:T httpResponse.size}">
              <controls:Icon Classes="meta" Kind="download" />
              <TextBlock Classes="meta" Text="{Binding Size}" />
            </StackPanel>
          </WrapPanel>
          <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding !HasResponse}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Error}" />
        </DockPanel>
        <DockPanel>
          <Border DockPanel.Dock="Left" Classes="chip square mono" Classes.info="{Binding IsMethodOther}" Classes.success="{Binding IsMethodCreate}" Classes.error="{Binding IsMethodDelete}" Margin="0,0,8,0">
            <TextBlock Text="{Binding Method}" />
          </Border>
          <Button DockPanel.Dock="Right" Classes="link" Content="{Binding Source}" Command="{Binding OpenRequestCommand}" IsVisible="{Binding HasSource}" VerticalAlignment="Center"
                  ToolTip.Tip="{l:T httpResponse.openTheRequestInItsHttp}" />
          <TextBlock DockPanel.Dock="Right" Classes="muted small" Text="{l:T httpResponse.from}" IsVisible="{Binding HasSource}" VerticalAlignment="Center" Margin="8,0,4,0" />
          <TextBlock Text="{Binding Url}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Noto Sans Mono, Ubuntu Mono, Liberation Mono, Noto Mono, monospace" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Url}" />
        </DockPanel>
      </StackPanel>
      <!-- Body, Headers and Request (the tabs inside a view, TabStrip.viewTabs); the body's view switch on the right. The
           row draws the strip's hairline, across the tools too; the tabs reach over it. -->
      <Border x:Name="TabRow" DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Shell.ViewTabs.Rule}" Padding="6,0" IsVisible="{Binding HasExchange}">
        <DockPanel>
          <TabStrip x:Name="Tabs" Classes="viewTabs" BorderThickness="0" Padding="0" DockPanel.Dock="Left" SelectedIndex="{Binding TabIndex}" AutomationProperties.Name="{l:T httpResponse.response}">
            <TabStripItem Content="{l:T httpResponse.body}" />
            <TabStripItem AutomationProperties.Name="{l:T httpResponse.headers}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{l:T httpResponse.headers}" VerticalAlignment="Center" />
                <Border Classes="badge" IsVisible="{Binding HasHeaders}">
                  <TextBlock Text="{Binding HeaderCount}" />
                </Border>
              </StackPanel>
            </TabStripItem>
            <TabStripItem Content="{l:T httpResponse.request}" />
          </TabStrip>
          <!-- Pretty or Raw and Word Wrap: a narrow window moves them into the toolbar's overflow menu. -->
          <controls:ToolbarPanel x:Name="BodyTools" DockPanel.Dock="Right" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4" IsVisible="{Binding IsBodyTab}">
            <controls:SegmentedControl x:Name="BodyView" SelectedIndex="{Binding BodyViewIndex}" AutomationProperties.Name="{l:T httpResponse.bodyView}">
              <controls:SegmentedControlItem Content="{l:T httpResponse.pretty}" ToolTip.Tip="{l:T httpResponse.theBodyFormattedByItsContent}" />
              <controls:SegmentedControlItem Content="{l:T httpResponse.raw}" ToolTip.Tip="{l:T httpResponse.theBodyAsReceived}" />
            </controls:SegmentedControl>
            <ToggleButton x:Name="WrapToggle" Classes="toolbar icon" controls:ButtonIcon.Kind="word-wrap" ToolTip.Tip="{l:T httpResponse.wordWrap}" AutomationProperties.Name="{l:T httpResponse.wordWrap}" />
          </controls:ToolbarPanel>
          <TextBlock Classes="muted small" Text="{Binding ContentType}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,8,0"
                     TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ContentType}" IsVisible="{Binding IsBodyTab}" />
        </DockPanel>
      </Border>
      <Panel>
        <Border x:Name="BodyHost" IsVisible="{Binding IsBodyTab}" />
        <ScrollViewer IsVisible="{Binding IsHeadersTab}">
          <ItemsControl ItemsSource="{Binding HeaderRows}" Margin="12,6" AutomationProperties.Name="{l:T httpResponse.responseHeaders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:HttpHeaderRow">
                <Grid ColumnDefinitions="200,*" MinHeight="22">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" Margin="0,0,12,0" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Noto Sans Mono, Ubuntu Mono, Liberation Mono, Noto Mono, monospace" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <ScrollViewer IsVisible="{Binding IsRequestTab}">
          <SelectableTextBlock Text="{Binding RequestText}" FontFamily="{Binding Font.Family}" Margin="12,8" />
        </ScrollViewer>
        <!-- Nothing sent yet. -->
        <StackPanel Classes="emptyState" IsVisible="{Binding HasNoExchange}">
          <controls:Icon Kind="globe" Width="32" Height="32" />
          <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" />
        </StackPanel>
      </Panel>
    </DockPanel>

    <!-- The history's width: dragged, it stays as the user leaves it. -->
    <GridSplitter x:Name="HistorySplitter" Grid.Column="1" ResizeDirection="Columns" Background="Transparent" AutomationProperties.Name="{l:T httpResponse.resizeTheHistory}">
      <GridSplitter.Template>
        <ControlTemplate>
          <Border Background="Transparent">
            <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource Shell.Border}" />
          </Border>
        </ControlTemplate>
      </GridSplitter.Template>
    </GridSplitter>

    <!-- The history. -->
    <DockPanel x:Name="HistoryPane" Grid.Column="2">
      <Border DockPanel.Dock="Top" MinHeight="32" Padding="12,0,6,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Shell.Grid.Rule}">
        <DockPanel VerticalAlignment="Center">
          <Button DockPanel.Dock="Right" Classes="toolbar icon" controls:ButtonIcon.Kind="clear-all" Command="{Binding ClearHistoryCommand}" IsEnabled="{Binding HasHistory}"
                  ToolTip.Tip="{l:T httpResponse.clearHistory}" AutomationProperties.Name="{l:T httpResponse.clearTheRequestHistory}" />
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <TextBlock Text="{l:T httpResponse.history}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Classes="badge" IsVisible="{Binding HasHistory}">
              <TextBlock Text="{Binding History.Count}" />
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>
      <Border DockPanel.Dock="Bottom" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Shell.Grid.Rule}">
        <DockPanel>
          <controls:Icon DockPanel.Dock="Left" Kind="info" Width="12" Height="12" Margin="0,2,6,0" VerticalAlignment="Top" />
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="{l:T httpResponse.sendARequestFromAHttp}" />
        </DockPanel>
      </Border>
      <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="{l:T httpResponse.requestHistory}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem" x:DataType="vm:HttpHistoryRow">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:HttpHistoryRow">
            <Grid ColumnDefinitions="52,*,Auto" RowDefinitions="20,16" ToolTip.Tip="{Binding AccessibleName}">
              <Border Grid.RowSpan="2" Classes="chip square mono" Classes.info="{Binding IsMethodOther}" Classes.success="{Binding IsMethodCreate}" Classes.error="{Binding IsMethodDelete}">
                <TextBlock Text="{Binding Method}" />
              </Border>
              <TextBlock Grid.Column="1" Text="{Binding Path}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Noto Sans Mono, Ubuntu Mono, Liberation Mono, Noto Mono, monospace" FontSize="12" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
              <Border Grid.Column="2" Classes="chip" Classes.success="{Binding IsStatusSuccess}" Classes.warning="{Binding IsStatusRedirect}" Classes.error="{Binding IsStatusError}" Classes.info="{Binding IsStatusInfo}">
                <TextBlock Text="{Binding StatusText}" />
              </Border>
              <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0">
                <TextBlock DockPanel.Dock="Left" Classes="meta small" Text="{Binding Time}" Margin="0,0,8,0" />
                <TextBlock DockPanel.Dock="Left" Classes="meta small" Text="{Binding At}" Margin="0,0,8,0" />
                <TextBlock Classes="meta small" Text="{Binding Note}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
