<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.QuickWatchView"
             x:DataType="vm:QuickWatchViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="6,4">
      <TextBox x:Name="Input" Text="{Binding Expression}" PlaceholderText="{l:T quickWatch.expressionEnterToEvaluate}" AutomationProperties.Name="{l:T quickWatch.quickwatchExpression}" />
      <Button x:Name="Reevaluate" Grid.Column="1" Margin="6,0,0,0" Content="{l:T quickWatch.reevaluate}" AutomationProperties.Name="{l:T quickWatch.reevaluate}" />
      <Button x:Name="AddWatch" Grid.Column="2" Margin="6,0,0,0" Content="{l:T quickWatch.addWatch}" AutomationProperties.Name="{l:T quickWatch.addWatch}" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Classes="error" Margin="12,4" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" Background="Transparent" AutomationProperties.Name="{l:T quickWatch.quickwatchValue}">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:VariableNode">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="vm:VariableNode" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Value}" Classes.error="{Binding IsError}" TextTrimming="CharacterEllipsis" MaxWidth="600" ToolTip.Tip="{Binding Value}" />
            <TextBlock Text="{Binding Type}" Classes="muted" IsVisible="{Binding HasType}" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
