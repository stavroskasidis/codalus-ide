<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codalus.Shell.Controls"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.BreakpointsView"
             x:DataType="vm:BreakpointsViewModel">
  <DockPanel>
    <controls:ToolbarPanel DockPanel.Dock="Top" Spacing="4">
      <Button x:Name="NewFunction" Content="{l:T breakpoints.newFunction}" ToolTip.Tip="{l:T breakpoints.newFunctionBreakpoint}" AutomationProperties.Name="{l:T breakpoints.newFunctionBreakpoint2}" />
      <Button x:Name="EnableAll" Content="{l:T breakpoints.enableAll}" ToolTip.Tip="{l:T breakpoints.enableTheBreakpointsShown}" AutomationProperties.Name="{l:T breakpoints.enableAllBreakpoints}" />
      <Button x:Name="DisableAll" Content="{l:T breakpoints.disableAll}" ToolTip.Tip="{l:T breakpoints.disableTheBreakpointsShown}" AutomationProperties.Name="{l:T breakpoints.disableAllBreakpoints}" />
      <Button x:Name="Export" Content="{l:T breakpoints.export}" AutomationProperties.Name="{l:T breakpoints.exportBreakpoints}" />
      <Button x:Name="Import" Content="{l:T breakpoints.import}" AutomationProperties.Name="{l:T breakpoints.importBreakpoints}" />
      <Button x:Name="DeleteAll" Content="{l:T breakpoints.deleteAll}" AutomationProperties.Name="{l:T breakpoints.deleteAllBreakpoints}" />
      <TextBox x:Name="Search" Text="{Binding Filter}" PlaceholderText="{l:T breakpoints.searchLocationConditionLabel}" AutomationProperties.Name="{l:T breakpoints.searchBreakpoints}" />
    </controls:ToolbarPanel>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{l:T breakpoints.noBreakpointsPressF9InAn}" IsVisible="{Binding IsEmpty}" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T breakpoints.breakpoints}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:BreakpointRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:BreakpointRow">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <CheckBox IsChecked="{Binding Enabled}" AutomationProperties.Name="{l:T breakpoints.enabled}" />
            <TextBlock Text="{Binding Location}" VerticalAlignment="Center" Classes.muted="{Binding !IsVerified}" />
            <Border Classes="badge" IsVisible="{Binding HasLabels}" VerticalAlignment="Center" Padding="4,0" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}">
              <TextBlock Text="{Binding Labels}" FontSize="{DynamicResource Shell.FontSize.Small}" />
            </Border>
            <TextBlock Text="{Binding Details}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
