<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.BookmarksView"
             x:DataType="vm:BookmarksViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" IsVisible="{Binding IsEmpty}"
               Text="{l:T bookmarks.noBookmarksCtrlKCtrlK}" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T bookmarks.bookmarks}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:BookmarkRowViewModel">
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          <Setter Property="Padding" Value="6,2" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:BookmarkRowViewModel">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" IsVisible="{Binding HasName}" />
            <TextBlock Text="{Binding Location}" />
            <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Folder}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
