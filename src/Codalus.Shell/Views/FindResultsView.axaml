<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codalus.Shell.Controls"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.FindResultsView"
             x:DataType="vm:FindResultsViewModel">
  <!-- The results only: Find and Replace (the floating window, Ctrl+Shift+F) runs the searches; Modify Find shows it again. -->
  <DockPanel>
    <controls:ToolbarPanel DockPanel.Dock="Top">
      <Button Classes="toolbar" Command="{Binding PreviousCommand}" ToolTip.Tip="{l:T findResults.goToPreviousLocation}" AutomationProperties.Name="{l:T findResults.goToPreviousLocation}">
        <controls:Icon Kind="arrow-up" />
      </Button>
      <Button Classes="toolbar" Command="{Binding NextCommand}" ToolTip.Tip="{l:T findResults.goToNextLocation}" AutomationProperties.Name="{l:T findResults.goToNextLocation}">
        <controls:Icon Kind="arrow-down" />
      </Button>
      <Button Classes="toolbar" Command="{Binding ClearCommand}" ToolTip.Tip="{l:T findResults.clearAll}" AutomationProperties.Name="{l:T findResults.clearAll}">
        <controls:Icon Kind="clear-all" />
      </Button>
      <Button Classes="toolbar" Command="{Binding CancelCommand}" IsVisible="{Binding IsSearching}" ToolTip.Tip="{l:T findResults.stopSearching}" AutomationProperties.Name="{l:T findResults.stopSearching}">
        <controls:Icon Kind="stop" />
      </Button>
      <Button Classes="toolbar" Command="{Binding ModifyFindCommand}" ToolTip.Tip="{l:T findResults.modifyFindTip}" AutomationProperties.Name="{l:T findResults.modifyFind}">
        <StackPanel Orientation="Horizontal" Spacing="4"><controls:Icon Kind="edit" /><TextBlock Text="{l:T findResults.modifyFind}" /></StackPanel>
      </Button>
      <ComboBox MinWidth="200" ItemsSource="{Binding ReferenceSets}" SelectedItem="{Binding CurrentSet}" IsVisible="{Binding IsReferences}" AutomationProperties.Name="{l:T findResults.earlierResults}" ToolTip.Tip="{l:T findResults.earlierResults}" />
      <ComboBox MinWidth="90" ItemsSource="{x:Static vm:FindResultsViewModel.GroupByOptions}" SelectedItem="{Binding GroupBy}" IsVisible="{Binding IsReferences}" AutomationProperties.Name="{l:T findResults.groupBy}" ToolTip.Tip="{l:T findResults.groupBy}" />
      <ComboBox MinWidth="110" ItemsSource="{x:Static vm:FindResultsViewModel.KindFilterOptions}" SelectedItem="{Binding KindFilter}" IsVisible="{Binding IsReferences}" AutomationProperties.Name="{l:T findResults.referenceKind}" ToolTip.Tip="{l:T findResults.show}" />
    </controls:ToolbarPanel>
    <TextBlock DockPanel.Dock="Top" Margin="10,2" TextWrapping="Wrap" Text="{Binding Title}" IsVisible="{Binding HasTitle}" />
    <TextBlock DockPanel.Dock="Bottom" Classes="muted" Margin="10,2" TextWrapping="Wrap" Text="{Binding Summary}" AutomationProperties.LiveSetting="Polite" />
    <Grid DockPanel.Dock="Top" ColumnDefinitions="3*,*,44,36" Margin="8,2,8,0">
      <TextBlock Classes="muted" Text="{l:T findResults.code}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Classes="muted" Text="{l:T findResults.file}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
      <TextBlock Grid.Column="2" Classes="muted" Text="{l:T findResults.line}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="3" Classes="muted" Text="{l:T findResults.col}" TextTrimming="CharacterEllipsis" />
    </Grid>
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Background="Transparent" AutomationProperties.Name="{l:T findResults.findResults}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:FindResultRow">
          <Setter Property="Padding" Value="4,1" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FindResultRow">
          <Grid ColumnDefinitions="3*,*,44,36" Opacity="{Binding IsReplaced, Converter={x:Static vm:FindResultsStyles.ReplacedOpacity}}">
            <controls:HighlightedText Source="{Binding Code}" Highlights="{Binding Highlights}" Margin="{Binding IsHeader, Converter={x:Static vm:FindResultsStyles.Indent}}"
                                      FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12"
                                      FontWeight="{Binding IsHeader, Converter={x:Static vm:FindResultsStyles.Weight}}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
            <TextBlock Grid.Column="2" Text="{Binding LineLabel}" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="3" Text="{Binding ColumnLabel}" FontSize="12" TextTrimming="CharacterEllipsis" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
