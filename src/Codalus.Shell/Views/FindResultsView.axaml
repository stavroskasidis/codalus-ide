<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codalus.Shell.Controls"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.FindResultsView"
             x:DataType="vm:FindResultsViewModel">
  <DockPanel>
    <controls:ToolbarPanel DockPanel.Dock="Top">
      <TextBox x:Name="QueryBox" Text="{Binding Query}" PlaceholderText="{l:T findResults.findInFiles}" AutomationProperties.Name="{l:T findResults.findInFiles}" />
      <ToggleButton Classes="toolbar" Content="{l:T findResults.aa}" IsChecked="{Binding MatchCase}" ToolTip.Tip="{l:T findResults.matchCase}" AutomationProperties.Name="{l:T findResults.matchCase}" />
      <ToggleButton Classes="toolbar" Content="{l:T findResults.ab}" IsChecked="{Binding WholeWord}" ToolTip.Tip="{l:T findResults.matchWholeWord}" AutomationProperties.Name="{l:T findResults.matchWholeWord}" />
      <ToggleButton Classes="toolbar" Content=".*" IsChecked="{Binding UseRegex}" ToolTip.Tip="{l:T findResults.useRegularExpressions}" AutomationProperties.Name="{l:T findResults.useRegularExpressions}" />
      <Button Content="{l:T findResults.findAll}" Command="{Binding SearchCommand}" AutomationProperties.Name="{l:T findResults.findAll2}" />
      <Button Content="{l:T findResults.stop}" Command="{Binding CancelCommand}" IsVisible="{Binding IsSearching}" AutomationProperties.Name="{l:T findResults.stopSearching}" />
    </controls:ToolbarPanel>
    <TextBox DockPanel.Dock="Top" Text="{Binding Include}" PlaceholderText="{l:T findResults.filesEGCs}" AutomationProperties.Name="{l:T findResults.fileTypes}" Margin="4,0,4,4" />
    <controls:ToolbarPanel DockPanel.Dock="Top" IsVisible="{Binding IsReferences}">
      <ComboBox MinWidth="200" ItemsSource="{Binding ReferenceSets}" SelectedItem="{Binding CurrentSet}" AutomationProperties.Name="{l:T findResults.earlierResults}" ToolTip.Tip="{l:T findResults.earlierResults}" />
      <ComboBox MinWidth="90" ItemsSource="{x:Static vm:FindResultsViewModel.GroupByOptions}" SelectedItem="{Binding GroupBy}" AutomationProperties.Name="{l:T findResults.groupBy}" ToolTip.Tip="{l:T findResults.groupBy}" />
      <ComboBox MinWidth="110" ItemsSource="{x:Static vm:FindResultsViewModel.KindFilterOptions}" SelectedItem="{Binding KindFilter}" AutomationProperties.Name="{l:T findResults.referenceKind}" ToolTip.Tip="{l:T findResults.show}" />
    </controls:ToolbarPanel>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="10,2" TextWrapping="Wrap" Text="{Binding Summary}" AutomationProperties.LiveSetting="Polite" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T findResults.findResults}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:FindResultRow">
          <Setter Property="Padding" Value="4,1" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:FindResultRow">
          <TextBlock Text="{Binding Display}" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12"
                     FontWeight="{Binding IsHeader, Converter={x:Static vm:FindResultsStyles.Weight}}" TextTrimming="CharacterEllipsis" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
