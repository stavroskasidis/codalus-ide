<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codalus.Shell.Controls"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.ExceptionSettingsView"
             x:DataType="vm:ExceptionSettingsViewModel">
  <DockPanel>
    <controls:ToolbarPanel DockPanel.Dock="Top" Spacing="4">
      <TextBox x:Name="Search" Text="{Binding Filter}" PlaceholderText="{l:T exceptionSettings.searchExceptionTypes}" AutomationProperties.Name="{l:T exceptionSettings.searchExceptionTypes}" />
      <Button x:Name="CheckAll" Content="{l:T exceptionSettings.breakOnAll}" ToolTip.Tip="{l:T exceptionSettings.breakWhenAnyExceptionIsThrown}" AutomationProperties.Name="{l:T exceptionSettings.breakOnAllExceptions}" />
      <Button x:Name="UncheckAll" Content="{l:T exceptionSettings.breakOnNone}" ToolTip.Tip="{l:T exceptionSettings.breakOnlyOnUserUnhandledExceptions}" AutomationProperties.Name="{l:T exceptionSettings.breakOnNoThrownExceptions}" />
      <Button x:Name="Reset" Content="{l:T exceptionSettings.restoreDefaults}" AutomationProperties.Name="{l:T exceptionSettings.restoreTheDefaultExceptionSettings}" />
    </controls:ToolbarPanel>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="10,2,10,4" TextWrapping="Wrap"
               Text="{l:T exceptionSettings.checkedTypesBreakWhenTheyAre}" />
    <CheckBox DockPanel.Dock="Top" Margin="10,2" IsChecked="{Binding BreakOnOthers}" Content="{l:T exceptionSettings.allOtherExceptionTypesNotIn}" AutomationProperties.Name="{l:T exceptionSettings.breakOnAllOtherExceptionTypes}" />
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="6,4">
      <TextBox x:Name="NewType" Text="{Binding NewType}" PlaceholderText="{l:T exceptionSettings.addATypeByItsFull}" AutomationProperties.Name="{l:T exceptionSettings.newExceptionType}" />
      <Button x:Name="Add" Grid.Column="1" Margin="6,0,0,0" Content="{l:T exceptionSettings.add}" AutomationProperties.Name="{l:T exceptionSettings.addExceptionType}" />
    </Grid>
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T exceptionSettings.exceptionTypes}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ExceptionTypeRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ExceptionTypeRow">
          <Grid ColumnDefinitions="*,220">
            <CheckBox IsChecked="{Binding BreakWhenThrown}" Content="{Binding Type}" AutomationProperties.Name="{Binding Type}" />
            <TextBox Grid.Column="1" Text="{Binding Condition, UpdateSourceTrigger=LostFocus}" PlaceholderText="{l:T exceptionSettings.allModules}" MinHeight="22" Padding="4,1"
                     ToolTip.Tip="{l:T exceptionSettings.breakOnlyWhenThrownInThese}"
                     AutomationProperties.Name="{Binding Type, StringFormat=Module condition for {0}}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
