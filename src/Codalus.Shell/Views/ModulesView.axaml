<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.ModulesView"
             x:DataType="vm:ModulesViewModel">
  <DockPanel>
    <TextBox x:Name="Search" DockPanel.Dock="Top" Margin="6,4" Text="{Binding Filter}" PlaceholderText="{l:T modules.searchModules}" AutomationProperties.Name="{l:T modules.searchModules}" />
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{l:T modules.modulesAppearHereWhileDebugging}" IsVisible="{Binding IsEmpty}" />
    <!--
      The table fills the pane; below its minimum width the columns keep their widths and scroll sideways together
      (M34g on M43: at 280 px the symbol status, a desktop-CLR module's reason among them, was past the pane's edge).
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <DockPanel MinWidth="720" Width="{Binding $parent[ScrollViewer].Bounds.Width}">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="40,240,200,70,*" Margin="8,2" IsVisible="{Binding !IsEmpty}">
          <TextBlock Text="#" Classes="muted" />
          <TextBlock Grid.Column="1" Text="{l:T modules.name}" Classes="muted" />
          <TextBlock Grid.Column="2" Text="{l:T modules.symbolStatus}" Classes="muted" />
          <TextBlock Grid.Column="3" Text="{l:T modules.optimized}" Classes="muted" />
          <TextBlock Grid.Column="4" Text="{l:T modules.path}" Classes="muted" />
        </Grid>
        <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T modules.modules}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="vm:ModuleRow">
              <Setter Property="Padding" Value="2" />
              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ModuleRow">
              <Grid ColumnDefinitions="40,240,200,70,*">
                <TextBlock Text="{Binding Order}" Classes="muted" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                <TextBlock Grid.Column="2" Text="{Binding SymbolStatus}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SymbolStatus}" />
                <TextBlock Grid.Column="3" Text="{Binding Optimized}" />
                <TextBlock Grid.Column="4" Text="{Binding Path}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
