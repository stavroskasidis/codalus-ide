<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.SolutionExplorerView"
             x:DataType="vm:SolutionExplorerViewModel">
  <DockPanel>
  <!-- The toolbar and search box of a classic IDE's Solution Explorer (M29). Each icon in its family's color (M34h): Home
       navigates (blue), Sync with Active Document is a refresh (green), Track Active Item (M50) keeps it in step (blue), Collapse All and Switch Views act on the solution's
       tree (purple), Show All Files shows the folder's files (tan), Properties the Properties window's grid (blue). -->
  <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasSolution}">
    <controls:ToolbarPanel Spacing="1">
      <Button Classes="toolbar" Command="{Binding HomeCommand}" ToolTip.Tip="{l:T solutionExplorer.home}" AutomationProperties.Name="{l:T solutionExplorer.home}">
        <controls:Icon Kind="home" />
      </Button>
      <Button Classes="toolbar" Command="{Binding SyncCommand}" ToolTip.Tip="{l:T solutionExplorer.syncWithActiveDocument}" AutomationProperties.Name="{l:T solutionExplorer.syncWithActiveDocument}">
        <controls:Icon Kind="link" Classes="accent-green" />
      </Button>
      <ToggleButton Classes="toolbar" IsChecked="{Binding TrackActiveItem}" ToolTip.Tip="{l:T solutionExplorer.trackActiveItem}" AutomationProperties.Name="{l:T solutionExplorer.trackActiveItem}">
        <controls:Icon Kind="sync" />
      </ToggleButton>
      <Button Classes="toolbar" Command="{Binding CollapseAllCommand}" ToolTip.Tip="{l:T solutionExplorer.collapseAll}" AutomationProperties.Name="{l:T solutionExplorer.collapseAll}">
        <controls:Icon Kind="collapse-all" Classes="accent-purple" />
      </Button>
      <ToggleButton Classes="toolbar" IsChecked="{Binding ShowAllFiles}" ToolTip.Tip="{l:T solutionExplorer.showAllFiles}" AutomationProperties.Name="{l:T solutionExplorer.showAllFiles}" IsVisible="{Binding !IsFolderView}">
        <controls:Icon Kind="files" Classes="accent-folder" />
      </ToggleButton>
      <Button Classes="toolbar" Command="{Binding SwitchViewsCommand}" IsVisible="{Binding CanSwitchViews}" ToolTip.Tip="{l:T solutionExplorer.switchViewsFolderViewSolutionView}" AutomationProperties.Name="{l:T solutionExplorer.switchViews}">
        <controls:Icon Kind="layout" Classes="accent-purple" />
      </Button>
      <Button Classes="toolbar" Command="{Binding PropertiesCommand}" ToolTip.Tip="{l:T solutionExplorer.propertiesAltEnter}" AutomationProperties.Name="{l:T solutionExplorer.properties}">
        <controls:Icon Kind="properties" />
      </Button>
    </controls:ToolbarPanel>
    <TextBox x:Name="SearchBox" Text="{Binding Filter}" Margin="4,0,4,4" PlaceholderText="{l:T solutionExplorer.searchSolutionExplorerCtrl}"
             AutomationProperties.Name="{l:T solutionExplorer.searchSolutionExplorer}" />
  </StackPanel>
  <Grid>
    <StackPanel Margin="{DynamicResource Shell.Padding.EmptyState}" Spacing="10" IsVisible="{Binding !HasSolution}">
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T solutionExplorer.noSolutionIsOpen}" />
      <Button Classes="iconText" controls:ButtonIcon.Kind="folder-open" Content="{l:T solutionExplorer.openSolution}" HorizontalAlignment="Left" Command="{Binding OpenSolutionCommand}" />
    </StackPanel>
    <ListBox x:Name="List"
             ItemsSource="{Binding Rows}"
             SelectedItem="{Binding Selected}"
             IsVisible="{Binding HasSolution}"
             Background="Transparent"
             DragDrop.AllowDrop="True"
             AutomationProperties.Name="{l:T solutionExplorer.solutionExplorer}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ExplorerRowViewModel">
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.TreeRow}" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
        <Style Selector="ListBoxItem.dropTarget">
          <Setter Property="BorderBrush" Value="{DynamicResource Shell.Focus}" />
          <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock.linked">
          <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style Selector="TextBlock.startup">
          <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.unloaded">
          <Setter Property="Opacity" Value="0.6" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ExplorerRowViewModel">
          <!-- The name trims with an ellipsis in a narrow pane (the root's was cut off, M29); the tooltip has the path (M34d). -->
          <!-- The selected row's pill at its left edge, before the indentation (D46: Classic's; transparent in the families). -->
          <Panel>
          <Border Classes="selectionPill" IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
          <DockPanel Margin="{Binding Indent}" Background="Transparent" ToolTip.Tip="{Binding ToolTip}">
            <Border DockPanel.Dock="Left" Classes="chevron" Width="16" Height="18" Background="Transparent">
              <controls:Icon Kind="{Binding Chevron}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <controls:Icon DockPanel.Dock="Left" Margin="4,0" Kind="{Binding Icon}" Classes.warning="{Binding IsWarning}" VerticalAlignment="Center" />
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Classes.linked="{Binding IsLinked}" Classes.startup="{Binding IsStartup}" Classes.unloaded="{Binding IsDimmed}">
              <Run Text="{Binding Name}" />
              <Run Text="{Binding Detail}" FontSize="{DynamicResource Shell.FontSize.Small}" FontWeight="Normal" Classes="muted" />
            </TextBlock>
          </DockPanel>
          </Panel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
  </DockPanel>
</UserControl>
