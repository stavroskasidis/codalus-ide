<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.LivePropertiesView"
             x:DataType="vm:LivePropertiesViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Margin="8,4,8,0" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
    <controls:ToolbarPanel DockPanel.Dock="Top" Margin="6,4">
      <TextBox x:Name="FilterBox" Text="{Binding Filter}" PlaceholderText="{l:T liveProperties.searchProperties}" MinWidth="80" AutomationProperties.Name="{l:T liveProperties.searchProperties}" />
    </controls:ToolbarPanel>
    <!-- Proportional columns (M34g): the fixed 180 and 110 px left the value no room at the tool window's 280 px. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,3*,1.4*" Margin="8,2">
      <TextBlock Text="{l:T liveProperties.property}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{l:T liveProperties.property}" />
      <TextBlock Grid.Column="1" Text="{l:T liveProperties.value}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{l:T liveProperties.value}" />
      <TextBlock Grid.Column="2" Text="{l:T liveProperties.source}" Classes="muted" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{l:T liveProperties.source}" />
    </Grid>
    <!-- Why each style applies to the element or doesn't (M64b): its selector or trigger, the part that fails, its setters. -->
    <Expander x:Name="StylesExpander" DockPanel.Dock="Bottom" Header="{l:T liveProperties.styles}" IsExpanded="True" Margin="4,2" Padding="2"
              HorizontalAlignment="Stretch" AutomationProperties.Name="{l:T liveProperties.styles}">
      <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="{Binding StylesMessage}" IsVisible="{Binding HasStylesMessage}" Classes="muted" TextWrapping="Wrap" Margin="4,2" />
          <ItemsControl x:Name="StylesList" ItemsSource="{Binding Styles}" AutomationProperties.Name="{l:T liveProperties.styles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:LiveStyleRow">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="2,3" AutomationProperties.Name="{Binding AccessibleName}">
                  <TextBlock Text="{Binding Glyph}" ToolTip.Tip="{Binding StateText}" Margin="2,0,6,0" VerticalAlignment="Top" />
                  <DockPanel Grid.Column="1">
                    <Button DockPanel.Dock="Right" Classes="link" Content="{Binding Location}" Command="{Binding GoToCommand}" IsVisible="{Binding HasLocation}"
                            ToolTip.Tip="{l:T liveProperties.goToStyle}" AutomationProperties.Name="{l:T liveProperties.goToStyle}" />
                    <SelectableTextBlock Text="{Binding Selector}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip.Tip="{Binding StateText}" />
                  </DockPanel>
                  <SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Reason}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasReason}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Setters}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasSetters}" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Expander>
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T liveProperties.liveProperties}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:LivePropertyRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LivePropertyRow">
          <Grid ColumnDefinitions="2*,3*,1.4*" RowDefinitions="Auto,Auto" Background="Transparent">
            <Grid.ContextMenu>
              <ContextMenu>
                <!-- M64b: the debugger stops when the property changes in the app. -->
                <MenuItem controls:MenuEntry.Icon="breakpoint" Header="{Binding WatchHeader}" Command="{Binding ToggleWatchCommand}" />
              </ContextMenu>
            </Grid.ContextMenu>
            <DockPanel>
              <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,4,0" Fill="{DynamicResource Shell.Editor.Breakpoint}" IsVisible="{Binding IsWatched}"
                       ToolTip.Tip="{l:T liveProperties.breakWhenValueChanges}" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="{Binding NameWeight}"
                         ToolTip.Tip="{Binding ToolTip}" />
            </DockPanel>
            <TextBox Grid.Column="1" Classes="cell" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}"
                     VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
            <TextBlock Grid.Column="2" Text="{Binding Source}" Classes="muted" VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Source}" />
            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
