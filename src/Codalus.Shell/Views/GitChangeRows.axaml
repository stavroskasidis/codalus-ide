<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Codalus.Shell.ViewModels"
                    xmlns:controls="using:Codalus.Shell.Controls">
  <!-- A read-only row of a flattened tree of changed files (M57): a commit's changes and Compare, which show Git Changes'
       rows without its hover buttons. Its level's indentation, a folder's chevron (TreeRows toggles it), the icon, the name,
       a rename's old name, and the file's status letter. -->
  <DataTemplate x:Key="ReadOnlyChangeRow" x:DataType="vm:GitChangeRow">
    <Grid ColumnDefinitions="Auto,Auto,*,18" Margin="{Binding Indent}" Background="Transparent" ToolTip.Tip="{Binding Tip}">
      <Border Classes="chevron" Width="16" Height="18" Background="Transparent" VerticalAlignment="Center">
        <controls:Icon Kind="{Binding Chevron}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <controls:Icon Grid.Column="1" Kind="{Binding Icon}" Margin="2,0,6,0" VerticalAlignment="Center" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding OldName}" IsVisible="{Binding HasOldName}" Classes="muted" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Grid.Column="3" Text="{Binding Letter}" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip.Tip="{Binding Description}" />
    </Grid>
  </DataTemplate>
</ResourceDictionary>
