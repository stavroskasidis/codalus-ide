<local:LoadingView xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:Codalus.Shell.ViewModels"
                   xmlns:local="using:Codalus.Shell.Views"
                   x:Class="Codalus.Shell.Views.BatchBuildView"
                   x:DataType="vm:BatchBuildViewModel">
  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
      <TextBlock Classes="heading" Text="{l:T batchBuild.batchBuild}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T batchBuild.checkTheProjectConfigurationsToBuild}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button x:Name="BuildButton" Content="{l:T batchBuild.build}" Command="{Binding BuildCommand}" AutomationProperties.Name="{l:T batchBuild.buildCheckedProjectConfigurations}" />
        <Button Content="{l:T batchBuild.rebuild}" Command="{Binding RebuildCommand}" AutomationProperties.Name="{l:T batchBuild.rebuildCheckedProjectConfigurations}" />
        <Button Content="{l:T batchBuild.clean}" Command="{Binding CleanCommand}" AutomationProperties.Name="{l:T batchBuild.cleanCheckedProjectConfigurations}" />
        <Button Content="{l:T batchBuild.selectAll}" Command="{Binding SelectAllCommand}" />
        <Button Content="{l:T batchBuild.deselectAll}" Command="{Binding DeselectAllCommand}" />
        <ProgressBar IsIndeterminate="True" Width="80" Height="2" MinHeight="2" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Status}" />
      </StackPanel>
    </StackPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="32,240,140,120,*" Margin="4,0,0,4">
      <TextBlock Grid.Column="1" Classes="muted" Text="{l:T batchBuild.project}" />
      <TextBlock Grid.Column="2" Classes="muted" Text="{l:T batchBuild.configuration}" />
      <TextBlock Grid.Column="3" Classes="muted" Text="{l:T batchBuild.platform}" />
      <TextBlock Grid.Column="4" Classes="muted" Text="{l:T batchBuild.result}" />
    </Grid>
    <ListBox ItemsSource="{Binding Rows}" AutomationProperties.Name="{l:T batchBuild.projectConfigurations}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:BatchBuildRowViewModel">
          <Grid ColumnDefinitions="32,240,140,120,*" AutomationProperties.Name="{Binding AccessibleName}">
            <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding AccessibleName}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Configuration}" />
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding Platform}" />
            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding Status}" Classes.muted="{Binding !Failed}"
                       Foreground="{DynamicResource Shell.Error.Foreground}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</local:LoadingView>
