<local:LoadingView xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:Codalus.Shell.ViewModels"
                   xmlns:local="using:Codalus.Shell.Views"
                   x:Class="Codalus.Shell.Views.ReferenceManagerView"
                   x:DataType="vm:ReferenceManagerViewModel">
  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock Classes="heading" Text="{Binding Title}" />
      <TextBlock Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
    <TabControl>
      <TabItem Header="{l:T referenceManager.projects}">
        <DockPanel Margin="0,8,0,0">
          <TextBox DockPanel.Dock="Top" Text="{Binding Filter}" PlaceholderText="{l:T referenceManager.filterProjects}" Margin="0,0,0,6" AutomationProperties.Name="{l:T referenceManager.filterProjects}" />
          <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{l:T referenceManager.apply}" Command="{Binding ApplyCommand}" AutomationProperties.Name="{l:T referenceManager.applyProjectReferences}" />
          <ListBox ItemsSource="{Binding VisibleProjects}" AutomationProperties.Name="{l:T referenceManager.projects}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ReferenceChoiceViewModel">
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding Name}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
      <TabItem Header="{l:T referenceManager.assembliesAndAnalyzers}">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
            <Button Content="{l:T referenceManager.addAssembly}" Command="{Binding AddAssemblyCommand}" />
            <Button Content="{l:T referenceManager.addAnalyzer}" Command="{Binding AddAnalyzerCommand}" />
            <Button Content="{l:T referenceManager.remove}" Command="{Binding RemoveFileCommand}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" AutomationProperties.Name="{l:T referenceManager.assemblyAndAnalyzerReferences}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FileReferenceRow">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="muted" Width="70" Text="{Binding Kind}" />
                  <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</local:LoadingView>
