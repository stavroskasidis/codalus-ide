<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codalus.Shell.Controls"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.ProjectPropertiesView"
             x:DataType="vm:ProjectPropertiesViewModel">
  <UserControl.Styles>
    <Style Selector="Border.property">
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.property.set">
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Modified}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Shell.Border}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Classes="heading" VerticalAlignment="Center" Text="{Binding Title}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsPropertiesPage}" Margin="0,0,12,0">
          <TextBlock VerticalAlignment="Center" Text="{l:T projectProperties.configuration}" />
          <ComboBox x:Name="ScopePicker" MinWidth="170" ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" AutomationProperties.Name="{l:T projectProperties.configuration2}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="link" Content="{l:T projectProperties.editProjectFile}" Command="{Binding OpenProjectFileCommand}" />
      </Grid>
    </Border>
    <Grid ColumnDefinitions="180,*">
      <ListBox x:Name="PageList" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent" Margin="0,8,0,0" AutomationProperties.Name="{l:T projectProperties.propertyPages}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PropertyPage">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Properties. -->
      <ScrollViewer Grid.Column="1" IsVisible="{Binding IsPropertiesPage}">
        <StackPanel Margin="16,8,16,16" Spacing="4">
          <TextBlock Foreground="{DynamicResource Shell.Error.Foreground}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
          <ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding IsLoading}" />
          <ItemsControl x:Name="Sections" ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PropertySectionViewModel">
                <StackPanel Spacing="4" Margin="0,8,0,4">
                  <TextBlock Classes="subheading" Text="{Binding Title}" />
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PropertyItemViewModel">
                        <Border Classes="property" Classes.set="{Binding IsSetInProject}">
                          <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                              <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" Text="{Binding Name}" />
                            </StackPanel>
                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
                            <TextBox Width="460" HorizontalAlignment="Left" IsVisible="{Binding IsText}" IsEnabled="{Binding CanEdit}"
                                     Text="{Binding Text, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding Label}" />
                            <CheckBox IsVisible="{Binding IsBool}" IsEnabled="{Binding CanEdit}" IsChecked="{Binding BoolValue}" Content="{Binding Label}" AutomationProperties.Name="{Binding Label}" />
                            <ComboBox MinWidth="260" IsVisible="{Binding IsChoice}" IsEnabled="{Binding CanEdit}" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                                      PlaceholderText="{l:T projectProperties.default}" AutomationProperties.Name="{Binding Label}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PropertyOption">
                                  <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding EvaluatedNote}" IsVisible="{Binding HasEvaluatedNote}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Classes="link" FontSize="{DynamicResource Shell.FontSize.Small}" Content="{Binding Origin}" Command="{Binding OpenDefinitionCommand}" ToolTip.Tip="{l:T projectProperties.openTheFileThatSetsIt}" />
                              <Button Classes="link" FontSize="{DynamicResource Shell.FontSize.Small}" Content="{l:T projectProperties.reset}" Command="{Binding ResetCommand}" IsVisible="{Binding IsSetInProject}"
                                      ToolTip.Tip="{l:T projectProperties.removeItFromTheProjectFile}" AutomationProperties.Name="{Binding Label, StringFormat='Reset {0}'}" />
                            </StackPanel>
                            <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" FontStyle="Italic" Text="{Binding ScopeNote}" IsVisible="{Binding !CanEdit}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Build Events (ADR 0034). -->
      <Panel Grid.Column="1" IsVisible="{Binding IsBuildEventsPage}">
        <ScrollViewer DataContext="{Binding BuildEvents}" x:DataType="vm:BuildEventsViewModel">
          <StackPanel Margin="16,8,16,16" Spacing="6">
            <TextBlock Classes="subheading" Text="{l:T projectProperties.buildEvents}" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T projectProperties.commandsThatRunBeforeAndAfter}" />
            <TextBlock Foreground="{DynamicResource Shell.Error.Foreground}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
            <TextBlock FontWeight="SemiBold" Text="{l:T projectProperties.preBuildEventCommandLine}" Margin="0,6,0,0" />
            <TextBox x:Name="PreBuildBox" Text="{Binding PreBuild}" AcceptsReturn="True" MinHeight="80" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" AutomationProperties.Name="{l:T projectProperties.preBuildEventCommandLine}" />
            <TextBlock FontWeight="SemiBold" Text="{l:T projectProperties.postBuildEventCommandLine}" Margin="0,6,0,0" />
            <TextBox Text="{Binding PostBuild}" AcceptsReturn="True" MinHeight="80" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" AutomationProperties.Name="{l:T projectProperties.postBuildEventCommandLine}" />
            <TextBlock Text="{l:T projectProperties.runThePostBuildEvent}" Margin="0,6,0,0" />
            <ComboBox MinWidth="320" ItemsSource="{x:Static vm:BuildEventsViewModel.RunOptions}" SelectedItem="{Binding RunPostBuildEvent}" AutomationProperties.Name="{l:T projectProperties.runThePostBuildEvent}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RunPostBuildOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" TextWrapping="Wrap" Text="{x:Static vm:BuildEventsViewModel.Macros}" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
              <Button Content="{l:T projectProperties.save}" Command="{Binding SaveCommand}" AutomationProperties.Name="{l:T projectProperties.saveBuildEvents}" />
              <Button Content="{l:T projectProperties.revert}" Command="{Binding RevertCommand}" />
              <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Status}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Panel>

      <!-- Debug: launch profiles. -->
      <Panel Grid.Column="1" IsVisible="{Binding IsLaunchProfilesPage}">
      <DockPanel Margin="16,8" DataContext="{Binding LaunchProfiles}" x:DataType="vm:LaunchProfilesViewModel">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
          <TextBlock Classes="subheading" Text="{l:T projectProperties.launchProfiles}" />
          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T projectProperties.howF5AndCtrlF5Start}" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" Text="{Binding Location}" />
            <Button Grid.Column="1" Classes="link" Content="{l:T projectProperties.openLaunchsettingsJson}" Command="{Binding OpenFileCommand}" />
          </Grid>
          <TextBlock Foreground="{DynamicResource Shell.Error.Foreground}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
          <Button Content="{l:T projectProperties.save}" Command="{Binding SaveCommand}" AutomationProperties.Name="{l:T projectProperties.saveLaunchProfiles}" />
          <Button Content="{l:T projectProperties.revert}" Command="{Binding RevertCommand}" />
        </StackPanel>
        <Grid ColumnDefinitions="220,*">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
              <Button Classes="iconText compact" controls:ButtonIcon.Kind="add" Content="{l:T projectProperties.new}" Command="{Binding AddCommand}" />
              <Button Classes="icon compact" controls:ButtonIcon.Kind="rename" Command="{Binding RenameCommand}" ToolTip.Tip="{l:T projectProperties.rename}" AutomationProperties.Name="{l:T projectProperties.rename}" />
              <Button Classes="icon compact" controls:ButtonIcon.Kind="trash" Command="{Binding RemoveCommand}" ToolTip.Tip="{l:T projectProperties.delete}" AutomationProperties.Name="{l:T projectProperties.delete}" />
            </StackPanel>
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{l:T projectProperties.launchProfiles}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LaunchProfileViewModel">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <Panel Grid.Column="1" IsVisible="{Binding HasSelection}">
            <ScrollViewer>
              <StackPanel Margin="16,0,0,0" Spacing="6" DataContext="{Binding Selected}" x:DataType="vm:LaunchProfileViewModel">
                <TextBlock Text="{l:T projectProperties.launch}" />
                <ComboBox MinWidth="200" ItemsSource="{x:Static vm:LaunchProfilesViewModel.CommandNames}" SelectedItem="{Binding CommandName}" AutomationProperties.Name="{l:T projectProperties.launch}" />
                <TextBlock Text="{l:T projectProperties.executable}" IsVisible="{Binding IsExecutable}" />
                <TextBox Text="{Binding ExecutablePath}" IsVisible="{Binding IsExecutable}" AutomationProperties.Name="{l:T projectProperties.executable}" />
                <TextBlock Text="{l:T projectProperties.commandLineArguments}" />
                <TextBox Text="{Binding CommandLineArgs}" AutomationProperties.Name="{l:T projectProperties.commandLineArguments}" />
                <TextBlock Text="{l:T projectProperties.workingDirectory}" />
                <TextBox Text="{Binding WorkingDirectory}" AutomationProperties.Name="{l:T projectProperties.workingDirectory}" />
                <TextBlock Text="{l:T projectProperties.environmentVariablesNameValueOnePer}" />
                <TextBox Text="{Binding EnvironmentVariables}" AcceptsReturn="True" MinHeight="70" AutomationProperties.Name="{l:T projectProperties.environmentVariables}" />
                <TextBlock Text="{l:T projectProperties.appUrlWebProjects}" />
                <TextBox Text="{Binding ApplicationUrl}" PlaceholderText="{l:T projectProperties.httpsLocalhost5001HttpLocalhost5000}" AutomationProperties.Name="{l:T projectProperties.appUrl}" />
                <CheckBox Content="{l:T projectProperties.launchBrowser}" IsChecked="{Binding LaunchBrowser}" />
                <TextBlock Text="{l:T projectProperties.urlToOpen}" />
                <TextBox Text="{Binding LaunchUrl}" PlaceholderText="{l:T projectProperties.relativeToTheAppUrlE}" AutomationProperties.Name="{l:T projectProperties.launchUrl}" />
              </StackPanel>
            </ScrollViewer>
          </Panel>
        </Grid>
      </DockPanel>
      </Panel>
    </Grid>
  </DockPanel>
</UserControl>
