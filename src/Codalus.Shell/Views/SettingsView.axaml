<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:views="using:Codalus.Shell.Views"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <UserControl.Styles>
    <!--
      A setting (M34h, docs/design/controls/Options.dc.html): Shell.Row.Hover under the pointer; a modified one is marked
      with the accent at its left edge and a Modified chip.
    -->
    <Style Selector="Border.setting">
      <Setter Property="Padding" Value="14,10,14,10" />
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="MaxWidth" Value="780" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
    </Style>
    <Style Selector="Border.setting:pointerover">
      <Setter Property="Background" Value="{DynamicResource Shell.Row.Hover}" />
    </Style>
    <Style Selector="Border.setting.modified">
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
    </Style>
    <!-- A boolean's description and key line up under its check box's label. -->
    <Style Selector="StackPanel.indented">
      <Setter Property="Margin" Value="26,0,0,0" />
    </Style>
    <!-- The page's header tile behind the category's icon. -->
    <Style Selector="Border.pageTile">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Shell.Status.Info}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Status.Info.Foreground}" />
      <Setter Property="BorderThickness" Value="{DynamicResource Shell.Chip.BorderThickness}" />
    </Style>
    <!-- The color theme's family cards (M45): the chosen one outlined in the accent. -->
    <Style Selector="ToggleButton.themeCard">
      <Setter Property="Width" Value="196" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource Shell.Panel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Shell.CornerRadius.Overlay}" />
    </Style>
    <Style Selector="ToggleButton.themeCard:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Shell.Selection}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Foreground}" />
    </Style>
    <Style Selector="ToggleButton.themeCard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
    </Style>
    <Style Selector="ToggleButton.themeCard:checked TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Foreground}" />
    </Style>
  </UserControl.Styles>

  <!-- Editors by setting type. -->
  <UserControl.DataTemplates>
    <DataTemplate DataType="vm:BoolSettingViewModel">
      <CheckBox IsChecked="{Binding Value}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Heading}">
        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
      </CheckBox>
    </DataTemplate>
    <!-- System Integration (M51): changes the OS, not settings.json; undetermined when it's partly there or another copy's. -->
    <DataTemplate DataType="vm:OsIntegrationSettingViewModel">
      <CheckBox IsChecked="{Binding IsOn}" IsEnabled="{Binding CanToggle}" AutomationProperties.Name="{Binding Heading}">
        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
      </CheckBox>
    </DataTemplate>
    <DataTemplate DataType="vm:EnumSettingViewModel">
      <StackPanel Spacing="4" HorizontalAlignment="Left">
        <ComboBox MinWidth="260" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{Binding Heading}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:EnumOption">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SelectedDescription}" />
      </StackPanel>
    </DataTemplate>
    <!--
      The color theme (M45): the families as cards, each with a picture drawn in its own tokens in the mode chosen, and
      the mode. A plugin's theme comes from its own list.
    -->
    <DataTemplate DataType="vm:ColorThemeSettingViewModel">
      <StackPanel Spacing="8" HorizontalAlignment="Left">
        <ItemsControl ItemsSource="{Binding Families}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{l:T settings.themeFamilies}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ThemeFamilyOption">
              <ToggleButton Classes="themeCard" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}"
                            ToolTip.Tip="{Binding Description}" AutomationProperties.Name="{Binding Title}" AutomationProperties.HelpText="{Binding Description}">
                <StackPanel Spacing="6">
                  <views:ThemePictureView DataContext="{Binding Picture}" HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Classes="muted small" Text="{Binding Description}" TextWrapping="Wrap" />
                </StackPanel>
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SelectedFamily, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{l:T settings.mode}" VerticalAlignment="Center" />
          <ComboBox MinWidth="180" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{l:T settings.themeMode}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ThemeModeOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasPluginThemes}">
          <TextBlock Text="{l:T settings.pluginTheme}" VerticalAlignment="Center" />
          <ComboBox MinWidth="220" ItemsSource="{Binding PluginThemes}" SelectedItem="{Binding SelectedPluginTheme}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="{l:T settings.pluginColorTheme}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:EnumOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <!-- Before the text setting's template, which it derives from: a path's text with the Browse button. -->
    <DataTemplate DataType="vm:PathSettingViewModel">
      <controls:PathBox Width="420"
                        HorizontalAlignment="Left"
                        Text="{Binding Text}"
                        Kind="{Binding Kind}"
                        IsEnabled="{Binding CanEdit}"
                        AutomationProperties.Name="{Binding Heading}" />
    </DataTemplate>
    <DataTemplate DataType="vm:TextSettingViewModel">
      <TextBox Width="420"
               HorizontalAlignment="Left"
               Text="{Binding Text}"
               PlaceholderText="{Binding Watermark}"
               AcceptsReturn="{Binding IsMultiline}"
               IsEnabled="{Binding CanEdit}"
               AutomationProperties.Name="{Binding Heading}" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Shell.Border}">
      <StackPanel Spacing="8">
        <!-- The search, User or Workspace as a segmented control (M34h, the toggle buttons before), and the JSON's link. -->
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBox x:Name="SearchBox"
                   Classes="search"
                   Text="{Binding Search}"
                   PlaceholderText="{l:T settings.searchSettingsModifiedShowsChangedOnes}"
                   AutomationProperties.Name="{l:T settings.searchSettings}" />
          <controls:SegmentedControl Grid.Column="1"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     SelectedIndex="{Binding ScopeIndex}"
                                     IsVisible="{Binding HasWorkspace}"
                                     ToolTip.Tip="{l:T settings.whereChangesAreSaved}"
                                     AutomationProperties.Name="{l:T settings.settingsScope}">
            <controls:SegmentedControlItem Icon="file" Content="{l:T settings.user}" AutomationProperties.Name="{l:T settings.userSettings}" />
            <controls:SegmentedControlItem Icon="solution" Content="{l:T settings.workspace}" AutomationProperties.Name="{l:T settings.workspaceSettings}" />
          </controls:SegmentedControl>
          <Button Grid.Column="2"
                  Classes="link"
                  Margin="14,0,0,0"
                  VerticalAlignment="Center"
                  Content="{l:T settings.editInSettingsJson}"
                  Command="{Binding OpenJsonCommand}" />
        </Grid>
        <!-- A dock, not a horizontal stack: the path gets exactly the width left after the icon and trims there. -->
        <DockPanel>
          <controls:Icon DockPanel.Dock="Left" Kind="file" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center" />
          <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding FileLabel}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileLabel}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Classes="warning" TextWrapping="Wrap" Text="{Binding Diagnostics}" IsVisible="{Binding HasDiagnostics}" />
      </StackPanel>
    </Border>
    <Grid ColumnDefinitions="240,*">
      <!-- The Options tree (M29): groups as a classic IDE arranges them, with their categories. -->
      <TreeView ItemsSource="{Binding Categories}"
                SelectedItem="{Binding SelectedCategory}"
                Background="Transparent"
                Margin="4,8,0,0"
                AutomationProperties.Name="{l:T settings.settingCategories}">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:SettingCategoryViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
            <Setter Property="MinHeight" Value="24" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <!-- Each node with its palette-colored icon and its count (M34h). -->
          <TreeDataTemplate x:DataType="vm:SettingCategoryViewModel" ItemsSource="{Binding Children}">
            <DockPanel>
              <controls:Icon Kind="{Binding Icon}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock DockPanel.Dock="Right" Classes="muted small" Text="{Binding Count}" Margin="8,0,4,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" Classes.group="{Binding IsExpanded}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" />
            </DockPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <ScrollViewer Grid.Column="1" BorderThickness="1,0,0,0">
        <StackPanel Margin="24,14,16,16">
          <!-- The page's header (M34h): the category's icon on a tile, its name, its count and how many are changed. -->
          <DockPanel Margin="0,0,0,10">
            <Border DockPanel.Dock="Left" Classes="pageTile" Margin="0,0,10,0">
              <controls:Icon Kind="{Binding PageIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="heading" Text="{Binding PageTitle}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PageTitle}" />
              <TextBlock Classes="muted small" Text="{Binding PageSummary}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PageSummary}" />
            </StackPanel>
          </DockPanel>
          <TextBlock Classes="muted" Text="{l:T settings.noSettingsFound}" IsVisible="{Binding IsEmpty}" Margin="0,8" />
          <ItemsControl x:Name="Items" ItemsSource="{Binding Items}">
            <!-- All Settings is hundreds of editors: only those in view are made (opening it stalled the UI for a second). -->
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SettingItemViewModel">
                <Border Classes="setting" Classes.modified="{Binding IsModified}">
                  <StackPanel Spacing="4">
                    <!-- The title, a Modified chip and Reset; a boolean is one check box, its label the title (M34h). -->
                    <WrapPanel Orientation="Horizontal">
                      <ContentControl Content="{Binding}" IsVisible="{Binding IsBool}" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock FontWeight="SemiBold" Text="{Binding DisplayTitle}" IsVisible="{Binding !IsBool}" Margin="0,0,8,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                      <Border Classes="chip info" IsVisible="{Binding IsModified}" Margin="0,0,8,0">
                        <TextBlock Text="{l:T settings.modified}" />
                      </Border>
                      <Button Classes="link"
                              Content="{l:T settings.reset}"
                              Command="{Binding ResetCommand}"
                              IsVisible="{Binding IsModified}"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="{Binding Title, StringFormat='Reset {0}'}" />
                    </WrapPanel>
                    <StackPanel Spacing="4" Classes.indented="{Binding IsBool}">
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Description}" IsVisible="{Binding HasDescription}" MaxWidth="640" HorizontalAlignment="Left" />
                      <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" FontStyle="Italic" Text="{l:T settings.thisSettingCanOnlyBeChanged}" IsVisible="{Binding IsUserOnlyHere}" />
                      <ContentControl Content="{Binding}" Margin="0,4,0,0" IsVisible="{Binding !IsBool}" />
                      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Status}" IsVisible="{Binding HasStatus}" MaxWidth="640" HorizontalAlignment="Left" />
                      <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
                      <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" Text="{Binding Key}" IsVisible="{Binding IsSetting}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
