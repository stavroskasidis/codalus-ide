<local:LoadingView xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:Codalus.Shell.ViewModels"
                   xmlns:local="using:Codalus.Shell.Views"
                   x:Class="Codalus.Shell.Views.ConfigurationManagerView"
                   x:DataType="vm:ConfigurationManagerViewModel">
  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
      <TextBlock Classes="heading" Text="{l:T configurationManager.configurationManager}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T configurationManager.forEachSolutionConfigurationAndPlatform}" />
      <WrapPanel Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:T configurationManager.solutionConfiguration}" />
        <ComboBox MinWidth="140" ItemsSource="{Binding BuildTypes}" SelectedItem="{Binding BuildType}" Margin="0,0,4,4" AutomationProperties.Name="{l:T configurationManager.solutionConfiguration2}" />
        <Button Content="{l:T configurationManager.new}" Command="{Binding AddBuildTypeCommand}" Margin="0,0,4,4" />
        <Button Content="{l:T configurationManager.remove}" Command="{Binding RemoveBuildTypeCommand}" Margin="0,0,16,4" />
        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="{l:T configurationManager.platform}" />
        <ComboBox MinWidth="120" ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" Margin="0,0,4,4" AutomationProperties.Name="{l:T configurationManager.solutionPlatform}" />
        <Button Content="{l:T configurationManager.new}" Command="{Binding AddPlatformCommand}" Margin="0,0,4,4" />
        <Button Content="{l:T configurationManager.remove}" Command="{Binding RemovePlatformCommand}" Margin="0,0,16,4" />
        <Button Content="{l:T configurationManager.makeActive}" Command="{Binding ActivateCommand}" Margin="0,0,4,4" />
      </WrapPanel>
      <TextBlock Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
    <Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,180,140,70" Margin="8,2">
        <TextBlock Classes="muted" Text="{l:T configurationManager.project}" />
        <TextBlock Grid.Column="1" Classes="muted" Text="{l:T configurationManager.configuration}" />
        <TextBlock Grid.Column="2" Classes="muted" Text="{l:T configurationManager.platform2}" />
        <TextBlock Grid.Column="3" Classes="muted" Text="{l:T configurationManager.build}" />
      </Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" AutomationProperties.Name="{l:T configurationManager.projectConfigurations}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectConfigurationRowViewModel">
            <Grid ColumnDefinitions="*,180,140,70">
              <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
              <ComboBox Grid.Column="1" Margin="0,0,8,0" ItemsSource="{Binding Configurations}" SelectedItem="{Binding Configuration}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} configuration'}" />
              <ComboBox Grid.Column="2" Margin="0,0,8,0" ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} platform'}" />
              <CheckBox Grid.Column="3" IsChecked="{Binding Build}" AutomationProperties.Name="{Binding Name, StringFormat='Build {0}'}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>
  </DockPanel>
</local:LoadingView>
