<local:LoadingView xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:vm="using:Codalus.Shell.ViewModels"
                   xmlns:local="using:Codalus.Shell.Views"
                   xmlns:controls="using:Codalus.Shell.Controls"
                   x:Class="Codalus.Shell.Views.ConfigurationManagerView"
                   x:DataType="vm:ConfigurationManagerViewModel">
  <DockPanel Margin="16,12">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,10">
      <TextBlock Classes="heading" Text="{l:T configurationManager.configurationManager}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T configurationManager.forEachSolutionConfigurationAndPlatform}" />
      <!--
        The control set (M34h, docs/design/controls/ToolWindowToolbars.dc.html): New… and Remove as icon buttons attached
        to the combo box they act on, a chip for the active pair, Make Active with an icon (disabled while the pair is
        the active one).
      -->
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0,0,0">
          <Border Classes="chip success" IsVisible="{Binding IsActivePair}" ToolTip.Tip="{l:T configurationManager.theSolutionBuildsThisConfigurationAnd}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <controls:Icon Kind="check" VerticalAlignment="Center" />
              <TextBlock Text="{l:T configurationManager.active}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button Classes="iconText" controls:ButtonIcon.Kind="check-circle" Content="{l:T configurationManager.makeActive}" Command="{Binding ActivateCommand}" />
        </StackPanel>
        <WrapPanel Orientation="Horizontal">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,4">
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:T configurationManager.solutionConfiguration2}" />
            <Border Classes="attached">
              <StackPanel Orientation="Horizontal">
                <ComboBox Width="150" ItemsSource="{Binding BuildTypes}" SelectedItem="{Binding BuildType}" AutomationProperties.Name="{l:T configurationManager.solutionConfiguration2}" />
                <Button Classes="icon" controls:ButtonIcon.Kind="add" Command="{Binding AddBuildTypeCommand}" ToolTip.Tip="{l:T configurationManager.new}" AutomationProperties.Name="{l:T configurationManager.newSolutionConfiguration}" />
                <Button Classes="icon" controls:ButtonIcon.Kind="trash" Command="{Binding RemoveBuildTypeCommand}" ToolTip.Tip="{l:T configurationManager.remove}" AutomationProperties.Name="{Binding RemoveBuildTypeName}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,4">
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{l:T configurationManager.platform2}" />
            <Border Classes="attached">
              <StackPanel Orientation="Horizontal">
                <ComboBox Width="130" ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" AutomationProperties.Name="{l:T configurationManager.solutionPlatform}" />
                <Button Classes="icon" controls:ButtonIcon.Kind="add" Command="{Binding AddPlatformCommand}" ToolTip.Tip="{l:T configurationManager.new}" AutomationProperties.Name="{l:T configurationManager.newSolutionPlatform}" />
                <Button Classes="icon" controls:ButtonIcon.Kind="trash" Command="{Binding RemovePlatformCommand}" ToolTip.Tip="{l:T configurationManager.remove}" AutomationProperties.Name="{Binding RemovePlatformName}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </WrapPanel>
      </DockPanel>
      <TextBlock Classes="error" TextWrapping="Wrap" Text="{Binding Error}" IsVisible="{Binding HasError}" />
    </StackPanel>
    <!-- The projects' grid: a bordered table, compact combo boxes in its rows (M34h). -->
    <Border BorderBrush="{DynamicResource Shell.Grid.Rule}" BorderThickness="1" CornerRadius="{DynamicResource Shell.Control.CornerRadius}" ClipToBounds="True">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="gridHeader" Padding="12,0">
          <Grid ColumnDefinitions="*,180,150,60">
            <TextBlock Text="{l:T configurationManager.project}" />
            <TextBlock Grid.Column="1" Text="{l:T configurationManager.configuration}" />
            <TextBlock Grid.Column="2" Text="{l:T configurationManager.platform2}" />
            <TextBlock Grid.Column="3" Text="{l:T configurationManager.build}" />
          </Grid>
        </Border>
        <ListBox ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T configurationManager.projectConfigurations}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="12,3" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProjectConfigurationRowViewModel">
              <Grid ColumnDefinitions="*,180,150,60">
                <!-- A dock, not a horizontal stack, so a long name trims in its column. -->
                <DockPanel VerticalAlignment="Center" Margin="0,0,8,0">
                  <controls:Icon DockPanel.Dock="Left" Kind="project" Margin="0,0,6,0" VerticalAlignment="Center" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                </DockPanel>
                <ComboBox Grid.Column="1" Margin="0,0,8,0" HorizontalAlignment="Stretch" MinHeight="{DynamicResource Shell.Size.Input}" Height="{DynamicResource Shell.Size.Input}" Padding="6,0"
                          ItemsSource="{Binding Configurations}" SelectedItem="{Binding Configuration}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} configuration'}" />
                <ComboBox Grid.Column="2" Margin="0,0,8,0" HorizontalAlignment="Stretch" MinHeight="{DynamicResource Shell.Size.Input}" Height="{DynamicResource Shell.Size.Input}" Padding="6,0"
                          ItemsSource="{Binding Platforms}" SelectedItem="{Binding Platform}" AutomationProperties.Name="{Binding Name, StringFormat='{}{0} platform'}" />
                <CheckBox Grid.Column="3" IsChecked="{Binding Build}" AutomationProperties.Name="{Binding Name, StringFormat='Build {0}'}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</local:LoadingView>
