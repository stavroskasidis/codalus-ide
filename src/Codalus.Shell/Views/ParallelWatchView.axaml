<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codalus.Shell.Controls"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.ParallelWatchView"
             x:DataType="vm:ParallelWatchViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="6,4">
      <TextBox x:Name="ExpressionBox" Text="{Binding Expression}" PlaceholderText="{l:T parallelWatch.anExpressionToEvaluateOnEvery}" KeyDown="OnKeyDown"
               AutomationProperties.Name="{l:T parallelWatch.expression}" />
      <Button Classes="iconText compact" controls:ButtonIcon.Kind="play" Grid.Column="1" Content="{l:T parallelWatch.evaluate}" Margin="6,0,0,0" Click="OnEvaluate" />
    </Grid>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="160,240,*" Margin="8,2">
      <TextBlock Text="{l:T parallelWatch.thread}" Classes="muted" />
      <TextBlock Grid.Column="1" Text="{l:T parallelWatch.frame}" Classes="muted" />
      <TextBlock Grid.Column="2" Text="{l:T parallelWatch.value}" Classes="muted" />
    </Grid>
    <ListBox ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T parallelWatch.valuesByThread}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:ParallelWatchRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ParallelWatchRow">
          <Grid ColumnDefinitions="160,240,*">
            <TextBlock Text="{Binding Thread}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Frame}" Classes="muted" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding Value}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
