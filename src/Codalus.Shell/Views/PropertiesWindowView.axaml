<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.PropertiesWindowView"
             x:DataType="vm:PropertiesWindowViewModel">
  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.set">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.cell, ComboBox.cell">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Shell.Border}">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="1" Classes="toolbar" Command="{Binding AddMetadataCommand}" IsVisible="{Binding !HasDesignerSource}" ToolTip.Tip="{l:T properties.addMetadata}" AutomationProperties.Name="{l:T properties.addMetadata2}">
          <controls:Icon Kind="file-add" />
        </Button>
        <!-- A designer's selection (M41a): by category or name, properties or events, as a classic IDE's property grid. -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="2" Margin="0,4,0,0" IsVisible="{Binding HasDesignerSource}">
          <ToggleButton Classes="toolbar" IsChecked="{Binding !Alphabetical, Mode=OneWay}" Command="{Binding CategorizedCommand}" Content="{l:T properties.categorized}" AutomationProperties.Name="{l:T properties.categorized}" />
          <ToggleButton Classes="toolbar" IsChecked="{Binding Alphabetical, Mode=OneWay}" Command="{Binding AlphabeticalCommand}" Content="{l:T properties.alphabetical}" AutomationProperties.Name="{l:T properties.alphabetical}" />
          <Border Width="1" Margin="4,2" Background="{DynamicResource Shell.Border}" />
          <ToggleButton Classes="toolbar" IsChecked="{Binding !ShowEvents, Mode=OneWay}" Command="{Binding PropertiesCommand}" Content="{l:T properties.properties}" AutomationProperties.Name="{l:T properties.properties}" />
          <ToggleButton Classes="toolbar" IsChecked="{Binding ShowEvents, Mode=OneWay}" Command="{Binding EventsCommand}" Content="{l:T properties.events}" AutomationProperties.Name="{l:T properties.events}" />
        </StackPanel>
      </Grid>
    </Border>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding IsLoading}" />

    <!-- The selected property's description, as a classic IDE's property grid shows it. -->
    <Border DockPanel.Dock="Bottom" Padding="8,6" MinHeight="58" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Shell.Border}">
      <StackPanel Spacing="2">
        <TextBlock FontWeight="SemiBold" Text="{Binding DescriptionTitle}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Description}" />
      </StackPanel>
    </Border>
    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Links}" Margin="8,4">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PropertyLinkViewModel">
          <Button Classes="link" Content="{Binding Title}" Command="{Binding Command}" HorizontalAlignment="Left" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid>
      <TextBlock Classes="emptyState" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
      <ScrollViewer IsVisible="{Binding !HasMessage}">
        <ItemsControl x:Name="Grid" ItemsSource="{Binding Categories}" AutomationProperties.Name="{l:T properties.properties}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PropertyCategoryViewModel">
              <StackPanel>
                <Border Padding="6,3" Background="{DynamicResource Shell.Toolbar}">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                </Border>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PropertyRowViewModel">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="0.45*,0.55*,Auto">
                          <TextBlock VerticalAlignment="Center" Text="{Binding Name}" Classes.set="{Binding IsSet}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Description}" />
                          <DockPanel Grid.Column="1" IsVisible="{Binding IsTextEditor}">
                            <Border DockPanel.Dock="Left" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}"
                                    Background="{Binding Swatch}" IsVisible="{Binding IsColor}" />
                            <TextBox Classes="cell" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding Name}" />
                          </DockPanel>
                          <ItemsControl Grid.Column="1" IsVisible="{Binding IsFlags}" ItemsSource="{Binding Flags}" AutomationProperties.Name="{Binding Name}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:FlagOptionViewModel">
                                <ToggleButton Classes="toolbar" Margin="0,1,2,1" Padding="4,0" IsChecked="{Binding IsChecked}" Content="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ComboBox Grid.Column="1" Classes="cell" HorizontalAlignment="Stretch" IsVisible="{Binding IsChoice}" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" AutomationProperties.Name="{Binding Name}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:PropertyOption">
                                <TextBlock Text="{Binding Label}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <SelectableTextBlock Grid.Column="1" Margin="4,3" IsVisible="{Binding IsReadOnly}" Text="{Binding Value}" Classes.set="{Binding IsSet}" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Value}" AutomationProperties.Name="{Binding AccessibleName}" Focusable="True" />
                          <Button Grid.Column="2" Classes="toolbar" Padding="2,0" IsVisible="{Binding HasAction}" Command="{Binding Action}" ToolTip.Tip="{Binding ActionTitle}" AutomationProperties.Name="{Binding ActionTitle}">
                            <controls:Icon Kind="go-to" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
