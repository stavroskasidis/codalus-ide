<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:views="using:Codalus.Shell.Views"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.PropertiesWindowView"
             x:DataType="vm:PropertiesWindowViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Shell.Border}">
      <StackPanel Spacing="4">
        <!--
          A designer's selection (#68, D41 question 5): the component selector replaces the title, the form first, then its
          components by name, each with its type muted; blank for several. The list widens to its widest entry.
        -->
        <ComboBox x:Name="ComponentSelector" HorizontalAlignment="Stretch" IsVisible="{Binding HasDesignerSource}" IsEnabled="{Binding IsInputEnabled}"
                  ItemsSource="{Binding ComponentChoices}" SelectedItem="{Binding SelectedComponent}" ToolTip.Tip="{Binding Title}"
                  AutomationProperties.Name="{l:T properties.componentSelector}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DesignerComponentChoice">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Margin="6,0,0,0" Classes="muted" Text="{Binding Type}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Type}" />
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !HasDesignerSource}" MinHeight="24">
          <TextBlock VerticalAlignment="Center" Margin="2,0,0,0" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
          <Button Grid.Column="1" Classes="toolbar" Command="{Binding AddMetadataCommand}" ToolTip.Tip="{l:T properties.addMetadata}" AutomationProperties.Name="{l:T properties.addMetadata2}">
            <controls:Icon Kind="file-add" />
          </Button>
        </Grid>
        <!--
          The classic IDE's toolbar (D41 question 15): Categorized, Alphabetical | Properties, Events (a designer only) |
          Property Pages, for every source. One row that overflows (M34g: the buttons ran off the tool window's 280 px).
        -->
        <controls:ToolbarPanel IsEnabled="{Binding IsInputEnabled}">
          <ToggleButton Classes="toolbar icon" controls:ButtonIcon.Kind="type-hierarchy" IsChecked="{Binding !Alphabetical, Mode=OneWay}" Command="{Binding CategorizedCommand}" ToolTip.Tip="{l:T properties.categorized}" AutomationProperties.Name="{l:T properties.categorized}" />
          <ToggleButton Classes="toolbar icon" controls:ButtonIcon.Kind="arrow-sort" IsChecked="{Binding Alphabetical, Mode=OneWay}" Command="{Binding AlphabeticalCommand}" ToolTip.Tip="{l:T properties.alphabetical}" AutomationProperties.Name="{l:T properties.alphabetical}" />
          <Border Classes="toolbarSeparator" />
          <ToggleButton Classes="toolbar icon" controls:ButtonIcon.Kind="properties" IsVisible="{Binding HasDesignerSource}" IsChecked="{Binding !ShowEvents, Mode=OneWay}" Command="{Binding PropertiesCommand}" ToolTip.Tip="{l:T properties.properties}" AutomationProperties.Name="{l:T properties.properties}" />
          <ToggleButton Classes="toolbar icon" controls:ButtonIcon.Kind="events" IsVisible="{Binding HasDesignerSource}" IsChecked="{Binding ShowEvents, Mode=OneWay}" Command="{Binding EventsCommand}" ToolTip.Tip="{l:T properties.events}" AutomationProperties.Name="{l:T properties.events}" />
          <Border Classes="toolbarSeparator" IsVisible="{Binding HasDesignerSource}" />
          <Button Classes="toolbar icon" controls:ButtonIcon.Kind="tools" Command="{Binding PropertyPagesCommand}" ToolTip.Tip="{l:T properties.propertyPages}" AutomationProperties.Name="{l:T properties.propertyPages}" />
        </controls:ToolbarPanel>
      </StackPanel>
    </Border>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding IsLoading}" />

    <Grid>
      <views:PropertyGridView x:Name="GridView" DataContext="{Binding Grid}" IsVisible="{Binding !$parent[views:PropertiesWindowView].((vm:PropertiesWindowViewModel)DataContext).HasMessage}">
        <views:PropertyGridView.Footer>
          <ItemsControl ItemsSource="{Binding $parent[views:PropertiesWindowView].((vm:PropertiesWindowViewModel)DataContext).Links}" Margin="8,4"
                        IsVisible="{Binding $parent[views:PropertiesWindowView].((vm:PropertiesWindowViewModel)DataContext).HasLinks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PropertyLinkViewModel">
                <Button Classes="link" Content="{Binding Title}" Command="{Binding Command}" HorizontalAlignment="Left" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </views:PropertyGridView.Footer>
      </views:PropertyGridView>
      <TextBlock Classes="emptyState" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
    </Grid>
  </DockPanel>
</UserControl>
