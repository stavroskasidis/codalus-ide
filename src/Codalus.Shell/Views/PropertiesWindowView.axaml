<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.PropertiesWindowView"
             x:DataType="vm:PropertiesWindowViewModel">
  <UserControl.Styles>
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TextBlock.set">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.cell, ComboBox.cell">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Shell.Border}">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
        <Button Grid.Column="1" Classes="toolbar" Command="{Binding AddMetadataCommand}" IsVisible="{Binding !HasDesignerSource}" ToolTip.Tip="{l:T properties.addMetadata}" AutomationProperties.Name="{l:T properties.addMetadata2}">
          <controls:Icon Kind="file-add" />
        </Button>
        <!--
          A designer's selection (M41a): by category or name, properties or events, as a classic IDE's property grid. One
          toolbar row that overflows (M34g: the four buttons ran off the tool window's 280 px).
        -->
        <controls:ToolbarPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0" IsVisible="{Binding HasDesignerSource}">
          <ToggleButton Classes="toolbar" IsChecked="{Binding !Alphabetical, Mode=OneWay}" Command="{Binding CategorizedCommand}" Content="{l:T properties.categorized}" AutomationProperties.Name="{l:T properties.categorized}" />
          <ToggleButton Classes="toolbar" IsChecked="{Binding Alphabetical, Mode=OneWay}" Command="{Binding AlphabeticalCommand}" Content="{l:T properties.alphabetical}" AutomationProperties.Name="{l:T properties.alphabetical}" />
          <Border Classes="toolbarSeparator" />
          <ToggleButton Classes="toolbar" IsChecked="{Binding !ShowEvents, Mode=OneWay}" Command="{Binding PropertiesCommand}" Content="{l:T properties.properties}" AutomationProperties.Name="{l:T properties.properties}" />
          <ToggleButton Classes="toolbar" IsChecked="{Binding ShowEvents, Mode=OneWay}" Command="{Binding EventsCommand}" Content="{l:T properties.events}" AutomationProperties.Name="{l:T properties.events}" />
        </controls:ToolbarPanel>
      </Grid>
    </Border>
    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding IsLoading}" />

    <!-- The selected property's description, as a classic IDE's property grid shows it. -->
    <Border DockPanel.Dock="Bottom" Padding="8,6" MinHeight="58" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Shell.Border}">
      <StackPanel Spacing="2">
        <TextBlock FontWeight="SemiBold" Text="{Binding DescriptionTitle}" />
        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding Description}" />
      </StackPanel>
    </Border>
    <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Links}" Margin="8,4">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PropertyLinkViewModel">
          <Button Classes="link" Content="{Binding Title}" Command="{Binding Command}" HorizontalAlignment="Left" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid>
      <TextBlock Classes="emptyState" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
      <ScrollViewer IsVisible="{Binding !HasMessage}">
        <ItemsControl x:Name="Grid" ItemsSource="{Binding Categories}" AutomationProperties.Name="{l:T properties.properties}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PropertyCategoryViewModel">
              <StackPanel>
                <Border Padding="6,3" Background="{DynamicResource Shell.Toolbar}">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                </Border>
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PropertyRowViewModel">
                      <Border Classes="row">
                        <Grid ColumnDefinitions="0.45*,0.55*,Auto,Auto">
                          <TextBlock VerticalAlignment="Center" Text="{Binding Name}" Classes.set="{Binding IsSet}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NameToolTip}" />
                          <DockPanel Grid.Column="1" IsVisible="{Binding IsTextEditor}">
                            <Border DockPanel.Dock="Left" Width="14" Height="14" Margin="4,0,0,0" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}"
                                    Background="{Binding Swatch}" IsVisible="{Binding IsColor}" />
                            <TextBox Classes="cell" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{Binding Name}" />
                          </DockPanel>
                          <ItemsControl Grid.Column="1" IsVisible="{Binding IsFlags}" ItemsSource="{Binding Flags}" AutomationProperties.Name="{Binding Name}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:FlagOptionViewModel">
                                <ToggleButton Classes="toolbar" Margin="0,1,2,1" Padding="4,0" IsChecked="{Binding IsChecked}" Content="{Binding Name}" AutomationProperties.Name="{Binding Name}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <ComboBox Grid.Column="1" Classes="cell" HorizontalAlignment="Stretch" IsVisible="{Binding IsChoice}" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" AutomationProperties.Name="{Binding Name}">
                            <ComboBox.ItemTemplate>
                              <DataTemplate x:DataType="vm:PropertyOption">
                                <TextBlock Text="{Binding Label}" />
                              </DataTemplate>
                            </ComboBox.ItemTemplate>
                          </ComboBox>
                          <SelectableTextBlock Grid.Column="1" Margin="4,3" IsVisible="{Binding IsReadOnly}" Text="{Binding Value}" Classes.set="{Binding IsSet}" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Value}" AutomationProperties.Name="{Binding AccessibleName}" Focusable="True" />
                          <!-- Visual Studio's Dock and Anchor pickers (M41b): a drop-down with the edges to click. -->
                          <DropDownButton Grid.Column="1" Classes="cell" IsVisible="{Binding IsPicker}" Content="{Binding Value}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                          AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Description}">
                            <DropDownButton.Flyout>
                              <Flyout Placement="BottomEdgeAlignedLeft">
                                <Panel Margin="4">
                                  <Grid IsVisible="{Binding IsDock}" ColumnDefinitions="28,56,28" RowDefinitions="22,44,22,26" Width="116">
                                    <ToggleButton Grid.Row="0" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Margin="1" Command="{Binding DockCommand}" CommandParameter="Top" IsChecked="{Binding DockTop, Mode=OneWay}"
                                                  ToolTip.Tip="{l:T properties.dockTop}" AutomationProperties.Name="{l:T properties.dockTop}" />
                                    <ToggleButton Grid.Row="1" Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="1" Command="{Binding DockCommand}" CommandParameter="Left" IsChecked="{Binding DockLeft, Mode=OneWay}"
                                                  ToolTip.Tip="{l:T properties.dockLeft}" AutomationProperties.Name="{l:T properties.dockLeft}" />
                                    <ToggleButton Grid.Row="1" Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="1" Command="{Binding DockCommand}" CommandParameter="Fill" IsChecked="{Binding DockFill, Mode=OneWay}"
                                                  ToolTip.Tip="{l:T properties.dockFill}" AutomationProperties.Name="{l:T properties.dockFill}" />
                                    <ToggleButton Grid.Row="1" Grid.Column="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="1" Command="{Binding DockCommand}" CommandParameter="Right" IsChecked="{Binding DockRight, Mode=OneWay}"
                                                  ToolTip.Tip="{l:T properties.dockRight}" AutomationProperties.Name="{l:T properties.dockRight}" />
                                    <ToggleButton Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Margin="1" Command="{Binding DockCommand}" CommandParameter="Bottom" IsChecked="{Binding DockBottom, Mode=OneWay}"
                                                  ToolTip.Tip="{l:T properties.dockBottom}" AutomationProperties.Name="{l:T properties.dockBottom}" />
                                    <ToggleButton Grid.Row="3" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Margin="1" Command="{Binding DockCommand}" CommandParameter="None" IsChecked="{Binding DockNone, Mode=OneWay}"
                                                  Content="{l:T properties.dockNone}" AutomationProperties.Name="{l:T properties.dockNone}" />
                                  </Grid>
                                  <Grid IsVisible="{Binding IsAnchor}" ColumnDefinitions="40,36,40" RowDefinitions="30,36,30" Width="116">
                                    <ToggleButton Grid.Row="0" Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch" IsChecked="{Binding AnchorTop.IsChecked}"
                                                  ToolTip.Tip="{l:T properties.anchorTop}" AutomationProperties.Name="{l:T properties.anchorTop}" />
                                    <ToggleButton Grid.Row="1" Grid.Column="0" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsChecked="{Binding AnchorLeft.IsChecked}"
                                                  ToolTip.Tip="{l:T properties.anchorLeft}" AutomationProperties.Name="{l:T properties.anchorLeft}" />
                                    <Border Grid.Row="1" Grid.Column="1" Margin="2" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}" Background="{DynamicResource Shell.Toolbar}" />
                                    <ToggleButton Grid.Row="1" Grid.Column="2" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsChecked="{Binding AnchorRight.IsChecked}"
                                                  ToolTip.Tip="{l:T properties.anchorRight}" AutomationProperties.Name="{l:T properties.anchorRight}" />
                                    <ToggleButton Grid.Row="2" Grid.Column="1" Width="10" HorizontalAlignment="Center" VerticalAlignment="Stretch" IsChecked="{Binding AnchorBottom.IsChecked}"
                                                  ToolTip.Tip="{l:T properties.anchorBottom}" AutomationProperties.Name="{l:T properties.anchorBottom}" />
                                  </Grid>
                                </Panel>
                              </Flyout>
                            </DropDownButton.Flyout>
                          </DropDownButton>
                          <Button Grid.Column="2" Classes="toolbar" Padding="2,0" IsVisible="{Binding HasAction}" Command="{Binding Action}" ToolTip.Tip="{Binding ActionTitle}" AutomationProperties.Name="{Binding ActionTitle}">
                            <controls:Icon Kind="{Binding ActionIcon}" />
                          </Button>
                          <Button Grid.Column="3" Classes="toolbar" Padding="2,0" IsVisible="{Binding HasSecondaryAction}" Command="{Binding SecondaryAction}" ToolTip.Tip="{Binding SecondaryActionTitle}" AutomationProperties.Name="{Binding SecondaryActionTitle}">
                            <controls:Icon Kind="folder" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
