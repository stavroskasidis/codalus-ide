<local:LoadingView xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codalus.Shell.Controls"
                   xmlns:vm="using:Codalus.Shell.ViewModels"
                   xmlns:local="using:Codalus.Shell.Views"
                   x:Class="Codalus.Shell.Views.PerformanceProfilerView"
                   x:DataType="vm:PerformanceProfilerViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,12" Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Classes="heading" Text="{l:T performanceProfiler.performanceProfiler}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T performanceProfiler.chooseTheToolsAndWhatTo}" />

      <TextBlock FontWeight="SemiBold" Text="{l:T performanceProfiler.tools}" Margin="0,6,0,0" />
      <ItemsControl x:Name="ToolList" ItemsSource="{Binding Tools}" Focusable="True">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ProfilerToolChoice">
            <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Title}" Margin="0,2">
              <TextBlock TextWrapping="Wrap" Text="{Binding Text}" />
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock FontWeight="SemiBold" Text="{l:T performanceProfiler.target}" Margin="0,6,0,0" />
      <ComboBox SelectedIndex="{Binding TargetIndex}" MinWidth="380" AutomationProperties.Name="{l:T performanceProfiler.whatToProfile}">
        <ComboBoxItem Content="{Binding StartupProject}" />
        <ComboBoxItem Content="{l:T performanceProfiler.aRunningNetProcess}" />
      </ComboBox>
      <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !IsProcessTarget}" Text="{l:T performanceProfiler.theStartupProjectIsBuiltAnd}" />
      <StackPanel Spacing="6" IsVisible="{Binding IsProcessTarget}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding ProcessFilter}" PlaceholderText="{l:T performanceProfiler.filterByProcessIdOrName}" AutomationProperties.Name="{l:T performanceProfiler.filterProcessesByIdOrName}" />
          <Button Classes="icon" controls:ButtonIcon.Kind="refresh" Grid.Column="1" Margin="6,0,0,0" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:T performanceProfiler.refresh}" AutomationProperties.Name="{l:T performanceProfiler.refresh}" />
        </Grid>
        <ListBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" Height="180" AutomationProperties.Name="{l:T performanceProfiler.netProcesses}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProcessRowViewModel">
              <StackPanel AutomationProperties.Name="{Binding AccessibleName}">
                <TextBlock Text="{Binding Text}" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
        <Button Classes="accent iconText" controls:ButtonIcon.Kind="play" x:Name="StartButton" Content="{l:T performanceProfiler.start}" Command="{Binding StartCommand}" />
        <Button Classes="iconText" controls:ButtonIcon.Kind="stop" Content="{l:T performanceProfiler.stopCollection}" Command="{Binding StopCommand}" />
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Elapsed}" IsVisible="{Binding IsCollecting}" AutomationProperties.Name="{l:T performanceProfiler.timeCollecting}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanSnapshot}">
        <Button Classes="iconText" controls:ButtonIcon.Kind="snapshot" Content="{l:T performanceProfiler.takeSnapshot}" Command="{Binding SnapshotCommand}" ToolTip.Tip="{l:T performanceProfiler.aGcHeapSnapshotNowA}" />
        <Button Classes="iconText" controls:ButtonIcon.Kind="dump" Content="{l:T performanceProfiler.createFullDump}" Command="{Binding DumpCommand}" ToolTip.Tip="{l:T performanceProfiler.aFullDumpOfTheProcess}" />
        <TextBlock VerticalAlignment="Center" Classes="muted" Text="{Binding SnapshotText}" />
      </StackPanel>
      <TextBlock TextWrapping="Wrap" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" />

      <TextBlock FontWeight="SemiBold" Text="{l:T performanceProfiler.sessions}" Margin="0,10,0,0" />
      <ListBox x:Name="SessionList" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" MaxHeight="300" AutomationProperties.Name="{l:T performanceProfiler.savedProfilingSessions}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProfilerSessionRowViewModel">
            <StackPanel AutomationProperties.Name="{Binding AccessibleName}">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Detail}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Classes="iconText" controls:ButtonIcon.Kind="document-text" Content="{l:T performanceProfiler.openReport}" Command="{Binding OpenSessionCommand}" />
        <Button Classes="icon" controls:ButtonIcon.Kind="trash" Command="{Binding DeleteSessionCommand}" ToolTip.Tip="{l:T performanceProfiler.delete}" AutomationProperties.Name="{l:T performanceProfiler.delete}" />
        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Text="{l:T performanceProfiler.compareWith}" />
        <ComboBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding CompareBaseline}" MinWidth="240" AutomationProperties.Name="{l:T performanceProfiler.theSessionToCompareWithThe}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfilerSessionRowViewModel">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Classes="iconText" controls:ButtonIcon.Kind="compare" Content="{l:T performanceProfiler.compare}" Command="{Binding CompareCommand}" ToolTip.Tip="{l:T performanceProfiler.theSelectedSessionAgainstTheBaseline}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</local:LoadingView>
