<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.DataTipView"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:DataType="vm:DataTipViewModel">
  <DockPanel>
  <Button DockPanel.Dock="Right" VerticalAlignment="Top" Classes="toolbar" Padding="1" Margin="4,0,0,0" Click="OnPin" IsVisible="{Binding CanPin}"
          ToolTip.Tip="{l:T dataTip.pinToSource}" AutomationProperties.Name="{l:T dataTip.pinToSource}">
    <controls:Icon Kind="pin" Width="14" Height="14" />
  </Button>
  <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" Background="Transparent" MaxHeight="360" MinWidth="240" AutomationProperties.Name="{l:T dataTip.dataTip}">
    <TreeView.Styles>
      <Style Selector="TreeViewItem" x:DataType="vm:VariableNode">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        <Setter Property="MinHeight" Value="20" />
      </Style>
    </TreeView.Styles>
    <TreeView.ItemTemplate>
      <TreeDataTemplate x:DataType="vm:VariableNode" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Value}" Classes.error="{Binding IsError}" TextTrimming="CharacterEllipsis" MaxWidth="480" ToolTip.Tip="{Binding Value}" />
          <TextBlock Text="{Binding Type}" Classes="muted" IsVisible="{Binding HasType}" />
        </StackPanel>
      </TreeDataTemplate>
    </TreeView.ItemTemplate>
  </TreeView>
  </DockPanel>
</UserControl>
