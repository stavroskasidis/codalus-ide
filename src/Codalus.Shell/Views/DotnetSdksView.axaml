<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.DotnetSdksView"
             x:DataType="vm:DotnetSdksViewModel">
  <!-- Tools → .NET SDKs (ADR 0113), layout B of docs/design/controls/DotnetSdks.dc.html: Installed, Updates and
       Available over one list grouped by .NET folder, and the selection's details with the command its button runs. -->
  <UserControl.Styles>
    <Style Selector="ListBox#List ListBoxItem" x:DataType="vm:DotnetSdkRowViewModel">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
      <Setter Property="IsEnabled" Value="{Binding IsSelectable}" />
    </Style>
    <!-- A folder's heading: a row of the list that can't be selected, on the grid header's color. -->
    <Style Selector="ListBox#List ListBoxItem:disabled">
      <Setter Property="Background" Value="{DynamicResource Shell.Grid.Header}" />
      <Setter Property="Padding" Value="10,7,10,6" />
    </Style>
    <Style Selector="ListBox#List ListBoxItem:disabled TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    </Style>
    <Style Selector="ListBox#List ListBoxItem:disabled TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
    </Style>
    <Style Selector="Grid.indented">
      <Setter Property="Margin" Value="22,0,0,0" />
    </Style>
    <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
      <Setter Property="FontFamily" Value="{x:Static controls:MarkdownRenderer.Monospace}" />
    </Style>
    <Style Selector="Border.bar">
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
    </Style>
    <Style Selector="Border.bar.info">
      <Setter Property="Background" Value="{DynamicResource Shell.Status.Info}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.Status.Info.Foreground}" />
    </Style>
    <Style Selector="Border.bar.warning">
      <Setter Property="Background" Value="{DynamicResource Shell.Status.Warning}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.Status.Warning.Foreground}" />
    </Style>
    <Style Selector="Border.runs">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.command">
      <Setter Property="Background" Value="{DynamicResource Shell.Editor.Background}" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="Border.command SelectableTextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Shell.Editor.Foreground}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- The tabs, search, when the release information is from, and Refresh. -->
    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Shell.Border}" Padding="8,2,8,2">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <TabStrip x:Name="Tabs" Classes="viewTabs" BorderThickness="0" Padding="0" SelectedIndex="{Binding TabIndex}" AutomationProperties.Name="{l:T dotnetSdks.lists}">
          <TabStripItem AutomationProperties.Name="{l:T dotnetSdks.installed}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{l:T dotnetSdks.installed}" VerticalAlignment="Center" />
              <Border Classes="badge" IsVisible="{Binding !IsLoading}"><TextBlock Text="{Binding InstalledCount}" /></Border>
            </StackPanel>
          </TabStripItem>
          <TabStripItem AutomationProperties.Name="{l:T dotnetSdks.updates}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{l:T dotnetSdks.updates}" VerticalAlignment="Center" />
              <Border Classes="badge" IsVisible="{Binding HasUpdates}"><TextBlock Text="{Binding UpdatesCount}" /></Border>
            </StackPanel>
          </TabStripItem>
          <TabStripItem AutomationProperties.Name="{l:T dotnetSdks.available}">
            <TextBlock Text="{l:T dotnetSdks.available}" VerticalAlignment="Center" />
          </TabStripItem>
        </TabStrip>
        <TextBox x:Name="SearchBox" Grid.Column="1" Classes="search" Width="220" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Search}"
                 PlaceholderText="{l:T dotnetSdks.searchVersions}" AutomationProperties.Name="{l:T dotnetSdks.searchVersions}" />
        <TextBlock Grid.Column="3" Classes="muted" Margin="12,0,4,0" VerticalAlignment="Center" Text="{Binding ReleaseInfo}" ToolTip.Tip="{Binding ReleaseInfoTip}" TextTrimming="CharacterEllipsis" />
        <Button x:Name="RefreshButton" Grid.Column="4" Classes="toolbar icon" Command="{Binding RefreshCommand}" VerticalAlignment="Center"
                ToolTip.Tip="{l:T dotnetSdks.refreshTip}" AutomationProperties.Name="{l:T dotnetSdks.refresh}">
          <controls:Icon Kind="refresh" />
        </Button>
      </Grid>
    </Border>

    <!-- The release information is old or missing. -->
    <Border DockPanel.Dock="Top" Classes="bar warning" IsVisible="{Binding HasReleaseInfoProblem}">
      <DockPanel>
        <controls:Icon DockPanel.Dock="Left" Kind="warning" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ReleaseInfoProblem}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- What the last change did. -->
    <Border x:Name="MessageBar" DockPanel.Dock="Top" Classes="bar info" IsVisible="{Binding HasMessage}">
      <DockPanel>
        <controls:Icon DockPanel.Dock="Left" Kind="info" Margin="0,0,8,0" VerticalAlignment="Center" />
        <Button DockPanel.Dock="Right" Classes="toolbar icon" Command="{Binding DismissMessageCommand}" VerticalAlignment="Center"
                ToolTip.Tip="{l:T dotnetSdks.dismiss}" AutomationProperties.Name="{l:T dotnetSdks.dismiss}">
          <controls:Icon Kind="close" />
        </Button>
        <SelectableTextBlock x:Name="Message" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Available: where installs go, and what more to list. -->
    <Border DockPanel.Dock="Top" Classes="bar" IsVisible="{Binding IsAvailableTab}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Classes="muted" Text="{Binding InstallsInto}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding InstallsInto}" VerticalAlignment="Center" />
        <CheckBox Grid.Column="1" Margin="12,0,0,0" Content="{l:T dotnetSdks.showPreviews}" IsChecked="{Binding ShowPreviews}" />
        <CheckBox Grid.Column="2" Margin="12,0,0,0" Content="{l:T dotnetSdks.showOutOfSupport}" IsChecked="{Binding ShowOutOfSupport}" />
      </Grid>
    </Border>

    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding IsBusy}" />

    <Grid ColumnDefinitions="2*,4,3*">
      <!-- The list. -->
      <Panel>
        <TextBlock Classes="muted" Margin="16" Text="{l:T dotnetSdks.reading}" TextWrapping="Wrap" IsVisible="{Binding IsLoading}" />
        <StackPanel Classes="emptyState" IsVisible="{Binding IsEmpty}">
          <controls:Icon Kind="check-circle" />
          <TextBlock x:Name="EmptyText" Text="{Binding EmptyText}" />
        </StackPanel>
        <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Background="Transparent" IsVisible="{Binding !IsEmpty}"
                 AutomationProperties.Name="{l:T dotnetSdks.list}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DotnetSdkRowViewModel">
              <Panel>
                <!-- A .NET folder. -->
                <DockPanel IsVisible="{Binding IsHeader}">
                  <TextBlock DockPanel.Dock="Right" Classes="muted small" Margin="12,0,0,0" Text="{Binding Detail}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:Icon Kind="{Binding Icon}" VerticalAlignment="Center" />
                    <TextBlock Classes="mono" FontWeight="SemiBold" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                  </StackPanel>
                </DockPanel>
                <!-- A folder's runtimes, folded. -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding IsGroup}">
                  <Button Classes="toolbar icon compact" Margin="-4,0,2,0" VerticalAlignment="Center" Focusable="False"
                          Command="{Binding $parent[ListBox].((vm:DotnetSdksViewModel)DataContext).ToggleGroupCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding ExpandName}" AutomationProperties.Name="{Binding ExpandName}">
                    <controls:Icon Kind="{Binding Chevron}" />
                  </Button>
                  <controls:Icon Grid.Column="1" Kind="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                    <TextBlock Classes="muted small" Margin="8,0,0,0" Text="{Binding Detail}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                  </DockPanel>
                  <ItemsControl Grid.Column="3" Margin="8,0,0,0" ItemsSource="{Binding Chips}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DotnetSdkChip">
                        <Border Classes="chip" Classes.info="{Binding IsInfo}" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" Classes.square="{Binding IsSquare}" ToolTip.Tip="{Binding Tip}">
                          <TextBlock Text="{Binding Text}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
                <!-- An SDK, a runtime, or what can be installed. -->
                <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsItem}" Classes.indented="{Binding IsIndented}">
                  <controls:Icon Kind="{Binding Icon}" Margin="0,0,10,0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted small" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                  </StackPanel>
                  <ItemsControl Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding Chips}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DotnetSdkChip">
                        <Border Classes="chip" Classes.info="{Binding IsInfo}" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" Classes.square="{Binding IsSquare}" ToolTip.Tip="{Binding Tip}">
                          <TextBlock Text="{Binding Text}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Panel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>

      <GridSplitter Grid.Column="1" Background="{DynamicResource Shell.Border}" ResizeDirection="Columns" />

      <!-- The selection's details. -->
      <ScrollViewer x:Name="DetailsScroller" Grid.Column="2" IsVisible="{Binding HasDetails}">
        <StackPanel DataContext="{Binding Details}" x:DataType="vm:DotnetSdkDetailsViewModel" Margin="20,16" Spacing="14">
          <DockPanel>
            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="6" Background="{DynamicResource Shell.Grid.Header}" Margin="0,0,12,0" VerticalAlignment="Top">
              <controls:Icon Kind="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="4">
              <SelectableTextBlock x:Name="DetailsHeading" FontSize="{DynamicResource Shell.FontSize.Heading}" FontWeight="SemiBold" Text="{Binding Heading}" TextWrapping="Wrap" />
              <ItemsControl ItemsSource="{Binding Chips}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DotnetSdkChip">
                    <Border Classes="chip" Classes.info="{Binding IsInfo}" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" Classes.square="{Binding IsSquare}" ToolTip.Tip="{Binding Tip}">
                      <TextBlock Text="{Binding Long}" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DockPanel>

          <!-- The buttons: only those that apply (nothing grayed but while a change runs). -->
          <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
            <Button x:Name="PrimaryButton" Classes="accent iconText" controls:ButtonIcon.Kind="{Binding PrimaryIcon}" Content="{Binding PrimaryLabel}"
                    Command="{Binding PrimaryCommand}" IsVisible="{Binding HasPrimary}" AutomationProperties.Name="{Binding PrimaryLabel}" />
            <Button x:Name="RemoveButton" Classes="iconText" controls:ButtonIcon.Kind="trash" Content="{Binding RemoveLabel}"
                    Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" AutomationProperties.Name="{Binding RemoveLabel}" />
            <Button x:Name="OldPatchesButton" Classes="iconText" controls:ButtonIcon.Kind="broom" Content="{Binding OldPatchesLabel}"
                    Command="{Binding OldPatchesCommand}" IsVisible="{Binding HasOldPatches}" ToolTip.Tip="{Binding OldPatchesTip}" AutomationProperties.Name="{Binding OldPatchesLabel}" />
          </WrapPanel>
          <ProgressBar IsIndeterminate="True" Height="2" MinHeight="2" IsVisible="{Binding IsLoadingPreview}" />
          <TextBlock Classes="muted" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
          <TextBlock Foreground="{DynamicResource Shell.Warning.Foreground}" Text="{Binding NoPlan}" TextWrapping="Wrap" IsVisible="{Binding HasNoPlan}" />

          <ItemsControl x:Name="Facts" ItemsSource="{Binding Facts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DotnetSdkFact">
                <Grid ColumnDefinitions="150,*" Margin="0,0,0,6">
                  <TextBlock Classes="muted" Text="{Binding Label}" TextWrapping="Wrap" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- What the main button runs: each way, when there are several, and the chosen one runs. -->
          <Border Classes="runs" IsVisible="{Binding HasPrimary}">
            <StackPanel>
              <Border Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Shell.Border}" Background="{DynamicResource Shell.Grid.Header}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:Icon Kind="{Binding PrimaryIcon}" VerticalAlignment="Center" />
                  <TextBlock FontWeight="SemiBold" Text="{Binding ActionHeading}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <ItemsControl x:Name="Options" ItemsSource="{Binding Options}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DotnetSdkOptionViewModel">
                    <StackPanel>
                      <RadioButton GroupName="dotnetSdkOption" Margin="10,6,10,0" IsChecked="{Binding IsSelected}" Content="{Binding Title}" AutomationProperties.Name="{Binding Title}"
                                   IsVisible="{Binding $parent[ItemsControl].((vm:DotnetSdkDetailsViewModel)DataContext).HasManyOptions}" />
                      <Border Classes="command" Margin="0,4,0,0">
                        <SelectableTextBlock Classes="mono" Text="{Binding Command}" TextWrapping="Wrap" />
                      </Border>
                      <TextBlock Classes="muted" Margin="10,4,10,6" Text="{Binding Note}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="muted" Margin="10,2,10,8" Text="{Binding ActionFooter}" TextWrapping="Wrap" IsVisible="{Binding HasActionFooter}" />
            </StackPanel>
          </Border>

          <!-- What Remove does, or why it isn't offered. -->
          <TextBlock Classes="muted" Text="{Binding RemoveRefused}" TextWrapping="Wrap" IsVisible="{Binding HasRemoveRefused}" />
          <Expander x:Name="RemovalExpander" Header="{l:T dotnetSdks.whatRemoveDoes}" IsVisible="{Binding HasRemovalText}" HorizontalAlignment="Stretch">
            <SelectableTextBlock Classes="mono" Text="{Binding RemovalText}" TextWrapping="Wrap" />
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
