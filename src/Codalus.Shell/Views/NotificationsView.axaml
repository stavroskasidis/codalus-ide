<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:views="using:Codalus.Shell.Views"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.NotificationsView"
             x:DataType="vm:NotificationsViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="6,4">
      <Button Classes="toolbar"
              Command="{Binding ClearAllCommand}"
              ToolTip.Tip="{l:T notifications.clearAllNotifications}"
              AutomationProperties.Name="{l:T notifications.clearAllNotifications2}">
        <controls:Icon Kind="clear-all" />
      </Button>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{l:T notifications.noNewNotifications}" IsVisible="{Binding IsEmpty}" />
    <ListBox x:Name="List" ItemsSource="{Binding Items}" Background="Transparent" AutomationProperties.Name="{l:T notifications.notifications}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:NotificationViewModel">
          <Setter Property="Padding" Value="0" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:NotificationViewModel">
          <views:NotificationCard />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
