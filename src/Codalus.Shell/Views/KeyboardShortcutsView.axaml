<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.KeyboardShortcutsView"
             x:DataType="vm:KeyboardShortcutsViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Shell.Border}">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="SearchBox"
                   Text="{Binding Search}"
                   PlaceholderText="{l:T keyboardShortcuts.searchByCommandIdOrKeys}"
                   AutomationProperties.Name="{l:T keyboardShortcuts.searchKeyboardShortcuts}" />
          <Button Grid.Column="1"
                  Classes="link"
                  Margin="16,0,0,0"
                  VerticalAlignment="Center"
                  Content="{l:T keyboardShortcuts.editInKeybindingsJson}"
                  Command="{Binding OpenJsonCommand}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="{l:T keyboardShortcuts.changeKeyBinding}" Command="{Binding ChangeCommand}" ToolTip.Tip="{l:T keyboardShortcuts.enterOrDoubleClick}" />
          <Button Content="{l:T keyboardShortcuts.remove}" Command="{Binding RemoveCommand}" ToolTip.Tip="{l:T keyboardShortcuts.delete}" />
          <Button Content="{l:T keyboardShortcuts.reset}" Command="{Binding ResetCommand}" ToolTip.Tip="{l:T keyboardShortcuts.restoreTheDefaultKeyBinding}" />
          <TextBlock Classes="muted" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Status}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border x:Name="Recorder"
            DockPanel.Dock="Top"
            Classes="overlay"
            Margin="16,10"
            Padding="16,12"
            Focusable="True"
            IsVisible="{Binding IsRecording}"
            AutomationProperties.Name="{Binding RecordingTitle}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding RecordingTitle}" TextWrapping="Wrap" />
        <TextBlock FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{Binding RecordedLabel}" AutomationProperties.LiveSetting="Assertive" />
        <TextBlock Foreground="{DynamicResource Shell.Warning.Foreground}" HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding RecordedConflicts}" />
      </StackPanel>
    </Border>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,150,170,120" Margin="22,6,22,2">
      <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{l:T keyboardShortcuts.command}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="1" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{l:T keyboardShortcuts.keyBinding}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="2" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{l:T keyboardShortcuts.when}" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="3" Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{l:T keyboardShortcuts.source}" TextTrimming="CharacterEllipsis" />
    </Grid>

    <ListBox x:Name="List"
             Margin="8,0"
             Background="Transparent"
             ItemsSource="{Binding Rows}"
             SelectedItem="{Binding Selected}"
             AutomationProperties.Name="{l:T keyboardShortcuts.keyboardShortcuts}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:KeybindingRowViewModel">
          <Setter Property="Padding" Value="11,4,14,4" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="BorderThickness" Value="3,0,0,0" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
        <!--
          M34h: the row under the pointer and the selected command in the theme's colors (Fluent's were a neutral gray):
          Shell.Hover, and Shell.Selection with an accent bar on its left edge, as the maintainer asked for a bit of color.
          The selected style comes last, so it wins over the hover on the selected row.
        -->
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource Shell.Hover}" />
          <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
        </Style>
        <!-- The muted columns (When, Source) are 4.3:1 on Classic Light's and Dark's hover: the text's color there. -->
        <Style Selector="ListBoxItem:pointerover TextBlock.muted">
          <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
        </Style>
        <Style Selector="ListBoxItem:selected TextBlock.muted">
          <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Foreground}" />
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="{DynamicResource Shell.Selection}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
          <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Foreground}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:KeybindingRowViewModel">
          <Grid ColumnDefinitions="*,150,170,120">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding CommandId}" />
              <controls:Icon Kind="warning" Classes="warning" IsVisible="{Binding HasConflict}" ToolTip.Tip="{l:T keyboardShortcuts.thisKeyBindingConflictsWithAnother}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding KeyLabel}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding KeyLabel}" />
            <TextBlock Grid.Column="2" Classes="muted" Text="{Binding When}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding When}" />
            <TextBlock Grid.Column="3" Classes="muted" Text="{Binding Source}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Source}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
