<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.ServiceReferencesView"
             x:DataType="vm:ServiceReferencesViewModel">
  <ScrollViewer>
    <StackPanel Margin="16,12" Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Classes="heading" Text="{Binding Title}" />
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:T serviceReferences.openapiReferencesGenerateAClientWith}" />

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock FontWeight="SemiBold" Text="{l:T serviceReferences.references}" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="{l:T serviceReferences.reload}" Command="{Binding ReloadCommand}" />
      </Grid>
      <TextBlock Classes="muted" Text="{l:T serviceReferences.thisProjectHasNoServiceReferences}" IsVisible="{Binding IsEmpty}" />
      <ListBox x:Name="ReferenceList" ItemsSource="{Binding References}" SelectedItem="{Binding Selected}" MaxHeight="220" IsVisible="{Binding !IsEmpty}" AutomationProperties.Name="{l:T serviceReferences.serviceReferences}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ServiceReferenceRow">
            <Grid ColumnDefinitions="Auto,*" Margin="0,2" AutomationProperties.Name="{Binding Name}">
              <controls:Icon Kind="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1">
                <TextBlock>
                  <Run Text="{Binding Name}" FontWeight="SemiBold" />
                  <Run Text="{Binding Kind}" Foreground="{DynamicResource Shell.MutedForeground}" />
                </TextBlock>
                <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Detail}" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Packages}" TextWrapping="Wrap" />

      <Border Padding="10" BorderThickness="1" BorderBrush="{DynamicResource Shell.Border}" IsVisible="{Binding HasSelection}">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Text="{l:T serviceReferences.namespace}" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="{Binding SelectedIsOpenApi}" />
            <TextBox Grid.Column="1" Text="{Binding EditNamespace}" IsVisible="{Binding SelectedIsOpenApi}" AutomationProperties.Name="{l:T serviceReferences.referenceNamespace}" />
            <TextBlock Grid.Row="1" Text="{l:T serviceReferences.className}" Classes="muted" VerticalAlignment="Center" Margin="0,6,12,0" IsVisible="{Binding SelectedIsOpenApi}" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding EditClassName}" IsVisible="{Binding SelectedIsOpenApi}" AutomationProperties.Name="{l:T serviceReferences.referenceClassName}" />
            <TextBlock Grid.Row="2" Text="{l:T serviceReferences.nswagOptions}" Classes="muted" VerticalAlignment="Center" Margin="0,6,12,0" IsVisible="{Binding SelectedIsOpenApi}" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="{Binding EditOptions}" PlaceholderText="{l:T serviceReferences.usebaseurlFalseGenerateclientinterfacesTrue}" IsVisible="{Binding SelectedIsOpenApi}" AutomationProperties.Name="{l:T serviceReferences.nswagOptions}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SelectedIsGrpc}">
            <TextBlock Text="{l:T serviceReferences.generate}" Classes="muted" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding ServiceKinds}" SelectedItem="{Binding EditServices}" MinWidth="120" AutomationProperties.Name="{l:T serviceReferences.referenceServices}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{l:T serviceReferences.save}" Command="{Binding SaveCommand}" IsEnabled="{Binding !IsBusy}" />
            <Button Content="{l:T serviceReferences.refresh}" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanRefresh}" ToolTip.Tip="{l:T serviceReferences.downloadTheDocumentAgainFromIts}" />
            <Button Content="{l:T serviceReferences.openDocument}" Command="{Binding OpenCommand}" />
            <Button Content="{l:T serviceReferences.remove}" Command="{Binding RemoveCommand}" IsEnabled="{Binding !IsBusy}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock FontWeight="SemiBold" Text="{l:T serviceReferences.addAServiceReference}" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Text="{l:T serviceReferences.kind}" Classes="muted" VerticalAlignment="Center" Margin="0,0,12,0" />
        <ComboBox x:Name="KindBox" Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding KindLabel}" MinWidth="160" AutomationProperties.Name="{l:T serviceReferences.referenceKind}" />
        <TextBlock Grid.Row="1" Text="{l:T serviceReferences.document}" Classes="muted" VerticalAlignment="Center" Margin="0,6,12,0" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Source}" PlaceholderText="{l:T serviceReferences.aFileOrHttpsSwaggerV1}" AutomationProperties.Name="{l:T serviceReferences.documentFileOrUrl}" />
        <Button Grid.Row="1" Grid.Column="2" Margin="6,6,0,0" Content="{l:T serviceReferences.browse}" Command="{Binding BrowseCommand}" />
        <TextBlock Grid.Row="2" Text="{l:T serviceReferences.namespace}" Classes="muted" VerticalAlignment="Center" Margin="0,6,12,0" IsVisible="{Binding IsOpenApi}" />
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" Text="{Binding Namespace}" PlaceholderText="{l:T serviceReferences.theProjectSRootNamespace}" IsVisible="{Binding IsOpenApi}" AutomationProperties.Name="{l:T serviceReferences.namespace}" />
        <TextBlock Grid.Row="3" Text="{l:T serviceReferences.className}" Classes="muted" VerticalAlignment="Center" Margin="0,6,12,0" IsVisible="{Binding IsOpenApi}" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" Text="{Binding ClassName}" PlaceholderText="{l:T serviceReferences.fromTheDocumentSName}" IsVisible="{Binding IsOpenApi}" AutomationProperties.Name="{l:T serviceReferences.className}" />
        <TextBlock Grid.Row="2" Text="{l:T serviceReferences.generate}" Classes="muted" VerticalAlignment="Center" Margin="0,6,12,0" IsVisible="{Binding IsGrpc}" />
        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" ItemsSource="{Binding ServiceKinds}" SelectedItem="{Binding GrpcServices}" MinWidth="160" IsVisible="{Binding IsGrpc}" AutomationProperties.Name="{l:T serviceReferences.servicesToGenerate}" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsOpenApi}">
        <TextBlock Text="{l:T serviceReferences.generator}" Classes="muted" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding CodeGenerators}" SelectedItem="{Binding CodeGenerator}" MinWidth="160" AutomationProperties.Name="{l:T serviceReferences.codeGenerator}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="accent" Content="{l:T serviceReferences.addReference}" Command="{Binding AddCommand}" IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="{l:T serviceReferences.addServiceReference}" />
        <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource Shell.Error}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Result}" IsVisible="{Binding HasResult}" FontWeight="SemiBold" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
