<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.DisassemblyView"
             x:DataType="vm:DisassemblyViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="6,4">
      <Button x:Name="StepOver" Content="{l:T disassembly.stepOverInstruction}" IsEnabled="{Binding CanStep}" Click="OnStepOver" AutomationProperties.Name="{l:T disassembly.stepOverInstruction}" />
      <Button x:Name="StepInto" Content="{l:T disassembly.stepIntoInstruction}" IsEnabled="{Binding CanStep}" Click="OnStepInto" AutomationProperties.Name="{l:T disassembly.stepIntoInstruction}" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{l:T disassembly.codeAppearsHereWhilePaused}">
      <TextBlock.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsEmpty" />
          <Binding Path="Message" Converter="{x:Static ObjectConverters.IsNull}" />
        </MultiBinding>
      </TextBlock.IsVisible>
    </TextBlock>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T disassembly.disassembly}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:DisassemblyRow">
          <Setter Property="Padding" Value="1" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:DisassemblyRow">
          <Panel>
            <TextBlock Text="{Binding Heading}" IsVisible="{Binding IsHeading}" Classes="muted" Margin="6,4,0,0" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="20,150,220,*" IsVisible="{Binding IsInstruction}" Margin="4,0">
              <TextBlock Text="{Binding Marker}" />
              <TextBlock Grid.Column="1" Text="{Binding Address}" Classes="muted" FontFamily="{x:Static controls:MarkdownRenderer.Monospace}" />
              <TextBlock Grid.Column="2" Text="{Binding Bytes}" Classes="muted" FontFamily="{x:Static controls:MarkdownRenderer.Monospace}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding Text}" FontFamily="{x:Static controls:MarkdownRenderer.Monospace}" />
            </Grid>
          </Panel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
