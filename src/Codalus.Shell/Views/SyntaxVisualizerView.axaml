<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.SyntaxVisualizerView"
             x:DataType="vm:SyntaxVisualizerViewModel">
  <Grid RowDefinitions="*,4,Auto">
    <TextBlock Classes="emptyState" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="{l:T syntaxVisualizer.syntaxTree}">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:SyntaxItemViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          <Setter Property="MinHeight" Value="20" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="vm:SyntaxItemViewModel" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Noto Sans Mono, Ubuntu Mono, Liberation Mono, Noto Mono, monospace" FontSize="12"
                       Foreground="{DynamicResource Shell.Accent}" IsVisible="{Binding IsNode}" />
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Noto Sans Mono, Ubuntu Mono, Liberation Mono, Noto Mono, monospace" FontSize="12"
                       Foreground="{DynamicResource Shell.Diff.Added}" IsVisible="{Binding IsToken}" />
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Noto Sans Mono, Ubuntu Mono, Liberation Mono, Noto Mono, monospace" FontSize="12"
                       Foreground="{DynamicResource Shell.Warning.Foreground}" IsVisible="{Binding IsTrivia}" />
            <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Span}" VerticalAlignment="Center" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
    <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="{DynamicResource Shell.Border}" />
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" MaxHeight="420">
      <TextBlock Classes="muted" Margin="8,4" Text="{l:T syntaxVisualizer.properties}" />
      <ItemsControl Grid.Row="1" ItemsSource="{Binding Properties}" Margin="8,0,8,4" AutomationProperties.Name="{l:T syntaxVisualizer.properties}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PropertyRow">
            <Grid ColumnDefinitions="120,*">
              <TextBlock Classes="muted" Text="{Binding Name}" />
              <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Noto Sans Mono, Ubuntu Mono, Liberation Mono, Noto Mono, monospace" FontSize="12" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <DockPanel Grid.Row="2" IsVisible="{Binding HasOperations}">
        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="8,4" Text="{l:T syntaxVisualizer.ioperationTree}" />
        <TreeView ItemsSource="{Binding Operations}" MaxHeight="200" Background="Transparent" AutomationProperties.Name="{l:T syntaxVisualizer.operationTree}">
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="vm:OperationItemViewModel">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
              <Setter Property="MinHeight" Value="20" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:OperationItemViewModel" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <TextBlock Classes="muted" FontSize="{DynamicResource Shell.FontSize.Small}" Text="{Binding Syntax}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Noto Sans Mono, Ubuntu Mono, Liberation Mono, Noto Mono, monospace" />
              </StackPanel>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
