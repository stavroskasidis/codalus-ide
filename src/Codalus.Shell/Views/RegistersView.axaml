<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.RegistersView"
             x:DataType="vm:RegistersViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{l:T registers.registersAppearHereWhilePaused}">
      <TextBlock.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsEmpty" />
          <Binding Path="Message" Converter="{x:Static ObjectConverters.IsNull}" />
        </MultiBinding>
      </TextBlock.IsVisible>
    </TextBlock>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" Background="Transparent" AutomationProperties.Name="{l:T registers.registers}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:RegisterRow">
          <Setter Property="Padding" Value="2" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:RegisterRow">
          <Grid ColumnDefinitions="60,*" Margin="6,0">
            <TextBlock Text="{Binding Name}" Classes="muted" FontFamily="{x:Static controls:MarkdownRenderer.Monospace}" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="{x:Static controls:MarkdownRenderer.Monospace}" Classes="dataTipValue" Classes.changed="{Binding IsChanged}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
