<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.CustomizeView"
             x:DataType="vm:CustomizeViewModel">
  <DockPanel Margin="12,8">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <TextBlock Classes="heading" Text="{l:T customize.customize}" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="{l:T customize.addAnyCommandToAMenu}" />
      <controls:ToolbarPanel>
        <ComboBox x:Name="TargetBox" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" MinWidth="260" AutomationProperties.Name="{l:T customize.menuOrToolbar}" />
        <Button Classes="toolbar iconText" controls:ButtonIcon.Kind="add" Content="{l:T customize.newToolbar}" Command="{Binding NewToolbarCommand}" />
        <Button Classes="toolbar icon" controls:ButtonIcon.Kind="trash" Command="{Binding DeleteToolbarCommand}" ToolTip.Tip="{l:T customize.deleteToolbar}" AutomationProperties.Name="{l:T customize.deleteToolbar}" />
      </controls:ToolbarPanel>
    </StackPanel>
    <controls:ToolbarPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
      <Button Classes="toolbar iconText" controls:ButtonIcon.Kind="add" Content="{l:T customize.addCommand}" Command="{Binding AddCommand}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="trash" Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding RemoveTitle}" ToolTip.Tip="{Binding RemoveTitle}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="arrow-up" Command="{Binding MoveUpCommand}" ToolTip.Tip="{l:T customize.moveUp}" AutomationProperties.Name="{l:T customize.moveUp}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="arrow-down" Command="{Binding MoveDownCommand}" ToolTip.Tip="{l:T customize.moveDown}" AutomationProperties.Name="{l:T customize.moveDown}" />
      <Button Classes="toolbar icon" controls:ButtonIcon.Kind="reset" Command="{Binding ResetCommand}" ToolTip.Tip="{l:T customize.backToTheItemsAsContributed}" AutomationProperties.Name="{l:T customize.reset}" />
    </controls:ToolbarPanel>
    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" Margin="0,6,0,0" AutomationProperties.Name="{l:T customize.items}">
      <ListBox.Styles>
        <Style Selector="ListBoxItem" x:DataType="vm:CustomizeItem">
          <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:CustomizeItem">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" ToolTip.Tip="{Binding Key}" />
            <TextBlock Classes="muted" Text="{Binding Note}" IsVisible="{Binding HasNote}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
