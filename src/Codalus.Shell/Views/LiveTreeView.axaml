<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.LiveTreeView"
             x:DataType="vm:LiveTreeViewModel">
  <DockPanel>
    <controls:ToolbarPanel DockPanel.Dock="Top" Margin="6,4">
      <ToggleButton Classes="toolbar" IsChecked="{Binding IsPicking}" IsEnabled="{Binding IsConnected}"
                    ToolTip.Tip="{l:T liveTree.selectElementInTheAppClick}"
                    AutomationProperties.Name="{l:T liveTree.selectElementInTheApp}">
        <controls:Icon Kind="select-expand" />
      </ToggleButton>
      <ToggleButton Classes="toolbar" IsChecked="{Binding ShowVisualTree}"
                    ToolTip.Tip="{l:T liveTree.showTheVisualTreeTemplatesParts}"
                    AutomationProperties.Name="{l:T liveTree.showVisualTree}">
        <controls:Icon Kind="layers" Classes="accent-purple" />
      </ToggleButton>
      <Button Classes="toolbar" Command="{Binding GoToXamlCommand}" ToolTip.Tip="{l:T liveTree.goToTheElementSXaml}" AutomationProperties.Name="{l:T liveTree.goToXaml}">
        <controls:Icon Kind="go-to" />
      </Button>
      <Button Classes="toolbar" Command="{Binding RefreshCommand}" ToolTip.Tip="{l:T liveTree.refresh}" AutomationProperties.Name="{l:T liveTree.refresh}">
        <controls:Icon Kind="refresh" />
      </Button>
    </controls:ToolbarPanel>
    <TextBlock DockPanel.Dock="Top" Classes="emptyState" Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextWrapping="Wrap" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected, Mode=TwoWay}" Background="Transparent"
              AutomationProperties.Name="{l:T liveTree.liveVisualTree}">
      <TreeView.Styles>
        <Style Selector="TextBlock.muted.onSelection">
          <Setter Property="Foreground" Value="{DynamicResource TreeViewItemForegroundSelected}" />
        </Style>
        <!-- M34h: without the focus the selection is Shell.Selection.Inactive, with its own text. -->
        <Style Selector="TreeView:not(:focus-within) TextBlock.muted.onSelection">
          <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Inactive.Foreground}" />
        </Style>
        <Style Selector="TreeViewItem" x:DataType="vm:LiveNodeViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
          <Setter Property="MinHeight" Value="22" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="vm:LiveNodeViewModel" ItemsSource="{Binding Children}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:Icon Kind="window" IsVisible="{Binding IsWindow}" VerticalAlignment="Center" />
            <!-- A template part is muted, except on the selection, where it takes the selection's text (M34g). -->
            <TextBlock Text="{Binding Label}" Classes.muted="{Binding IsTemplated}" Classes.onSelection="{Binding $parent[TreeViewItem].IsSelected}" VerticalAlignment="Center" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
