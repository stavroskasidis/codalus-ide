<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             xmlns:controls="using:Codalus.Shell.Controls"
             x:Class="Codalus.Shell.Views.GitHistoryView"
             x:DataType="vm:GitHistoryViewModel">
  <UserControl.Styles>
    <Style Selector="Border.ref">
      <Setter Property="Background" Value="{DynamicResource Shell.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="3,0,5,0" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <!-- The current branch, as the classic IDE marks it. -->
    <Style Selector="Border.ref.current">
      <Setter Property="Background" Value="{DynamicResource Shell.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
    </Style>
    <Style Selector="Border.ref.current TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Shell.AccentForeground}" />
    </Style>
    <Style Selector="TextBlock.columnHeader">
      <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- The toolbar: Refresh, Show All Branches (the Git Repository document), remote branches and tags in the Branch / Tag column; Filter History. -->
    <DockPanel Margin="4,2">
      <TextBox x:Name="FilterBox" DockPanel.Dock="Right" Width="240" Text="{Binding Filter}" PlaceholderText="{l:T gitHistory.filterHistory}"
               AutomationProperties.Name="{l:T gitHistory.filterHistoryByMessageAuthorOrId}" ToolTip.Tip="{l:T gitHistory.filterHistoryByMessageAuthorOrId}">
        <TextBox.InnerLeftContent>
          <controls:Icon Kind="search" Margin="6,0,0,0" VerticalAlignment="Center" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="toolbar icon" controls:ButtonIcon.Kind="refresh" Click="OnRefresh" ToolTip.Tip="{l:T gitHistory.refresh}" AutomationProperties.Name="{l:T gitHistory.refresh}" />
        <ToggleButton Classes="toolbar icon" controls:ButtonIcon.Kind="fork" IsChecked="{Binding AllBranches}" IsVisible="{Binding CanShowAllBranches}"
                      ToolTip.Tip="{l:T gitHistory.showAllBranches}" AutomationProperties.Name="{l:T gitHistory.showAllBranches}" />
        <ToggleButton Classes="toolbar icon" controls:ButtonIcon.Kind="cloud" IsChecked="{Binding ShowRemoteRefs}"
                      ToolTip.Tip="{l:T gitHistory.showRemoteBranches}" AutomationProperties.Name="{l:T gitHistory.showRemoteBranches}" />
        <ToggleButton Classes="toolbar icon" controls:ButtonIcon.Kind="tag" IsChecked="{Binding ShowTags}"
                      ToolTip.Tip="{l:T gitHistory.showTags}" AutomationProperties.Name="{l:T gitHistory.showTags}" />
      </StackPanel>
    </DockPanel>

    <!-- The columns, as the classic IDE's: Branch / Tag, Graph, Message, Author, Date, ID. -->
    <Border Grid.Row="1" BorderBrush="{DynamicResource Shell.Border}" BorderThickness="0,1" Padding="4,2">
      <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" MinWidth="180" />
          <ColumnDefinition Width="130" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="72" />
        </Grid.ColumnDefinitions>
        <TextBlock Classes="columnHeader" Text="{l:T gitHistory.branchTag}" />
        <Border Grid.Column="1" Width="{Binding GraphWidth}" MinWidth="44">
          <TextBlock Classes="columnHeader" Text="{l:T gitHistory.graph}" />
        </Border>
        <TextBlock Grid.Column="2" Classes="columnHeader" Text="{l:T gitHistory.message}" />
        <TextBlock Grid.Column="3" Classes="columnHeader" Text="{l:T gitHistory.author}" />
        <TextBlock Grid.Column="4" Classes="columnHeader" Text="{l:T gitHistory.date}" />
        <TextBlock Grid.Column="5" Classes="columnHeader" Text="{l:T gitHistory.id}" />
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <TextBlock Classes="emptyState" Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" />
      <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" SelectionMode="Multiple" Background="Transparent" AutomationProperties.Name="{l:T gitHistory.commits}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListBox.Styles>
        <ListBox.DataTemplates>
          <!-- A section's header: its chevron, its title and its links (Incoming: Fetch, Pull; Local History: Push, Sync). -->
          <DataTemplate DataType="vm:GitHistorySection" x:DataType="vm:GitHistorySection">
            <StackPanel Orientation="Horizontal" Height="26" Spacing="6" Background="Transparent" AutomationProperties.Name="{Binding AccessibleName}">
              <Button Classes="toolbar" Width="20" Height="20" MinWidth="20" Padding="0" Click="OnToggleSection" AutomationProperties.Name="{Binding AccessibleName}">
                <Path Data="M 0.75 0.75 L 4.75 4.75 L 0.75 8.75" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5" Width="6" Height="10" Stretch="None"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path.RenderTransform>
                    <RotateTransform Angle="{Binding ChevronAngle}" />
                  </Path.RenderTransform>
                </Path>
              </Button>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <ItemsControl ItemsSource="{Binding Links}" IsVisible="{Binding HasLinks}" VerticalAlignment="Center" Margin="6,0,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GitHistoryLink">
                    <Button Classes="link" Content="{Binding Text}" Click="OnLink" AutomationProperties.Name="{Binding Text}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
          <!-- A commit. -->
          <DataTemplate DataType="vm:GitCommitRow" x:DataType="vm:GitCommitRow">
            <Grid Height="22" Background="Transparent" ClipToBounds="True" AutomationProperties.Name="{Binding AccessibleName}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="72" />
              </Grid.ColumnDefinitions>
              <ItemsControl ItemsSource="{Binding ShownRefs}" IsVisible="{Binding HasRefs}" ClipToBounds="True" VerticalAlignment="Center" ToolTip.Tip="{Binding RefsTip}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GitRefChip">
                    <Border Classes="ref" Classes.current="{Binding IsCurrent}">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <controls:Icon Kind="{Binding Icon}" Width="12" Height="12" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Shell.FontSize.Small}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <controls:GitGraphCell Grid.Column="1" Row="{Binding Graph}" IsHead="{Binding IsHead}" Lanes="{Binding $parent[ListBox].((vm:GitHistoryViewModel)DataContext).Lanes}" VerticalAlignment="Stretch" MinWidth="44" />
              <TextBlock Grid.Column="2" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" ToolTip.Tip="{Binding Subject}" />
              <TextBlock Grid.Column="3" Text="{Binding Author}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" />
              <TextBlock Grid.Column="4" Text="{Binding Date}" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" />
              <TextBlock Grid.Column="5" Text="{Binding ShortHash}" Classes="muted" FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, Noto Sans Mono, Ubuntu Mono, Liberation Mono, Noto Mono, monospace" VerticalAlignment="Center" Margin="4,0" />
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
        <ListBox.ContextMenu>
          <ContextMenu x:Name="CommitMenu">
            <MenuItem controls:MenuEntry.Icon="document-text" Header="{l:T gitHistory.viewCommitDetails}" Tag="details" Click="OnCommitAction" FontWeight="SemiBold" IsEnabled="{Binding IsSingleSelection}" />
            <Separator />
            <!-- Two selected commits (Ctrl+click, Shift+click), or one and its parent: the Compare document, the older on the left. -->
            <MenuItem controls:MenuEntry.Icon="compare" Header="{l:T gitHistory.compareWithPrevious}" Click="OnCompareWithPrevious" IsEnabled="{Binding CanCompareWithPrevious}" />
            <MenuItem controls:MenuEntry.Icon="compare" Header="{l:T gitHistory.compareCommits}" Click="OnCompareCommits" IsEnabled="{Binding CanCompareCommits}" />
            <Separator />
            <MenuItem controls:MenuEntry.Icon="go-to" Header="{l:T gitHistory.checkoutDetached}" Tag="checkout" Click="OnCommitAction" IsEnabled="{Binding IsSingleSelection}" />
            <MenuItem controls:MenuEntry.Icon="branch" Header="{l:T gitHistory.newBranchHere}" Tag="branch" Click="OnCommitAction" IsEnabled="{Binding IsSingleSelection}" />
            <MenuItem controls:MenuEntry.Icon="tag" Header="{l:T gitHistory.createTag}" Tag="tag" Click="OnCommitAction" IsEnabled="{Binding IsSingleSelection}" />
            <Separator />
            <MenuItem controls:MenuEntry.Icon="fork" Header="{l:T gitHistory.cherryPick}" Tag="cherryPick" Click="OnCommitAction" IsEnabled="{Binding IsSingleSelection}" />
            <MenuItem controls:MenuEntry.Icon="undo" Header="{l:T gitHistory.revert}" Tag="revert" Click="OnCommitAction" IsEnabled="{Binding IsSingleSelection}" />
            <MenuItem controls:MenuEntry.Icon="reset" Header="{l:T gitHistory.reset}" IsEnabled="{Binding IsSingleSelection}">
              <MenuItem Header="{l:T gitHistory.keepChangesStagedSoft}" Tag="reset-soft" Click="OnCommitAction" />
              <MenuItem Header="{l:T gitHistory.keepChangesMixed}" Tag="reset-mixed" Click="OnCommitAction" />
              <MenuItem Header="{l:T gitHistory.discardChangesHard}" Tag="reset-hard" Click="OnCommitAction" />
            </MenuItem>
            <MenuItem controls:MenuEntry.Icon="arrow-sort" Header="{l:T gitHistory.interactiveRebaseFromHere}" Tag="rebaseInteractive" Click="OnCommitAction" IsEnabled="{Binding IsSingleSelection}" />
            <Separator />
            <MenuItem controls:MenuEntry.Icon="copy" Header="{l:T gitHistory.copyCommitHash}" Tag="copyHash" Click="OnCommitAction" IsEnabled="{Binding IsSingleSelection}" />
          </ContextMenu>
        </ListBox.ContextMenu>
      </ListBox>
    </Grid>
  </Grid>
</UserControl>
