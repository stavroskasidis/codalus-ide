<UserControl xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Codalus.Shell.Controls"
             xmlns:vm="using:Codalus.Shell.ViewModels"
             x:Class="Codalus.Shell.Views.ContainersView"
             x:DataType="vm:ContainersViewModel">
  <UserControl.Styles>
    <Style Selector="Ellipse">
      <Setter Property="Stroke" Value="{DynamicResource Shell.MutedForeground}" />
    </Style>
    <Style Selector="Ellipse.running">
      <Setter Property="Fill" Value="{DynamicResource Shell.Icon.Green}" />
      <Setter Property="Stroke" Value="{DynamicResource Shell.Icon.Green}" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <!-- The control set's toolbar (M34h, docs/design/controls/ToolWindowToolbars.dc.html): icons in three groups. -->
    <controls:ToolbarPanel DockPanel.Dock="Top">
      <Button x:Name="Refresh" Classes="toolbar icon" controls:ButtonIcon.Kind="refresh" ToolTip.Tip="{l:T containers.refresh}" AutomationProperties.Name="{l:T containers.refreshTheContainersAndImages}" />
      <Border Classes="toolbarSeparator" />
      <Button x:Name="Start" Classes="toolbar icon" controls:ButtonIcon.Kind="play" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:T containers.start}" AutomationProperties.Name="{l:T containers.startTheSelectedContainer}" />
      <Button x:Name="Stop" Classes="toolbar icon" controls:ButtonIcon.Kind="stop" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:T containers.stop}" AutomationProperties.Name="{l:T containers.stopTheSelectedContainer}" />
      <Button x:Name="Restart" Classes="toolbar icon" controls:ButtonIcon.Kind="restart" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:T containers.restart}" AutomationProperties.Name="{l:T containers.restartTheSelectedContainer}" />
      <Button x:Name="Remove" Classes="toolbar icon" controls:ButtonIcon.Kind="trash" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:T containers.remove}" AutomationProperties.Name="{l:T containers.removeTheSelectedContainer}" />
      <Border Classes="toolbarSeparator" />
      <Button x:Name="Browse" Classes="toolbar icon" controls:ButtonIcon.Kind="globe" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:T containers.openInBrowser}" AutomationProperties.Name="{l:T containers.openTheSelectedContainerSFirst}" />
      <Button x:Name="Terminal" Classes="toolbar icon" controls:ButtonIcon.Kind="terminal" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:T containers.openTerminal}" AutomationProperties.Name="{l:T containers.openATerminalInTheSelected}" />
      <Button x:Name="Attach" Classes="toolbar icon" controls:ButtonIcon.Kind="debug" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:T containers.attachDebugger}" AutomationProperties.Name="{l:T containers.attachTheDebuggerToAProcess}" />
      <Button x:Name="RemoteWindow" Classes="toolbar icon" controls:ButtonIcon.Kind="window-remote" IsEnabled="{Binding HasSelection}" ToolTip.Tip="{l:T containers.openInRemoteWindow}" AutomationProperties.Name="{l:T containers.openTheSelectedContainerInA}" />
      <TextBlock Classes="muted small" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,4,0" Text="{l:T containers.working}" IsVisible="{Binding IsBusy}" />
      <TextBlock Classes="muted small" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,4,0" Text="{Binding ServerLabel}" IsVisible="{Binding !IsBusy}" AutomationProperties.LiveSetting="Polite" />
    </controls:ToolbarPanel>
    <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="12,4" Text="{Binding Status}" TextWrapping="Wrap">
      <TextBlock.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="HasStatus" />
          <Binding Path="!IsEmpty" />
        </MultiBinding>
      </TextBlock.IsVisible>
    </TextBlock>
    <!-- Empty (or the engine doesn't answer): an icon, the status with its next step, and Refresh (M34h). -->
    <StackPanel x:Name="EmptyState" DockPanel.Dock="Top" Classes="emptyState" IsVisible="{Binding IsEmpty}">
      <controls:Icon Kind="container" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" Classes="muted" />
      <Button x:Name="EmptyRefresh" Classes="iconText" controls:ButtonIcon.Kind="refresh" HorizontalAlignment="Center" Content="{l:T containers.refresh}" AutomationProperties.Name="{l:T containers.refreshTheContainersAndImages}" />
    </StackPanel>
    <Grid ColumnDefinitions="2*,4,3*" IsVisible="{Binding !IsEmpty}">
      <TabControl Grid.Column="0" Padding="0">
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{l:T containers.containers}" VerticalAlignment="Center" />
              <Border Classes="badge"><TextBlock Text="{Binding ContainerCount}" /></Border>
            </StackPanel>
          </TabItem.Header>
          <ListBox x:Name="ContainerList" ItemsSource="{Binding Containers}" SelectedItem="{Binding Selected}" Background="Transparent" AutomationProperties.Name="{l:T containers.containers}">
            <ListBox.Styles>
              <Style Selector="ListBoxItem" x:DataType="vm:ContainerRow">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContainerRow">
                <Grid ColumnDefinitions="Auto,*">
                  <!-- The state as a dot (filled while it runs) and a word, its status in the detail line (M34h). -->
                  <Ellipse Width="8" Height="8" Margin="2,0,8,0" VerticalAlignment="Center" StrokeThickness="1.5"
                           Classes.running="{Binding IsRunning}" ToolTip.Tip="{Binding StateText}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{l:T containers.images}" VerticalAlignment="Center" />
              <Border Classes="badge"><TextBlock Text="{Binding ImageCount}" /></Border>
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <controls:ToolbarPanel DockPanel.Dock="Top">
              <Button x:Name="RemoveImage" Classes="toolbar icon" controls:ButtonIcon.Kind="trash" ToolTip.Tip="{l:T containers.removeImage}" AutomationProperties.Name="{l:T containers.removeTheSelectedImage}" />
            </controls:ToolbarPanel>
            <ListBox ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" Background="Transparent" AutomationProperties.Name="{l:T containers.images}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ImageRow">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Detail}" Classes="muted" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <TabControl Grid.Column="2" Padding="0" SelectedIndex="{Binding Tab}">
        <TabItem Header="{l:T containers.logs}">
          <TextBox x:Name="LogText" Text="{Binding Logs}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" AutomationProperties.Name="{l:T containers.containerLogs}" />
        </TabItem>
        <TabItem Header="{l:T containers.environment}">
          <ListBox ItemsSource="{Binding Environment}" Background="Transparent" AutomationProperties.Name="{l:T containers.environmentVariables}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContainerPropertyRow">
                <Grid ColumnDefinitions="220,*">
                  <TextBlock Text="{Binding Name}" Classes="accent" TextTrimming="CharacterEllipsis" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="{l:T containers.ports}">
          <ListBox ItemsSource="{Binding Ports}" Background="Transparent" AutomationProperties.Name="{l:T containers.portsAndMounts}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContainerPropertyRow">
                <Grid ColumnDefinitions="220,*">
                  <TextBlock Text="{Binding Name}" Classes="accent" TextTrimming="CharacterEllipsis" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="{l:T containers.labels}">
          <ListBox ItemsSource="{Binding Labels}" Background="Transparent" AutomationProperties.Name="{l:T containers.labels}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ContainerPropertyRow">
                <Grid ColumnDefinitions="260,*">
                  <TextBlock Text="{Binding Name}" Classes="accent" TextTrimming="CharacterEllipsis" />
                  <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
        <TabItem Header="{l:T containers.files}">
          <DockPanel>
            <TextBox x:Name="PathBox" DockPanel.Dock="Top" Margin="4" Text="{Binding FilesPath}" AutomationProperties.Name="{l:T containers.folderInTheContainerEnterLists}" />
            <ListBox x:Name="FileList" ItemsSource="{Binding Files}" Background="Transparent" AutomationProperties.Name="{l:T containers.filesInTheContainer}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ContainerFileRow">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
