<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Codalus.Shell"
             x:Class="Codalus.Shell.App"
             Name="Codalus IDE"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://codalus/Theming/Tokens.axaml" />
        <!-- The control set's control themes (M34h): app resources come before Fluent's, so these replace its own. -->
        <ResourceInclude Source="avares://codalus/Theming/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <DockFluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://codalus/Theming/ShellStyles.axaml" />
  </Application.Styles>
</Application>
