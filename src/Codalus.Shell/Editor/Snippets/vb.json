{
  "class": { "prefix": "Class", "description": "Class", "body": ["Public Class ${1:MyClass}", "\t$0", "End Class"] },
  "module": { "prefix": "Module", "description": "Module", "body": ["Public Module ${1:MyModule}", "\t$0", "End Module"] },
  "interface": { "prefix": "Interface", "description": "Interface", "body": ["Public Interface ${1:IMyInterface}", "\t$0", "End Interface"] },
  "structure": { "prefix": "Structure", "description": "Structure", "body": ["Public Structure ${1:MyStructure}", "\t$0", "End Structure"] },
  "enum": { "prefix": "Enum", "description": "Enum", "body": ["Public Enum ${1:MyEnum}", "\t$0", "End Enum"] },
  "namespace": { "prefix": "Namespace", "description": "Namespace", "body": ["Namespace ${1:$TM_DIRECTORY_NAME}", "\t$0", "End Namespace"] },
  "sub": { "prefix": "Sub", "description": "Sub procedure", "body": ["Public Sub ${1:MySub}(${2})", "\t$0", "End Sub"] },
  "function": { "prefix": "Function", "description": "Function", "body": ["Public Function ${1:MyFunction}(${2}) As ${3:Integer}", "\t$0", "End Function"] },
  "ctor": { "prefix": "New", "description": "Constructor", "body": ["Public Sub New(${1})", "\t$0", "End Sub"] },
  "prop": { "prefix": "Property", "description": "Auto-implemented property", "body": ["Public Property ${1:MyProperty} As ${2:Integer}$0"] },
  "propr": { "prefix": "ReadOnly", "description": "Read-only property", "body": ["Public ReadOnly Property ${1:MyProperty} As ${2:Integer}", "\tGet", "\t\tReturn $0", "\tEnd Get", "End Property"] },
  "propfull": { "prefix": "propfull", "description": "Property with a backing field", "body": ["Private _${1:myVar} As ${2:Integer}", "", "Public Property ${3:MyProperty} As $2", "\tGet", "\t\tReturn _$1", "\tEnd Get", "\tSet(value As $2)", "\t\t_$1 = value", "\tEnd Set", "End Property$0"] },
  "if": { "prefix": "If", "description": "If statement", "body": ["If ${1:True} Then", "\t$TM_SELECTED_TEXT$0", "End If"] },
  "ifelse": { "prefix": "IfElse", "description": "If…Else statement", "body": ["If ${1:True} Then", "\t$TM_SELECTED_TEXT$0", "Else", "End If"] },
  "for": { "prefix": "For", "description": "For loop", "body": ["For ${1:i} As Integer = ${2:0} To ${3:10}", "\t$TM_SELECTED_TEXT$0", "Next"] },
  "foreach": { "prefix": "ForEach", "description": "For Each loop", "body": ["For Each ${1:item} In ${2:collection}", "\t$TM_SELECTED_TEXT$0", "Next"] },
  "while": { "prefix": "While", "description": "While loop", "body": ["While ${1:True}", "\t$TM_SELECTED_TEXT$0", "End While"] },
  "do": { "prefix": "Do", "description": "Do…Loop While", "body": ["Do", "\t$TM_SELECTED_TEXT$0", "Loop While ${1:True}"] },
  "select": { "prefix": "Select", "description": "Select Case", "body": ["Select Case ${1:value}", "\tCase ${2:1}", "\t\t$0", "\tCase Else", "End Select"] },
  "try": { "prefix": "Try", "description": "Try…Catch", "body": ["Try", "\t$TM_SELECTED_TEXT$0", "Catch ${1:ex} As ${2:Exception}", "\tThrow", "End Try"] },
  "tryf": { "prefix": "TryF", "description": "Try…Finally", "body": ["Try", "\t$TM_SELECTED_TEXT$0", "Finally", "End Try"] },
  "using": { "prefix": "Using", "description": "Using block", "body": ["Using ${1:resource} = ${2:New MemoryStream()}", "\t$TM_SELECTED_TEXT$0", "End Using"] },
  "synclock": { "prefix": "SyncLock", "description": "SyncLock block", "body": ["SyncLock ${1:Me}", "\t$TM_SELECTED_TEXT$0", "End SyncLock"] },
  "with": { "prefix": "With", "description": "With block", "body": ["With ${1:obj}", "\t$TM_SELECTED_TEXT$0", "End With"] },
  "region": { "prefix": "#Region", "description": "#Region", "body": ["#Region \"${1:MyRegion}\"", "$TM_SELECTED_TEXT$0", "#End Region"] },
  "event": { "prefix": "Event", "description": "Event", "body": ["Public Event ${1:MyEvent} As EventHandler$0"] },
  "main": { "prefix": "Main", "description": "Sub Main", "body": ["Sub Main(args As String())", "\t$0", "End Sub"] },
  "test": { "prefix": "Fact", "description": "xUnit test", "body": ["<Fact>", "Sub ${1:Test}()", "\t$0", "End Sub"] }
}
