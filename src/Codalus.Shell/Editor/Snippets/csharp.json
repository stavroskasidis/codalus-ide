{
  "class": { "prefix": "class", "description": "Class", "body": ["public class ${1:MyClass}", "{", "\t$0", "}"] },
  "interface": { "prefix": "interface", "description": "Interface", "body": ["public interface ${1:IMyInterface}", "{", "\t$0", "}"] },
  "struct": { "prefix": "struct", "description": "Struct", "body": ["public struct ${1:MyStruct}", "{", "\t$0", "}"] },
  "record": { "prefix": "record", "description": "Record", "body": ["public record ${1:MyRecord}(${2:string Name});$0"] },
  "enum": { "prefix": "enum", "description": "Enum", "body": ["public enum ${1:MyEnum}", "{", "\t$0", "}"] },
  "namespace": { "prefix": "namespace", "description": "File-scoped namespace", "body": ["namespace ${1:$TM_DIRECTORY_NAME};", "", "$0"] },
  "ctor": { "prefix": "ctor", "description": "Constructor", "body": ["public ${1:$TM_FILENAME_BASE}()", "{", "\t$0", "}"] },
  "prop": { "prefix": "prop", "description": "Auto-implemented property", "body": ["public ${1:int} ${2:MyProperty} { get; set; }$0"] },
  "propg": { "prefix": "propg", "description": "Property with a private setter", "body": ["public ${1:int} ${2:MyProperty} { get; private set; }$0"] },
  "propi": { "prefix": "propi", "description": "Init-only property", "body": ["public ${1:int} ${2:MyProperty} { get; init; }$0"] },
  "propfull": { "prefix": "propfull", "description": "Property with a backing field", "body": ["private ${1:int} ${2:myVar};", "", "public $1 ${3:MyProperty}", "{", "\tget => $2;", "\tset => $2 = value;", "}$0"] },
  "indexer": { "prefix": "indexer", "description": "Indexer", "body": ["public ${1:object} this[${2:int} index]", "{", "\tget => $0;", "\tset { }", "}"] },
  "for": { "prefix": "for", "description": "for loop", "body": ["for (var ${1:i} = 0; $1 < ${2:length}; $1++)", "{", "\t$0", "}"] },
  "forr": { "prefix": "forr", "description": "Reverse for loop", "body": ["for (var ${1:i} = ${2:length} - 1; $1 >= 0; $1--)", "{", "\t$0", "}"] },
  "foreach": { "prefix": "foreach", "description": "foreach loop", "body": ["foreach (var ${1:item} in ${2:collection})", "{", "\t$0$TM_SELECTED_TEXT", "}"] },
  "while": { "prefix": "while", "description": "while loop", "body": ["while (${1:true})", "{", "\t$TM_SELECTED_TEXT$0", "}"] },
  "do": { "prefix": "do", "description": "do-while loop", "body": ["do", "{", "\t$TM_SELECTED_TEXT$0", "} while (${1:true});"] },
  "if": { "prefix": "if", "description": "if statement", "body": ["if (${1:true})", "{", "\t$TM_SELECTED_TEXT$0", "}"] },
  "else": { "prefix": "else", "description": "else statement", "body": ["else", "{", "\t$TM_SELECTED_TEXT$0", "}"] },
  "switch": { "prefix": "switch", "description": "switch statement", "body": ["switch (${1:switch_on})", "{", "\tcase ${2:value}:", "\t\t$0", "\t\tbreak;", "\tdefault:", "\t\tbreak;", "}"] },
  "try": { "prefix": "try", "description": "try-catch", "body": ["try", "{", "\t$TM_SELECTED_TEXT$0", "}", "catch (${1:Exception} ${2:ex})", "{", "\tthrow;", "}"] },
  "tryf": { "prefix": "tryf", "description": "try-finally", "body": ["try", "{", "\t$TM_SELECTED_TEXT$0", "}", "finally", "{", "}"] },
  "using": { "prefix": "using", "description": "using statement", "body": ["using (${1:resource})", "{", "\t$TM_SELECTED_TEXT$0", "}"] },
  "lock": { "prefix": "lock", "description": "lock statement", "body": ["lock (${1:this})", "{", "\t$TM_SELECTED_TEXT$0", "}"] },
  "checked": { "prefix": "checked", "description": "checked block", "body": ["checked", "{", "\t$TM_SELECTED_TEXT$0", "}"] },
  "unchecked": { "prefix": "unchecked", "description": "unchecked block", "body": ["unchecked", "{", "\t$TM_SELECTED_TEXT$0", "}"] },
  "unsafe": { "prefix": "unsafe", "description": "unsafe block", "body": ["unsafe", "{", "\t$TM_SELECTED_TEXT$0", "}"] },
  "region": { "prefix": "#region", "description": "#region", "body": ["#region ${1:MyRegion}", "$TM_SELECTED_TEXT$0", "#endregion"] },
  "if directive": { "prefix": "#if", "description": "#if directive", "body": ["#if ${1:true}", "$TM_SELECTED_TEXT$0", "#endif"] },
  "cw": { "prefix": "cw", "description": "Console.WriteLine", "body": ["Console.WriteLine($0);"] },
  "svm": { "prefix": "svm", "description": "static void Main", "body": ["static void Main(string[] args)", "{", "\t$0", "}"] },
  "sim": { "prefix": "sim", "description": "static int Main", "body": ["static int Main(string[] args)", "{", "\t$0", "\treturn 0;", "}"] },
  "equals": { "prefix": "equals", "description": "Equals and GetHashCode", "body": ["public override bool Equals(object? obj) => obj is ${1:$TM_FILENAME_BASE} other && $0;", "", "public override int GetHashCode() => HashCode.Combine();"] },
  "exception": { "prefix": "exception", "description": "Exception class", "body": ["public class ${1:My}Exception : Exception", "{", "\tpublic $1Exception() { }", "", "\tpublic $1Exception(string message) : base(message) { }", "", "\tpublic $1Exception(string message, Exception inner) : base(message, inner) { }", "}$0"] },
  "attribute": { "prefix": "attribute", "description": "Attribute class", "body": ["[AttributeUsage(AttributeTargets.${2:All}, Inherited = false, AllowMultiple = false)]", "public sealed class ${1:My}Attribute : Attribute", "{", "\t$0", "}"] },
  "iterator": { "prefix": "iterator", "description": "Iterator method", "body": ["public IEnumerable<${1:int}> ${2:MyIterator}()", "{", "\tyield return ${3:default};$0", "}"] },
  "fact": { "prefix": "fact", "description": "xUnit test", "body": ["[Fact]", "public void ${1:Test}()", "{", "\t$0", "}"] },
  "testm": { "prefix": "testm", "description": "MSTest test method", "body": ["[TestMethod]", "public void ${1:Test}()", "{", "\t$0", "}"] }
