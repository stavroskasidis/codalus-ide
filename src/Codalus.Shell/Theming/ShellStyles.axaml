<Styles xmlns:l="using:Codalus.Shell.Infrastructure"
             xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Codalus.Shell.Controls"
        xmlns:core="using:Dock.Model.Core"
        xmlns:docking="using:Codalus.Shell.Docking"
        xmlns:editing="using:AvaloniaEdit.Editing"
        xmlns:collections="using:System.Collections">
  <Styles.Resources>
    <!-- Dock's document tab strip takes its panel from this resource (a style can't replace it): ours fits (M34e). -->
    <ItemsPanelTemplate x:Key="DockDocumentTabStripHorizontalItemsPanel">
      <controls:DocumentTabPanel />
    </ItemsPanelTemplate>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Shell.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    <!-- A classic IDE's density: 9 pt UI text (M29, the Shell.FontSize tokens since M34d). -->
    <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Body}" />
  </Style>

  <!--
    Dock tab headers show the dockable title; preview tabs in italics, pinned tabs with a pin (M34d). The header
    templates and tab styles are typed to IShellTab, which documents and tool windows both are, since either can be
    dragged into the other kind of group or a floating window: a template typed to one kind didn't match the other, and
    Avalonia's search for another found the view locator, which put the whole view in the tab.
  -->
  <Style Selector="DocumentControl">
    <Setter Property="HeaderTemplate">
      <DataTemplate DataType="docking:IShellTab">
        <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding TabToolTip}">
          <controls:Icon Kind="{Binding TabIcon}" IsVisible="{Binding HasTabIcon}" Width="14" Height="14" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Title}" FontStyle="{Binding TitleFontStyle}" VerticalAlignment="Center" Padding="2" />
          <controls:Icon Kind="pin" IsVisible="{Binding IsPinned}" Width="12" Height="12" VerticalAlignment="Center" AutomationProperties.Name="{l:T shellStyles.pinned}" />
        </StackPanel>
      </DataTemplate>
    </Setter>
  </Style>
  <!--
    Tool window tabs fit their pane (FittingTabPanel): the widest shrink first and end in an ellipsis; tabs with no room
    left for a title show only their icon (the icon shows only then, the maintainer's rule). The tooltip has the name.
  -->
  <Style Selector="ToolControl">
    <Setter Property="HeaderTemplate">
      <DataTemplate DataType="docking:IShellTab">
        <StackPanel Orientation="Horizontal" ToolTip.Tip="{Binding Title}">
          <controls:Icon Classes="tabIcon" Kind="{Binding TabIcon}" Width="14" Height="14" VerticalAlignment="Center"
                         IsVisible="{Binding $parent[ToolTabStripItem].(controls:FittingTabPanel.IconOnly)}" />
          <TextBlock Classes="tabTitle" Text="{Binding Title}" Padding="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     IsVisible="{Binding !$parent[ToolTabStripItem].(controls:FittingTabPanel.IconOnly)}"
                     MaxWidth="{Binding $parent[ToolTabStripItem].(controls:FittingTabPanel.TitleMaxWidth)}" />
        </StackPanel>
      </DataTemplate>
    </Setter>
  </Style>
  <Style Selector="ToolTabStrip">
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <controls:FittingTabPanel />
      </ItemsPanelTemplate>
    </Setter>
  </Style>
  <!-- Dock scrolls the tabs sideways (hidden scroll bar), which gives them unlimited width: the panel needs the pane's. -->
  <Style Selector="ToolTabStrip /template/ ScrollViewer#PART_ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!--
    Document tabs (M34d): Dock's template, our colors in every state. Unselected tabs take Shell.Tab.Inactive (Blue's
    dark tabs), the selected tab of a pane without the focus Shell.Tab.Selected (its title was white on light gray in
    Light and black on black in High Contrast), the active one Shell.Tab.Active, or Shell.Tab.Preview when it previews.
    A tab colored by project has a stripe along its bottom edge. Styles outrank the control theme in any state, so
    every state is restated here, in order.
  -->
  <Style Selector="DocumentTabStripItem" x:DataType="docking:IShellTab">
    <Setter Property="Background" Value="{DynamicResource Shell.Tab.Inactive}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Tab.Inactive.Foreground}" />
    <Setter Property="(controls:DocumentTab.IsPreview)" Value="{Binding IsPreview}" />
    <Setter Property="(controls:DocumentTab.IsPinned)" Value="{Binding IsPinned}" />
    <Setter Property="BorderBrush" Value="{Binding TabAccent}" />
    <Setter Property="BorderThickness" Value="{Binding TabAccentThickness}" />
  </Style>
  <Style Selector="DocumentTabStripItem:pointerover:not(:selected)">
    <Setter Property="Background" Value="{DynamicResource Shell.Tab.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Tab.Hover.Foreground}" />
  </Style>
  <Style Selector="DocumentTabStripItem:selected">
    <Setter Property="Background" Value="{DynamicResource Shell.Tab.Selected}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Tab.Selected.Foreground}" />
  </Style>
  <Style Selector="DocumentTabStripItem:active:selected">
    <Setter Property="Background" Value="{DynamicResource Shell.Tab.Active}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Tab.Active.Foreground}" />
  </Style>
  <!-- The preview tab keeps its color whenever it's selected, focused or not (the Mac's review: it didn't stand out). -->
  <Style Selector="DocumentTabStripItem:selected[(controls|DocumentTab.IsPreview)=True]">
    <Setter Property="Background" Value="{DynamicResource Shell.Tab.Preview}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Tab.Preview.Foreground}" />
  </Style>
  <!--
    The active tab's indicator (M45, the family's shape): Harbor's 3 px accent bar on top, Graphite's 2 px underline,
    Ember's 1 px edge, none in Daylight and Classic. Every tab has the indicator's thickness, transparent, so the
    active one doesn't move; its corners follow Dock's (rounded in Daylight and Ember).
  -->
  <Style Selector="DocumentTabStripItem /template/ Border#PART_TabGutter">
    <Setter Property="BorderThickness" Value="{DynamicResource Shell.Tab.Active.Indicator}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource DockDocumentTabItemCornerRadius}" />
  </Style>
  <Style Selector="DocumentTabStripItem:active:selected /template/ Border#PART_TabGutter">
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Tab.Active.IndicatorBrush}" />
  </Style>
  <!--
    Document tabs fit the group (M34e): tabs that don't fit leave from the right, never a pinned or the selected one,
    instead of Dock's sideways scrolling that took pinned tabs out of view.
  -->

  <!-- Tool window tabs: a hover that keeps its text readable, and the selected tab's title in the link color. -->
  <Style Selector="ToolTabStripItem:pointerover:not(:selected)">
    <Setter Property="Background" Value="{DynamicResource Shell.Tab.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Tab.Hover.Foreground}" />
  </Style>
  <Style Selector="ToolTabStripItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Link}" />
  </Style>

  <!-- Tool window captions: Shell.Caption.Active with the focus, Shell.Caption.Inactive without (M34d). -->
  <Style Selector="ToolChromeControl /template/ Grid#PART_Grip">
    <Setter Property="Background" Value="{DynamicResource Shell.Caption.Inactive}" />
  </Style>
  <Style Selector="ToolChromeControl /template/ TextBlock#PART_Title">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Caption.Inactive.Foreground}" />
  </Style>
  <Style Selector="ToolChromeControl /template/ Path">
    <Setter Property="Fill" Value="{DynamicResource Shell.Caption.Inactive.Foreground}" />
  </Style>
  <!--
    The family's shapes (M45): Ember's tool windows and documents are cards with rounded corners, and the focused tool
    window's title is bold where the family has no caption color (Graphite, Daylight, Ember).
  -->
  <Style Selector="ToolChromeControl /template/ Border#PART_Border">
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Panel.CornerRadius.Top}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="ToolChromeControl /template/ DeferredContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Panel.CornerRadius.Bottom}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="DocumentControl /template/ Border#PART_Border">
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Panel.CornerRadius.Bottom}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="ToolChromeControl /template/ TextBlock#PART_Title">
    <Setter Property="Padding" Value="{DynamicResource Shell.Caption.Active.MarkerPadding}" />
  </Style>
  <Style Selector="ToolChromeControl:active /template/ TextBlock#PART_Title">
    <Setter Property="FontWeight" Value="{DynamicResource Shell.Caption.Active.FontWeight}" />
    <!-- Graphite's accent dot before the title (a brush, so Dock's template doesn't change). -->
    <Setter Property="Background" Value="{DynamicResource Shell.Caption.Active.Marker}" />
  </Style>
  <!-- The gutter between docked windows (M45): Harbor's 6 px and Ember's 8 px of window, Graphite's and Daylight's hairline. -->
  <Style Selector="ProportionalStackPanelSplitter">
    <Setter Property="Thickness" Value="{DynamicResource Shell.Gutter}" />
    <Setter Property="Background" Value="{DynamicResource Shell.Gutter.Background}" />
  </Style>
  <Style Selector="ToolChromeControl:active /template/ Grid#PART_Grip">
    <Setter Property="Background" Value="{DynamicResource Shell.Caption.Active}" />
  </Style>
  <Style Selector="ToolChromeControl:active /template/ TextBlock#PART_Title">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Caption.Active.Foreground}" />
  </Style>
  <Style Selector="ToolChromeControl:active /template/ Path">
    <Setter Property="Fill" Value="{DynamicResource Shell.Caption.Active.Foreground}" />
  </Style>

  <!-- Type (M34d): body text is the window's 12 px; .small for secondary text, .subheading and .heading for titles. -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Small}" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.subheading">
    <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="SelectableTextBlock.subheading">
    <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- An empty or error state's message: muted, wrapped, with room around it; a next step goes below it. -->
  <Style Selector="TextBlock.emptyState">
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="{DynamicResource Shell.Padding.EmptyState}" />
  </Style>


  <!--
    The control set (M34h, docs/design/controls.md): what Fluent's templates draw for fields, choices, tabs and rows,
    restyled from the Shell.* tokens; the buttons, check boxes, radio buttons, switches and the segmented control have
    their own control themes (Theming/Controls.axaml). A style outranks Fluent's control theme in any state, and a style
    with a class or a state outranks what a template sets, so each state is restated here. docs/ui-guidelines.md lists
    the classes.
  -->

  <!-- The primary button's icon is drawn in the accent's text, as its label. -->
  <Style Selector="Button.accent controls|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Shell.AccentForeground}" />
  </Style>
  <Style Selector="Button.accent:disabled controls|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
  </Style>

  <!--
    Text boxes: Shell.Input with a 1 px Shell.Input.Border that darkens under the pointer and becomes a 2 px accent edge
    with the focus; an error (a validation error, or the invalid class) draws it in Shell.Error; read-only is the panel's
    color; disabled is Shell.Disabled. Placeholders are the muted text at full opacity. 28 px high (24 in toolbars).
  -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Shell.Input}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Input.Border}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Shell.Foreground}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Shell.Input.Placeholder}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Control}" />
    <Setter Property="Padding" Value="8,5" />
  </Style>
  <Style Selector="TextBox:not(.unstyled) /template/ TextBlock#PART_Placeholder">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Shell.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Input.Border.Hover}" />
  </Style>
  <Style Selector="TextBox:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Shell.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Focus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox[IsReadOnly=True] /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Shell.Panel}" />
  </Style>
  <Style Selector="TextBox:error /template/ Border#PART_BorderElement, TextBox.invalid /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Error}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="TextBox:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
  </Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Shell.Disabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Disabled.Border}" />
  </Style>
  <Style Selector="TextBox:disabled /template/ TextBlock#PART_Placeholder">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
  </Style>
  <!--
    A search box (TextBox.search): a search icon, the placeholder naming what is searched, and a clear button once there
    is text. In a toolbar it takes the rest of the row.
  -->
  <Style Selector="TextBox.search">
    <Setter Property="Padding" Value="6,5,8,5" />
    <Setter Property="InnerLeftContent">
      <Template>
        <controls:Icon Kind="search" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Shell.MutedForeground}" />
      </Template>
    </Setter>
  </Style>
  <Style Selector="TextBox.search[IsReadOnly=False]:not(TextBox:empty)">
    <Setter Property="InnerRightContent">
      <Template>
        <Button Classes="subtle" Command="{Binding $parent[TextBox].Clear}" Focusable="False" Padding="0"
                Width="18" Height="18" MinWidth="18" MinHeight="18" Margin="0,0,4,0" VerticalAlignment="Center"
                ToolTip.Tip="{l:T shellStyles.clearSearch}" AutomationProperties.Name="{l:T shellStyles.clearSearch}">
          <controls:Icon Kind="close" Width="12" Height="12" Foreground="{DynamicResource Shell.MutedForeground}" />
        </Button>
      </Template>
    </Setter>
  </Style>
  <!-- Validation errors say what to do under the field, with the error icon, in the error text color. -->
  <Style Selector="DataValidationErrors">
    <Setter Property="ErrorTemplate">
      <DataTemplate x:DataType="collections:IEnumerable">
        <ItemsControl ItemsSource="{Binding}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:Object">
              <DockPanel Margin="0,4,0,0" TextElement.Foreground="{DynamicResource Shell.Error.Foreground}" TextElement.FontSize="{DynamicResource Shell.FontSize.Small}">
                <controls:Icon Kind="error" Classes="error" Width="12" Height="12" Margin="0,1,4,0" VerticalAlignment="Top" DockPanel.Dock="Left" />
                <TextBlock Text="{Binding Converter={x:Static controls:ValidationMessage.Converter}}" TextWrapping="Wrap" />
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DataTemplate>
    </Setter>
  </Style>

  <!--
    Combo boxes: the field with a 12 px chevron; open or focused from the keyboard, the field keeps the focus edge. The
    list's rows are 24 px, the chosen one in the selection's colors.
  -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Shell.Input}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Input.Border}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Control}" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource Shell.Input.Placeholder}" />
  </Style>
  <Style Selector="ComboBox:not(.unstyled) /template/ PathIcon#DropDownGlyph">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Margin" Value="0,0,9,0" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
  </Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background, ComboBox:pressed /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Shell.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Input.Border.Hover}" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <!-- An editable one takes the focus edge whenever its text box has the focus, as a text box does. -->
  <Style Selector="ComboBox:focus-visible /template/ Border#Background, ComboBox:dropdownopen /template/ Border#Background, ComboBox[IsEditable=True]:focus-within /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Focus}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ComboBox:focus-visible /template/ ContentControl#ContentPresenter, ComboBox:focus:pressed /template/ ContentControl#ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
  </Style>
  <Style Selector="ComboBox:error /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Error}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Shell.Disabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Disabled.Border}" />
  </Style>
  <Style Selector="ComboBox:disabled /template/ ContentControl#ContentPresenter, ComboBox:disabled /template/ TextBlock#PlaceholderTextBlock, ComboBox:disabled /template/ PathIcon#DropDownGlyph">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
  </Style>
  <!--
    An editable combo box (Find and Replace's Find what, Look in and File types): its text box is part of the field, not a
    text box of its own. The combo's border draws the hover and focus edges around the text and the chevron as one, as a
    text box's do; the text box draws no fill or border over it (the text boxes' hover fill hid the combo's border along
    the text, their focus edge stopped at the chevron). The text box fills the field's height and draws its text and
    placeholder in the middle of it, not at its top.
  -->
  <Style Selector="ComboBox[IsEditable=True] /template/ TextBox#PART_EditableTextBox">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox /template/ TextBox#PART_EditableTextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ComboBox /template/ TextBox#PART_EditableTextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ComboBox /template/ TextBox#PART_EditableTextBox:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource Shell.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Overlay.Border}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.CornerRadius.Overlay}" />
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Selection}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Foreground}" />
  </Style>

  <!--
    Tabs inside a view (TabControl, 28 px): different content (Body, Headers, Request), not a view switch (that is a
    SegmentedControl). Muted until selected; the selected one bold with a 2 px accent underline. Counts go in a
    Border.badge in the header, which takes the accent on the selected tab.
  -->
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Body}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Tab}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusAdorner" Value="{StaticResource Shell.FocusRing}" />
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot, TabItem:pressed /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Hover}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.Foreground}" />
  </Style>
  <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
    <Setter Property="Background" Value="{DynamicResource Shell.Accent}" />
    <Setter Property="Height" Value="2" />
    <Setter Property="Margin" Value="-4,0,-4,0" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="TabItem:disabled /template/ Border#PART_LayoutRoot">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
  </Style>
  <Style Selector="TabItem:selected Border.badge">
    <Setter Property="Background" Value="{DynamicResource Shell.Accent}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.AccentForeground}" />
  </Style>

  <!--
    Rows of lists and trees: Shell.Row.Hover under the pointer (quieter than a control's hover, so colored text stays AA;
    High contrast outlines it), Shell.Selection, and Shell.Selection.Inactive when the list hasn't the focus; a 1 px
    outline in Shell.Focus marks the keyboard's row. ListBox.rows gives a list the design's 22 px rows.
  -->
  <Style Selector="ListBoxItem">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border BorderThickness="1" BorderBrush="{DynamicResource Shell.Focus}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Row.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shell.Row.Hover.Outline}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Selection}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Row}" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TreeViewItem:not(:selected) /template/ Border#PART_LayoutRoot:pointerover">
    <Setter Property="Background" Value="{DynamicResource Shell.Row.Hover}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shell.Row.Hover.Outline}" />
  </Style>
  <Style Selector="TreeViewItem:not(:selected) /template/ Border#PART_LayoutRoot:pointerover > ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
  </Style>

  <!--
    Chips say a state in a word (200 OK, Fault, GET) on a Shell.Status.* tint: Border.chip with .success, .error,
    .warning or .info (none: neutral), .square for a method; badges are counts (Border.badge). Color never carries the
    meaning alone; High contrast outlines both.
  -->
  <!--
    A table's column header row (the control set's views, M34h): 24 px on Shell.Grid.Header with a Shell.Grid.Rule under
    it, its labels muted and semibold.
  -->
  <Style Selector="Border.gridHeader">
    <Setter Property="Background" Value="{DynamicResource Shell.Grid.Header}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Grid.Rule}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Border.gridHeader TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="BorderThickness" Value="{DynamicResource Shell.Chip.BorderThickness}" />
    <Setter Property="Background" Value="{DynamicResource Shell.Badge}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Badge.Foreground}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.Badge.Foreground}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource Shell.FontSize.Small}" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.chip.square">
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
  </Style>
  <Style Selector="Border.chip.success">
    <Setter Property="Background" Value="{DynamicResource Shell.Status.Success}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Status.Success.Foreground}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.Status.Success.Foreground}" />
  </Style>
  <Style Selector="Border.chip.error">
    <Setter Property="Background" Value="{DynamicResource Shell.Status.Error}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Status.Error.Foreground}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.Status.Error.Foreground}" />
  </Style>
  <Style Selector="Border.chip.warning">
    <Setter Property="Background" Value="{DynamicResource Shell.Status.Warning}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Status.Warning.Foreground}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.Status.Warning.Foreground}" />
  </Style>
  <Style Selector="Border.chip.info">
    <Setter Property="Background" Value="{DynamicResource Shell.Status.Info}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Status.Info.Foreground}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.Status.Info.Foreground}" />
  </Style>
  <Style Selector="Border.chip controls|Icon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="BorderThickness" Value="{DynamicResource Shell.Chip.BorderThickness}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
    <Setter Property="Background" Value="{DynamicResource Shell.Badge}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.Badge.Foreground}" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource Shell.FontSize.Small}" />
    <Setter Property="TextElement.FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.chip > TextBlock, Border.badge > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Inline code in rendered Markdown (MarkdownRenderer): the code font on a badge's quiet fill. -->
  <Style Selector="Run.code">
    <Setter Property="Background" Value="{DynamicResource Shell.Badge}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Badge.Foreground}" />
  </Style>

  <!--
    A composer (Border.composer, M34h, AI Chat): one field that holds a multi-line text box and a row of its own
    actions under the text (a hint, Send). It draws the text box's look around both: Shell.Input with its border,
    darker under the pointer, and the 2 px focus edge while anything in it has the focus; the text box inside is bare.
  -->
  <Style Selector="Border.composer">
    <Setter Property="Background" Value="{DynamicResource Shell.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Input.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.CornerRadius.Overlay}" />
    <Setter Property="Padding" Value="10,8,8,6" />
  </Style>
  <Style Selector="Border.composer:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Input.Border.Hover}" />
  </Style>
  <Style Selector="Border.composer:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Focus}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="9,7,7,5" />
  </Style>
  <Style Selector="Border.composer TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="36" />
  </Style>
  <Style Selector="Border.composer TextBox /template/ Border#PART_BorderElement, Border.composer TextBox:pointerover /template/ Border#PART_BorderElement, Border.composer TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!--
    An empty or error state (StackPanel.emptyState): an icon (32 px), one sentence, and the next step as a button or a
    link, centered.
  -->
  <Style Selector="StackPanel.emptyState">
    <Setter Property="Spacing" Value="10" />
    <Setter Property="Margin" Value="24" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.emptyState > controls|Icon">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.emptyState > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="MaxWidth" Value="360" />
  </Style>
  <Style Selector="StackPanel.emptyState > Button">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- A dialog's button row (Border.dialogFooter) and a key in a hint (Border.kbd). -->
  <Style Selector="Border.dialogFooter">
    <Setter Property="Background" Value="{DynamicResource Shell.Dialog.Footer}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="{DynamicResource Shell.Padding.DialogFooter}" />
  </Style>
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource Shell.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
    <Setter Property="BorderThickness" Value="1,1,1,2" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextElement.FontSize" Value="{DynamicResource Shell.FontSize.Small}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.Foreground}" />
  </Style>

  <!-- Tool window toolbars (M34d): one row that never wraps (ToolbarPanel), 24 px buttons with 16 px icons. -->
  <Style Selector="controls|ToolbarPanel">
    <Setter Property="Margin" Value="{DynamicResource Shell.Padding.Toolbar}" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
  </Style>
  <Style Selector="controls|ToolbarPanel > TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Input}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|ToolbarPanel > ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Input}" />
    <Setter Property="Height" Value="{DynamicResource Shell.Size.Input}" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <!-- An editable combo box in a toolbar (Counters' process box, M34h): its text box fits the 24 px field. -->
  <Style Selector="controls|ToolbarPanel > ComboBox /template/ TextBox#PART_EditableTextBox">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="controls|ToolbarPanel > Button:not(.toolbar)">
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
    <Setter Property="Padding" Value="8,2" />
  </Style>
  <!--
    Toolbar buttons and toggles (M34d, the control set's since M34h): flat 24 px squares, Shell.Toolbar.Hover under the
    pointer with its border, Shell.Toolbar.Pressed while pressed; a checked toggle is a tint with an accent edge
    (Shell.Toolbar.Checked), not a solid accent block; disabled, a dimmed icon, not a gray box. With classes icon or
    iconText and controls:ButtonIcon.Kind they draw their icon (and text) themselves.
  -->
  <Style Selector="Button.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="{DynamicResource Shell.Padding.ToolbarButton}" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
    <Setter Property="MinWidth" Value="{DynamicResource Shell.Size.ToolbarButton}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
  </Style>
  <Style Selector="Button.toolbar.iconText, ToggleButton.toolbar.iconText">
    <Setter Property="Padding" Value="5,0,7,0" />
  </Style>
  <!-- The Start button (M45): filled with the accent in Daylight, on the toolbar's color elsewhere. -->
  <Style Selector="Button.toolbar.start">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Start}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Toolbar.Start.Foreground}" />
  </Style>
  <Style Selector="Button.toolbar.start controls|Icon.start">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Toolbar.Start.Icon}" />
  </Style>
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Hover.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
  </Style>
  <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Pressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Hover.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
  </Style>
  <Style Selector="ToggleButton.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="{DynamicResource Shell.Padding.ToolbarButton}" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
    <Setter Property="MinWidth" Value="{DynamicResource Shell.Size.ToolbarButton}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
  </Style>
  <Style Selector="ToggleButton.toolbar:checked /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Checked}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Checked.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Toolbar.Checked.Foreground}" />
  </Style>
  <Style Selector="Button.toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.toolbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
  </Style>
  <!--
    A split button (the control set): the default button's look with its arrow; in a toolbar (the Hot Reload button and
    its menu's arrow) flat like the buttons beside it. Its two parts are Buttons in its template that Fluent styles
    itself, so every state is restated on their presenters: the hover color and border under the pointer or pressed or
    while the menu is open, and the disabled look. The tokens differ per theme, High Contrast included.
  -->
  <Style Selector="SplitButton">
    <Setter Property="Background" Value="{DynamicResource Shell.Button}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Button.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Button.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Control}" />
    <Setter Property="Padding" Value="{DynamicResource Shell.Padding.Button}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
    <Setter Property="FocusAdorner" Value="{StaticResource Shell.FocusRing}" />
  </Style>
  <Style Selector="SplitButton.compact">
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
    <Setter Property="Padding" Value="{DynamicResource Shell.Padding.ButtonCompact}" />
  </Style>
  <Style Selector="SplitButton /template/ Button#PART_SecondaryButton">
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Padding" Value="4,0" />
  </Style>
  <Style Selector="SplitButton /template/ Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Button.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Button.Hover.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Button.Foreground}" />
  </Style>
  <Style Selector="SplitButton /template/ Button:pressed /template/ ContentPresenter#PART_ContentPresenter, SplitButton:flyout-open /template/ Button#PART_SecondaryButton /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Button.Pressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Button.Pressed.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Button.Foreground}" />
  </Style>
  <Style Selector="SplitButton:disabled /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Disabled}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Disabled.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
  </Style>
  <Style Selector="SplitButton /template/ Border#SeparatorBorder">
    <Setter Property="Background" Value="{DynamicResource Shell.Button.Border}" />
  </Style>
  <Style Selector="SplitButton.toolbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="{DynamicResource Shell.Padding.ToolbarButton}" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
  </Style>
  <Style Selector="SplitButton.toolbar /template/ Button#PART_PrimaryButton">
    <Setter Property="MinWidth" Value="{DynamicResource Shell.Size.ToolbarButton}" />
  </Style>
  <Style Selector="SplitButton.toolbar /template/ Button#PART_SecondaryButton">
    <Setter Property="MinWidth" Value="14" />
    <Setter Property="Padding" Value="1,0" />
  </Style>
  <Style Selector="SplitButton.toolbar /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="SplitButton.toolbar:pointerover /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Hover.Border}" />
  </Style>
  <Style Selector="SplitButton.toolbar /template/ Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Hover.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
  </Style>
  <Style Selector="SplitButton.toolbar /template/ Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Pressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Hover.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
  </Style>
  <Style Selector="SplitButton.toolbar:flyout-open /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Pressed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Hover.Border}" />
  </Style>
  <Style Selector="SplitButton.toolbar /template/ Border#SeparatorBorder">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="SplitButton.toolbar:pointerover /template/ Border#SeparatorBorder, SplitButton.toolbar:flyout-open /template/ Border#SeparatorBorder">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Hover.Border}" />
  </Style>
  <Style Selector="SplitButton.toolbar:disabled /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ToolTip">
    <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Body}" />
  </Style>
  <!-- A selected row's text is Shell.Selection.Foreground (M45: a High contrast family selects with its accent, black text). -->
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Foreground}" />
  </Style>
  <!--
    M34g: secondary text on a selected row (a result's detail, a command's kind) is the selection's text too: the muted
    gray was 3:1 on Classic's selection and 1:1 on a High contrast family's accent. A tree's selected header takes the
    selection's text as well (Fluent left it the window's: white on a High contrast family's accent).
  -->
  <Style Selector="ListBoxItem:selected TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Foreground}" />
  </Style>
  <!--
    M34g on M43: a muted run after a name (a project's "(non-SDK-style)", a test's detail, a reference's kind) is
    muted text too, and the selection's on a selected row: as a run in the muted color it was 1.03:1 on a High contrast
    family's selection and 4.29:1 on Classic Dark's.
  -->
  <Style Selector="Run.muted">
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
  </Style>
  <Style Selector="ListBoxItem:selected Run.muted">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Foreground}" />
  </Style>
  <!--
    The matched characters of a search result (HighlightedText): Shell.Match, and the selection's text on a selected
    row, still bold. In Shell.Match on Code Search's selected result they were 1.00:1 in Daylight High contrast and
    2.98:1 in Classic Dark (found once the rendered contrast check read runs, M34g on M43).
  -->
  <Style Selector="TextBlock.highlighted">
    <Setter Property="controls:HighlightedText.MatchForeground" Value="{DynamicResource Shell.Match}" />
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock.highlighted">
    <Setter Property="controls:HighlightedText.MatchForeground" Value="{DynamicResource Shell.Selection.Foreground}" />
  </Style>
  <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource TreeViewItemForegroundSelected}" />
  </Style>
  <!--
    M34h: a list or tree without the focus keeps its selection as Shell.Selection.Inactive, quieter, with its own text;
    the secondary text and matched characters on it take that text too. After the styles above, which they override.
  -->
  <Style Selector="ListBox:not(:focus-within) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Selection.Inactive}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Inactive.Foreground}" />
  </Style>
  <Style Selector="ListBox:not(:focus-within) ListBoxItem:selected TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Inactive.Foreground}" />
  </Style>
  <Style Selector="ListBox:not(:focus-within) ListBoxItem:selected Run.muted">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Inactive.Foreground}" />
  </Style>
  <Style Selector="ListBox:not(:focus-within) ListBoxItem:selected TextBlock.highlighted">
    <Setter Property="controls:HighlightedText.MatchForeground" Value="{DynamicResource Shell.Selection.Inactive.Foreground}" />
  </Style>
  <Style Selector="TreeView:not(:focus-within) TreeViewItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Shell.Selection.Inactive}" />
  </Style>
  <Style Selector="TreeView:not(:focus-within) TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Inactive.Foreground}" />
  </Style>
  <!-- Error and warning messages (M34g): the state colors made readable as text (4.5:1, 7:1 in a family's High contrast). -->
  <Style Selector="TextBlock.error, SelectableTextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Error.Foreground}" />
  </Style>
  <Style Selector="TextBlock.warning, SelectableTextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Warning.Foreground}" />
  </Style>

  <!-- The status bar's color says the state: purple without a solution, the accent with one, orange while debugging. -->
  <Style Selector="Border#StatusBarHost">
    <Setter Property="Background" Value="{DynamicResource Shell.StatusBar}" />
  </Style>
  <Style Selector="Border#StatusBarHost.empty">
    <Setter Property="Background" Value="{DynamicResource Shell.StatusBar.Empty}" />
  </Style>
  <Style Selector="Border#StatusBarHost.debugging">
    <Setter Property="Background" Value="{DynamicResource Shell.StatusBar.Debugging}" />
  </Style>

  <!-- The title row, the standard toolbar and the search box (M29). -->
  <Style Selector="Border.titleBar">
    <Setter Property="Background" Value="{DynamicResource Shell.TitleBar}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.TitleBar.Foreground}" />
    <Setter Property="MinHeight" Value="32" />
  </Style>
  <Style Selector="Border.titleBar Menu">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!--
    The menu bar's items take the title bar's text and hover colors (M45: Harbor Light's title bar is navy); their
    menus keep the menus' own.
  -->
  <Style Selector="Border.titleBar Menu > MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Shell.TitleBar.Foreground}" />
  </Style>
  <Style Selector="Border.titleBar Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot, Border.titleBar Menu > MenuItem:selected /template/ Border#PART_LayoutRoot, Border.titleBar Menu > MenuItem:open /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource Shell.TitleBar.Hover}" />
  </Style>
  <Style Selector="Border.titleBar Menu > MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter, Border.titleBar Menu > MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter, Border.titleBar Menu > MenuItem:open /template/ ContentPresenter#PART_HeaderPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Shell.TitleBar.Foreground}" />
  </Style>
  <Style Selector="Button.searchBox TextBlock.searchText">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Search.Foreground}" />
  </Style>
  <Style Selector="Button.searchBox controls|Icon">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Search.Foreground}" />
  </Style>
  <Style Selector="Button.searchBox:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.searchBox:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Search}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Focus}" />
  </Style>
  <!-- Avalonia's drawn decorations write the window's title over the client area; our title row has the menu there
       (the solution's name is shown next to the search box). A trigger selector outranks the template's binding. -->
  <Style Selector="WindowDrawnDecorations:not(:fullscreen) /template/ Panel#PART_TitleTextPanel">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.standardToolbar">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.toolbarSeparator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="4,4" />
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Border}" />
  </Style>
  <Style Selector="ComboBox.toolbar">
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Input}" />
    <Setter Property="Height" Value="{DynamicResource Shell.Size.Input}" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- The editor's navigation bar (M34a): flat pickers, a border only on hover, a small chevron, the tabs' height. -->
  <Style Selector="Border.navigationBar">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="2,1" />
  </Style>
  <Style Selector="ComboBox.navigationBar">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="6,0,4,0" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox.navigationBar /template/ Border#Background">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="ComboBox.navigationBar:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Shell.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
  </Style>
  <Style Selector="ComboBox.navigationBar:dropdownopen /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource Shell.Selection}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Focus}" />
  </Style>
  <Style Selector="ComboBox.navigationBar:focus-visible /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Focus}" />
  </Style>
  <Style Selector="ComboBox.navigationBar /template/ PathIcon#DropDownGlyph">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
  </Style>
  <!-- Combo box placeholders (M34g): the muted token at full opacity, 4.5:1 (7:1 in the families' High contrast), not
       Fluent's text at half opacity (2.1–2.8:1): the navigation bar's "Members" while the caret is outside a member,
       Project Properties' "Default". The template sets the opacity, which only a style with a condition overrides;
       disabled ones keep Fluent's disabled look. -->
  <Style Selector="ComboBox:not(:disabled) /template/ TextBlock#PlaceholderTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ComboBox.navigationBar ComboBoxItem">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="controls|Icon.start">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Run}" />
  </Style>
  <Style Selector="controls|Icon.stop">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Stop}" />
  </Style>

  <!-- Command families color their icons (M34a, D24): the tokens are monochrome in High Contrast. -->
  <Style Selector="controls|Icon.accent-run">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Run}" />
  </Style>
  <Style Selector="controls|Icon.accent-stop">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Stop}" />
  </Style>
  <Style Selector="controls|Icon.accent-save">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Save}" />
  </Style>
  <Style Selector="controls|Icon.accent-open">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Open}" />
  </Style>
  <Style Selector="controls|Icon.accent-build">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Build}" />
  </Style>
  <Style Selector="controls|Icon.accent-git">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Git}" />
  </Style>
  <Style Selector="controls|Icon.accent-test">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Test}" />
  </Style>
  <Style Selector="controls|Icon.accent-navigate">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Navigate}" />
  </Style>
  <!-- The palette's colors as accents, for icons whose family is a color. -->
  <Style Selector="controls|Icon.accent-blue">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Blue}" />
  </Style>
  <Style Selector="controls|Icon.accent-green">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Green}" />
  </Style>
  <Style Selector="controls|Icon.accent-red">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Red}" />
  </Style>
  <Style Selector="controls|Icon.accent-orange">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Orange}" />
  </Style>
  <Style Selector="controls|Icon.accent-purple">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Purple}" />
  </Style>
  <Style Selector="controls|Icon.accent-yellow">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Yellow}" />
  </Style>
  <Style Selector="controls|Icon.accent-folder">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Icon.Folder}" />
  </Style>
  <!-- Disabled commands dim their icons, colored or not. -->
  <Style Selector="MenuItem:disabled controls|Icon">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button:disabled controls|Icon">
    <Setter Property="Opacity" Value="0.4" />
  </Style>
  <Style Selector="Button.searchBox">
    <Setter Property="Background" Value="{DynamicResource Shell.Search}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Search.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinWidth" Value="220" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.solutionName">
    <Setter Property="Background" Value="{DynamicResource Shell.TitleBar.Chip}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="4,0" />
  </Style>

  <!-- Status bar entries. -->
  <Style Selector="Button.statusbar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.StatusBar.Foreground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="8,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.statusbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.StatusBar.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.StatusBar.Foreground}" />
  </Style>
  <Style Selector="Button.statusbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.StatusBar.Hover}" />
  </Style>
  <!-- Items without a command are plain text, not disabled buttons. -->
  <Style Selector="Button.statusbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.StatusBar.Foreground}" />
  </Style>

  <!-- Links (Settings UI, Markdown views). -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Link}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- A link navigates, never runs a command: underlined under the pointer (thicker while pressed), no fill. -->
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Link}" />
  </Style>
  <Style Selector="Button.link:pointerover TextBlock, Button.link:pressed TextBlock">
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <!-- A disabled link is dimmed text, not a gray box. -->
  <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
  </Style>

  <!-- Floating surfaces: command palette and toasts. -->
  <Style Selector="Border.overlay">
    <Setter Property="Background" Value="{DynamicResource Shell.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Overlay.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="BoxShadow" Value="0 6 18 0 #40000000" />
  </Style>

  <Style Selector="controls|Icon.info">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Info}" />
  </Style>
  <Style Selector="controls|Icon.warning">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Warning}" />
  </Style>
  <Style Selector="controls|Icon.error">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Error}" />
  </Style>
  <!-- Test outcomes: color and shape both carry the outcome (accessibility). -->
  <Style Selector="controls|Icon.passed">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Diff.Added}" />
  </Style>
  <Style Selector="controls|Icon.failed">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Error}" />
  </Style>
  <Style Selector="controls|Icon.skipped">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Warning}" />
  </Style>
  <Style Selector="controls|Icon.running">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Info}" />
  </Style>
  <Style Selector="controls|Icon.none">
    <Setter Property="Foreground" Value="{DynamicResource Shell.MutedForeground}" />
  </Style>
  <!-- Quick Info and diagnostics popup in the editor. -->
  <Style Selector="Border.editorHover">
    <Setter Property="Background" Value="{DynamicResource Shell.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Overlay.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <!--
    IntelliSense (M49): the completion list, its description tooltip, signature help and Quick Info, as a classic IDE draws
    them. A thin border on the overlay color with the family's control corners; the window manager adds the shadow (the
    popups set WindowManagerAddShadowHint). Code inside takes the editor's own colors (ClassifiedInlines).
  -->
  <Style Selector="Border.intelliSense">
    <Setter Property="Background" Value="{DynamicResource Shell.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Overlay.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.Foreground}" />
  </Style>
  <Style Selector="Border.intelliSense.completionPopup">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="240" />
    <Setter Property="MaxWidth" Value="560" />
  </Style>
  <Style Selector="Border.intelliSense.signatureHelp">
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="ListBox.completion">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.completion ListBoxItem">
    <Setter Property="Height" Value="{DynamicResource Shell.Size.Row}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0,0,8,0" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="ListBox.completion ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Row.Hover}" />
  </Style>
  <!-- The selection stays the active one though the list never has the focus (the editor keeps it), with an accent bar. -->
  <Style Selector="ListBox.completion ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.completion ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Selection}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Foreground}" />
  </Style>
  <Style Selector="Border.completionAccent">
    <Setter Property="Width" Value="3" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.completion ListBoxItem:selected Border.completionAccent">
    <Setter Property="Background" Value="{DynamicResource Shell.Accent}" />
  </Style>
  <Style Selector="ListBox.completion ListBoxItem:selected TextBlock.highlighted">
    <Setter Property="controls:HighlightedText.MatchForeground" Value="{DynamicResource Shell.Selection.Foreground}" />
  </Style>
  <Style Selector="ListBox.completion ListBoxItem:selected TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Selection.Foreground}" />
  </Style>
  <Style Selector="Border.completionFilters">
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="ToggleButton.completionFilter">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="2" />
  </Style>
  <Style Selector="Border.intelliSense.completionTip">
    <Setter Property="MaxWidth" Value="500" />
  </Style>
  <Style Selector="Button.signatureChevron">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.signatureChevron:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Hover}" />
  </Style>
  <Style Selector="Border.quickInfoSeparator">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Shell.Border}" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="Button.quickInfoAction">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Link}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="2,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.quickInfoAction:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.quickInfoAction:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Link}" />
  </Style>

  <!-- A running task in the status bar (M22a): a green bar on a light track, as the classic IDE shows it, and flat buttons. -->
  <Style Selector="ProgressBar#StatusProgress">
    <Setter Property="Foreground" Value="#16C60C" />
    <Setter Property="Background" Value="#E6FFFFFF" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.statusCancel">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.StatusBar.Foreground}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.statusCancel:pointerover /template/ ContentPresenter, Button.statusCancel:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.StatusBar.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.StatusBar.Foreground}" />
  </Style>
  <!--
    The status bar's states each have their text color (M45): Ember's bar is the window's color with dark text, white
    only while debugging, and a High contrast bar without a solution is black under white text. Last in the file:
    they override the entries' and the cancel button's styles above (the later style wins).
  -->
  <Style Selector="Border#StatusBarHost TextBlock.statusMessage">
    <Setter Property="Foreground" Value="{DynamicResource Shell.StatusBar.Foreground}" />
  </Style>
  <Style Selector="Border#StatusBarHost.empty TextBlock.statusMessage, Border#StatusBarHost.empty Button.statusbar, Border#StatusBarHost.empty Button.statusCancel">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.StatusBar.Empty.Foreground}" />
  </Style>
  <Style Selector="Border#StatusBarHost.debugging TextBlock.statusMessage, Border#StatusBarHost.debugging Button.statusbar, Border#StatusBarHost.debugging Button.statusCancel">
    <Setter Property="TextElement.Foreground" Value="{DynamicResource Shell.StatusBar.Debugging.Foreground}" />
  </Style>
  <Style Selector="Border#StatusBarHost.empty Button.statusbar:pointerover /template/ ContentPresenter#PART_ContentPresenter, Border#StatusBarHost.empty Button.statusbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.StatusBar.Empty.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.StatusBar.Empty.Foreground}" />
  </Style>
  <Style Selector="Border#StatusBarHost.debugging Button.statusbar:pointerover /template/ ContentPresenter#PART_ContentPresenter, Border#StatusBarHost.debugging Button.statusbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Shell.StatusBar.Debugging.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.StatusBar.Debugging.Foreground}" />
  </Style>
  <Style Selector="Border#StatusBarHost.empty Button.statusbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Shell.StatusBar.Empty.Foreground}" />
  </Style>
  <Style Selector="Border#StatusBarHost.debugging Button.statusbar:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource Shell.StatusBar.Debugging.Foreground}" />
  </Style>
  <!-- Ember's state dot: the accent with a solution, muted without one, the bar's text color while debugging. -->
  <Style Selector="Border#StatusBarHost Ellipse.statusDot">
    <Setter Property="IsVisible" Value="{DynamicResource Shell.StatusBar.ShowDot}" />
    <Setter Property="Fill" Value="{DynamicResource Shell.Accent}" />
  </Style>
  <Style Selector="Border#StatusBarHost.empty Ellipse.statusDot">
    <Setter Property="Fill" Value="{DynamicResource Shell.MutedForeground}" />
  </Style>
  <Style Selector="Border#StatusBarHost.debugging Ellipse.statusDot">
    <Setter Property="Fill" Value="{DynamicResource Shell.StatusBar.Debugging.Foreground}" />
  </Style>

  <!--
    AvaloniaEdit's text area template without its watermark (no editor has one). The watermark's visibility was bound to
    the document's Text, which builds the whole document as a string on every change and keeps the last one: 6 MB per
    keystroke in a 100k-line file, and per append in the Output window. The rest is AvaloniaEdit 12's template.
  -->
  <Style Selector="editing|TextArea">
    <Setter Property="Template">
      <ControlTemplate TargetType="editing:TextArea">
        <DockPanel Focusable="False" Background="{TemplateBinding Background}">
          <ItemsControl DockPanel.Dock="Left" Focusable="False" ItemsSource="{TemplateBinding LeftMargins}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Panel>
            <ContentPresenter Name="PART_CP" Cursor="IBeam" Focusable="False" Background="{TemplateBinding Background}" />
          </Panel>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <!--
    Buttons attached to the field they act on (the control set's views, M34h: Configuration Manager's New… and Remove on
    their combo box): one shape with the control set's corners, its inner joints square.
    <Border Classes="attached"><StackPanel Orientation="Horizontal"><ComboBox …/><Button Classes="icon" …/></StackPanel></Border>
  -->
  <Style Selector="Border.attached">
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.attached > StackPanel > ComboBox, Border.attached > StackPanel > TextBox, Border.attached > StackPanel > Button">
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Border.attached > StackPanel > Button">
    <Setter Property="Margin" Value="-1,0,0,0" />
    <!-- The shape clips: the ring would be cut to it. -->
    <Setter Property="FocusAdorner" Value="{StaticResource Shell.FocusRing.Unclipped}" />
  </Style>
</Styles>
