<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:Codalus.Shell.Controls">
  <!--
    The control set (M34h, docs/design/controls.md, approved 2026-10-18): one look for buttons, fields and choices, in
    every state and theme, from the Shell.* tokens (Theming/Tokens.axaml). These control themes replace Fluent's for
    Button, ToggleButton, DropDownButton, CheckBox, RadioButton and ToggleSwitch, so a plain control gets the look
    without a class; ShellStyles.axaml restyles text boxes, combo boxes, split buttons, tabs and rows over Fluent's
    templates, and holds the classes a view picks from (docs/ui-guidelines.md, "The control set").
  -->

  <!--
    The focus ring: 2 px in Shell.Focus, 1 px outside the control, so it reads on any fill. The adorner layer gives the
    adorner the control's size, so the ring is a child that its negative margin grows past it.
  -->
  <FocusAdornerTemplate x:Key="Shell.FocusRing">
    <Panel>
      <Border BorderThickness="{DynamicResource Shell.Focus.Thickness}"
              BorderBrush="{DynamicResource Shell.Focus}"
              Margin="{DynamicResource Shell.Focus.Margin}"
              CornerRadius="{DynamicResource Shell.Focus.CornerRadius}" />
    </Panel>
  </FocusAdornerTemplate>

  <!--
    The ring for a control inside a clipping shape (Border.attached, M34h): the adorner layer would clip the ring to the
    shape, so this one draws past it.
  -->
  <FocusAdornerTemplate x:Key="Shell.FocusRing.Unclipped">
    <Panel AdornerLayer.IsClipEnabled="False">
      <Border BorderThickness="{DynamicResource Shell.Focus.Thickness}"
              BorderBrush="{DynamicResource Shell.Focus}"
              Margin="{DynamicResource Shell.Focus.Margin}"
              CornerRadius="{DynamicResource Shell.Focus.CornerRadius}" />
    </Panel>
  </FocusAdornerTemplate>

  <!-- A button's content with controls:ButtonIcon.Kind: the icon alone (class icon), or the icon and the text (iconText). -->
  <DataTemplate x:Key="Shell.Button.IconTemplate">
    <controls:Icon Kind="{Binding $parent[ContentControl].(controls:ButtonIcon.Kind)}" Width="16" Height="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
  </DataTemplate>
  <DataTemplate x:Key="Shell.Button.IconTextTemplate">
    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Shell.Space.ButtonIcon}">
      <controls:Icon Kind="{Binding $parent[ContentControl].(controls:ButtonIcon.Kind)}" Width="16" Height="16" VerticalAlignment="Center" />
      <ContentPresenter Content="{Binding $parent[ContentControl].Content}" VerticalAlignment="Center" />
    </StackPanel>
  </DataTemplate>
  <!-- A chip toggle's content (ToggleButton.chip): a 12 px icon and the text. -->
  <DataTemplate x:Key="Shell.Button.ChipTemplate">
    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Shell.Space.S}">
      <controls:Icon Kind="{Binding $parent[ContentControl].(controls:ButtonIcon.Kind)}" Width="12" Height="12" VerticalAlignment="Center" />
      <ContentPresenter Content="{Binding $parent[ContentControl].Content}" VerticalAlignment="Center" />
    </StackPanel>
  </DataTemplate>

  <!--
    Buttons. The default is every text button; .accent is the primary (the one main action in view); .subtle is flat
    until hovered; .icon is a square with an icon (a tooltip and an AutomationProperties.Name name it); .iconText has the
    icon before its text; .compact is the 24 px size of tool windows and dense rows; .dialog is a button row's (80 px at
    least). 28 px high, Shell.Control.CornerRadius corners, the focus ring outside.
  -->
  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Shell.Button}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Button.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Button.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
    <Setter Property="Padding" Value="{DynamicResource Shell.Padding.Button}" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Control}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{StaticResource Shell.FocusRing}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          RecognizesAccessKey="True"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Shell.Button.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Button.Hover.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.Button.Foreground}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Shell.Button.Pressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Button.Pressed.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.Button.Foreground}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Shell.Disabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Disabled.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
    </Style>

    <Style Selector="^.accent">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Shell.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.AccentForeground}" />
      </Style>
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Shell.Accent.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.AccentForeground}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Shell.Accent.Pressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.AccentForeground}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="FontWeight" Value="Normal" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Shell.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Disabled.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
      </Style>
    </Style>

    <Style Selector="^.subtle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Hover.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Pressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Hover.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
      </Style>
      <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
    </Style>

    <Style Selector="^.compact">
      <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
      <Setter Property="Padding" Value="{DynamicResource Shell.Padding.ButtonCompact}" />
    </Style>
    <Style Selector="^.dialog">
      <Setter Property="MinWidth" Value="{DynamicResource Shell.Size.Button.MinWidth}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="^.iconText">
      <Setter Property="ContentTemplate" Value="{StaticResource Shell.Button.IconTextTemplate}" />
      <Setter Property="Padding" Value="10,0,12,0" />
    </Style>
    <Style Selector="^.iconText.compact">
      <Setter Property="Padding" Value="6,0,8,0" />
    </Style>
    <Style Selector="^.icon">
      <Setter Property="ContentTemplate" Value="{StaticResource Shell.Button.IconTemplate}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="{DynamicResource Shell.Size.Control}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="^.icon.compact">
      <Setter Property="MinWidth" Value="{DynamicResource Shell.Size.ToolbarButton}" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </ControlTheme>

  <!--
    Toggle buttons: the default button's look unchecked; checked, the accent with its text (M34g's tokens). A toolbar
    toggle (ToggleButton.toolbar, ShellStyles.axaml) is a tint with an accent edge instead.
  -->
  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
    <Setter Property="Background" Value="{DynamicResource Shell.Button}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Button.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Button.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
    <Setter Property="Padding" Value="{DynamicResource Shell.Padding.Button}" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Control}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{StaticResource Shell.FocusRing}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          RecognizesAccessKey="True"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Shell.Button.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Button.Hover.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.Button.Foreground}" />
    </Style>
    <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Shell.Button.Pressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Button.Pressed.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.Button.Foreground}" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundChecked}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToggleButtonBackgroundChecked}" />
      <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundChecked}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Shell.Accent.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent.Hover}" />
      <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundChecked}" />
    </Style>
    <Style Selector="^:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Shell.Accent.Pressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent.Pressed}" />
      <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundChecked}" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Shell.Disabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Disabled.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
    </Style>
    <Style Selector="^.compact">
      <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
      <Setter Property="Padding" Value="{DynamicResource Shell.Padding.ButtonCompact}" />
    </Style>
    <Style Selector="^.iconText">
      <Setter Property="ContentTemplate" Value="{StaticResource Shell.Button.IconTextTemplate}" />
      <Setter Property="Padding" Value="10,0,12,0" />
    </Style>
    <Style Selector="^.iconText.compact">
      <Setter Property="Padding" Value="6,0,8,0" />
    </Style>
    <Style Selector="^.icon">
      <Setter Property="ContentTemplate" Value="{StaticResource Shell.Button.IconTemplate}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="{DynamicResource Shell.Size.Control}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="^.icon.compact">
      <Setter Property="MinWidth" Value="{DynamicResource Shell.Size.ToolbarButton}" />
    </Style>
    <!--
      A chip toggle (M34h, AI Chat's context: what goes with a question): a 22 px pill outlined in Shell.Input.Border, a
      12 px icon (controls:ButtonIcon.Kind) and 11 px text, flat under the pointer like a toolbar button; checked, the
      toolbar's checked tint with its accent edge. Several sit in a wrapping row, each on or off.
    -->
    <Style Selector="^.chip">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="6,0,8,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Input.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
      <Setter Property="FontSize" Value="{DynamicResource Shell.FontSize.Small}" />
      <Setter Property="ContentTemplate" Value="{StaticResource Shell.Button.ChipTemplate}" />
      <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Hover.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
      </Style>
      <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Pressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Hover.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
      </Style>
      <Style Selector="^:checked /template/ ContentPresenter#PART_ContentPresenter, ^:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Checked}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Checked.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Toolbar.Checked.Foreground}" />
      </Style>
      <Style Selector="^:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Pressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Checked.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Toolbar.Checked.Foreground}" />
      </Style>
    </Style>
  </ControlTheme>

  <!-- A drop-down button opens a choice (it never runs anything itself): the default button with a 12 px chevron. -->
  <ControlTheme x:Key="{x:Type DropDownButton}" TargetType="DropDownButton">
    <Setter Property="Background" Value="{DynamicResource Shell.Button}" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Button.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Button.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
    <Setter Property="Padding" Value="12,0,8,0" />
    <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.Control}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{StaticResource Shell.FocusRing}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="RootBorder"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Grid ColumnDefinitions="*,Auto">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              RecognizesAccessKey="True"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <controls:Icon x:Name="DropDownGlyph" Grid.Column="1" Kind="chevron-down" Width="12" Height="12" Margin="6,0,0,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Shell.MutedForeground}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#RootBorder">
      <Setter Property="Background" Value="{DynamicResource Shell.Button.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Button.Hover.Border}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#RootBorder, ^:flyout-open /template/ Border#RootBorder">
      <Setter Property="Background" Value="{DynamicResource Shell.Button.Pressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Button.Pressed.Border}" />
    </Style>
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Border#RootBorder">
        <Setter Property="Background" Value="{DynamicResource Shell.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Disabled.Border}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
      </Style>
      <Style Selector="^ /template/ controls|Icon#DropDownGlyph">
        <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
      </Style>
    </Style>
    <Style Selector="^.compact">
      <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
      <Setter Property="Padding" Value="8,0,6,0" />
    </Style>
    <Style Selector="^.iconText">
      <Setter Property="ContentTemplate" Value="{StaticResource Shell.Button.IconTextTemplate}" />
      <Setter Property="Padding" Value="10,0,8,0" />
    </Style>
    <Style Selector="^.iconText.compact">
      <Setter Property="Padding" Value="6,0,6,0" />
    </Style>
    <!-- In a toolbar: flat until hovered, like the buttons beside it. -->
    <Style Selector="^.toolbar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
      <Setter Property="MinHeight" Value="{DynamicResource Shell.Size.ToolbarButton}" />
      <Setter Property="Padding" Value="5,0,5,0" />
      <Style Selector="^:pointerover /template/ Border#RootBorder">
        <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Hover.Border}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#RootBorder, ^:flyout-open /template/ Border#RootBorder">
        <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Pressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Toolbar.Hover.Border}" />
      </Style>
      <Style Selector="^:disabled /template/ Border#RootBorder">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
    </Style>
  </ControlTheme>

  <!--
    Check boxes: a 16 px box with a 1 px Shell.Check.Border outline (3:1), filled with the accent when checked or mixed,
    the label after it (once: the title is the check box's own label). The focus ring is around the box.
  -->
  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
          <Panel Width="16" Height="16" VerticalAlignment="Center">
            <Border x:Name="FocusRing"
                    Margin="{DynamicResource Shell.Focus.Margin}"
                    BorderThickness="{DynamicResource Shell.Focus.Thickness}"
                    BorderBrush="{DynamicResource Shell.Focus}"
                    CornerRadius="{DynamicResource Shell.Focus.CornerRadius}"
                    IsVisible="False" />
            <Border x:Name="Box"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Shell.Check.Border}"
                    Background="{DynamicResource Shell.Input}"
                    CornerRadius="{DynamicResource Shell.Check.CornerRadius}" />
            <Path x:Name="CheckGlyph"
                  Data="M4,8.5 L7,11.5 L12,5"
                  Stroke="{DynamicResource Shell.AccentForeground}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  IsVisible="False" />
            <Border x:Name="MixedGlyph" Width="8" Height="2" CornerRadius="1" Background="{DynamicResource Shell.AccentForeground}" IsVisible="False" />
          </Panel>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{TemplateBinding Padding}"
                            RecognizesAccessKey="True"
                            TextWrapping="Wrap"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Box">
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Foreground}" />
    </Style>
    <Style Selector="^:checked /template/ Border#Box, ^:indeterminate /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource Shell.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#Box, ^:indeterminate:pointerover /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource Shell.Accent.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent.Hover}" />
    </Style>
    <Style Selector="^:checked:pressed /template/ Border#Box, ^:indeterminate:pressed /template/ Border#Box">
      <Setter Property="Background" Value="{DynamicResource Shell.Accent.Pressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent.Pressed}" />
    </Style>
    <Style Selector="^:checked /template/ Path#CheckGlyph">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#MixedGlyph">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
      </Style>
      <Style Selector="^ /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource Shell.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Disabled.Border}" />
      </Style>
      <Style Selector="^:checked /template/ Border#Box, ^:indeterminate /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource Shell.Disabled.Border}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Disabled.Border}" />
      </Style>
      <Style Selector="^ /template/ Path#CheckGlyph">
        <Setter Property="Stroke" Value="{DynamicResource Shell.Disabled.Foreground}" />
      </Style>
      <Style Selector="^ /template/ Border#MixedGlyph">
        <Setter Property="Background" Value="{DynamicResource Shell.Disabled.Foreground}" />
      </Style>
    </Style>
  </ControlTheme>

  <!-- Radio buttons: one of a few choices that need their descriptions. A 16 px circle; chosen, the accent with a dot. -->
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,0,0,0" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
          <Panel Width="16" Height="16" VerticalAlignment="Center">
            <Ellipse x:Name="FocusRing" Margin="-3" Stroke="{DynamicResource Shell.Focus}" StrokeThickness="2" IsVisible="False" />
            <Ellipse x:Name="OuterEllipse" Stroke="{DynamicResource Shell.Check.Border}" StrokeThickness="1" Fill="{DynamicResource Shell.Input}" />
            <Ellipse x:Name="CheckGlyph" Width="6" Height="6" Fill="{DynamicResource Shell.AccentForeground}" IsVisible="False" />
          </Panel>
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{TemplateBinding Padding}"
                            RecognizesAccessKey="True"
                            TextWrapping="Wrap"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Ellipse#OuterEllipse">
      <Setter Property="Stroke" Value="{DynamicResource Shell.Foreground}" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#OuterEllipse">
      <Setter Property="Fill" Value="{DynamicResource Shell.Accent}" />
      <Setter Property="Stroke" Value="{DynamicResource Shell.Accent}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ Ellipse#OuterEllipse">
      <Setter Property="Fill" Value="{DynamicResource Shell.Accent.Hover}" />
      <Setter Property="Stroke" Value="{DynamicResource Shell.Accent.Hover}" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#CheckGlyph">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:focus-visible /template/ Ellipse#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
      </Style>
      <Style Selector="^ /template/ Ellipse#OuterEllipse">
        <Setter Property="Fill" Value="{DynamicResource Shell.Disabled}" />
        <Setter Property="Stroke" Value="{DynamicResource Shell.Disabled.Border}" />
      </Style>
      <Style Selector="^:checked /template/ Ellipse#OuterEllipse">
        <Setter Property="Fill" Value="{DynamicResource Shell.Disabled.Border}" />
      </Style>
      <Style Selector="^ /template/ Ellipse#CheckGlyph">
        <Setter Property="Fill" Value="{DynamicResource Shell.Disabled.Foreground}" />
      </Style>
    </Style>
  </ControlTheme>

  <!--
    The switch: only for an on/off that takes effect at once and has its own place (AI Chat's Agent mode); Options keeps
    check boxes. A 32 × 18 track, the knob in Shell.Check.Border off and the accent's text on the accent on; the label
    (Content, or OnContent and OffContent) after it.
  -->
  <ControlTheme x:Key="{x:Type ToggleSwitch}" TargetType="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="KnobTransitions">
      <Transitions>
        <DoubleTransition Easing="CubicEaseOut" Property="Canvas.Left" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
          <Grid x:Name="SwitchArea" Width="32" Height="18" VerticalAlignment="Center">
            <Border x:Name="FocusRing" Margin="{DynamicResource Shell.Focus.Margin}" CornerRadius="12"
                    BorderThickness="{DynamicResource Shell.Focus.Thickness}" BorderBrush="{DynamicResource Shell.Focus}" IsVisible="False" />
            <Border x:Name="Track" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource Shell.Check.Border}" Background="{DynamicResource Shell.Input}" />
            <Canvas x:Name="PART_SwitchKnob" Width="14" Height="18" Margin="4,0,0,0" HorizontalAlignment="Left">
              <Panel x:Name="PART_MovingKnobs" Width="10" Height="18">
                <Ellipse x:Name="Knob" Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource Shell.Check.Border}" />
              </Panel>
            </Canvas>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
            <ContentPresenter x:Name="PART_OffContentPresenter" Content="{TemplateBinding OffContent}" ContentTemplate="{TemplateBinding OffContentTemplate}"
                              VerticalAlignment="Center" IsVisible="False" />
            <ContentPresenter x:Name="PART_OnContentPresenter" Content="{TemplateBinding OnContent}" ContentTemplate="{TemplateBinding OnContentTemplate}"
                              VerticalAlignment="Center" IsVisible="False" />
            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              RecognizesAccessKey="True" VerticalAlignment="Center"
                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#Track">
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Foreground}" />
    </Style>
    <Style Selector="^:pointerover /template/ Ellipse#Knob">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="^:checked /template/ Border#Track">
      <Setter Property="Background" Value="{DynamicResource Shell.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent}" />
    </Style>
    <Style Selector="^:checked:pointerover /template/ Border#Track">
      <Setter Property="Background" Value="{DynamicResource Shell.Accent.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Accent.Hover}" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#Knob">
      <Setter Property="Fill" Value="{DynamicResource Shell.AccentForeground}" />
    </Style>
    <Style Selector="^:checked /template/ ContentPresenter#PART_OnContentPresenter, ^:unchecked /template/ ContentPresenter#PART_OffContentPresenter">
      <Setter Property="IsVisible" Value="{Binding $parent[ToggleSwitch].Content, Converter={x:Static ObjectConverters.IsNull}}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
      <Style Selector="^ /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource Shell.Disabled}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Disabled.Border}" />
      </Style>
      <Style Selector="^ /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{DynamicResource Shell.Disabled.Border}" />
      </Style>
    </Style>
  </ControlTheme>

  <!--
    The segmented control (Controls/SegmentedControl.cs): a 24 px track in the field's colors with its segments; the
    chosen one filled with Shell.Segment.Selected, bold. The arrow keys move the choice; the ring marks the focus.
  -->
  <ControlTheme x:Key="{x:Type controls:SegmentedControl}" TargetType="controls:SegmentedControl">
    <Setter Property="Background" Value="{DynamicResource Shell.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Shell.Input.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="Height" Value="{DynamicResource Shell.Size.Segment}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="1" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:disabled">
      <Setter Property="Background" Value="{DynamicResource Shell.Disabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Shell.Disabled.Border}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type controls:SegmentedControlItem}" TargetType="controls:SegmentedControlItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Shell.Foreground}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Shell.Control.CornerRadius}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{StaticResource Shell.FocusRing}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="PART_Border"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <controls:Icon x:Name="SegmentIcon" Kind="{TemplateBinding Icon}" Width="16" Height="16" VerticalAlignment="Center"
                           IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              VerticalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover:not(:selected) /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource Shell.Toolbar.Hover}" />
    </Style>
    <Style Selector="^:selected">
      <Setter Property="Foreground" Value="{DynamicResource Shell.Segment.Selected.Foreground}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style Selector="^ /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource Shell.Segment.Selected}" />
      </Style>
      <Style Selector="^ /template/ controls|Icon#SegmentIcon">
        <Setter Property="Foreground" Value="{DynamicResource Shell.Segment.Selected.Foreground}" />
      </Style>
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Shell.Disabled.Foreground}" />
    </Style>
    <Style Selector="^:disabled:selected /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource Shell.Disabled.Border}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
