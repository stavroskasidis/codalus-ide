      <SolidColorBrush x:Key="Shell.Panel" Color="#F4F6FC" />
      <SolidColorBrush x:Key="Shell.Hover" Color="#E0E6F6" />
      <SolidColorBrush x:Key="Shell.Selection" Color="#CCD9F6" />
      <SolidColorBrush x:Key="Shell.Selection.Foreground" Color="#0E1735" />
      <SolidColorBrush x:Key="Shell.Accent" Color="#2B59C3" />
      <SolidColorBrush x:Key="Shell.AccentForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Focus" Color="#2B59C3" />
      <SolidColorBrush x:Key="Shell.Input" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar" Color="#2B59C3" />
      <SolidColorBrush x:Key="Shell.StatusBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Hover" Color="#2349A0" />
      <SolidColorBrush x:Key="Shell.StatusBar.Border" Color="#2B59C3" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty" Color="#56607A" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Hover" Color="#454D62" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging" Color="#B4500F" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Hover" Color="#90400C" />
      <SolidColorBrush x:Key="Shell.Overlay" Color="#F4F6FC" />
      <SolidColorBrush x:Key="Shell.Overlay.Border" Color="#BCC7E0" />
      <SolidColorBrush x:Key="Shell.Match" Color="#1D49B0" />
      <SolidColorBrush x:Key="Shell.Info" Color="#1A85FF" />
      <SolidColorBrush x:Key="Shell.Warning" Color="#9A6A00" />
      <SolidColorBrush x:Key="Shell.Error" Color="#E51400" />
      <!-- Text in the state colors (M34g): Shell.Error and Shell.Warning are graphics at 3:1; text needs 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Error.Foreground" Color="#A1260D" />
      <SolidColorBrush x:Key="Shell.Warning.Foreground" Color="#7A5400" />
      <!-- Diff text (M34g): Shell.Diff.Added and .Removed are graphics at 3:1; added and removed lines need 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Diff.Added.Foreground" Color="#116329" />
      <SolidColorBrush x:Key="Shell.Diff.Removed.Foreground" Color="#A1260D" />
      <SolidColorBrush x:Key="Shell.Link" Color="#1D49B0" />
      <SolidColorBrush x:Key="Shell.Modified" Color="#2B59C3" />
      <SolidColorBrush x:Key="Shell.Editor.Background" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.Foreground" Color="#1B1F2A" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers" Color="#6A7490" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers.Current" Color="#6A7490" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentLine" Color="#F2F6FE" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint" Color="#C4314B" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint.Line" Color="#FCE9EC" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentStatement" Color="#FFF1B8" />
      <SolidColorBrush x:Key="Shell.Diff.Added" Color="#1E7F34" />
      <SolidColorBrush x:Key="Shell.Diff.Removed" Color="#C62828" />
      <!-- The merge editor's conflict blocks (2026-10-19): a muted red fill with a dashed outline while unresolved, a solid outline once resolved. -->
      <SolidColorBrush x:Key="Shell.Merge.Conflict" Color="#F6DFDF" />
      <SolidColorBrush x:Key="Shell.Merge.Conflict.Border" Color="#C62828" />
      <SolidColorBrush x:Key="Shell.Merge.Resolved.Border" Color="#1E7F34" />
      <SolidColorBrush x:Key="Shell.Editor.Fold" Color="#8A8A8A" />
      <SolidColorBrush x:Key="Shell.Editor.Fold.Hover" Color="#E0E6F6" />
      <SolidColorBrush x:Key="Shell.Icon.Blue" Color="#00539C" />
      <SolidColorBrush x:Key="Shell.Icon.Green" Color="#388A34" />
      <SolidColorBrush x:Key="Shell.Icon.Red" Color="#A1260D" />
