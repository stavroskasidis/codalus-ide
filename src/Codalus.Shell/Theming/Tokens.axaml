      <SolidColorBrush x:Key="Shell.Editor.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers" Color="#D6D6D6" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers.Current" Color="#D6D6D6" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentLine" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint" Color="#FF5C5C" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint.Line" Color="#4A0010" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentStatement" Color="#2E2600" />
      <SolidColorBrush x:Key="Shell.Diff.Added" Color="#00FF00" />
      <SolidColorBrush x:Key="Shell.Diff.Removed" Color="#FF6B6B" />
      <!-- The merge editor's conflict blocks (2026-10-19): a muted red fill with a dashed outline while unresolved (High contrast: the outline only), a solid outline once resolved. -->
      <SolidColorBrush x:Key="Shell.Merge.Conflict" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Merge.Conflict.Border" Color="#FF6B6B" />
      <SolidColorBrush x:Key="Shell.Merge.Resolved.Border" Color="#00FF00" />
      <SolidColorBrush x:Key="Shell.Editor.Fold" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.Fold.Hover" Color="#1A323D" />
      <SolidColorBrush x:Key="Shell.Icon.Blue" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Green" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Red" Color="#FFFFFF" />
