      <SolidColorBrush x:Key="Shell.Button.Hover.Border" Color="#2A5C5B" />
      <SolidColorBrush x:Key="Shell.Button.Pressed" Color="#1B2326" />
      <SolidColorBrush x:Key="Shell.Button.Pressed.Border" Color="#2BB3A3" />
      <SolidColorBrush x:Key="Shell.Accent.Hover" Color="#55C2B5" />
      <SolidColorBrush x:Key="Shell.Accent.Pressed" Color="#27A193" />
      <SolidColorBrush x:Key="Shell.Toolbar.Hover" Color="#213839" />
      <SolidColorBrush x:Key="Shell.Toolbar.Hover.Border" Color="#224A49" />
      <SolidColorBrush x:Key="Shell.Toolbar.Pressed" Color="#1D2E2F" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked" Color="#1F3332" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked.Border" Color="#2BB3A3" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked.Foreground" Color="#E8F4F2" />
      <SolidColorBrush x:Key="Shell.Input.Border" Color="#2A3D41" />
      <SolidColorBrush x:Key="Shell.Input.Border.Hover" Color="#2A5C5B" />
      <SolidColorBrush x:Key="Shell.Input.Placeholder" Color="#9A9FAA" />
      <SolidColorBrush x:Key="Shell.Disabled.Foreground" Color="#6F737B" />
      <SolidColorBrush x:Key="Shell.Disabled" Color="#1A1B1E" />
      <SolidColorBrush x:Key="Shell.Disabled.Border" Color="#26282E" />
