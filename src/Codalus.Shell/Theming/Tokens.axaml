      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#2BB3A3" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#2BB3A3" />
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#2BB3A3" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#2BB3A3" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#2BB3A3" />
