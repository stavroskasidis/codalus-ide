<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="using:Codalus.Shell.Theming">
  <!--
    Theme tokens. Views use these keys (DynamicResource) instead of literal colors, so the themes switch at runtime.
    - Classic (M29, ADR 0019): Blue, Light and Dark follow Visual Studio's themes; High Contrast follows the Windows
      "high contrast black" conventions: pure black surfaces, white text, cyan accents, orange focus and selection
      outlines.
    - The theme families (M45, ADR 0077): Harbor, Graphite, Daylight and Ember, each Light, Dark and High contrast, with
      every color from docs/design/shell-themes.md. Each variant inherits Classic's of its kind (Light, Dark, High
      Contrast), so the Fluent controls start from those, but sets every Shell.* token itself. Their shapes are tokens
      too (Shell.Gutter, Shell.Panel.CornerRadius.*, Shell.Tab.Active.Indicator, Shell.StatusBar.ShowDot, Dock's tab
      corners), which ShellStyles.axaml applies, so views don't change.
    A family's token the design leaves out takes its panel colors, or a mix of its own colors that meets the contrast
    pairs (tests/Codalus.Shell.Tests/TestData/contrast-pairs.txt).
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Shell.Background" Color="#EEEEF2" />
      <SolidColorBrush x:Key="Shell.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.MutedForeground" Color="#646464" />
      <SolidColorBrush x:Key="Shell.Border" Color="#CCCEDB" />
      <SolidColorBrush x:Key="Shell.Panel" Color="#F5F5F5" />
      <SolidColorBrush x:Key="Shell.Hover" Color="#C9DEF5" />
      <SolidColorBrush x:Key="Shell.Selection" Color="#CCE8FF" />
      <SolidColorBrush x:Key="Shell.Accent" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.AccentForeground" Color="#FFFFFF" />
      <!-- A checked toggle button (M34g): the accent with its text (Fluent's blue under white was 4.5:1 at best). -->
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#007ACC" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#007ACC" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#007ACC" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Focus" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.StatusBar" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.StatusBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Hover" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.StatusBar.Border" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.Overlay" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Overlay.Border" Color="#C8C8C8" />
      <SolidColorBrush x:Key="Shell.Match" Color="#0066BF" />
      <SolidColorBrush x:Key="Shell.Info" Color="#1A85FF" />
      <SolidColorBrush x:Key="Shell.Warning" Color="#9A6A00" />
      <SolidColorBrush x:Key="Shell.Error" Color="#E51400" />
      <!-- Text in the state colors (M34g): Shell.Error and Shell.Warning are graphics at 3:1; text needs 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Error.Foreground" Color="#A1260D" />
      <SolidColorBrush x:Key="Shell.Warning.Foreground" Color="#7A5400" />
      <!-- Diff text (M34g): Shell.Diff.Added and .Removed are graphics at 3:1; added and removed lines need 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Diff.Added.Foreground" Color="#116329" />
      <SolidColorBrush x:Key="Shell.Diff.Removed.Foreground" Color="#A1260D" />
      <SolidColorBrush x:Key="Shell.Link" Color="#006AB1" />
      <SolidColorBrush x:Key="Shell.Modified" Color="#1A85FF" />
      <SolidColorBrush x:Key="Shell.Editor.Background" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.Foreground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers" Color="#727272" />
      <!-- The current line's number, brighter than the others, and CodeLens: the classic IDE's (#83, D47). -->
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers.Current" Color="#3F3F3F" />
      <SolidColorBrush x:Key="Shell.Diff.Added" Color="#1E7F34" />
      <SolidColorBrush x:Key="Shell.Diff.Removed" Color="#C62828" />
      <!-- The merge editor's conflict blocks (2026-10-19): a muted red fill with a dashed outline while unresolved, a solid outline once resolved. -->
      <SolidColorBrush x:Key="Shell.Merge.Conflict" Color="#F6DFDF" />
      <SolidColorBrush x:Key="Shell.Merge.Conflict.Border" Color="#C62828" />
      <SolidColorBrush x:Key="Shell.Merge.Resolved.Border" Color="#1E7F34" />
      <SolidColorBrush x:Key="Shell.Editor.Fold" Color="#8A8A8A" />
      <SolidColorBrush x:Key="Shell.Editor.Fold.Hover" Color="#E5EBF1" />
      <!-- Icons in the Visual Studio palette (the maintainer's rule: every icon is colored), at least 3:1 against menus, toolbars and panels; command families are palette colors. -->
      <SolidColorBrush x:Key="Shell.Icon.Blue" Color="#00539C" />
      <SolidColorBrush x:Key="Shell.Icon.Green" Color="#388A34" />
      <SolidColorBrush x:Key="Shell.Icon.Red" Color="#A1260D" />
      <SolidColorBrush x:Key="Shell.Icon.Orange" Color="#B26B12" />
      <SolidColorBrush x:Key="Shell.Icon.Purple" Color="#652D90" />
      <SolidColorBrush x:Key="Shell.Icon.Yellow" Color="#8A6400" />
      <SolidColorBrush x:Key="Shell.Icon.Folder" Color="#8A6320" />
      <SolidColorBrush x:Key="Shell.Icon.Outline" Color="#424242" />
      <SolidColorBrush x:Key="Shell.Icon.Run" Color="#388A34" />
      <SolidColorBrush x:Key="Shell.Icon.Stop" Color="#A1260D" />
      <SolidColorBrush x:Key="Shell.Icon.Save" Color="#00539C" />
      <SolidColorBrush x:Key="Shell.Icon.Open" Color="#8A6320" />
      <SolidColorBrush x:Key="Shell.Icon.Build" Color="#652D90" />
      <SolidColorBrush x:Key="Shell.Icon.Git" Color="#B26B12" />
      <SolidColorBrush x:Key="Shell.Icon.Test" Color="#388A34" />
      <SolidColorBrush x:Key="Shell.Icon.Navigate" Color="#00539C" />
      <SolidColorBrush x:Key="Shell.Editor.InlayHint.Foreground" Color="#5F6670" />
      <SolidColorBrush x:Key="Shell.Editor.CodeLens.Foreground" Color="#5E5E5E" />
      <SolidColorBrush x:Key="Shell.Editor.InlayHint.Background" Color="#F3F3F3" />
      <SolidColorBrush x:Key="Shell.Editor.Guide" Color="#E0E0E0" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket1" Color="#0431FA" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket2" Color="#319331" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket3" Color="#7B3814" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty" Color="#68217A" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging" Color="#BC4B00" />
      <SolidColorBrush x:Key="Shell.TitleBar" Color="#EEEEF2" />
      <SolidColorBrush x:Key="Shell.TitleBar.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Toolbar" Color="#F5F5F5" />
      <SolidColorBrush x:Key="Shell.Toolbar.Border" Color="#CCCEDB" />
      <SolidColorBrush x:Key="Shell.Search" Color="#F5F5F5" />
      <SolidColorBrush x:Key="Shell.Search.Border" Color="#CCCEDB" />
      <SolidColorBrush x:Key="Shell.Tab.Active" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Tab.Active.Foreground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive" Color="#F5F5F5" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Caption.Active" Color="#EEEEF2" />
      <SolidColorBrush x:Key="Shell.Caption.Active.Foreground" Color="#000000" />
      <!-- M34d: the selected tab of a pane without the focus, hover, the preview tab, captions without the focus. -->
      <SolidColorBrush x:Key="Shell.Tab.Selected" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Tab.Selected.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Tab.Hover" Color="#DCEAF8" />
      <SolidColorBrush x:Key="Shell.Tab.Hover.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Tab.Preview" Color="#68217A" />
      <SolidColorBrush x:Key="Shell.Tab.Preview.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive" Color="#EEEEF2" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive.Foreground" Color="#3C3C3C" />
      <!-- Tabs colored by project (M34d): eight stripes, at least 3:1 against the tabs. -->
      <SolidColorBrush x:Key="Shell.TabColor.1" Color="#0E70C0" />
      <SolidColorBrush x:Key="Shell.TabColor.2" Color="#1E7F34" />
      <SolidColorBrush x:Key="Shell.TabColor.3" Color="#9A6700" />
      <SolidColorBrush x:Key="Shell.TabColor.4" Color="#7B4FD0" />
      <SolidColorBrush x:Key="Shell.TabColor.5" Color="#C4380D" />
      <SolidColorBrush x:Key="Shell.TabColor.6" Color="#0B7A75" />
      <SolidColorBrush x:Key="Shell.TabColor.7" Color="#B0306A" />
      <SolidColorBrush x:Key="Shell.TabColor.8" Color="#5B6B7A" />
      <!-- M45: tokens the theme families brought. In Classic they keep its look: text boxes stay Fluent's (Shell.Input
           matches them), the status bar's states keep its text and hover, and the debugger's lines are the colors the
           editor drew before, over its background. -->
      <SolidColorBrush x:Key="Shell.Selection.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Input" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Hover" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Hover" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.TitleBar.Hover" Color="#D7D7DA" />
      <SolidColorBrush x:Key="Shell.TitleBar.Chip" Color="#C9DEF5" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start" Color="#F5F5F5" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start.Icon" Color="#388A34" />
      <SolidColorBrush x:Key="Shell.Search.Foreground" Color="#646464" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentLine" Color="#F0F0F0" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint" Color="#E51400" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint.Line" Color="#F9C4BF" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentStatement" Color="#FFEEAA" />
      <!-- Shapes (M45; rounded corners since 0.6, D46): 4 px cards and tabs on 6 px of window, the selected tab outlined, captions without a dot. -->
      <x:Double x:Key="Shell.Gutter">6</x:Double>
      <SolidColorBrush x:Key="Shell.Gutter.Background" Color="#EEEEF2" />
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Top">4,4,0,0</CornerRadius>
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Bottom">0,0,4,4</CornerRadius>
      <Thickness x:Key="Shell.Tab.Active.Indicator">1,1,1,0</Thickness>
      <SolidColorBrush x:Key="Shell.Tab.Active.IndicatorBrush" Color="#007ACC" />
      <x:Boolean x:Key="Shell.StatusBar.ShowDot">False</x:Boolean>
      <FontWeight x:Key="Shell.Caption.Active.FontWeight">SemiBold</FontWeight>
      <SolidColorBrush x:Key="Shell.Caption.Active.Marker" Color="Transparent" />
      <Thickness x:Key="Shell.Caption.Active.MarkerPadding">0</Thickness>
      <!-- Rounded corners (0.6, D46, design/controls/RoundedCorners.dc.html): the classic IDE's 4 px cards, tabs and controls on 6 px of window. -->
      <CornerRadius x:Key="Shell.Card.CornerRadius">4</CornerRadius>
      <Thickness x:Key="Shell.Card.BorderThickness">1</Thickness>
      <Thickness x:Key="Shell.Card.Content.BorderThickness">1,0,1,1</Thickness>
      <SolidColorBrush x:Key="Shell.Card.Background" Color="#F5F5F5" />
      <SolidColorBrush x:Key="Shell.Well.Background" Color="#F5F5F5" />
      <SolidColorBrush x:Key="Shell.Card.Focus.BorderBrush" Color="#007ACC" />
      <Thickness x:Key="Shell.ToolControl.BorderThickness">0</Thickness>
      <CornerRadius x:Key="Shell.ToolTab.CornerRadius">0,0,4,4</CornerRadius>
      <Thickness x:Key="Shell.Dock.Margin">6,0,6,6</Thickness>
      <Thickness x:Key="Shell.Toolbar.Margin">6,0,6,6</Thickness>
      <HorizontalAlignment x:Key="Shell.Toolbar.HorizontalAlignment">Left</HorizontalAlignment>
      <Thickness x:Key="Shell.Toolbar.BorderThickness">1</Thickness>
      <CornerRadius x:Key="Shell.Toolbar.CornerRadius">4</CornerRadius>
      <SolidColorBrush x:Key="Shell.Tab.Selected.IndicatorBrush" Color="#80838F" />
      <SolidColorBrush x:Key="Shell.Well.Frame.Active" Color="#007ACC" />
      <Thickness x:Key="Shell.Well.Frame.Margin">-1,0,-1,-1</Thickness>
      <x:Double x:Key="Shell.TabStripEdge.Height">1</x:Double>
      <Thickness x:Key="Shell.TabStripEdge.Margin">-1,0</Thickness>
      <FontWeight x:Key="Shell.Tab.Selected.FontWeight">SemiBold</FontWeight>
      <CornerRadius x:Key="Shell.Control.CornerRadius.Compact">4</CornerRadius>
      <SolidColorBrush x:Key="Shell.Selection.Indicator" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.Selection.Indicator.Inactive" Color="#646464" />
      <Thickness x:Key="Shell.Row.Margin">3,0</Thickness>
      <CornerRadius x:Key="Shell.Row.CornerRadius">4</CornerRadius>
      <Thickness x:Key="Shell.AutoHide.BarThickness">0,0,0,3</Thickness>
      <SolidColorBrush x:Key="Shell.AutoHide.Bar" Color="#646464" />
      <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
      <CornerRadius x:Key="DockDocumentTabItemCornerRadius">4,4,0,0</CornerRadius>
      <Thickness x:Key="DockDocumentTabItemMargin">0</Thickness>
      <SolidColorBrush x:Key="DockDocumentContentBorderBrush" Color="#CCCEDB" />
      <Thickness x:Key="DockDocumentContentBorderThickness">1,0,1,1</Thickness>
      <x:Double x:Key="DockDocumentTabStripSeparatorSize">0</x:Double>
      <!-- Dock's document well and tool window captions. -->
      <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#007ACC" />
      <!-- The strip is drawn on the well card's fill (Shell.Card.Background), so the card's corners round it (D46). -->
      <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="Transparent" />
      <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#EEEEF2" />
      <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#EEEEF2" />
      <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#EEEEF2" />
      <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#EEEEF2" />
      <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DockSeparatorBrush" Color="#CCCEDB" />
      <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#CCCEDB" />
      <!-- The control set (M34h, docs/design/controls.md): Classic keeps its look: Light's blues. -->
      <SolidColorBrush x:Key="Shell.Button" Color="#FDFDFD" />
      <SolidColorBrush x:Key="Shell.Button.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Button.Border" Color="#C2C4D0" />
      <SolidColorBrush x:Key="Shell.Button.Hover" Color="#EAF3FC" />
      <SolidColorBrush x:Key="Shell.Button.Hover.Border" Color="#7EB4EA" />
      <SolidColorBrush x:Key="Shell.Button.Pressed" Color="#CCE4F7" />
      <SolidColorBrush x:Key="Shell.Button.Pressed.Border" Color="#569DE5" />
      <SolidColorBrush x:Key="Shell.Accent.Hover" Color="#0068B0" />
      <SolidColorBrush x:Key="Shell.Accent.Pressed" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.Toolbar.Hover" Color="#DCEAF8" />
      <SolidColorBrush x:Key="Shell.Toolbar.Hover.Border" Color="#B3D3F2" />
      <SolidColorBrush x:Key="Shell.Toolbar.Pressed" Color="#C3DBF4" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked" Color="#D5E8FA" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked.Border" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Input.Border" Color="#BDBFCC" />
      <SolidColorBrush x:Key="Shell.Input.Border.Hover" Color="#8D90A0" />
      <SolidColorBrush x:Key="Shell.Input.Placeholder" Color="#646464" />
      <SolidColorBrush x:Key="Shell.Disabled.Foreground" Color="#8A8A8A" />
      <SolidColorBrush x:Key="Shell.Disabled" Color="#EDEDEF" />
      <SolidColorBrush x:Key="Shell.Disabled.Border" Color="#D7D8DF" />
      <SolidColorBrush x:Key="Shell.Check.Border" Color="#6E7080" />
      <SolidColorBrush x:Key="Shell.Segment.Selected" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.Segment.Selected.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Selection.Inactive" Color="#E4E6EE" />
      <SolidColorBrush x:Key="Shell.Selection.Inactive.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Row.Hover" Color="#E8F1FB" />
      <SolidColorBrush x:Key="Shell.Grid.Header" Color="#F0F0F3" />
      <SolidColorBrush x:Key="Shell.Grid.Rule" Color="#EBEBEF" />
      <SolidColorBrush x:Key="Shell.ViewTabs.Rule" Color="#E2E3EA" />
      <SolidColorBrush x:Key="Shell.Match.Background" Color="#FFE58F" />
      <SolidColorBrush x:Key="Shell.Match.Background.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Badge" Color="#E4E6EE" />
      <SolidColorBrush x:Key="Shell.Badge.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Status.Success" Color="#E3F2E6" />
      <SolidColorBrush x:Key="Shell.Status.Success.Foreground" Color="#116329" />
      <SolidColorBrush x:Key="Shell.Status.Error" Color="#FBE7E3" />
      <SolidColorBrush x:Key="Shell.Status.Error.Foreground" Color="#9A220B" />
      <SolidColorBrush x:Key="Shell.Status.Warning" Color="#FFF2CC" />
      <SolidColorBrush x:Key="Shell.Status.Warning.Foreground" Color="#6E4B00" />
      <SolidColorBrush x:Key="Shell.Status.Info" Color="#E1EEF9" />
      <SolidColorBrush x:Key="Shell.Status.Info.Foreground" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.Dialog.Footer" Color="#F2F2F5" />
      <SolidColorBrush x:Key="Shell.Dialog.Scrim" Color="#611E1E1E" />
      <SolidColorBrush x:Key="Shell.Chat.User" Color="#E1EEF9" />
      <SolidColorBrush x:Key="Shell.Chat.User.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.CodeBlock.Header" Color="#F2F2F5" />
      <CornerRadius x:Key="Shell.Control.CornerRadius">4</CornerRadius>
      <CornerRadius x:Key="Shell.Check.CornerRadius">3</CornerRadius>
      <CornerRadius x:Key="Shell.Focus.CornerRadius">6</CornerRadius>
      <!-- High contrast outlines what the others fill: a row under the pointer, chips and badges (Avalonia's borders draw no dashes). -->
      <BoxShadows x:Key="Shell.Row.Hover.Outline">0 0 0 0 #00000000</BoxShadows>
      <Thickness x:Key="Shell.Chip.BorderThickness">0</Thickness>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Shell.Background" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Foreground" Color="#F1F1F1" />
      <SolidColorBrush x:Key="Shell.MutedForeground" Color="#A6A6A6" />
      <SolidColorBrush x:Key="Shell.Border" Color="#3F3F46" />
      <SolidColorBrush x:Key="Shell.Panel" Color="#252526" />
      <SolidColorBrush x:Key="Shell.Hover" Color="#3E3E40" />
      <SolidColorBrush x:Key="Shell.Selection" Color="#3F3F46" />
      <SolidColorBrush x:Key="Shell.Accent" Color="#3794FF" />
      <SolidColorBrush x:Key="Shell.AccentForeground" Color="#000000" />
      <!-- A checked toggle button (M34g): the accent with its text (Fluent's blue under white was 4.5:1 at best). -->
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#3794FF" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3794FF" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#3794FF" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Focus" Color="#3794FF" />
      <SolidColorBrush x:Key="Shell.StatusBar" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.StatusBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Hover" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.StatusBar.Border" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.Overlay" Color="#252526" />
      <SolidColorBrush x:Key="Shell.Overlay.Border" Color="#454545" />
      <SolidColorBrush x:Key="Shell.Match" Color="#2AAAFF" />
      <SolidColorBrush x:Key="Shell.Info" Color="#3794FF" />
      <SolidColorBrush x:Key="Shell.Warning" Color="#CCA700" />
      <SolidColorBrush x:Key="Shell.Error" Color="#F14C4C" />
      <!-- Text in the state colors (M34g): Shell.Error and Shell.Warning are graphics at 3:1; text needs 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Error.Foreground" Color="#F48771" />
      <SolidColorBrush x:Key="Shell.Warning.Foreground" Color="#CCA700" />
      <!-- Diff text (M34g): Shell.Diff.Added and .Removed are graphics at 3:1; added and removed lines need 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Diff.Added.Foreground" Color="#73C991" />
      <SolidColorBrush x:Key="Shell.Diff.Removed.Foreground" Color="#F48771" />
      <SolidColorBrush x:Key="Shell.Link" Color="#4DAAFC" />
      <SolidColorBrush x:Key="Shell.Modified" Color="#3794FF" />
      <SolidColorBrush x:Key="Shell.Editor.Background" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Editor.Foreground" Color="#DCDCDC" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers" Color="#8A8A8A" />
      <!-- The current line's number, brighter than the others, and CodeLens: the classic IDE's (#83, D47). -->
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers.Current" Color="#CCCCCC" />
      <SolidColorBrush x:Key="Shell.Diff.Added" Color="#73C991" />
      <SolidColorBrush x:Key="Shell.Diff.Removed" Color="#F14C4C" />
      <!-- The merge editor's conflict blocks (2026-10-19): a muted red fill with a dashed outline while unresolved, a solid outline once resolved. -->
      <SolidColorBrush x:Key="Shell.Merge.Conflict" Color="#482727" />
      <SolidColorBrush x:Key="Shell.Merge.Conflict.Border" Color="#F14C4C" />
      <SolidColorBrush x:Key="Shell.Merge.Resolved.Border" Color="#73C991" />
      <SolidColorBrush x:Key="Shell.Editor.Fold" Color="#858585" />
      <SolidColorBrush x:Key="Shell.Editor.Fold.Hover" Color="#3E3E42" />
      <!-- Icons in the Visual Studio palette (every icon is colored); command families are palette colors. -->
      <SolidColorBrush x:Key="Shell.Icon.Blue" Color="#75BEFF" />
      <SolidColorBrush x:Key="Shell.Icon.Green" Color="#89D185" />
      <SolidColorBrush x:Key="Shell.Icon.Red" Color="#F48771" />
      <SolidColorBrush x:Key="Shell.Icon.Orange" Color="#E8AB53" />
      <SolidColorBrush x:Key="Shell.Icon.Purple" Color="#B180D7" />
      <SolidColorBrush x:Key="Shell.Icon.Yellow" Color="#FFCC00" />
      <SolidColorBrush x:Key="Shell.Icon.Folder" Color="#DCB67A" />
      <SolidColorBrush x:Key="Shell.Icon.Outline" Color="#C5C5C5" />
