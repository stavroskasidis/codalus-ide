      <SolidColorBrush x:Key="Shell.Toolbar.Checked.Border" Color="#3794FF" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked.Foreground" Color="#F1F1F1" />
      <SolidColorBrush x:Key="Shell.Input.Border" Color="#4A4A50" />
      <SolidColorBrush x:Key="Shell.Input.Border.Hover" Color="#6A6A72" />
      <SolidColorBrush x:Key="Shell.Input.Placeholder" Color="#A6A6A6" />
