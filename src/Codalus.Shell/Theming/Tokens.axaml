      <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#3F3F46" />
      <!-- The control set (M34h, docs/design/controls.md): Classic Dark keeps its look: its grays, the accent's blue for pressed and checked. -->
      <SolidColorBrush x:Key="Shell.Button" Color="#333337" />
      <SolidColorBrush x:Key="Shell.Button.Foreground" Color="#F1F1F1" />
