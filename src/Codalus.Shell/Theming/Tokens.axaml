      <CornerRadius x:Key="Shell.Check.CornerRadius">3</CornerRadius>
      <CornerRadius x:Key="Shell.Focus.CornerRadius">5</CornerRadius>
      <!-- High contrast outlines what the others fill: a row under the pointer, chips and badges (Avalonia's borders draw no dashes). -->
      <BoxShadows x:Key="Shell.Row.Hover.Outline">inset 0 0 0 1 #FFFFFF</BoxShadows>
      <Thickness x:Key="Shell.Chip.BorderThickness">1</Thickness>
    </ResourceDictionary>

    <!-- Daylight, Light (M45, docs/design/shell-themes.md). -->
    <ResourceDictionary x:Key="{x:Static theming:ThemeService.DaylightLight}">
      <SolidColorBrush x:Key="Shell.Background" Color="#F3F3F6" />
