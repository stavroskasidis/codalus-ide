      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#000000" />
      <!-- A checked toggle button (M34g): the family's accent with its text, as the accent buttons (Classic High Contrast's blue was 4.5:1 under white). -->
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#3FF2D2" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#3FF2D2" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#3FF2D2" />
