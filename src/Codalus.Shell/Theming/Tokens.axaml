      <SolidColorBrush x:Key="Shell.Match.Background.Foreground" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Badge" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Badge.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Status.Success" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Status.Success.Foreground" Color="#00FF00" />
      <SolidColorBrush x:Key="Shell.Status.Error" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Status.Error.Foreground" Color="#F48771" />
      <SolidColorBrush x:Key="Shell.Status.Warning" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Status.Warning.Foreground" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.Status.Info" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Status.Info.Foreground" Color="#75BEFF" />
