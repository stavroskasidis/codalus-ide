      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#D2B3FF" />
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#D2B3FF" />
      <Color x:Key="SystemListMediumColor">#322B3D</Color>
      <!-- The control set (M34h, docs/design/controls.md): derived from the family's own colors by the design's rules (docs/design/controls.md) -->
      <SolidColorBrush x:Key="Shell.Button" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Button.Foreground" Color="#FFFFFF" />
