      <SolidColorBrush x:Key="Shell.Tab.Preview.Foreground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.TabColor.1" Color="#75BEFF" />
      <SolidColorBrush x:Key="Shell.TabColor.2" Color="#00FF00" />
      <SolidColorBrush x:Key="Shell.TabColor.3" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.TabColor.4" Color="#DA70D6" />
      <SolidColorBrush x:Key="Shell.TabColor.5" Color="#FF8C00" />
      <SolidColorBrush x:Key="Shell.TabColor.6" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.TabColor.7" Color="#FF69B4" />
      <SolidColorBrush x:Key="Shell.TabColor.8" Color="#FFFFFF" />
      <!-- Shapes (the design's Shapes table). -->
      <x:Double x:Key="Shell.Gutter">1</x:Double>
      <SolidColorBrush x:Key="Shell.Gutter.Background" Color="#FFFFFF" />
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Top">0</CornerRadius>
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Bottom">0</CornerRadius>
      <Thickness x:Key="Shell.Tab.Active.Indicator">0</Thickness>
      <SolidColorBrush x:Key="Shell.Tab.Active.IndicatorBrush" Color="Transparent" />
      <x:Boolean x:Key="Shell.StatusBar.ShowDot">False</x:Boolean>
      <FontWeight x:Key="Shell.Caption.Active.FontWeight">Bold</FontWeight>
      <SolidColorBrush x:Key="Shell.Caption.Active.Marker" Color="Transparent" />
      <Thickness x:Key="Shell.Caption.Active.MarkerPadding">0</Thickness>
      <!-- Rounded corners (0.6, D46) change only Classic's shapes: these keep this family's, Dock's values included (Classic's would leak in through the variant it inherits). -->
      <CornerRadius x:Key="Shell.Card.CornerRadius">0</CornerRadius>
      <Thickness x:Key="Shell.Card.BorderThickness">0</Thickness>
      <Thickness x:Key="Shell.Card.Content.BorderThickness">0</Thickness>
