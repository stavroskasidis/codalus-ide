      <x:Double x:Key="DockDocumentTabStripSeparatorSize">0</x:Double>
      <!-- Dock's document well and tool window captions. -->
      <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#F5CC84" />
      <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#F5CC84" />
      <!-- The strip is drawn on the well card's fill (Shell.Card.Background), so the card's corners round it (D46). -->
      <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="Transparent" />
      <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#CCD5F0" />
      <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#CCD5F0" />
      <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#CCD5F0" />
      <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#FFF29D" />
      <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DockSeparatorBrush" Color="#8E9BBC" />
      <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#8E9BBC" />
      <!-- The control set (M34h, docs/design/controls.md): Classic Blue keeps its look: the yellow hover and border of its buttons and toolbars. -->
      <SolidColorBrush x:Key="Shell.Button" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Button.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Button.Border" Color="#8E9BBC" />
      <SolidColorBrush x:Key="Shell.Button.Hover" Color="#FDF4BF" />
      <SolidColorBrush x:Key="Shell.Button.Hover.Border" Color="#E5C365" />
      <SolidColorBrush x:Key="Shell.Button.Pressed" Color="#FFE8A6" />
      <SolidColorBrush x:Key="Shell.Button.Pressed.Border" Color="#E5C365" />
      <SolidColorBrush x:Key="Shell.Accent.Hover" Color="#0C62A8" />
      <SolidColorBrush x:Key="Shell.Accent.Pressed" Color="#0A5591" />
      <SolidColorBrush x:Key="Shell.Toolbar.Hover" Color="#FDF4BF" />
      <SolidColorBrush x:Key="Shell.Toolbar.Hover.Border" Color="#E5C365" />
      <SolidColorBrush x:Key="Shell.Toolbar.Pressed" Color="#FFE8A6" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked" Color="#FFEFBB" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked.Border" Color="#E5C365" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Input.Border" Color="#8E9BBC" />
      <SolidColorBrush x:Key="Shell.Input.Border.Hover" Color="#5B6E99" />
      <SolidColorBrush x:Key="Shell.Input.Placeholder" Color="#4D5A73" />
      <SolidColorBrush x:Key="Shell.Disabled.Foreground" Color="#7D8496" />
      <SolidColorBrush x:Key="Shell.Disabled" Color="#E9ECF4" />
      <SolidColorBrush x:Key="Shell.Disabled.Border" Color="#C3CADB" />
      <SolidColorBrush x:Key="Shell.Check.Border" Color="#5B6E99" />
      <SolidColorBrush x:Key="Shell.Segment.Selected" Color="#0E70C0" />
      <SolidColorBrush x:Key="Shell.Segment.Selected.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Selection.Inactive" Color="#DDE2EF" />
      <SolidColorBrush x:Key="Shell.Selection.Inactive.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Row.Hover" Color="#FEF7D9" />
      <SolidColorBrush x:Key="Shell.Grid.Header" Color="#EAEDF5" />
      <SolidColorBrush x:Key="Shell.Grid.Rule" Color="#E2E6F0" />
      <SolidColorBrush x:Key="Shell.ViewTabs.Rule" Color="#D5DAE8" />
      <SolidColorBrush x:Key="Shell.Match.Background" Color="#FFE58F" />
      <SolidColorBrush x:Key="Shell.Match.Background.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Badge" Color="#DDE2EF" />
      <SolidColorBrush x:Key="Shell.Badge.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Status.Success" Color="#E3F2E6" />
      <SolidColorBrush x:Key="Shell.Status.Success.Foreground" Color="#116329" />
      <SolidColorBrush x:Key="Shell.Status.Error" Color="#FBE7E3" />
      <SolidColorBrush x:Key="Shell.Status.Error.Foreground" Color="#9A220B" />
      <SolidColorBrush x:Key="Shell.Status.Warning" Color="#FFF2CC" />
      <SolidColorBrush x:Key="Shell.Status.Warning.Foreground" Color="#6E4B00" />
      <SolidColorBrush x:Key="Shell.Status.Info" Color="#E1ECF8" />
      <SolidColorBrush x:Key="Shell.Status.Info.Foreground" Color="#0054A0" />
      <SolidColorBrush x:Key="Shell.Dialog.Footer" Color="#EEF0F6" />
      <SolidColorBrush x:Key="Shell.Dialog.Scrim" Color="#731F2D54" />
      <SolidColorBrush x:Key="Shell.Chat.User" Color="#DCE6F6" />
      <SolidColorBrush x:Key="Shell.Chat.User.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.CodeBlock.Header" Color="#EEF0F6" />
      <CornerRadius x:Key="Shell.Control.CornerRadius">4</CornerRadius>
      <CornerRadius x:Key="Shell.Check.CornerRadius">3</CornerRadius>
      <CornerRadius x:Key="Shell.Focus.CornerRadius">6</CornerRadius>
      <!-- High contrast outlines what the others fill: a row under the pointer, chips and badges (Avalonia's borders draw no dashes). -->
      <BoxShadows x:Key="Shell.Row.Hover.Outline">0 0 0 0 #00000000</BoxShadows>
      <Thickness x:Key="Shell.Chip.BorderThickness">0</Thickness>
    </ResourceDictionary>

    <ResourceDictionary x:Key="{x:Static theming:ThemeService.HighContrast}">
      <SolidColorBrush x:Key="Shell.Background" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.MutedForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Panel" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Hover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Selection" Color="#0E4A7B" />
      <SolidColorBrush x:Key="Shell.Accent" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.AccentForeground" Color="#000000" />
      <!-- A checked toggle button (M34g): the accent with its text (Fluent's blue under white was 4.5:1 at best). -->
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#1AEBFF" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#1AEBFF" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#1AEBFF" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Focus" Color="#F38518" />
      <SolidColorBrush x:Key="Shell.StatusBar" Color="#000000" />
      <SolidColorBrush x:Key="Shell.StatusBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Hover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.StatusBar.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Overlay" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Overlay.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Match" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Info" Color="#75BEFF" />
      <SolidColorBrush x:Key="Shell.Warning" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.Error" Color="#F48771" />
      <!-- Text in the state colors (M34g): Shell.Error and Shell.Warning are graphics at 3:1; text needs 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Error.Foreground" Color="#F48771" />
      <SolidColorBrush x:Key="Shell.Warning.Foreground" Color="#FFD700" />
      <!-- Diff text (M34g): Shell.Diff.Added and .Removed are graphics at 3:1; added and removed lines need 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Diff.Added.Foreground" Color="#00FF00" />
      <SolidColorBrush x:Key="Shell.Diff.Removed.Foreground" Color="#FF6B6B" />
      <SolidColorBrush x:Key="Shell.Link" Color="#21A6FF" />
      <SolidColorBrush x:Key="Shell.Modified" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.Editor.Background" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Editor.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers.Current" Color="#FFFFFF" />
      <!-- Fluent colors (palettes cannot target custom variants). The accent fills selected tabs and checkboxes
           under white text, so it is a blue with about 5:1 contrast against white rather than cyan. -->
      <Color x:Key="SystemAccentColor">#0F6CBD</Color>
      <Color x:Key="SystemRegionColor">#000000</Color>
      <Color x:Key="SystemAltHighColor">#000000</Color>
      <Color x:Key="SystemBaseHighColor">#FFFFFF</Color>
      <Color x:Key="SystemBaseMediumColor">#FFFFFF</Color>
      <Color x:Key="SystemChromeLowColor">#000000</Color>
      <Color x:Key="SystemChromeMediumColor">#000000</Color>
      <Color x:Key="SystemChromeMediumLowColor">#000000</Color>
      <Color x:Key="SystemListLowColor">#1F1F1F</Color>
      <Color x:Key="SystemListMediumColor">#0E4A7B</Color>
      <SolidColorBrush x:Key="SystemRegionBrush" Color="#000000" />
      <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#000000" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#0F6CBD" />
      <!-- M34d: menus, drop-downs, flyouts and tooltips are black like High Contrast's other surfaces (Fluent's are dark
           gray, and its resources take their colors by StaticResource, so the keys the controls use are overridden). -->
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#000000" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#0E4A7B" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#0E4A7B" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="#0E4A7B" />
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#000000" />
      <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="ToolTipBackground" Color="#000000" />
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF" />
      <!-- Buttons and combo boxes: black with a white outline, not Fluent's dark gray (buttons) or accent fill (combo boxes). -->
      <SolidColorBrush x:Key="ButtonBackground" Color="#000000" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1F1F1F" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0E4A7B" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#F38518" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1F1F1F" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#0E4A7B" />
      <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#F38518" />
      <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#FFFFFF" />
      <!-- Fluent focus rectangles. -->
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#F38518" />
      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Diff.Added" Color="#00FF00" />
      <SolidColorBrush x:Key="Shell.Diff.Removed" Color="#FF6B6B" />
      <!-- The merge editor's conflict blocks (2026-10-19): a muted red fill with a dashed outline while unresolved (High contrast: the outline only), a solid outline once resolved. -->
      <SolidColorBrush x:Key="Shell.Merge.Conflict" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Merge.Conflict.Border" Color="#FF6B6B" />
      <SolidColorBrush x:Key="Shell.Merge.Resolved.Border" Color="#00FF00" />
      <SolidColorBrush x:Key="Shell.Editor.Fold" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.Fold.Hover" Color="#0E4A7B" />
      <!-- High Contrast keeps icons monochrome: shape carries the meaning, not color. -->
      <SolidColorBrush x:Key="Shell.Icon.Blue" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Green" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Red" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Orange" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Purple" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Yellow" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Folder" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Outline" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Run" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Stop" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Save" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Open" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Build" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Git" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Test" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Navigate" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.InlayHint.Foreground" Color="#D0D0D0" />
      <SolidColorBrush x:Key="Shell.Editor.CodeLens.Foreground" Color="#D0D0D0" />
      <SolidColorBrush x:Key="Shell.Editor.InlayHint.Background" Color="#1A1A1A" />
      <SolidColorBrush x:Key="Shell.Editor.Guide" Color="#7F7F7F" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket1" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket2" Color="#DA70D6" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket3" Color="#87CEFA" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty" Color="#000000" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging" Color="#000000" />
      <SolidColorBrush x:Key="Shell.TitleBar" Color="#000000" />
      <SolidColorBrush x:Key="Shell.TitleBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Toolbar" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Toolbar.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Search" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Search.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Tab.Active" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Tab.Active.Foreground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Caption.Active" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Caption.Active.Foreground" Color="#000000" />
      <!-- M34d: the selected tab of a pane without the focus, hover, the preview tab, captions without the focus. -->
      <SolidColorBrush x:Key="Shell.Tab.Selected" Color="#0E4A7B" />
      <SolidColorBrush x:Key="Shell.Tab.Selected.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Tab.Hover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Tab.Hover.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Tab.Preview" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Tab.Preview.Foreground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive.Foreground" Color="#FFFFFF" />
      <!-- Tabs colored by project (M34d): eight stripes, at least 3:1 against the tabs. -->
      <SolidColorBrush x:Key="Shell.TabColor.1" Color="#75BEFF" />
      <SolidColorBrush x:Key="Shell.TabColor.2" Color="#00FF00" />
      <SolidColorBrush x:Key="Shell.TabColor.3" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.TabColor.4" Color="#DA70D6" />
      <SolidColorBrush x:Key="Shell.TabColor.5" Color="#FF8C00" />
      <SolidColorBrush x:Key="Shell.TabColor.6" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.TabColor.7" Color="#FF69B4" />
      <SolidColorBrush x:Key="Shell.TabColor.8" Color="#FFFFFF" />
      <!-- M45: tokens the theme families brought. In Classic they keep its look: text boxes stay Fluent's (Shell.Input
           matches them), the status bar's states keep its text and hover, and the debugger's lines are the colors the
           editor drew before, over its background. -->
      <SolidColorBrush x:Key="Shell.Selection.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Input" Color="#000000" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Hover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Hover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.TitleBar.Hover" Color="#0E4A7B" />
      <SolidColorBrush x:Key="Shell.TitleBar.Chip" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start.Icon" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Search.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentLine" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint" Color="#E51400" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint.Line" Color="#3A0500" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentStatement" Color="#554400" />
      <!-- Shapes (M45; rounded corners since 0.6, D46): 4 px cards and tabs on 6 px of window, the selected tab outlined, captions without a dot. -->
      <x:Double x:Key="Shell.Gutter">6</x:Double>
      <SolidColorBrush x:Key="Shell.Gutter.Background" Color="#000000" />
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Top">4,4,0,0</CornerRadius>
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Bottom">0,0,4,4</CornerRadius>
      <Thickness x:Key="Shell.Tab.Active.Indicator">1,1,1,0</Thickness>
      <SolidColorBrush x:Key="Shell.Tab.Active.IndicatorBrush" Color="Transparent" />
      <x:Boolean x:Key="Shell.StatusBar.ShowDot">False</x:Boolean>
      <FontWeight x:Key="Shell.Caption.Active.FontWeight">Normal</FontWeight>
      <SolidColorBrush x:Key="Shell.Caption.Active.Marker" Color="Transparent" />
      <Thickness x:Key="Shell.Caption.Active.MarkerPadding">0</Thickness>
      <!-- Rounded corners (0.6, D46, design/controls/RoundedCorners.dc.html): the classic IDE's 4 px cards, tabs and controls on 6 px of window. -->
      <CornerRadius x:Key="Shell.Card.CornerRadius">4</CornerRadius>
      <Thickness x:Key="Shell.Card.BorderThickness">1</Thickness>
      <Thickness x:Key="Shell.Card.Content.BorderThickness">1,0,1,1</Thickness>
      <SolidColorBrush x:Key="Shell.Card.Background" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Well.Background" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Card.Focus.BorderBrush" Color="#6FC3DF" />
      <Thickness x:Key="Shell.ToolControl.BorderThickness">0</Thickness>
      <CornerRadius x:Key="Shell.ToolTab.CornerRadius">0,0,4,4</CornerRadius>
      <Thickness x:Key="Shell.Dock.Margin">6,0,6,6</Thickness>
      <Thickness x:Key="Shell.Toolbar.Margin">6,0,6,6</Thickness>
      <HorizontalAlignment x:Key="Shell.Toolbar.HorizontalAlignment">Left</HorizontalAlignment>
      <Thickness x:Key="Shell.Toolbar.BorderThickness">1</Thickness>
      <CornerRadius x:Key="Shell.Toolbar.CornerRadius">4</CornerRadius>
      <SolidColorBrush x:Key="Shell.Tab.Selected.IndicatorBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Well.Frame.Active" Color="#1AEBFF" />
      <Thickness x:Key="Shell.Well.Frame.Margin">-1,0,-1,-1</Thickness>
      <x:Double x:Key="Shell.TabStripEdge.Height">1</x:Double>
      <Thickness x:Key="Shell.TabStripEdge.Margin">-1,0</Thickness>
      <FontWeight x:Key="Shell.Tab.Selected.FontWeight">SemiBold</FontWeight>
      <CornerRadius x:Key="Shell.Control.CornerRadius.Compact">4</CornerRadius>
      <SolidColorBrush x:Key="Shell.Selection.Indicator" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Selection.Indicator.Inactive" Color="#FFFFFF" />
      <Thickness x:Key="Shell.Row.Margin">3,0</Thickness>
      <CornerRadius x:Key="Shell.Row.CornerRadius">4</CornerRadius>
      <Thickness x:Key="Shell.AutoHide.BarThickness">0,0,0,3</Thickness>
      <SolidColorBrush x:Key="Shell.AutoHide.Bar" Color="#FFFFFF" />
      <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
      <CornerRadius x:Key="DockDocumentTabItemCornerRadius">4,4,0,0</CornerRadius>
      <Thickness x:Key="DockDocumentTabItemMargin">0</Thickness>
      <SolidColorBrush x:Key="DockDocumentContentBorderBrush" Color="#6FC3DF" />
      <Thickness x:Key="DockDocumentContentBorderThickness">1,0,1,1</Thickness>
      <x:Double x:Key="DockDocumentTabStripSeparatorSize">0</x:Double>
      <!-- Dock's document well and tool window captions. -->
      <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#1AEBFF" />
      <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#1AEBFF" />
      <!-- The strip is drawn on the well card's fill (Shell.Card.Background), so the card's corners round it (D46). -->
      <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="Transparent" />
      <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#1AEBFF" />
      <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSeparatorBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#6FC3DF" />
      <!-- The control set (M34h, docs/design/controls.md): High Contrast: black controls with white borders, the orange focus color on hover. -->
      <SolidColorBrush x:Key="Shell.Button" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Button.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Button.Border" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Button.Hover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Button.Hover.Border" Color="#F38518" />
      <SolidColorBrush x:Key="Shell.Button.Pressed" Color="#0E4A7B" />
      <SolidColorBrush x:Key="Shell.Button.Pressed.Border" Color="#F38518" />
      <SolidColorBrush x:Key="Shell.Accent.Hover" Color="#7CF3FF" />
      <SolidColorBrush x:Key="Shell.Accent.Pressed" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Toolbar.Hover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Toolbar.Hover.Border" Color="#F38518" />
      <SolidColorBrush x:Key="Shell.Toolbar.Pressed" Color="#0E4A7B" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked" Color="#0E4A7B" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked.Border" Color="#1AEBFF" />
