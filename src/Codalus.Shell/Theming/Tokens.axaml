      <SolidColorBrush x:Key="Shell.Tab.Hover" Color="#E0EBEB" />
      <SolidColorBrush x:Key="Shell.Tab.Hover.Foreground" Color="#1F2226" />
      <SolidColorBrush x:Key="Shell.Tab.Preview" Color="#CDEDE8" />
      <SolidColorBrush x:Key="Shell.Tab.Preview.Foreground" Color="#062E2A" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive" Color="#F7F7F8" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive.Foreground" Color="#1F2226" />
      <SolidColorBrush x:Key="Shell.TabColor.1" Color="#0E70C0" />
