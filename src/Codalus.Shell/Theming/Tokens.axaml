      <SolidColorBrush x:Key="Shell.Warning" Color="#9A6A00" />
      <SolidColorBrush x:Key="Shell.Error" Color="#E51400" />
      <!-- Text in the state colors (M34g): Shell.Error and Shell.Warning are graphics at 3:1; text needs 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Error.Foreground" Color="#A1260D" />
      <SolidColorBrush x:Key="Shell.Warning.Foreground" Color="#7A5400" />
      <!-- Diff text (M34g): Shell.Diff.Added and .Removed are graphics at 3:1; added and removed lines need 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Diff.Added.Foreground" Color="#116329" />
      <SolidColorBrush x:Key="Shell.Diff.Removed.Foreground" Color="#A1260D" />
