      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#CDEDE8" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#CDEDE8" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#062E2A" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#062E2A" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPressed" Color="#062E2A" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#0F7C72" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#0F7C72" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#0F7C72" />
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#0F7C72" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#0F7C72" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#0F7C72" />
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#0F7C72" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#0F7C72" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#0F7C72" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
      <!-- A checked toggle button (M34g): the family's accent with its text, as the accent buttons (Classic High Contrast's blue was 4.5:1 under white). -->
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#0F7C72" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#0F7C72" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#0F7C72" />
