      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#0B1F1C" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#0B1F1C" />
      <!-- The control set (M34h, docs/design/controls.md): derived from the family's own colors by the design's rules (docs/design/controls.md) -->
      <SolidColorBrush x:Key="Shell.Button" Color="#202C2F" />
      <SolidColorBrush x:Key="Shell.Button.Foreground" Color="#DDE0E5" />
      <SolidColorBrush x:Key="Shell.Button.Border" Color="#2A3D41" />
