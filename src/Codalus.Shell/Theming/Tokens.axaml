    <!-- Harbor, Dark (M45, docs/design/shell-themes.md). -->
    <ResourceDictionary x:Key="{x:Static theming:ThemeService.HarborDark}">
      <SolidColorBrush x:Key="Shell.Background" Color="#121827" />
      <SolidColorBrush x:Key="Shell.Foreground" Color="#D9DFEE" />
      <SolidColorBrush x:Key="Shell.MutedForeground" Color="#9AA5C2" />
