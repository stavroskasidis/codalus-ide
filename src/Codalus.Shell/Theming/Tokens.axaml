      <!-- Graphite's focused tool window: an accent dot before its bold title. -->
      <DrawingBrush x:Key="Shell.Caption.Active.Marker" Stretch="None" AlignmentX="Left" AlignmentY="Center">
        <DrawingBrush.Drawing>
          <GeometryDrawing Brush="#2BB3A3" Geometry="M 0,3 A 3,3 0 1 1 6,3 A 3,3 0 1 1 0,3 Z" />
