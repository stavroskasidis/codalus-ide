      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Hover" Color="#44444C" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging" Color="#B4500F" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Hover" Color="#90400C" />
      <SolidColorBrush x:Key="Shell.Overlay" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Overlay.Border" Color="#E0E0E6" />
      <SolidColorBrush x:Key="Shell.Match" Color="#5A2FB0" />
      <SolidColorBrush x:Key="Shell.Info" Color="#1A85FF" />
      <SolidColorBrush x:Key="Shell.Warning" Color="#9A6A00" />
      <SolidColorBrush x:Key="Shell.Error" Color="#E51400" />
      <!-- Text in the state colors (M34g): Shell.Error and Shell.Warning are graphics at 3:1; text needs 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Error.Foreground" Color="#A1260D" />
      <SolidColorBrush x:Key="Shell.Warning.Foreground" Color="#7A5400" />
      <!-- Diff text (M34g): Shell.Diff.Added and .Removed are graphics at 3:1; added and removed lines need 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Diff.Added.Foreground" Color="#116329" />
      <SolidColorBrush x:Key="Shell.Diff.Removed.Foreground" Color="#A1260D" />
      <SolidColorBrush x:Key="Shell.Link" Color="#5A2FB0" />
      <SolidColorBrush x:Key="Shell.Modified" Color="#6B3FC4" />
      <SolidColorBrush x:Key="Shell.Editor.Background" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.Foreground" Color="#1F1F24" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers" Color="#6B6B76" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers.Current" Color="#6B6B76" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentLine" Color="#F7F5FC" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint" Color="#C4314B" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint.Line" Color="#FCEDEC" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentStatement" Color="#FFF3BF" />
      <SolidColorBrush x:Key="Shell.Diff.Added" Color="#1E7F34" />
      <SolidColorBrush x:Key="Shell.Diff.Removed" Color="#C62828" />
      <!-- The merge editor's conflict blocks (2026-10-19): a muted red fill with a dashed outline while unresolved, a solid outline once resolved. -->
      <SolidColorBrush x:Key="Shell.Merge.Conflict" Color="#F6DFDF" />
      <SolidColorBrush x:Key="Shell.Merge.Conflict.Border" Color="#C62828" />
      <SolidColorBrush x:Key="Shell.Merge.Resolved.Border" Color="#1E7F34" />
      <SolidColorBrush x:Key="Shell.Editor.Fold" Color="#8A8A8A" />
