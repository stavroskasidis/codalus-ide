      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#322B3D" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#322B3D" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#322B3D" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#D2B3FF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#D2B3FF" />
