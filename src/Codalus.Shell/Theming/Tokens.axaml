      <SolidColorBrush x:Key="Shell.Accent" Color="#2BB3A3" />
      <SolidColorBrush x:Key="Shell.AccentForeground" Color="#0B1F1C" />
      <SolidColorBrush x:Key="Shell.Focus" Color="#2BB3A3" />
      <SolidColorBrush x:Key="Shell.Input" Color="#1A1B1F" />
      <SolidColorBrush x:Key="Shell.StatusBar" Color="#0F766E" />
      <SolidColorBrush x:Key="Shell.StatusBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Hover" Color="#0C615A" />
      <SolidColorBrush x:Key="Shell.StatusBar.Border" Color="#0F766E" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty" Color="#3A3D45" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Hover" Color="#52545B" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging" Color="#A8480C" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Hover" Color="#863A0A" />
      <SolidColorBrush x:Key="Shell.Overlay" Color="#1F2125" />
      <SolidColorBrush x:Key="Shell.Overlay.Border" Color="#2A2D34" />
      <SolidColorBrush x:Key="Shell.Match" Color="#7CC4FF" />
      <SolidColorBrush x:Key="Shell.Info" Color="#3794FF" />
      <SolidColorBrush x:Key="Shell.Warning" Color="#CCA700" />
      <SolidColorBrush x:Key="Shell.Error" Color="#F14C4C" />
      <!-- Text in the state colors (M34g): Shell.Error and Shell.Warning are graphics at 3:1; text needs 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Error.Foreground" Color="#F48771" />
      <SolidColorBrush x:Key="Shell.Warning.Foreground" Color="#CCA700" />
      <!-- Diff text (M34g): Shell.Diff.Added and .Removed are graphics at 3:1; added and removed lines need 4.5:1. -->
      <SolidColorBrush x:Key="Shell.Diff.Added.Foreground" Color="#73C991" />
      <SolidColorBrush x:Key="Shell.Diff.Removed.Foreground" Color="#F48771" />
      <SolidColorBrush x:Key="Shell.Link" Color="#7CC4FF" />
      <SolidColorBrush x:Key="Shell.Modified" Color="#2BB3A3" />
      <SolidColorBrush x:Key="Shell.Editor.Background" Color="#1A1B1F" />
      <SolidColorBrush x:Key="Shell.Editor.Foreground" Color="#D5D8DE" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers" Color="#8A8F9A" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers.Current" Color="#8A8F9A" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentLine" Color="#202227" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint" Color="#F05A6E" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint.Line" Color="#3A1E22" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentStatement" Color="#3D3514" />
      <SolidColorBrush x:Key="Shell.Diff.Added" Color="#73C991" />
      <SolidColorBrush x:Key="Shell.Diff.Removed" Color="#F14C4C" />
      <!-- The merge editor's conflict blocks (2026-10-19): a muted red fill with a dashed outline while unresolved, a solid outline once resolved. -->
      <SolidColorBrush x:Key="Shell.Merge.Conflict" Color="#452528" />
      <SolidColorBrush x:Key="Shell.Merge.Conflict.Border" Color="#F14C4C" />
      <SolidColorBrush x:Key="Shell.Merge.Resolved.Border" Color="#73C991" />
