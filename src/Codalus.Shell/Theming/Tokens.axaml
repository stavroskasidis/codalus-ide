      <SolidColorBrush x:Key="Shell.Selection" Color="#EEE8FA" />
      <SolidColorBrush x:Key="Shell.Selection.Foreground" Color="#2A1660" />
      <SolidColorBrush x:Key="Shell.Accent" Color="#6B3FC4" />
      <SolidColorBrush x:Key="Shell.AccentForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Focus" Color="#6B3FC4" />
      <SolidColorBrush x:Key="Shell.Input" Color="#F3F3F6" />
      <SolidColorBrush x:Key="Shell.StatusBar" Color="#6B3FC4" />
      <SolidColorBrush x:Key="Shell.StatusBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Hover" Color="#5834A1" />
      <SolidColorBrush x:Key="Shell.StatusBar.Border" Color="#6B3FC4" />
