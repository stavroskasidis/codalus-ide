      <SolidColorBrush x:Key="Shell.TabColor.5" Color="#C4380D" />
      <SolidColorBrush x:Key="Shell.TabColor.6" Color="#0B7A75" />
      <SolidColorBrush x:Key="Shell.TabColor.7" Color="#B0306A" />
      <SolidColorBrush x:Key="Shell.TabColor.8" Color="#5B6B7A" />
      <!-- Shapes (the design's Shapes table). -->
      <x:Double x:Key="Shell.Gutter">1</x:Double>
      <SolidColorBrush x:Key="Shell.Gutter.Background" Color="#D3D6DB" />
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Top">0</CornerRadius>
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Bottom">0</CornerRadius>
      <Thickness x:Key="Shell.Tab.Active.Indicator">0,0,0,2</Thickness>
      <SolidColorBrush x:Key="Shell.Tab.Active.IndicatorBrush" Color="#0F7C72" />
      <x:Boolean x:Key="Shell.StatusBar.ShowDot">False</x:Boolean>
      <FontWeight x:Key="Shell.Caption.Active.FontWeight">Bold</FontWeight>
      <!-- Graphite's focused tool window: an accent dot before its bold title. -->
      <DrawingBrush x:Key="Shell.Caption.Active.Marker" Stretch="None" AlignmentX="Left" AlignmentY="Center">
        <DrawingBrush.Drawing>
          <GeometryDrawing Brush="#0F7C72" Geometry="M 0,3 A 3,3 0 1 1 6,3 A 3,3 0 1 1 0,3 Z" />
        </DrawingBrush.Drawing>
      </DrawingBrush>
      <Thickness x:Key="Shell.Caption.Active.MarkerPadding">11,0,0,0</Thickness>
      <!-- Rounded corners (0.6, D46) change only Classic's shapes: these keep this family's, Dock's values included (Classic's would leak in through the variant it inherits). -->
      <CornerRadius x:Key="Shell.Card.CornerRadius">0</CornerRadius>
      <Thickness x:Key="Shell.Card.BorderThickness">0</Thickness>
      <Thickness x:Key="Shell.Card.Content.BorderThickness">0</Thickness>
      <SolidColorBrush x:Key="Shell.Card.Background" Color="Transparent" />
      <SolidColorBrush x:Key="Shell.Well.Background" Color="Transparent" />
      <SolidColorBrush x:Key="Shell.Card.Focus.BorderBrush" Color="#D3D6DB" />
      <Thickness x:Key="Shell.ToolControl.BorderThickness">1,0,1,0</Thickness>
      <CornerRadius x:Key="Shell.ToolTab.CornerRadius">0</CornerRadius>
      <Thickness x:Key="Shell.Dock.Margin">0</Thickness>
      <Thickness x:Key="Shell.Toolbar.Margin">0</Thickness>
      <HorizontalAlignment x:Key="Shell.Toolbar.HorizontalAlignment">Stretch</HorizontalAlignment>
      <Thickness x:Key="Shell.Toolbar.BorderThickness">0,0,0,1</Thickness>
      <CornerRadius x:Key="Shell.Toolbar.CornerRadius">0</CornerRadius>
      <SolidColorBrush x:Key="Shell.Tab.Selected.IndicatorBrush" Color="Transparent" />
      <SolidColorBrush x:Key="Shell.Well.Frame.Active" Color="#66000000" />
      <Thickness x:Key="Shell.Well.Frame.Margin">0</Thickness>
      <x:Double x:Key="Shell.TabStripEdge.Height">0</x:Double>
      <Thickness x:Key="Shell.TabStripEdge.Margin">0</Thickness>
      <FontWeight x:Key="Shell.Tab.Selected.FontWeight">Normal</FontWeight>
      <CornerRadius x:Key="Shell.Control.CornerRadius.Compact">2</CornerRadius>
      <SolidColorBrush x:Key="Shell.Selection.Indicator" Color="Transparent" />
      <SolidColorBrush x:Key="Shell.Selection.Indicator.Inactive" Color="Transparent" />
      <Thickness x:Key="Shell.Row.Margin">0</Thickness>
      <CornerRadius x:Key="Shell.Row.CornerRadius">0</CornerRadius>
      <Thickness x:Key="Shell.AutoHide.BarThickness">0</Thickness>
      <SolidColorBrush x:Key="Shell.AutoHide.Bar" Color="Transparent" />
      <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
      <SolidColorBrush x:Key="DockDocumentContentBorderBrush" Color="#66000000" />
      <Thickness x:Key="DockDocumentContentBorderThickness">1</Thickness>
      <x:Double x:Key="DockDocumentTabStripSeparatorSize">2</x:Double>
      <CornerRadius x:Key="DockDocumentTabItemCornerRadius">0</CornerRadius>
      <Thickness x:Key="DockDocumentTabItemMargin">0</Thickness>
      <!-- Dock's document well and tool window captions. -->
      <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#0E1013" />
      <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#0E1013" />
