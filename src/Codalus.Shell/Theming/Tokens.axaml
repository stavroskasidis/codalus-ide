      <SolidColorBrush x:Key="DockSeparatorBrush" Color="#D3D6DB" />
      <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#D3D6DB" />
      <!-- Fluent controls in the family's colors: text boxes, selection, check boxes, toggles and accent buttons. -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
