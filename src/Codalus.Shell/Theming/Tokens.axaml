      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#0B1F1C" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#0B1F1C" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#0B1F1C" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0B1F1C" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0B1F1C" />
      <!-- A checked toggle button (M34g): the family's accent with its text, as the accent buttons (Classic High Contrast's blue was 4.5:1 under white). -->
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#2BB3A3" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2BB3A3" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#2BB3A3" />
