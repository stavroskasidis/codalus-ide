    <!-- Ember, Light (M45, docs/design/shell-themes.md). -->
    <ResourceDictionary x:Key="{x:Static theming:ThemeService.EmberLight}">
      <SolidColorBrush x:Key="Shell.Background" Color="#EDE8E3" />
