      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#D2B3FF" />
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#D2B3FF" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#D2B3FF" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D2B3FF" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#000000" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#000000" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#000000" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#000000" />
      <!-- A checked toggle button (M34g): the family's accent with its text, as the accent buttons (Classic High Contrast's blue was 4.5:1 under white). -->
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#D2B3FF" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#D2B3FF" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#D2B3FF" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFFFFF" />
