      <SolidColorBrush x:Key="Shell.Toolbar.Pressed" Color="#D5ECE9" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked" Color="#D4E5E4" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked.Border" Color="#0F7C72" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked.Foreground" Color="#062E2A" />
      <SolidColorBrush x:Key="Shell.Input.Border" Color="#C1C4C9" />
      <SolidColorBrush x:Key="Shell.Input.Border.Hover" Color="#94979C" />
      <SolidColorBrush x:Key="Shell.Input.Placeholder" Color="#555A63" />
      <SolidColorBrush x:Key="Shell.Disabled.Foreground" Color="#868990" />
      <SolidColorBrush x:Key="Shell.Disabled" Color="#EDEEEF" />
      <SolidColorBrush x:Key="Shell.Disabled.Border" Color="#DADBDD" />
      <SolidColorBrush x:Key="Shell.Check.Border" Color="#696E76" />
