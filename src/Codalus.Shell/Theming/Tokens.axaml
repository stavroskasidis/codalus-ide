      <SolidColorBrush x:Key="Shell.Dialog.Footer" Color="#EDEEEF" />
      <SolidColorBrush x:Key="Shell.Dialog.Scrim" Color="#6B1F2226" />
      <SolidColorBrush x:Key="Shell.Chat.User" Color="#DBE8E8" />
      <SolidColorBrush x:Key="Shell.Chat.User.Foreground" Color="#062E2A" />
      <SolidColorBrush x:Key="Shell.CodeBlock.Header" Color="#EDEEEF" />
      <CornerRadius x:Key="Shell.Control.CornerRadius">3</CornerRadius>
      <CornerRadius x:Key="Shell.Check.CornerRadius">3</CornerRadius>
      <CornerRadius x:Key="Shell.Focus.CornerRadius">5</CornerRadius>
      <!-- High contrast outlines what the others fill: a row under the pointer, chips and badges (Avalonia's borders draw no dashes). -->
      <BoxShadows x:Key="Shell.Row.Hover.Outline">0 0 0 0 #00000000</BoxShadows>
      <Thickness x:Key="Shell.Chip.BorderThickness">0</Thickness>
    </ResourceDictionary>

    <!-- Graphite, Dark (M45, docs/design/shell-themes.md). -->
    <ResourceDictionary x:Key="{x:Static theming:ThemeService.GraphiteDark}">
      <SolidColorBrush x:Key="Shell.Background" Color="#141518" />
      <SolidColorBrush x:Key="Shell.Foreground" Color="#D5D8DE" />
