<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theming="using:Codalus.Shell.Theming">
  <!--
    Theme tokens. Views use these keys (DynamicResource) instead of literal colors, so the themes switch at runtime.
    - Classic (M29, ADR 0019): Blue, Light and Dark follow Visual Studio's themes; High Contrast follows the Windows
      "high contrast black" conventions: pure black surfaces, white text, cyan accents, orange focus and selection
      outlines.
    - The theme families (M45, ADR 0077): Harbor, Graphite, Daylight and Ember, each Light, Dark and High contrast, with
      every color from docs/design/shell-themes.md. Each variant inherits Classic's of its kind (Light, Dark, High
      Contrast), so the Fluent controls start from those, but sets every Shell.* token itself. Their shapes are tokens
      too (Shell.Gutter, Shell.Panel.CornerRadius.*, Shell.Tab.Active.Indicator, Shell.StatusBar.ShowDot, Dock's tab
      corners), which ShellStyles.axaml applies, so views don't change.
    A family's token the design leaves out takes its panel colors, or a mix of its own colors that meets the contrast
    pairs (tests/Codalus.Shell.Tests/TestData/contrast-pairs.txt).
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Shell.Background" Color="#EEEEF2" />
      <SolidColorBrush x:Key="Shell.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.MutedForeground" Color="#646464" />
      <SolidColorBrush x:Key="Shell.Border" Color="#CCCEDB" />
      <SolidColorBrush x:Key="Shell.Panel" Color="#F5F5F5" />
      <SolidColorBrush x:Key="Shell.Hover" Color="#C9DEF5" />
      <SolidColorBrush x:Key="Shell.Selection" Color="#CCE8FF" />
      <SolidColorBrush x:Key="Shell.Accent" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.AccentForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Focus" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.StatusBar" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.StatusBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Hover" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.StatusBar.Border" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.Overlay" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Overlay.Border" Color="#C8C8C8" />
      <SolidColorBrush x:Key="Shell.Match" Color="#0066BF" />
      <SolidColorBrush x:Key="Shell.Info" Color="#1A85FF" />
      <SolidColorBrush x:Key="Shell.Warning" Color="#9A6A00" />
      <SolidColorBrush x:Key="Shell.Error" Color="#E51400" />
      <SolidColorBrush x:Key="Shell.Link" Color="#006AB1" />
      <SolidColorBrush x:Key="Shell.Modified" Color="#1A85FF" />
      <SolidColorBrush x:Key="Shell.Editor.Background" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers" Color="#6E7681" />
      <SolidColorBrush x:Key="Shell.Diff.Added" Color="#1E7F34" />
      <SolidColorBrush x:Key="Shell.Diff.Removed" Color="#C62828" />
      <SolidColorBrush x:Key="Shell.Editor.Fold" Color="#8A8A8A" />
      <SolidColorBrush x:Key="Shell.Editor.Fold.Hover" Color="#E5EBF1" />
      <!-- Icons in the Visual Studio palette (the maintainer's rule: every icon is colored), at least 3:1 against menus, toolbars and panels; command families are palette colors. -->
      <SolidColorBrush x:Key="Shell.Icon.Blue" Color="#00539C" />
      <SolidColorBrush x:Key="Shell.Icon.Green" Color="#388A34" />
      <SolidColorBrush x:Key="Shell.Icon.Red" Color="#A1260D" />
      <SolidColorBrush x:Key="Shell.Icon.Orange" Color="#B26B12" />
      <SolidColorBrush x:Key="Shell.Icon.Purple" Color="#652D90" />
      <SolidColorBrush x:Key="Shell.Icon.Yellow" Color="#8A6400" />
      <SolidColorBrush x:Key="Shell.Icon.Folder" Color="#8A6320" />
      <SolidColorBrush x:Key="Shell.Icon.Outline" Color="#424242" />
      <SolidColorBrush x:Key="Shell.Icon.Run" Color="#388A34" />
      <SolidColorBrush x:Key="Shell.Icon.Stop" Color="#A1260D" />
      <SolidColorBrush x:Key="Shell.Icon.Save" Color="#00539C" />
      <SolidColorBrush x:Key="Shell.Icon.Open" Color="#8A6320" />
      <SolidColorBrush x:Key="Shell.Icon.Build" Color="#652D90" />
      <SolidColorBrush x:Key="Shell.Icon.Git" Color="#B26B12" />
      <SolidColorBrush x:Key="Shell.Icon.Test" Color="#388A34" />
      <SolidColorBrush x:Key="Shell.Icon.Navigate" Color="#00539C" />
      <SolidColorBrush x:Key="Shell.Editor.InlayHint.Foreground" Color="#5F6670" />
      <SolidColorBrush x:Key="Shell.Editor.InlayHint.Background" Color="#F3F3F3" />
      <SolidColorBrush x:Key="Shell.Editor.Guide" Color="#E0E0E0" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket1" Color="#0431FA" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket2" Color="#319331" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket3" Color="#7B3814" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty" Color="#68217A" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging" Color="#BC4B00" />
      <SolidColorBrush x:Key="Shell.TitleBar" Color="#EEEEF2" />
      <SolidColorBrush x:Key="Shell.TitleBar.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Toolbar" Color="#EEEEF2" />
      <SolidColorBrush x:Key="Shell.Toolbar.Border" Color="#CCCEDB" />
      <SolidColorBrush x:Key="Shell.Search" Color="#F5F5F5" />
      <SolidColorBrush x:Key="Shell.Search.Border" Color="#CCCEDB" />
      <SolidColorBrush x:Key="Shell.Tab.Active" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.Tab.Active.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive" Color="#EEEEF2" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Caption.Active" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.Caption.Active.Foreground" Color="#FFFFFF" />
      <!-- M34d: the selected tab of a pane without the focus, hover, the preview tab, captions without the focus. -->
      <SolidColorBrush x:Key="Shell.Tab.Selected" Color="#CCCEDB" />
      <SolidColorBrush x:Key="Shell.Tab.Selected.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Tab.Hover" Color="#0E70C0" />
      <SolidColorBrush x:Key="Shell.Tab.Hover.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Tab.Preview" Color="#68217A" />
      <SolidColorBrush x:Key="Shell.Tab.Preview.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive" Color="#EEEEF2" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive.Foreground" Color="#3C3C3C" />
      <!-- Tabs colored by project (M34d): eight stripes, at least 3:1 against the tabs. -->
      <SolidColorBrush x:Key="Shell.TabColor.1" Color="#0E70C0" />
      <SolidColorBrush x:Key="Shell.TabColor.2" Color="#1E7F34" />
      <SolidColorBrush x:Key="Shell.TabColor.3" Color="#9A6700" />
      <SolidColorBrush x:Key="Shell.TabColor.4" Color="#7B4FD0" />
      <SolidColorBrush x:Key="Shell.TabColor.5" Color="#C4380D" />
      <SolidColorBrush x:Key="Shell.TabColor.6" Color="#0B7A75" />
      <SolidColorBrush x:Key="Shell.TabColor.7" Color="#B0306A" />
      <SolidColorBrush x:Key="Shell.TabColor.8" Color="#5B6B7A" />
      <!-- M45: tokens the theme families brought. In Classic they keep its look: text boxes stay Fluent's (Shell.Input
           matches them), the status bar's states keep its text and hover, and the debugger's lines are the colors the
           editor drew before, over its background. -->
      <SolidColorBrush x:Key="Shell.Selection.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Input" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Hover" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Hover" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.TitleBar.Hover" Color="#D7D7DA" />
      <SolidColorBrush x:Key="Shell.TitleBar.Chip" Color="#C9DEF5" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start" Color="#EEEEF2" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start.Icon" Color="#388A34" />
      <SolidColorBrush x:Key="Shell.Search.Foreground" Color="#646464" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentLine" Color="#F0F0F0" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint" Color="#E51400" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint.Line" Color="#F9C4BF" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentStatement" Color="#FFEEAA" />
      <!-- Shapes (M45): Dock's splitter, square panels and tabs, no tab indicator, captions in their color without a dot. -->
      <x:Double x:Key="Shell.Gutter">4</x:Double>
      <SolidColorBrush x:Key="Shell.Gutter.Background" Color="Transparent" />
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Top">0</CornerRadius>
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Bottom">0</CornerRadius>
      <Thickness x:Key="Shell.Tab.Active.Indicator">0</Thickness>
      <SolidColorBrush x:Key="Shell.Tab.Active.IndicatorBrush" Color="Transparent" />
      <x:Boolean x:Key="Shell.StatusBar.ShowDot">False</x:Boolean>
      <FontWeight x:Key="Shell.Caption.Active.FontWeight">Normal</FontWeight>
      <SolidColorBrush x:Key="Shell.Caption.Active.Marker" Color="Transparent" />
      <Thickness x:Key="Shell.Caption.Active.MarkerPadding">0</Thickness>
      <!-- Dock's document well and tool window captions. -->
      <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#007ACC" />
      <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#007ACC" />
      <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="#EEEEF2" />
      <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#EEEEF2" />
      <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#EEEEF2" />
      <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#EEEEF2" />
      <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#007ACC" />
      <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DockSeparatorBrush" Color="#CCCEDB" />
      <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#CCCEDB" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Shell.Background" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Foreground" Color="#F1F1F1" />
      <SolidColorBrush x:Key="Shell.MutedForeground" Color="#A6A6A6" />
      <SolidColorBrush x:Key="Shell.Border" Color="#3F3F46" />
      <SolidColorBrush x:Key="Shell.Panel" Color="#252526" />
      <SolidColorBrush x:Key="Shell.Hover" Color="#3E3E40" />
      <SolidColorBrush x:Key="Shell.Selection" Color="#3F3F46" />
      <SolidColorBrush x:Key="Shell.Accent" Color="#3794FF" />
      <SolidColorBrush x:Key="Shell.AccentForeground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Focus" Color="#3794FF" />
      <SolidColorBrush x:Key="Shell.StatusBar" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.StatusBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Hover" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.StatusBar.Border" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.Overlay" Color="#252526" />
      <SolidColorBrush x:Key="Shell.Overlay.Border" Color="#454545" />
      <SolidColorBrush x:Key="Shell.Match" Color="#2AAAFF" />
      <SolidColorBrush x:Key="Shell.Info" Color="#3794FF" />
      <SolidColorBrush x:Key="Shell.Warning" Color="#CCA700" />
      <SolidColorBrush x:Key="Shell.Error" Color="#F14C4C" />
      <SolidColorBrush x:Key="Shell.Link" Color="#4DAAFC" />
      <SolidColorBrush x:Key="Shell.Modified" Color="#3794FF" />
      <SolidColorBrush x:Key="Shell.Editor.Background" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Editor.Foreground" Color="#DCDCDC" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers" Color="#2B91AF" />
      <SolidColorBrush x:Key="Shell.Diff.Added" Color="#73C991" />
      <SolidColorBrush x:Key="Shell.Diff.Removed" Color="#F14C4C" />
      <SolidColorBrush x:Key="Shell.Editor.Fold" Color="#858585" />
      <SolidColorBrush x:Key="Shell.Editor.Fold.Hover" Color="#3E3E42" />
      <!-- Icons in the Visual Studio palette (every icon is colored); command families are palette colors. -->
      <SolidColorBrush x:Key="Shell.Icon.Blue" Color="#75BEFF" />
      <SolidColorBrush x:Key="Shell.Icon.Green" Color="#89D185" />
      <SolidColorBrush x:Key="Shell.Icon.Red" Color="#F48771" />
      <SolidColorBrush x:Key="Shell.Icon.Orange" Color="#E8AB53" />
      <SolidColorBrush x:Key="Shell.Icon.Purple" Color="#B180D7" />
      <SolidColorBrush x:Key="Shell.Icon.Yellow" Color="#FFCC00" />
      <SolidColorBrush x:Key="Shell.Icon.Folder" Color="#DCB67A" />
      <SolidColorBrush x:Key="Shell.Icon.Outline" Color="#C5C5C5" />
      <SolidColorBrush x:Key="Shell.Icon.Run" Color="#89D185" />
      <SolidColorBrush x:Key="Shell.Icon.Stop" Color="#F48771" />
      <SolidColorBrush x:Key="Shell.Icon.Save" Color="#75BEFF" />
      <SolidColorBrush x:Key="Shell.Icon.Open" Color="#DCB67A" />
      <SolidColorBrush x:Key="Shell.Icon.Build" Color="#B180D7" />
      <SolidColorBrush x:Key="Shell.Icon.Git" Color="#E8AB53" />
      <SolidColorBrush x:Key="Shell.Icon.Test" Color="#89D185" />
      <SolidColorBrush x:Key="Shell.Icon.Navigate" Color="#75BEFF" />
      <SolidColorBrush x:Key="Shell.Editor.InlayHint.Foreground" Color="#969696" />
      <SolidColorBrush x:Key="Shell.Editor.InlayHint.Background" Color="#2A2A2A" />
      <SolidColorBrush x:Key="Shell.Editor.Guide" Color="#404040" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket1" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket2" Color="#DA70D6" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket3" Color="#179FFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty" Color="#68217A" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging" Color="#BC4B00" />
      <SolidColorBrush x:Key="Shell.TitleBar" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.TitleBar.Foreground" Color="#F1F1F1" />
      <SolidColorBrush x:Key="Shell.Toolbar" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Toolbar.Border" Color="#3F3F46" />
      <SolidColorBrush x:Key="Shell.Search" Color="#333337" />
      <SolidColorBrush x:Key="Shell.Search.Border" Color="#434346" />
      <SolidColorBrush x:Key="Shell.Tab.Active" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.Tab.Active.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive.Foreground" Color="#F1F1F1" />
      <SolidColorBrush x:Key="Shell.Caption.Active" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.Caption.Active.Foreground" Color="#FFFFFF" />
      <!-- M34d: the selected tab of a pane without the focus, hover, the preview tab, captions without the focus. -->
      <SolidColorBrush x:Key="Shell.Tab.Selected" Color="#3F3F46" />
      <SolidColorBrush x:Key="Shell.Tab.Selected.Foreground" Color="#F1F1F1" />
      <SolidColorBrush x:Key="Shell.Tab.Hover" Color="#1177BB" />
      <SolidColorBrush x:Key="Shell.Tab.Hover.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Tab.Preview" Color="#68217A" />
      <SolidColorBrush x:Key="Shell.Tab.Preview.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive" Color="#252526" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive.Foreground" Color="#D0D0D0" />
      <!-- Tabs colored by project (M34d): eight stripes, at least 3:1 against the tabs. -->
      <SolidColorBrush x:Key="Shell.TabColor.1" Color="#75BEFF" />
      <SolidColorBrush x:Key="Shell.TabColor.2" Color="#89D185" />
      <SolidColorBrush x:Key="Shell.TabColor.3" Color="#DCB67A" />
      <SolidColorBrush x:Key="Shell.TabColor.4" Color="#C5A0F0" />
      <SolidColorBrush x:Key="Shell.TabColor.5" Color="#F37650" />
      <SolidColorBrush x:Key="Shell.TabColor.6" Color="#4EC9B0" />
      <SolidColorBrush x:Key="Shell.TabColor.7" Color="#F28CB8" />
      <SolidColorBrush x:Key="Shell.TabColor.8" Color="#A9B7C6" />
      <!-- M45: tokens the theme families brought. In Classic they keep its look: text boxes stay Fluent's (Shell.Input
           matches them), the status bar's states keep its text and hover, and the debugger's lines are the colors the
           editor drew before, over its background. -->
      <SolidColorBrush x:Key="Shell.Selection.Foreground" Color="#F1F1F1" />
      <SolidColorBrush x:Key="Shell.Input" Color="#2B2B2B" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Hover" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Hover" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.TitleBar.Hover" Color="#353535" />
      <SolidColorBrush x:Key="Shell.TitleBar.Chip" Color="#3E3E40" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start.Foreground" Color="#F1F1F1" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start.Icon" Color="#89D185" />
      <SolidColorBrush x:Key="Shell.Search.Foreground" Color="#A6A6A6" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentLine" Color="#2E2E2E" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint" Color="#E51400" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint.Line" Color="#501C16" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentStatement" Color="#695814" />
      <!-- Shapes (M45): Dock's splitter, square panels and tabs, no tab indicator, captions in their color without a dot. -->
      <x:Double x:Key="Shell.Gutter">4</x:Double>
      <SolidColorBrush x:Key="Shell.Gutter.Background" Color="Transparent" />
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Top">0</CornerRadius>
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Bottom">0</CornerRadius>
      <Thickness x:Key="Shell.Tab.Active.Indicator">0</Thickness>
      <SolidColorBrush x:Key="Shell.Tab.Active.IndicatorBrush" Color="Transparent" />
      <x:Boolean x:Key="Shell.StatusBar.ShowDot">False</x:Boolean>
      <FontWeight x:Key="Shell.Caption.Active.FontWeight">Normal</FontWeight>
      <SolidColorBrush x:Key="Shell.Caption.Active.Marker" Color="Transparent" />
      <Thickness x:Key="Shell.Caption.Active.MarkerPadding">0</Thickness>
      <!-- Dock's document well and tool window captions. -->
      <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#007ACC" />
      <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#007ACC" />
      <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="#1F1F1F" />
      <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#1F1F1F" />
      <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#1F1F1F" />
      <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#1F1F1F" />
      <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#007ACC" />
      <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#252526" />
      <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="DockSeparatorBrush" Color="#3F3F46" />
      <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#3F3F46" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="{x:Static theming:ThemeService.Blue}">
      <SolidColorBrush x:Key="Shell.Background" Color="#CCD5F0" />
      <SolidColorBrush x:Key="Shell.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.MutedForeground" Color="#4D5A73" />
      <SolidColorBrush x:Key="Shell.Border" Color="#8E9BBC" />
      <SolidColorBrush x:Key="Shell.Panel" Color="#F5F5F5" />
      <SolidColorBrush x:Key="Shell.Hover" Color="#FDF4BF" />
      <SolidColorBrush x:Key="Shell.Selection" Color="#C6D0EA" />
      <SolidColorBrush x:Key="Shell.Accent" Color="#0E70C0" />
      <SolidColorBrush x:Key="Shell.AccentForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Focus" Color="#0E70C0" />
      <SolidColorBrush x:Key="Shell.StatusBar" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.StatusBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Hover" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.StatusBar.Border" Color="#007ACC" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty" Color="#68217A" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging" Color="#BC4B00" />
      <SolidColorBrush x:Key="Shell.Overlay" Color="#FFFFFF" />
      <!-- Links and the modified mark on Blue's lavender surfaces (M34d: Light's fall short of AA there). -->
      <SolidColorBrush x:Key="Shell.Link" Color="#0054A0" />
      <SolidColorBrush x:Key="Shell.Modified" Color="#0E5FB4" />
      <SolidColorBrush x:Key="Shell.Overlay.Border" Color="#8E9BBC" />
      <SolidColorBrush x:Key="Shell.TitleBar" Color="#CCD5F0" />
      <SolidColorBrush x:Key="Shell.TitleBar.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Toolbar" Color="#D6DBE9" />
      <SolidColorBrush x:Key="Shell.Toolbar.Border" Color="#8E9BBC" />
      <SolidColorBrush x:Key="Shell.Search" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Search.Border" Color="#8E9BBC" />
      <SolidColorBrush x:Key="Shell.Tab.Active" Color="#F5CC84" />
      <SolidColorBrush x:Key="Shell.Tab.Active.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive" Color="#364E6F" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Caption.Active" Color="#FFF29D" />
      <SolidColorBrush x:Key="Shell.Caption.Active.Foreground" Color="#1E1E1E" />
      <!-- M34d: the selected tab of a pane without the focus, hover, the preview tab, captions without the focus. -->
      <SolidColorBrush x:Key="Shell.Tab.Selected" Color="#FDF4BF" />
      <SolidColorBrush x:Key="Shell.Tab.Selected.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Tab.Hover" Color="#5B7199" />
      <SolidColorBrush x:Key="Shell.Tab.Hover.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Tab.Preview" Color="#68217A" />
      <SolidColorBrush x:Key="Shell.Tab.Preview.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive" Color="#4D6082" />
      <SolidColorBrush x:Key="Shell.Caption.Inactive.Foreground" Color="#FFFFFF" />
      <!-- Tabs colored by project (M34d): eight stripes, at least 3:1 against the tabs. -->
      <SolidColorBrush x:Key="Shell.TabColor.1" Color="#75BEFF" />
      <SolidColorBrush x:Key="Shell.TabColor.2" Color="#89D185" />
      <SolidColorBrush x:Key="Shell.TabColor.3" Color="#DCB67A" />
      <SolidColorBrush x:Key="Shell.TabColor.4" Color="#C5A0F0" />
      <SolidColorBrush x:Key="Shell.TabColor.5" Color="#F37650" />
      <SolidColorBrush x:Key="Shell.TabColor.6" Color="#4EC9B0" />
      <SolidColorBrush x:Key="Shell.TabColor.7" Color="#F28CB8" />
      <SolidColorBrush x:Key="Shell.TabColor.8" Color="#A9B7C6" />
      <!-- M45: tokens the theme families brought. In Classic they keep its look: text boxes stay Fluent's (Shell.Input
           matches them), the status bar's states keep its text and hover, and the debugger's lines are the colors the
           editor drew before, over its background. -->
      <SolidColorBrush x:Key="Shell.Selection.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Input" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty.Hover" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging.Hover" Color="#005A9E" />
      <SolidColorBrush x:Key="Shell.TitleBar.Hover" Color="#B8C0D8" />
      <SolidColorBrush x:Key="Shell.TitleBar.Chip" Color="#FDF4BF" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start" Color="#D6DBE9" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start.Foreground" Color="#1E1E1E" />
      <SolidColorBrush x:Key="Shell.Toolbar.Start.Icon" Color="#388A34" />
      <SolidColorBrush x:Key="Shell.Search.Foreground" Color="#4D5A73" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentLine" Color="#F0F0F0" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint" Color="#E51400" />
      <SolidColorBrush x:Key="Shell.Editor.Breakpoint.Line" Color="#F9C4BF" />
      <SolidColorBrush x:Key="Shell.Editor.CurrentStatement" Color="#FFEEAA" />
      <!-- Shapes (M45): Dock's splitter, square panels and tabs, no tab indicator, captions in their color without a dot. -->
      <x:Double x:Key="Shell.Gutter">4</x:Double>
      <SolidColorBrush x:Key="Shell.Gutter.Background" Color="Transparent" />
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Top">0</CornerRadius>
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Bottom">0</CornerRadius>
      <Thickness x:Key="Shell.Tab.Active.Indicator">0</Thickness>
      <SolidColorBrush x:Key="Shell.Tab.Active.IndicatorBrush" Color="Transparent" />
      <x:Boolean x:Key="Shell.StatusBar.ShowDot">False</x:Boolean>
      <FontWeight x:Key="Shell.Caption.Active.FontWeight">Normal</FontWeight>
      <SolidColorBrush x:Key="Shell.Caption.Active.Marker" Color="Transparent" />
      <Thickness x:Key="Shell.Caption.Active.MarkerPadding">0</Thickness>
      <!-- Dock's document well and tool window captions. -->
      <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#F5CC84" />
      <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#F5CC84" />
      <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="#CCD5F0" />
      <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#CCD5F0" />
      <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#CCD5F0" />
      <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#CCD5F0" />
      <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#FFF29D" />
      <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#F5F5F5" />
      <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DockSeparatorBrush" Color="#8E9BBC" />
      <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#8E9BBC" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="{x:Static theming:ThemeService.HighContrast}">
      <SolidColorBrush x:Key="Shell.Background" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.MutedForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Panel" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Hover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Selection" Color="#0E4A7B" />
      <SolidColorBrush x:Key="Shell.Accent" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.AccentForeground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Focus" Color="#F38518" />
      <SolidColorBrush x:Key="Shell.StatusBar" Color="#000000" />
      <SolidColorBrush x:Key="Shell.StatusBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Hover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.StatusBar.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Overlay" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Overlay.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Match" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Info" Color="#75BEFF" />
      <SolidColorBrush x:Key="Shell.Warning" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.Error" Color="#F48771" />
      <SolidColorBrush x:Key="Shell.Link" Color="#21A6FF" />
      <SolidColorBrush x:Key="Shell.Modified" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.Editor.Background" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Editor.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.LineNumbers" Color="#FFFFFF" />
      <!-- Fluent colors (palettes cannot target custom variants). The accent fills selected tabs and checkboxes
           under white text, so it is a blue with about 5:1 contrast against white rather than cyan. -->
      <Color x:Key="SystemAccentColor">#0F6CBD</Color>
      <Color x:Key="SystemRegionColor">#000000</Color>
      <Color x:Key="SystemAltHighColor">#000000</Color>
      <Color x:Key="SystemBaseHighColor">#FFFFFF</Color>
      <Color x:Key="SystemBaseMediumColor">#FFFFFF</Color>
      <Color x:Key="SystemChromeLowColor">#000000</Color>
      <Color x:Key="SystemChromeMediumColor">#000000</Color>
      <Color x:Key="SystemChromeMediumLowColor">#000000</Color>
      <Color x:Key="SystemListLowColor">#1F1F1F</Color>
      <Color x:Key="SystemListMediumColor">#0E4A7B</Color>
      <SolidColorBrush x:Key="SystemRegionBrush" Color="#000000" />
      <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#000000" />
      <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#0F6CBD" />
      <!-- M34d: menus, drop-downs, flyouts and tooltips are black like High Contrast's other surfaces (Fluent's are dark
           gray, and its resources take their colors by StaticResource, so the keys the controls use are overridden). -->
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#000000" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#0E4A7B" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#0E4A7B" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="#0E4A7B" />
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#000000" />
      <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="ToolTipBackground" Color="#000000" />
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#6FC3DF" />
      <SolidColorBrush x:Key="ToolTipForeground" Color="#FFFFFF" />
      <!-- Buttons and combo boxes: black with a white outline, not Fluent's dark gray (buttons) or accent fill (combo boxes). -->
      <SolidColorBrush x:Key="ButtonBackground" Color="#000000" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1F1F1F" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0E4A7B" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#F38518" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1F1F1F" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#0E4A7B" />
      <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#F38518" />
      <SolidColorBrush x:Key="ComboBoxForeground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxForegroundFocused" Color="#FFFFFF" />
      <!-- Fluent focus rectangles. -->
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#F38518" />
      <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Diff.Added" Color="#00FF00" />
      <SolidColorBrush x:Key="Shell.Diff.Removed" Color="#FF6B6B" />
      <SolidColorBrush x:Key="Shell.Editor.Fold" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.Fold.Hover" Color="#0E4A7B" />
      <!-- High Contrast keeps icons monochrome: shape carries the meaning, not color. -->
      <SolidColorBrush x:Key="Shell.Icon.Blue" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Green" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Red" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Orange" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Purple" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Yellow" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Folder" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Outline" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Run" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Stop" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Save" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Open" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Build" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Git" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Test" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Icon.Navigate" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Editor.InlayHint.Foreground" Color="#D0D0D0" />
      <SolidColorBrush x:Key="Shell.Editor.InlayHint.Background" Color="#1A1A1A" />
      <SolidColorBrush x:Key="Shell.Editor.Guide" Color="#7F7F7F" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket1" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket2" Color="#DA70D6" />
      <SolidColorBrush x:Key="Shell.Editor.Bracket3" Color="#87CEFA" />
      <SolidColorBrush x:Key="Shell.StatusBar.Empty" Color="#000000" />
      <SolidColorBrush x:Key="Shell.StatusBar.Debugging" Color="#000000" />
      <SolidColorBrush x:Key="Shell.TitleBar" Color="#000000" />
      <SolidColorBrush x:Key="Shell.TitleBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Toolbar" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Toolbar.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Search" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Search.Border" Color="#6FC3DF" />
      <SolidColorBrush x:Key="Shell.Tab.Active" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Tab.Active.Foreground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Tab.Inactive.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Caption.Active" Color="#1AEBFF" />
      <SolidColorBrush x:Key="Shell.Caption.Active.Foreground" Color="#000000" />
      <!-- M34d: the selected tab of a pane without the focus, hover, the preview tab, captions without the focus. -->
      <SolidColorBrush x:Key="Shell.Tab.Selected" Color="#0E4A7B" />
      <SolidColorBrush x:Key="Shell.Tab.Selected.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Tab.Hover" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Tab.Hover.Foreground" Color="#FFFFFF" />
