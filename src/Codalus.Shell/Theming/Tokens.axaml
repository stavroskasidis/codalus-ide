      <SolidColorBrush x:Key="Shell.Hover" Color="#38314B" />
      <SolidColorBrush x:Key="Shell.Selection" Color="#3A2E5E" />
      <SolidColorBrush x:Key="Shell.Selection.Foreground" Color="#F1EBFF" />
      <SolidColorBrush x:Key="Shell.Accent" Color="#A98BFF" />
      <SolidColorBrush x:Key="Shell.AccentForeground" Color="#160A33" />
      <SolidColorBrush x:Key="Shell.Focus" Color="#A98BFF" />
      <SolidColorBrush x:Key="Shell.Input" Color="#2A2834" />
      <SolidColorBrush x:Key="Shell.StatusBar" Color="#5B3DB8" />
      <SolidColorBrush x:Key="Shell.StatusBar.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.StatusBar.Hover" Color="#4B3297" />
      <SolidColorBrush x:Key="Shell.StatusBar.Border" Color="#5B3DB8" />
