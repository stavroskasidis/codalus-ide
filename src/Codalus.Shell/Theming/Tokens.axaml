      <SolidColorBrush x:Key="Shell.Segment.Selected.Foreground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Selection.Inactive" Color="#1F1F1F" />
      <SolidColorBrush x:Key="Shell.Selection.Inactive.Foreground" Color="#FFFFFF" />
