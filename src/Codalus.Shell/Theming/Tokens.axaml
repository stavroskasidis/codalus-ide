      <SolidColorBrush x:Key="Shell.Tab.Active.IndicatorBrush" Color="#FFB547" />
      <x:Boolean x:Key="Shell.StatusBar.ShowDot">True</x:Boolean>
      <FontWeight x:Key="Shell.Caption.Active.FontWeight">Bold</FontWeight>
      <SolidColorBrush x:Key="Shell.Caption.Active.Marker" Color="Transparent" />
      <Thickness x:Key="Shell.Caption.Active.MarkerPadding">0</Thickness>
      <!-- Rounded corners (0.6, D46) change only Classic's shapes: these keep this family's, Dock's values included (Classic's would leak in through the variant it inherits). -->
      <CornerRadius x:Key="Shell.Card.CornerRadius">0</CornerRadius>
      <Thickness x:Key="Shell.Card.BorderThickness">0</Thickness>
      <Thickness x:Key="Shell.Card.Content.BorderThickness">0</Thickness>
      <SolidColorBrush x:Key="Shell.Card.Background" Color="Transparent" />
      <SolidColorBrush x:Key="Shell.Well.Background" Color="Transparent" />
      <SolidColorBrush x:Key="Shell.Card.Focus.BorderBrush" Color="#FFFFFF" />
      <Thickness x:Key="Shell.ToolControl.BorderThickness">1,0,1,0</Thickness>
      <CornerRadius x:Key="Shell.ToolTab.CornerRadius">0</CornerRadius>
      <Thickness x:Key="Shell.Dock.Margin">0</Thickness>
      <Thickness x:Key="Shell.Toolbar.Margin">0</Thickness>
      <HorizontalAlignment x:Key="Shell.Toolbar.HorizontalAlignment">Stretch</HorizontalAlignment>
      <Thickness x:Key="Shell.Toolbar.BorderThickness">0,0,0,1</Thickness>
      <CornerRadius x:Key="Shell.Toolbar.CornerRadius">0</CornerRadius>
      <SolidColorBrush x:Key="Shell.Tab.Selected.IndicatorBrush" Color="Transparent" />
      <SolidColorBrush x:Key="Shell.Well.Frame.Active" Color="#66FFFFFF" />
      <Thickness x:Key="Shell.Well.Frame.Margin">0</Thickness>
      <x:Double x:Key="Shell.TabStripEdge.Height">0</x:Double>
      <Thickness x:Key="Shell.TabStripEdge.Margin">0</Thickness>
      <FontWeight x:Key="Shell.Tab.Selected.FontWeight">Normal</FontWeight>
      <CornerRadius x:Key="Shell.Control.CornerRadius.Compact">2</CornerRadius>
      <SolidColorBrush x:Key="Shell.Selection.Indicator" Color="Transparent" />
      <SolidColorBrush x:Key="Shell.Selection.Indicator.Inactive" Color="Transparent" />
      <Thickness x:Key="Shell.Row.Margin">0</Thickness>
      <CornerRadius x:Key="Shell.Row.CornerRadius">0</CornerRadius>
      <Thickness x:Key="Shell.AutoHide.BarThickness">0</Thickness>
      <SolidColorBrush x:Key="Shell.AutoHide.Bar" Color="Transparent" />
      <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
      <SolidColorBrush x:Key="DockDocumentContentBorderBrush" Color="#66FFFFFF" />
      <Thickness x:Key="DockDocumentContentBorderThickness">1</Thickness>
      <x:Double x:Key="DockDocumentTabStripSeparatorSize">2</x:Double>
      <CornerRadius x:Key="DockDocumentTabItemCornerRadius">7</CornerRadius>
      <Thickness x:Key="DockDocumentTabItemMargin">2,3,2,3</Thickness>
      <!-- Dock's document well and tool window captions. -->
      <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#FFB547" />
      <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockDocumentTabCloseSelectedForegroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#FFB547" />
      <SolidColorBrush x:Key="DockDocumentTabStripBackgroundBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceWorkbenchBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceSidebarBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceHeaderBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfacePanelBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSurfaceEditorBrush" Color="#000000" />
      <SolidColorBrush x:Key="DockSeparatorBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="#FFFFFF" />
      <!-- Fluent controls in the family's colors: text boxes, selection, check boxes, toggles and accent buttons. -->
      <SolidColorBrush x:Key="TextControlBackground" Color="#000000" />
      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxBackground" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#000000" />
      <SolidColorBrush x:Key="ComboBoxBackgroundUnfocused" Color="#000000" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="#FFB547" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="#FFB547" />
      <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="#FFB547" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="#FFB547" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="#FFB547" />
      <SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="#FFB547" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="#000000" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="TreeViewItemForegroundSelectedPressed" Color="#000000" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FFB547" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FFB547" />
      <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#FFB547" />
      <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFB547" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFB547" />
      <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFB547" />
      <SolidColorBrush x:Key="AccentButtonBackground" Color="#FFB547" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFB547" />
      <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FFB547" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#000000" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#000000" />
      <SolidColorBrush x:Key="AccentButtonForeground" Color="#000000" />
      <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#000000" />
      <!-- A checked toggle button (M34g): the family's accent with its text, as the accent buttons (Classic High Contrast's blue was 4.5:1 under white). -->
      <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#FFB547" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FFB547" />
      <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#FFB547" />
      <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#000000" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#000000" />
      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#000000" />
      <SolidColorBrush x:Key="TextControlBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#3D2B11" />
      <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#3D2B11" />
      <SolidColorBrush x:Key="MenuFlyoutSubItemBackgroundSubMenuOpened" Color="#3D2B11" />
      <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#3D2B11" />
      <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#3D2B11" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#3D2B11" />
      <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#3D2B11" />
      <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFB547" />
      <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FFB547" />
      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#FFB547" />
      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFB547" />
      <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#FFB547" />
      <Color x:Key="SystemListMediumColor">#3D2B11</Color>
      <!-- The control set (M34h, docs/design/controls.md): derived from the family's own colors by the design's rules (docs/design/controls.md) -->
      <SolidColorBrush x:Key="Shell.Button" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Button.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Button.Border" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Button.Hover" Color="#3D2B11" />
      <SolidColorBrush x:Key="Shell.Button.Hover.Border" Color="#FFB547" />
      <SolidColorBrush x:Key="Shell.Button.Pressed" Color="#3D2B11" />
      <SolidColorBrush x:Key="Shell.Button.Pressed.Border" Color="#FFB547" />
      <SolidColorBrush x:Key="Shell.Accent.Hover" Color="#FFD391" />
      <SolidColorBrush x:Key="Shell.Accent.Pressed" Color="#FFB547" />
      <SolidColorBrush x:Key="Shell.Toolbar.Hover" Color="#3D2B11" />
      <SolidColorBrush x:Key="Shell.Toolbar.Hover.Border" Color="#FFB547" />
      <SolidColorBrush x:Key="Shell.Toolbar.Pressed" Color="#3D2B11" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked" Color="#FFB547" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked.Border" Color="#FFB547" />
      <SolidColorBrush x:Key="Shell.Toolbar.Checked.Foreground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Input.Border" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Input.Border.Hover" Color="#FFB547" />
      <SolidColorBrush x:Key="Shell.Input.Placeholder" Color="#D6D6D6" />
      <SolidColorBrush x:Key="Shell.Disabled.Foreground" Color="#9A9A9A" />
      <SolidColorBrush x:Key="Shell.Disabled" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Disabled.Border" Color="#6E6E6E" />
      <SolidColorBrush x:Key="Shell.Check.Border" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Segment.Selected" Color="#FFB547" />
      <SolidColorBrush x:Key="Shell.Segment.Selected.Foreground" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Selection.Inactive" Color="#3D2B11" />
      <SolidColorBrush x:Key="Shell.Selection.Inactive.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Row.Hover" Color="#3D2B11" />
      <SolidColorBrush x:Key="Shell.Grid.Header" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Grid.Rule" Color="#5C5C5C" />
      <SolidColorBrush x:Key="Shell.ViewTabs.Rule" Color="#8C8C8C" />
      <SolidColorBrush x:Key="Shell.Match.Background" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Match.Background.Foreground" Color="#FFE66D" />
      <SolidColorBrush x:Key="Shell.Badge" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Badge.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Status.Success" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Status.Success.Foreground" Color="#00FF00" />
      <SolidColorBrush x:Key="Shell.Status.Error" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Status.Error.Foreground" Color="#F48771" />
      <SolidColorBrush x:Key="Shell.Status.Warning" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Status.Warning.Foreground" Color="#FFD700" />
      <SolidColorBrush x:Key="Shell.Status.Info" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Status.Info.Foreground" Color="#7CF0FF" />
      <SolidColorBrush x:Key="Shell.Dialog.Footer" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Dialog.Scrim" Color="#B8000000" />
      <SolidColorBrush x:Key="Shell.Chat.User" Color="#000000" />
      <SolidColorBrush x:Key="Shell.Chat.User.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.CodeBlock.Header" Color="#000000" />
      <CornerRadius x:Key="Shell.Control.CornerRadius">6</CornerRadius>
      <CornerRadius x:Key="Shell.Check.CornerRadius">4</CornerRadius>
      <CornerRadius x:Key="Shell.Focus.CornerRadius">8</CornerRadius>
      <!-- High contrast outlines what the others fill: a row under the pointer, chips and badges (Avalonia's borders draw no dashes). -->
      <BoxShadows x:Key="Shell.Row.Hover.Outline">inset 0 0 0 1 #FFFFFF</BoxShadows>
      <Thickness x:Key="Shell.Chip.BorderThickness">1</Thickness>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!--
    Spacing, sizes and type (M34d, docs/ui-guidelines.md). The same in every theme. Spacing is a 4 px grid (2 for
    hairlines); toolbars are one height with one icon size; UI text is 9 pt (12 px), secondary text 11 px, and there
    are two heading sizes. Views take these through the classes in ShellStyles.axaml or {DynamicResource}.
  -->
  <x:Double x:Key="Shell.Space.XS">2</x:Double>
  <x:Double x:Key="Shell.Space.S">4</x:Double>
  <x:Double x:Key="Shell.Space.M">8</x:Double>
  <x:Double x:Key="Shell.Space.L">12</x:Double>
  <x:Double x:Key="Shell.Space.XL">16</x:Double>
  <x:Double x:Key="Shell.Size.Toolbar">28</x:Double>
  <x:Double x:Key="Shell.Size.ToolbarButton">24</x:Double>
  <x:Double x:Key="Shell.Size.Input">24</x:Double>
  <x:Double x:Key="Shell.Size.Icon">16</x:Double>
  <x:Double x:Key="Shell.Size.IconSmall">12</x:Double>
  <x:Double x:Key="Shell.Size.Row">22</x:Double>
  <x:Double x:Key="Shell.Size.ToolWindowMinWidth">280</x:Double>
  <x:Double x:Key="Shell.FontSize.Body">12</x:Double>
  <x:Double x:Key="Shell.FontSize.Small">11</x:Double>
  <x:Double x:Key="Shell.FontSize.Heading">14</x:Double>
  <x:Double x:Key="Shell.FontSize.Title">18</x:Double>
  <Thickness x:Key="Shell.Padding.Toolbar">4,2</Thickness>
  <Thickness x:Key="Shell.Padding.ToolbarButton">4,3</Thickness>
  <Thickness x:Key="Shell.Padding.Panel">8,6</Thickness>
  <Thickness x:Key="Shell.Padding.EmptyState">12</Thickness>
  <Thickness x:Key="Shell.Padding.Page">16</Thickness>
  <Thickness x:Key="Shell.Padding.Row">0,1</Thickness>
  <CornerRadius x:Key="Shell.CornerRadius">3</CornerRadius>
  <CornerRadius x:Key="Shell.CornerRadius.Overlay">6</CornerRadius>
  <!-- Two overlay radii (0.6, D46): menus, drop-down lists, flyouts and toasts 6 (Fluent's own 5 too), dialogs and Code Search 8. -->
  <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="Shell.CornerRadius.Dialog">8</CornerRadius>
  <!--
    The control set (M34h, docs/design/controls.md): one height per context (28 px in dialogs, documents and pages,
    24 px in tool windows and toolbars), a button's padding and the gap before its text, the focus ring (2 px in
    Shell.Focus, 1 px outside the control: the ring's margin is their sum), the in-window dialog's padding and width, the
    segmented control's and the view tabs' heights. Shell.Control.CornerRadius differs per family and sits in each theme.
  -->
  <x:Double x:Key="Shell.Size.Control">28</x:Double>
  <x:Double x:Key="Shell.Size.Button.MinWidth">80</x:Double>
  <Thickness x:Key="Shell.Padding.Button">12,0</Thickness>
  <Thickness x:Key="Shell.Padding.ButtonCompact">8,0</Thickness>
  <x:Double x:Key="Shell.Space.ButtonIcon">6</x:Double>
  <Thickness x:Key="Shell.Focus.Thickness">2</Thickness>
  <x:Double x:Key="Shell.Focus.Offset">1</x:Double>
  <Thickness x:Key="Shell.Focus.Margin">-3</Thickness>
  <Thickness x:Key="Shell.Padding.Dialog">20,16</Thickness>
  <Thickness x:Key="Shell.Padding.DialogFooter">20,12</Thickness>
  <x:Double x:Key="Shell.Size.Dialog.Width">520</x:Double>
  <x:Double x:Key="Shell.Size.Dialog.MaxWidth">720</x:Double>
  <x:Double x:Key="Shell.Size.Segment">24</x:Double>
  <x:Double x:Key="Shell.Size.Tab">28</x:Double>

  <!-- Menu density (M34a): rows of about 24 px at 9 pt, as in a classic IDE, so the menus fit a 1080p screen. -->
  <Thickness x:Key="MenuFlyoutItemThemePadding">8,4,12,4</Thickness>
  <Thickness x:Key="MenuFlyoutItemThemePaddingNarrow">8,4,12,4</Thickness>
  <Thickness x:Key="MenuFlyoutSeparatorThemePadding">-4,2,-4,2</Thickness>
</ResourceDictionary>
