      <Thickness x:Key="Shell.Row.Margin">0</Thickness>
      <CornerRadius x:Key="Shell.Row.CornerRadius">0</CornerRadius>
      <Thickness x:Key="Shell.AutoHide.BarThickness">0</Thickness>
      <SolidColorBrush x:Key="Shell.AutoHide.Bar" Color="Transparent" />
