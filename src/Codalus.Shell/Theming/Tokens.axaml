      <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />
      <!-- The control set (M34h, docs/design/controls.md): derived from the family's own colors by the design's rules (docs/design/controls.md) -->
      <SolidColorBrush x:Key="Shell.Button" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Shell.Button.Foreground" Color="#1F2226" />
      <SolidColorBrush x:Key="Shell.Button.Border" Color="#C1C4C9" />
      <SolidColorBrush x:Key="Shell.Button.Hover" Color="#ECF3F3" />
      <SolidColorBrush x:Key="Shell.Button.Hover.Border" Color="#9BAEB0" />
