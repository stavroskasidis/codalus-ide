      <x:Double x:Key="Shell.Gutter">6</x:Double>
      <SolidColorBrush x:Key="Shell.Gutter.Background" Color="#D5DDEF" />
      <CornerRadius x:Key="Shell.Panel.CornerRadius.Top">0</CornerRadius>
