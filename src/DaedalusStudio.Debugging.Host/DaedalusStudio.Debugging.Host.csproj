<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- On .NET 10 when installed, else the next newer .NET (ADR 0025). -->
    <RollForward>Major</RollForward>
    <AssemblyName>daedalus-debughost</AssemblyName>
    <RootNamespace>DaedalusStudio.Debugging.Host</RootNamespace>
    <Description>The debug companion host (M14b, ADR 0032): the debuggee's debugger attributes, dumps (ClrMD) and Create Dump, over JSON-RPC on stdio.</Description>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DaedalusStudio.Rpc\DaedalusStudio.Rpc.csproj" />
    <ProjectReference Include="..\DaedalusStudio.Debugging\DaedalusStudio.Debugging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DaedalusStudio.Debugging.Tests" />
  </ItemGroup>
</Project>
