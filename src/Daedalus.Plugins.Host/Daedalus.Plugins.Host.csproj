<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>daedalus-pluginhost</AssemblyName>
    <RootNamespace>Daedalus.Plugins.Host</RootNamespace>
    <Description>Out-of-process plugin host (ADR 0003): loads plugins into isolated load contexts and speaks JSON-RPC with the shell over stdio.</Description>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Daedalus.Rpc\Daedalus.Rpc.csproj" />
    <ProjectReference Include="..\Daedalus.Plugins.Protocol\Daedalus.Plugins.Protocol.csproj" />
    <ProjectReference Include="..\Daedalus.Plugins.Abstractions\Daedalus.Plugins.Abstractions.csproj" />
  </ItemGroup>
</Project>
