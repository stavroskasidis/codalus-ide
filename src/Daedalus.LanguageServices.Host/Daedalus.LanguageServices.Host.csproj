<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>daedalus-lshost</AssemblyName>
    <RootNamespace>Daedalus.LanguageServices.Host</RootNamespace>
    <Description>Out-of-process C# language service host (Roslyn, ADR 0005) speaking LSP over stdio.</Description>
    <!-- Roslyn relies on reflection (MEF, analyzers); the host runs on the regular JIT runtime. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- Roslyn ships messages in 13 languages; the IDE is English for now. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daedalus.Rpc\Daedalus.Rpc.csproj" />
    <ProjectReference Include="..\Daedalus.LanguageServices.Protocol\Daedalus.LanguageServices.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Daedalus.LanguageServices.Host.Tests" />
  </ItemGroup>
</Project>
