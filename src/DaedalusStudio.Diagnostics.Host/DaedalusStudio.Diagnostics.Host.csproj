<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- On .NET 10 when installed, else the next newer .NET (ADR 0025). -->
    <RollForward>Major</RollForward>
    <AssemblyName>daedalus-diaghost</AssemblyName>
    <RootNamespace>DaedalusStudio.Diagnostics.Host</RootNamespace>
    <Description>The diagnostics host (M18, ADR 0044): EventPipe sessions (counters, events, the CPU sample profiler) on .NET processes and trace processing (TraceEvent), over JSON-RPC on stdio.</Description>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The File I/O tool reads the OS's I/O counters (LibraryImport). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DaedalusStudio.Rpc\DaedalusStudio.Rpc.csproj" />
    <ProjectReference Include="..\DaedalusStudio.Diagnostics.Protocol\DaedalusStudio.Diagnostics.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
    <!--
      Its build props copy native Windows binaries (KernelTraceControl.dll for ETW kernel sessions, msdia140.dll for
      Windows PDBs) that are under Microsoft's proprietary terms: never shipped (ADR 0044). EventPipe traces and portable
      PDBs need neither.
    -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DaedalusStudio.Workbench.Tests" />
  </ItemGroup>
</Project>
