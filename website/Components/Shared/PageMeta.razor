@using System.Text.Json.Nodes
@inject SiteOptions Site
@inject Releases Releases
@inject NavigationManager Nav

<PageTitle>@FullTitle</PageTitle>
<HeadContent>
    <meta name="description" content="@Description" />
    <meta property="og:title" content="@FullTitle" />
    <meta property="og:description" content="@Description" />
    <meta property="og:url" content="@Canonical" />
    <meta property="og:image" content="@ImageUrl" />
    <meta property="og:image:alt" content="@ImageAlt" />
    <meta name="twitter:image" content="@ImageUrl" />
    <link rel="canonical" href="@Canonical" />
    @if (Software)
    {
        @((MarkupString)$"<script type=\"application/ld+json\">{SoftwareJson()}</script>")
    }
    @if (Breadcrumbs is { Count: > 0 })
    {
        @((MarkupString)$"<script type=\"application/ld+json\">{BreadcrumbJson()}</script>")
    }
</HeadContent>

@code {
    /// <summary>The page's name; " · Codalus IDE" follows it unless <see cref="Exact"/>.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter, EditorRequired] public string Description { get; set; } = "";

    [Parameter] public bool Exact { get; set; }

    /// <summary>Describe the product to search engines too: schema.org's <c>SoftwareApplication</c> as JSON-LD.</summary>
    [Parameter] public bool Software { get; set; }

    /// <summary>The page's preview image for social sites: a file in <c>assets/screenshots/</c> (M50).</summary>
    [Parameter] public string Image { get; set; } = "editor-dark.png";

    /// <summary>What the preview image shows, for readers that don't load it.</summary>
    [Parameter] public string ImageAlt { get; set; } = "Codalus IDE's C# editor in a dark theme";

    /// <summary>The page's place in the site, from the top (name and site-relative address): schema.org's <c>BreadcrumbList</c>.</summary>
    [Parameter] public IReadOnlyList<(string Name, string Url)>? Breadcrumbs { get; set; }

    private string ImageUrl => $"{Site.BaseUrl}assets/screenshots/{Image}";

    private string FullTitle => Exact ? Title : $"{Title} · Codalus IDE";

    private string Canonical => Site.BaseUrl + Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];

    // Markup, since Razor would encode the type's +. The serializer escapes <, > and &, so nothing in it can close
    // the script element.
    private string SoftwareJson()
    {
        var app = new JsonObject
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "SoftwareApplication",
            ["name"] = "Codalus IDE",
            ["alternateName"] = "Codalus",
            ["description"] = Description,
            ["url"] = Site.BaseUrl,
            ["applicationCategory"] = "DeveloperApplication",
            ["operatingSystem"] = "Windows, macOS, Linux",
            ["downloadUrl"] = Site.BaseUrl + "download/",
            ["screenshot"] = Site.BaseUrl + "assets/screenshots/editor-dark.png",
            ["license"] = "https://opensource.org/license/mit",
            ["isAccessibleForFree"] = true,
            ["offers"] = new JsonObject { ["@type"] = "Offer", ["price"] = "0", ["priceCurrency"] = "USD" },
            ["sameAs"] = new JsonArray(Site.GitHub),
        };
        if (Releases.Stable is { } version)
        {
            app["softwareVersion"] = version;
        }

        return app.ToJsonString();
    }

    private string BreadcrumbJson()
    {
        var items = new JsonArray();
        for (var i = 0; i < Breadcrumbs!.Count; i++)
        {
            items.Add(new JsonObject
            {
                ["@type"] = "ListItem",
                ["position"] = i + 1,
                ["name"] = Breadcrumbs[i].Name,
                ["item"] = Site.BaseUrl + Breadcrumbs[i].Url,
            });
        }

        return new JsonObject { ["@context"] = "https://schema.org", ["@type"] = "BreadcrumbList", ["itemListElement"] = items }.ToJsonString();
    }
}
