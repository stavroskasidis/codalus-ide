@page "/download"
@inject Releases Releases
@inject SiteOptions Site

<PageMeta Image="setup.png" ImageAlt="The first-run setup of Codalus IDE" Title="Download" Software="true" Description="Download Codalus IDE for Windows, macOS and Linux: installers that update themselves, a portable zip, apt and dnf repositories, the AUR, and an AppImage for any Linux distribution." />

<div class="container">
    <div class="intro-split rise">
        <section class="page-intro">
            <p class="eyebrow">Download@(Releases.Offered is { } offered ? $" · {offered}" : "")</p>
            <h1 class="display display-l">Install Codalus IDE</h1>
            <p class="lead">Free and open source. The installers update themselves from signed feeds, and the debugger is included.</p>
        </section>
        <section class="requirements" aria-labelledby="prereq">
            <p id="prereq">Before you install</p>
            <ul>
                <li><a href="https://dotnet.microsoft.com/download/dotnet/11.0">.NET 11 SDK</a><span>RC 3 or later, or newer</span></li>
                <li><a href="https://git-scm.com/downloads">git</a><span>2.30 or newer, on the PATH</span></li>
            </ul>
            <p>Codalus runs its helper processes on .NET 11 (release candidate 3 or later until .NET 11's release in November), and builds your solutions with any SDK from 2.1.200 on. When that runtime is missing, Codalus says so and offers to install it, and it doesn't download an update whose runtime isn't installed. <a href="docs/getting-started/#prerequisites">Details</a></p>
        </section>
    </div>

    @if (Releases.OnlyNightly)
    {
        <div class="notice notice-amber" style="margin-top: 32px">
            <p><strong>No stable release yet.</strong> These are the newest nightly build, @Releases.Nightly, built from develop. Expect rough edges, and please <a href="@(Site.GitHub)/issues">report what you find</a>.</p>
        </div>
    }
    else if (Releases.Offered is null)
    {
        <div class="notice notice-amber" style="margin-top: 32px">
            <p><strong>The first release isn't out yet.</strong> The links below lead to the releases page; until then, build from source.</p>
        </div>
    }

    <section class="rise rise-2" style="padding-top: 56px" aria-label="Downloads" data-tabs data-tabs-hash data-tabs-detect>
        <div class="tabs tabs-os" role="tablist" aria-label="Operating system" hidden>
            <button class="tab" type="button" role="tab" id="tab-windows" aria-controls="windows-panel" data-key="windows"><span class="tab-name">Windows</span><span class="tab-req">Windows 11 · x64</span></button>
            <button class="tab" type="button" role="tab" id="tab-macos" aria-controls="macos-panel" data-key="macos"><span class="tab-name">macOS</span><span class="tab-req">macOS 15+ · Apple silicon</span></button>
            <button class="tab" type="button" role="tab" id="tab-linux" aria-controls="linux-panel" data-key="linux"><span class="tab-name">Linux</span><span class="tab-req">x64 or arm64 · X11 or Wayland</span></button>
        </div>

        <div class="os-panel" role="tabpanel" id="windows-panel" aria-labelledby="tab-windows">
            <div class="os-head"><h2 id="windows">Windows</h2><span>Windows 11, x64</span></div>
            <DownloadFile Kind="Installer" Suffix="win-x64-setup.exe" Recommended="true">
                Installs for you alone, without administrator rights. Adds a Start menu entry and <code>codalus</code> to your PATH, and updates itself.
            </DownloadFile>
            <DownloadFile Kind="Portable zip" Suffix="win-x64.zip">Unzip anywhere and run codalus.exe. It doesn't update itself.</DownloadFile>
            <div class="os-foot">
                <strong>First start: “Windows protected your PC”</strong>
                <span>The installers aren't code-signed yet. Choose More info, then Run anyway. Windows asks only once.</span>
            </div>
        </div>

        <div class="os-panel" role="tabpanel" id="macos-panel" aria-labelledby="tab-macos">
            <div class="os-head"><h2 id="macos">macOS</h2><span>macOS 15 or newer, Apple silicon</span></div>
            <DownloadFile Kind="Installer package" Suffix="osx-arm64.pkg" Recommended="true">
                Install for you (~/Applications) or for every user (/Applications). The app updates itself.
            </DownloadFile>
            <DownloadFile Kind="App bundle" Suffix="osx-arm64.app.zip">The app on its own: unzip it and move it where you like.</DownloadFile>
            <div class="os-foot">
                <strong>First start: “Apple could not verify…”</strong>
                <span>The installers aren't code-signed yet. Close the message, open System Settings → Privacy &amp; Security, choose Open Anyway next to Codalus IDE, then open it again.</span>
            </div>
        </div>

        <div class="os-panel" role="tabpanel" id="linux-panel" aria-labelledby="tab-linux">
            <div class="os-head"><h2 id="linux">Linux</h2><span>x64 or arm64, X11 or Wayland through XWayland</span></div>
            @* A picker of distributions (site.js; without script every panel shows). Each leads with what installs from
               its package manager, which adds the menu entry and the command and updates with the system; the
               AppImage is for the rest. The repositories' headings keep their old anchors (#apt, #dnf, #zypper, #aur). *@
            <div class="distros" data-tabs data-tabs-hash data-tabs-detect-distro>
                <div class="tabs tabs-bar" role="tablist" aria-label="Linux distribution" hidden>
                    @foreach (var (key, name) in s_distros)
                    {
                        <button class="tab" type="button" role="tab" id="tab-@key" aria-controls="@key-panel" data-key="@key">@name</button>
                    }
                </div>
                <div class="distro" role="tabpanel" id="debian-panel" aria-labelledby="tab-debian">
                    <div class="distro-repo">
                        <h2 id="apt">Debian, Ubuntu and Linux Mint: the apt repository <span class="badge">Recommended</span></h2>
                        <p>Adds Codalus IDE to the applications menu and <code>codalus</code> to your PATH. <code>sudo apt upgrade</code> updates it with everything else.</p>
                        <Commands Text="@Apt" />
                        <p>Needs apt 1.6 or later (Debian 10, Ubuntu 18.04). Added the repository before 0.4.0? Run the second command again.</p>
                    </div>
                    <DownloadFile Kind="The .deb on its own" Suffix="linux-x64.deb" Arm64Suffix="linux-arm64.deb">
                        <code>sudo apt install ./</code> the file. Without the repository it doesn't update.
                    </DownloadFile>
                </div>
                <div class="distro" role="tabpanel" id="fedora-panel" aria-labelledby="tab-fedora">
                    <div class="distro-repo">
                        <h2 id="dnf">Fedora, RHEL and their relatives: the dnf repository <span class="badge">Recommended</span></h2>
                        <p>Adds Codalus IDE to the applications menu and <code>codalus</code> to your PATH. <code>sudo dnf upgrade</code> updates it with everything else.</p>
                        <Commands Text="@Dnf" />
                        <p>Use <code>nightly</code> in place of <code>stable</code> for nightly builds.</p>
                    </div>
                    <DownloadFile Kind="The .rpm on its own" Suffix="linux-x64.rpm" Arm64Suffix="linux-arm64.rpm">
                        <code>sudo dnf install ./</code> the file. Without the repository it doesn't update.
                    </DownloadFile>
                </div>
                <div class="distro" role="tabpanel" id="opensuse-panel" aria-labelledby="tab-opensuse">
                    <div class="distro-repo">
                        <h2 id="zypper">openSUSE: the rpm repository, with zypper <span class="badge">Recommended</span></h2>
                        <p>Adds Codalus IDE to the applications menu and <code>codalus</code> to your PATH. <code>sudo zypper update</code> updates it with everything else.</p>
                        <Commands Text="@Zypper" />
                        <p>Added it before 0.4.0? Remove it with <code>sudo zypper removerepo codalus-stable</code> and add it again.</p>
                    </div>
                    <DownloadFile Kind="The .rpm on its own" Suffix="linux-x64.rpm" Arm64Suffix="linux-arm64.rpm">
                        <code>sudo zypper install ./</code> the file. Without the repository it doesn't update.
                    </DownloadFile>
                </div>
                <div class="distro" role="tabpanel" id="arch-panel" aria-labelledby="tab-arch">
                    <div class="distro-repo">
                        <h2 id="aur">Arch Linux and Manjaro: the AUR <span class="badge">Recommended</span></h2>
                        <p>Adds Codalus IDE to the applications menu and <code>codalus</code> to your PATH. An AUR helper updates it with everything else.</p>
                        <Commands Text="@Aur" />
                        <p>Or with an AUR helper: <code>yay -S codalus-bin</code>.</p>
                    </div>
                </div>
                <div class="distro" role="tabpanel" id="other-panel" aria-labelledby="tab-other">
                    <div class="distro-repo">
                        <h2 id="appimage">Any distribution: the AppImage</h2>
                        <p>One file that runs on any distribution, without administrator rights, and updates itself. It doesn't add itself to the applications menu: on Debian, Ubuntu, Fedora, openSUSE or Arch, their package does.</p>
                    </div>
                    <DownloadFile Kind="AppImage" Suffix="linux-x64.AppImage" Arm64Suffix="linux-arm64.AppImage" Recommended="true">
                        Make it executable, then open it (<a href="download/#appimage-run">how</a>).
                    </DownloadFile>
                    <div class="distro-repo">
                        <h2 id="appimage-run">Running the AppImage</h2>
                        <ul>
                            <li><strong>From the file manager:</strong> right-click the file, choose Properties, and turn on <em>Executable as Program</em> (GNOME Files) or <em>Is executable</em> under Permissions (Dolphin). Then double-click it.</li>
                            <li><strong>From a terminal:</strong></li>
                        </ul>
                        <Commands Text="@AppImage" />
                        <p>It needs FUSE, which desktop installations have: the <code>fuse3</code> package (not the older <code>libfuse2</code> that some AppImages ask for). Where FUSE isn't available, in a container say, it says “Cannot mount AppImage”: start it with <code>--appimage-extract-and-run</code>, or set <code>APPIMAGE_EXTRACT_AND_RUN=1</code>.</p>
                    </div>
                    <DownloadFile Kind="Tarball" Suffix="linux-x64.tar.gz" Arm64Suffix="linux-arm64.tar.gz">
                        Extract it and run <code>codalus/codalus</code>. It doesn't update itself.
                    </DownloadFile>
                </div>
            </div>
            <div class="os-foot">
                <strong>Signed packages</strong>
                <span>The apt and dnf repositories and the .rpm packages are signed with the project's key, and the packages download from the GitHub release.</span>
            </div>
        </div>
    </section>

    <section class="section" aria-label="Channels and verification">
        <div class="grid grid-wide">
            <div class="card card-outline lift reveal">
                <h2>Stable and nightly</h2>
                <p>
                    Stable releases come from master. Nightly builds come from each change to develop that passes the tests on every platform, and are marked as prereleases.
                    @if (Releases.Stable is not null && Releases.Nightly is { } nightly)
                    {
                        @("The newest is ")<a href="@Releases.ReleaseUrl(nightly)">@nightly</a>@(".")
                    }
                </p>
                <a class="link-arrow" href="@Releases.ReleasesUrl">All releases <Icon Name="arrow" Size="16" /></a>
            </div>
            <div class="card card-outline lift reveal">
                <h2>Check the download</h2>
                <p>Every release lists the SHA-256 of each file in SHA256SUMS.txt. The .rpm packages and the apt and dnf repositories are signed with the project's key.</p>
                <a class="link-arrow" href="@Site.Blob("eng/packaging/linux/codalus-packages.asc")">The signing key <Icon Name="arrow" Size="16" /></a>
            </div>
            <div class="card card-outline lift reveal">
                <h2>Build from source</h2>
                <Commands Text="@Source" />
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="next">
        <div class="band reveal">
            <div class="band-text">
                <h2 id="next">Installed? Open a solution.</h2>
                <p>File → Open Solution or Project (Ctrl+Shift+O), or <code>codalus path/to/App.slnx</code>. Trust the folder, and the projects load, restore and light up.</p>
            </div>
            <a class="button button-light" href="docs/getting-started/#first-start">Getting started</a>
        </div>
    </section>
</div>

@code {
    // The repositories' metadata is served next to the site and the packages from the releases (eng/linux-repos.sh,
    // .github/workflows/pages.yml): apt and zypper read through mirror lists, dnf through the metadata's package addresses.
    private string Apt => $"""
        curl -fsSL {Site.BaseUrl}codalus-packages.asc | sudo gpg --dearmor -o /usr/share/keyrings/codalus.gpg
        echo "deb [signed-by=/usr/share/keyrings/codalus.gpg] mirror+{Site.BaseUrl}apt/mirrors.txt stable main" | sudo tee /etc/apt/sources.list.d/codalus.list
        sudo apt update && sudo apt install codalus
        """;

    private string Dnf => $"""
        sudo curl -fsSL -o /etc/yum.repos.d/codalus.repo {Site.BaseUrl}rpm/codalus-stable.repo
        sudo dnf install codalus
        """;

    private string Zypper => $"""
        sudo rpm --import {Site.BaseUrl}codalus-packages.asc
        sudo zypper addrepo {Site.BaseUrl}rpm/codalus-stable.repo
        sudo zypper install codalus
        """;

    private static readonly (string Key, string Name)[] s_distros =
    [
        ("debian", "Debian and Ubuntu"),
        ("fedora", "Fedora and RHEL"),
        ("opensuse", "openSUSE"),
        ("arch", "Arch Linux"),
        ("other", "Other distributions"),
    ];

    private string AppImage => $"""
        chmod +x {Releases.FileName("linux-x64.AppImage")}
        ./{Releases.FileName("linux-x64.AppImage")}
        """;

    private const string Aur = """
        git clone https://aur.archlinux.org/codalus-bin.git
        cd codalus-bin && makepkg -si
        """;

    private string Source => $"""
        git clone {Site.GitHub}
        cd codalus-ide
        dotnet run --project src/Codalus.Shell
        """;
}
