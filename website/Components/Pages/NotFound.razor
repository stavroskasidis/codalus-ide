@page "/404.html"

@* GitHub Pages serves 404.html for any address the site doesn't have; the app shows it for unknown routes too. *@
<PageMeta Title="Page not found" Description="This page doesn't exist on the Codalus IDE website." />

<div class="container">
    <section class="page-intro" style="padding-bottom: 40px">
        <p class="eyebrow">404</p>
        <h1 class="display display-l">This page isn't here.</h1>
        <p class="lead">It may have moved when the user guide changed. Try the guide's contents, or start from the home page.</p>
        <div class="hero-actions" style="justify-content: flex-start">
            <a class="button" href="./">Home</a>
            <a class="button button-quiet" href="docs/">User guide</a>
        </div>
    </section>
</div>
