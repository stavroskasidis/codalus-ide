@page "/"
@inject Releases Releases
@inject SiteOptions Site

<PageMeta Exact="true" Software="true" Title="Codalus IDE: the open-source .NET IDE for Windows, macOS and Linux"
          Description="Codalus IDE is a free, open-source IDE for .NET, native on Windows, macOS and Linux: the classic IDE's look and feel everywhere, remote development over SSH, in WSL and in containers, and an MCP server that gives your coding agents the IDE's compiler, tests and debugger." />

<div class="container">
    <section class="hero">
        <div class="hero-main">
            @if (Releases.Stable is { } stable)
            {
                <a class="pill rise" href="@Releases.ReleaseUrl(stable)"><span class="pill-tag">NEW</span>Version @stable is out: see what's in it <Icon Name="arrow" Size="14" /></a>
            }
            else if (Releases.OnlyNightly)
            {
                <a class="pill rise" href="@Releases.ReleaseUrl(Releases.Nightly)"><span class="pill-tag">PREVIEW</span>Nightly builds are available while 0.x takes shape <Icon Name="arrow" Size="14" /></a>
            }
            <h1 class="display display-xl rise rise-1">A real .NET IDE.<br /><span class="accent">Native on every desktop.</span></h1>
            <p class="lead rise rise-2">An open-source IDE for .NET, free, MIT-licensed and without telemetry. What sets it apart:</p>
            <ul class="hero-points rise rise-2">
                <li><a href="docs/getting-started/#the-first-run-setup">The classic IDE's look and feel, on macOS and Linux too</a></li>
                <li><a href="docs/remote/">Remote development over SSH, in WSL and in Dev Containers</a></li>
                <li><a href="docs/ai/#codalus-as-an-mcp-server">An MCP server that gives your coding agents the IDE's compiler, tests and debugger</a></li>
            </ul>
            <div class="hero-actions rise rise-3">
                <a class="button" href="download/" data-download-os @attributes="DownloadFiles">
                    <Icon Name="download" Size="18" />
                    <span data-label>Download</span>
                </a>
                <a class="button button-quiet" href="docs/">Read the user guide</a>
            </div>
        </div>
        <dl class="facts rise rise-4" aria-label="Platforms">
            <div><dt>Windows</dt><dd>11 x64</dd></div>
            <div><dt>macOS</dt><dd>15+ Apple silicon</dd></div>
            <div><dt>Linux</dt><dd>x64 and arm64</dd></div>
            <div><dt>Needs</dt><dd>.NET 11 SDK</dd></div>
            <div class="facts-link"><dt class="visually-hidden">More</dt><dd><a href="download/">Other downloads and package repositories</a></dd></div>
        </dl>
    </section>

    <section class="viewer rise rise-5" aria-label="Screenshot">
        <figure class="shot">
            <img src="assets/screenshots/editor-dark.png" width="1280" height="800" alt="The editor with inlay hints, the References window with the references to Greet, and the Solution Explorer" />
            <figcaption><strong>Editor</strong><span>Roslyn-powered C# with inlay hints, Find All References and the Solution Explorer.</span></figcaption>
        </figure>
    </section>

    <section class="spotlight reveal" aria-labelledby="app-models">
        <div class="section-head">
            <p class="eyebrow">Built for what you build</p>
            <h2 class="heading" id="app-models">One IDE for every .NET app model.</h2>
        </div>
        <div class="viewer tour" data-tabs>
            <div class="tabs tabs-rail" role="tablist" aria-label="App models" aria-orientation="vertical" hidden>
                @foreach (var model in s_models)
                {
                    <button class="tab" type="button" role="tab" id="tab-@model.Key" aria-controls="model-@model.Key" data-key="@model.Key"><span>@model.Label</span><span class="tab-ext">@model.Ext</span></button>
                }
            </div>
            <div class="tour-shots">
                @foreach (var (model, i) in s_models.Select((m, i) => (m, i)))
                {
                    <div class="shot model" role="tabpanel" id="model-@model.Key" aria-labelledby="tab-@model.Key" hidden="@(i != 0)">
                        <figure><img src="assets/screenshots/@model.File" width="1280" height="800" loading="lazy" alt="@model.Alt" /></figure>
                        <div class="model-text">
                            <div class="model-what">
                                <h3>@model.Label</h3>
                                <ul>
                                    @foreach (var point in model.Points)
                                    {
                                        <li>@point</li>
                                    }
                                </ul>
                            </div>
                            <div class="model-where">
                                <p class="model-where-label">Where it runs</p>
                                <p>@model.Where</p>
                                <a class="link-arrow" href="@model.Guide">@model.Label in the guide <Icon Name="arrow" Size="16" /></a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="spotlight reveal" aria-labelledby="ai">
        <div class="head-row">
            <div class="section-head">
                <p class="eyebrow">AI, on your terms</p>
                <h2 class="heading" id="ai">Your agent, with the whole IDE behind it.</h2>
            </div>
            <a class="link-arrow" href="docs/ai/">AI assistance in the guide <Icon Name="arrow" Size="16" /></a>
        </div>
        <div class="viewer tour" data-tabs>
            <div class="tabs tabs-rail" role="tablist" aria-label="AI features" aria-orientation="vertical" hidden>
                @foreach (var feature in s_ai)
                {
                    <button class="tab" type="button" role="tab" id="aitab-@feature.Key" aria-controls="ai-@feature.Key" data-key="ai-@feature.Key"><span>@feature.Label</span><span class="tab-ext">@feature.Ext</span></button>
                }
            </div>
            <div class="tour-shots">
                @foreach (var (feature, i) in s_ai.Select((f, i) => (f, i)))
                {
                    <div class="shot model" role="tabpanel" id="ai-@feature.Key" aria-labelledby="aitab-@feature.Key" hidden="@(i != 0)">
                        <figure><img src="assets/screenshots/@feature.File" width="1280" height="800" loading="lazy" alt="@feature.Alt" /></figure>
                        <div class="model-text">
                            <div class="model-what">
                                <h3>@feature.Label</h3>
                                <ul>
                                    @foreach (var point in feature.Points)
                                    {
                                        <li>@point</li>
                                    }
                                </ul>
                            </div>
                            <div class="model-where">
                                <p class="model-where-label">What stays yours</p>
                                <p>@feature.Where</p>
                                <a class="link-arrow" href="@feature.Guide">@feature.Label in the guide <Icon Name="arrow" Size="16" /></a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="everything">
        <div class="head-row">
            <div class="section-head">
                <p class="eyebrow">The whole inner loop</p>
                <h2 class="heading" id="everything">From opening a solution to shipping it, in one window.</h2>
            </div>
            <a class="link-arrow" href="features/">Every feature, with screenshots <Icon Name="arrow" Size="16" /></a>
        </div>
        <div class="groups">
            <div class="card group lift reveal">
                <div class="group-head"><span class="group-icon"><Icon Name="code" Size="20" /></span><h3>Write</h3></div>
                <div class="group-item"><h4>C# on Roslyn</h4><p>Semantic highlighting, completion, live diagnostics, refactorings with previews, your analyzers and source generators, and Code Search across the whole solution.</p></div>
                <div class="group-item"><h4>A real project system</h4><p>.sln and .slnx, SDK-style and .NET Framework projects on MSBuild, property pages, configurations, multi-targeting and NuGet.</p></div>
                <div class="group-item"><h4>Web, Razor and Blazor</h4><p>C# inside .razor and .cshtml, .http files, an Endpoints Explorer, and HTML, CSS and TypeScript servers.</p></div>
                <div class="group-item"><h4>Avalonia XAML</h4><p>Completion and binding paths in .axaml files, XAML diagnostics, and a live previewer beside the code.</p></div>
            </div>
            <div class="card group lift reveal">
                <div class="group-head"><span class="group-icon group-icon-amber"><Icon Name="bug" Size="20" /></span><h3>Run and fix</h3></div>
                <div class="group-item"><h4>Debugging</h4><p>Conditional breakpoints and logpoints, data tips, Watch, visualizers, PerfTips, and Blazor in the browser.</p></div>
                <div class="group-item"><h4>Testing</h4><p>A Test Explorer for xUnit, NUnit, MSTest and TUnit, test margins in the editor, and coverage with Coverlet.</p></div>
                <div class="group-item"><h4>Profiling</h4><p>Live .NET counters, CPU traces with flame graphs and hot lines in the editor, memory snapshots and .NET Async, through EventPipe.</p></div>
                <div class="group-item"><h4>Containers and Aspire</h4><p>Run and debug in a container with docker or podman, and debug an Aspire AppHost with all its projects.</p></div>
            </div>
            <div class="card group lift reveal">
                <div class="group-head"><span class="group-icon"><Icon Name="branch" Size="20" /></span><h3>Ship and extend</h3></div>
                <div class="group-item"><h4>Git and pull requests</h4><p>Hunk staging, a history graph, branch management, a 3-way merge editor, interactive rebase, every repository of a solution in one window, and GitHub, Azure DevOps and GitLab.</p></div>
                <div class="group-item"><h4>Data and EF Core</h4><p>Migrations and model views on your own dotnet-ef, and a Database Explorer for SQL Server, PostgreSQL, MySQL and SQLite.</p></div>
                <div class="group-item"><h4>Terminal and C# Interactive</h4><p>Your own shells with clickable file:line links, and a C# REPL that loads NuGet packages and your project.</p></div>
                <div class="group-item"><h4>Plugins</h4><p>A versioned, out-of-process plugin API, and any LSP language server added without writing code.</p></div>
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="arch">
        <div class="panel arch reveal">
            <div class="split-text">
                <p class="eyebrow">Built to stay responsive</p>
                <h2 class="heading" id="arch">A light native shell. Heavy work out of process.</h2>
                <p>The window is a Native AOT app. Roslyn, MSBuild, the debugger and plugins each run in their own supervised process. If one crashes, it restarts, and the editor never goes down with it. What stays in the window is built not to wait: everyday work on large solutions, from opening hundreds of projects to a test run of 20,000 results, is tested on every change so that no click or keystroke waits more than a second.</p>
            </div>
            <div class="arch-diagram">
                <div class="arch-shell"><strong>codalus</strong><span>UI shell · Native AOT</span></div>
                <div class="arch-wire">JSON-RPC · LSP · DAP</div>
                <ul class="arch-hosts" aria-label="Processes the shell supervises">
                    @foreach (var (name, role) in s_hosts)
                    {
                        <li><span>@name</span><span>@role</span></li>
                    }
                </ul>
            </div>
        </div>
    </section>

    <section class="section" aria-label="Principles">
        <div class="principles reveal">
            <div>
                <h3>Open source</h3>
                <p>MIT-licensed and developed in the open on GitHub. Every third-party component is listed with its license.</p>
            </div>
            <div>
                <h3>Private</h3>
                <p>No telemetry, and the tools it runs send none either: the .NET SDK's and Avalonia's build telemetry are turned off for its builds. Crash reports stay on your machine and are opt-in. Tokens live in the OS credential store.</p>
            </div>
            <div>
                <h3>Safe by default</h3>
                <p>Untrusted folders open in restricted mode: no MSBuild, no restore, no code runs until you trust them.</p>
            </div>
            <div>
                <h3>Familiar</h3>
                <p>A classic IDE layout and keyboard scheme, the Classic themes plus four theme families (Harbor, Graphite, Daylight and Ember, each Light, Dark and High contrast), and VS Code, ReSharper and Emacs key bindings as options, all offered by a setup at the first start.</p>
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="cta">
        <div class="band reveal">
            <div class="band-text">
                <h2 id="cta">Open your solution in Codalus IDE.</h2>
                <p>Installers for Windows, macOS and Linux that update themselves, plus apt and dnf repositories. You need the .NET 11 SDK (or newer) and git 2.30 or newer.</p>
            </div>
            <div class="hero-actions">
                <a class="button button-light" href="download/" data-download-os @attributes="DownloadFiles"><span data-label>Download for your platform</span></a>
                <a class="button button-ghost" href="@Site.GitHub">Star on GitHub</a>
            </div>
        </div>
    </section>
</div>

@code {
    private sealed record Model(string Key, string Label, string Ext, string File, string Alt, string[] Points, string Where, string Guide);

    /// <summary>
    /// The offered release's recommended file for Windows and macOS: site.js points the Download buttons at the
    /// visitor's, so a click downloads it. Linux has none: the button leads to the Download page's Linux tab, which
    /// recommends the visitor's distribution's package, and the AppImage for the others. Without a release (or without
    /// script) the buttons lead to the Download page.
    /// </summary>
    private Dictionary<string, object> DownloadFiles => Releases.Offered is null ? [] : new()
    {
        ["data-windows"] = Releases.AssetUrl("win-x64-setup.exe"),
        ["data-macos"] = Releases.AssetUrl("osx-arm64.pkg"),
    };

    /// <summary>
