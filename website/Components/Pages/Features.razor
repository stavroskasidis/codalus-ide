@page "/features"
@inject SiteOptions Site

<PageMeta Image="intellisense.png" ImageAlt="IntelliSense in the C# editor of Codalus IDE" Title="Features" Description="Everything in Codalus IDE: the C# editor, navigation, solutions and NuGet, build and test, debugging, Git and pull requests, web, data, containers, .NET MAUI, WPF, Windows Forms and WinUI 3, .NET Framework, Visual Basic, F#, WCF, profiling and more." />

<div class="container">
    <section class="page-intro rise">
        <p class="eyebrow">Features</p>
        <h1 class="display display-l">Everything you need to build for .NET. <span class="accent">Nothing to bolt on.</span></h1>
        <p class="lead">Write, run, debug, test and ship from one fast, native IDE on Windows, macOS and Linux. The tools you'd otherwise collect one extension at a time are already here, and they work together from the first launch.</p>
        <div class="hero-actions">
            <a class="button" href="download/" data-download-os>
                <Icon Name="download" Size="18" />
                <span data-label>Download</span>
            </a>
            <a class="button button-quiet" href="docs/getting-started/">Get started</a>
        </div>
    </section>

    <section class="viewer tour rise rise-3" aria-label="Screenshot tour" data-tabs>
        <div class="tabs tabs-rail" role="tablist" aria-label="Screenshots" hidden>
            @foreach (var shot in s_shots)
            {
                <button class="tab" type="button" role="tab" id="tab-@shot.Key" aria-controls="shot-@shot.Key" data-key="@shot.Key">@shot.Label</button>
            }
        </div>
        <div class="tour-shots">
            @foreach (var shot in s_shots)
            {
                <div class="shot" role="tabpanel" id="shot-@shot.Key" aria-labelledby="tab-@shot.Key" hidden="@(shot != s_shots[0])"><figure>
                    @* Lazy, the first too (M50): it loads at once in view, and an eager one delayed the intro's paint on a slow connection. *@
                    <img src="assets/screenshots/@shot.File" width="1280" height="800" loading="lazy" alt="@shot.Alt" />
                    <figcaption><strong>@shot.Label</strong><span>@shot.Caption</span></figcaption>
                </figure></div>
            }
        </div>
    </section>

    <section class="section themes" aria-labelledby="themes">
        <div class="head-row">
            <div class="section-head">
                <p class="eyebrow">Make it yours</p>
                <h2 class="heading" id="themes">Classic, and four theme families.</h2>
            </div>
            <p class="muted small">Classic, the default, in Blue, Light, Dark and High Contrast, and Harbor, Graphite, Daylight and Ember, each in Light, Dark and High contrast, following your system or not. A classic layout in each: the menu and search in the title bar, the Solution Explorer on the right, and a status bar colored by state.</p>
        </div>
        <div class="grid grid-wide">
            @foreach (var (family, variant, line) in s_families)
            {
                <figure class="lift reveal">
                    <img src="assets/screenshots/theme-@(family.ToLowerInvariant()).png" width="1280" height="800" loading="lazy" alt="Codalus IDE in the @family family, @variant" />
                    <figcaption><strong>@family <span>@variant</span></strong><span>@(char.ToUpperInvariant(line[0]) + line[1..])</span></figcaption>
                </figure>
            }
        </div>
    </section>

    <section class="section" aria-labelledby="all">
        <div class="section-head" style="margin-bottom: 28px">
            <p class="eyebrow">The full list</p>
            <h2 class="heading" id="all">Everything in the box</h2>
        </div>
        <nav class="chips" aria-label="Feature areas">
            @foreach (var (id, title) in s_areas)
            {
                <a href="features/#@id">@title</a>
            }
        </nav>
        <div class="feature-lists">
            <div class="card lift reveal" id="editor">
                <h3>Editor</h3>
                <ul>
                    <li>Tabs with preview and split views, multiple carets, folding and a minimap</li>
                    <li>Semantic highlighting, and IntelliSense like a classic IDE's: a completion list with an icon per kind, filters (Alt+C classes, Alt+M methods…, Alt+J target type matches), commit characters (Con then . gives Console.), the expected type preselected, and a description beside the selection; parameter info above the line with overloads and the active parameter in bold; Quick Info with fixes for the errors under the pointer. Signatures in your editor's colors, generics as you use them</li>
                    <li>Live diagnostics and an Error List, grouped by project, file, severity or code, with background analysis of open documents, the current project or the solution</li>
                    <li>Rename, code fixes and refactorings, all with previews</li>
                    <li>Snippets, Code Cleanup, format on save and local history</li>
                    <li>Pasted code brings its usings along; editor settings per language, and an EditorConfig settings page</li>
                    <li>CodeLens with references, Git history and test status</li>
                </ul>
            </div>
            <div class="card lift reveal" id="navigation">
                <h3>Navigation</h3>
                <ul>
                    <li>Go to Definition and Implementation, into decompiled code</li>
                    <li>Navigate Backward and Forward through the documents and places you were, from the toolbar, the keyboard or the mouse's back and forward buttons</li>
                    <li>Find All References as the classic IDE shows it: grouped by project and definition, the classic IDE's columns with resizable widths and per-column filters, a scope box, and Keep Results opening another window</li>
                    <li>Code Search: files, types, members and text in one window, with filter chips, a live, editable preview, and an index kept with the solution so it finds everything right after a restart</li>
                    <li>Feature Search for commands, settings and Options pages, from the search box</li>
                    <li>Peek Definition, Call and Type Hierarchy, Class View and the Object Browser</li>
                    <li>Find and Replace in Files: a floating window, and results in the editor's colors with every match highlighted, grouped by folder and file as a tree or listed, filtered and kept</li>
                    <li>Inlay hints, CodeLens, an inheritance margin and sticky scroll</li>
                    <li>Library code from Source Link before decompiling</li>
                </ul>
            </div>
            <div class="card lift reveal" id="solutions-and-nuget">
                <h3>Solutions and NuGet</h3>
                <ul>
                    <li>.sln and .slnx, SDK-style projects and solution filters</li>
                    <li>Property pages that show where each value comes from</li>
                    <li>Launch profiles, Configuration Manager and Reference Manager</li>
                    <li>Browse, update and consolidate packages; Central Package Management</li>
                    <li>nuget.org's verified owners: a badge after a package whose ID prefix nuget.org reserved for one of its owners, shown only when it can be nobody else's copy (never from a mirror), and search that leaves out what package source mapping wouldn't restore</li>
                    <li>New Project as the classic IDE's three-page wizard: recent templates, search and filters, each template's own options, and the framework with its support</li>
                    <li>The Properties window, Show All Files, Sync with Active Document and Track Active Item, Add New Item, templates and External Tools</li>
                    <li>Folder mode for a folder without a solution</li>
                    <li>A solution reopens as you left it: documents, breakpoints, bookmarks, configuration and the Solution Explorer's expansion, kept in a self-ignoring .codalus/state next to it</li>
                    <li>.NET 11 projects with C# 15, every framework from .NET Core 2.0 to .NET 10, and older SDKs in global.json</li>
                    <li>A start window with your recent solutions, pinned and searchable</li>
                    <li>Check Environment: a missing .NET SDK or git offered to install, and the .NET runtime Codalus itself needs: one notification that installs it and starts the helper processes again</li>
                </ul>
            </div>
            <div class="card lift reveal" id="build-run-and-test">
                <h3>Build, run and test</h3>
                <ul>
                    <li>Build, Rebuild and Clean on MSBuild, cancellable</li>
                    <li>Colored output: errors, warnings and successes in your theme's colors, standard error in red, and programs' ANSI colors shown as colors</li>
                    <li>A fast up-to-date check, binary logs and build timings</li>
                    <li>Batch Build, build events, and custom tools for ResX and T4, with a resource editor for .resx files</li>
                    <li>Run with Ctrl+F5, and multiple startup projects</li>
                    <li>A Test Explorer for xUnit, NUnit, MSTest and TUnit</li>
                    <li>Code coverage with Coverlet</li>
                </ul>
            </div>
            <div class="card lift reveal" id="debugging">
                <h3>Debugging</h3>
                <ul>
                    <li>Launch (F5) and attach, stepping and threads</li>
                    <li>Conditions, hit counts, logpoints and dependent breakpoints</li>
                    <li>Text, JSON, XML and HTML visualizers, and [DebuggerDisplay]</li>
                    <li>Data tips like a classic IDE's: the header over the hovered expression, each expanded level a tip of its own, members grouped with their icons, List, Dictionary, HashSet, Queue and Stack as their elements, View drop-downs for visualizers, values edited in place and red when they changed, any row pinned, and Ctrl to see through them</li>
                    <li>Pinned data tips that expand like the data tip, PerfTips and Run to Click</li>
                    <li>Locals, Autos, Watch and QuickWatch with the data tip's rows: Name, Value and Type in aligned columns at every depth, expansion kept across steps, values edited in place</li>
                    <li>Dumps, Parallel Stacks and Parallel Watch, and Just-In-Time crash dumps</li>
                    <li>Attach over SSH, in containers and in WSL; console apps in the integrated terminal</li>
                    <li>Blazor WebAssembly in Chrome, Edge or Chromium</li>
                    <li>A .NET debugger of Codalus IDE's own, as a preview beside netcoredbg: exit codes on macOS, casts and C#'s operators in expressions</li>
                </ul>
            </div>
            <div class="card lift reveal" id="git-and-hosting">
                <h3>Git and hosting</h3>
                <ul>
                    <li>Per-file, per-change and per-line staging, from Git Changes or the diff, and blame</li>
                    <li>Diffs and the merge editor in the editor's colors</li>
                    <li>A branch drop-down in Git Changes: search, outgoing and incoming counts, and each branch's own menu (checkout, merge, rebase, update, push, rename, delete, compare)</li>
                    <li>Update a branch from its remote without checking it out</li>
                    <li>Fetch, pull, push and sync show in Git Changes while they run, with Cancel, as in the classic IDE</li>
                    <li>Solutions in several repositories, all in Git Changes at once: a tree per repository, Commit All Repos, fetch, pull and push in each, and the branches every repository has</li>
                    <li>A folder's menu in Git Changes, as in the classic IDE: stage, discard, stash, ignore, history, reveal, terminal, copy path</li>
                    <li>A history graph and interactive rebase</li>
                    <li>A 3-way merge editor: check boxes beside each conflict, the merge base in the result, both versions scrolling with it</li>
                    <li>Stash, tags, remotes, worktrees and Git LFS</li>
                    <li>Pull requests, with review comments in the editor</li>
                    <li>GitHub, Azure DevOps and GitLab, and their own servers: Azure DevOps Server found from the remote, signed in to with your Windows account</li>
                    <li>Create a pull request from Git Changes, signing in first when you need to</li>
                </ul>
            </div>
            <div class="card lift reveal" id="web">
                <h3>Web</h3>
                <ul>
                    <li>Razor and Blazor, with C# features inside the markup and components and their parameters, HTML and directives each in their own color</li>
                    <li>.http files, the HTTP Response window (the status as a chip, the body pretty or raw, the headers, a history of requests) and an Endpoints Explorer</li>
                    <li>HTML, CSS, JavaScript and TypeScript language servers</li>
                    <li>ESLint, Prettier, npm scripts and the Task Runner Explorer</li>
                    <li>Hot Reload through dotnet watch, and while debugging Blazor WebAssembly components, standalone or in a Blazor Web App (its server under dotnet watch with the debugger attached)</li>
                    <li>Scaffolding, OpenAPI and gRPC service references, the dev certificate and user secrets</li>
                </ul>
            </div>
            <div class="card lift reveal" id="data-containers-and-cloud">
                <h3>Data, containers and cloud</h3>
                <ul>
                    <li>EF Core migrations, model views and reverse engineering</li>
                    <li>A Database Explorer for SQL Server, PostgreSQL, MySQL and SQLite</li>
                    <li>A query editor with plans and history, a SQL language service and .sqlproj builds</li>
                    <li>Run and debug in containers with docker or podman; Add Docker Support; Compose up, down and debug</li>
                    <li>Aspire AppHosts and their resources</li>
                    <li>Publish profiles, including container images</li>
                </ul>
            </div>
            <div class="card lift reveal" id="make-it-yours">
                <h3>Make it yours</h3>
                <ul>
                    <li>A first-run setup: the theme family and mode, previewed live, the keyboard scheme, your settings from VS Code, a .vssettings file or settings sync, a check of the .NET SDK and git, and the system integration you want, before the start window</li>
                    <li>Classic's Blue, Light, Dark and High Contrast, the default, with the classic IDE's rounded cards and editor colors, and four theme families, Harbor, Graphite, Daylight and Ember, each Light, Dark and High contrast, chosen from pictures in Options</li>
                    <li>Fonts and Colors over any theme, for code, the editor and the window</li>
                    <li>Default, VS Code, ReSharper and Emacs keyboard schemes</li>
                    <li>Import from VS Code or a .vssettings file; export to one file</li>
                    <li>Profiles, and settings sync with a folder or a Git repository</li>
                    <li>Customize menus and toolbars; saved window layouts and distraction-free mode</li>
                    <li>Opt-in system integration, off until you choose it and removable: Open with Codalus IDE on a folder's right-click (File Explorer, the Finder, GNOME Files, Dolphin, Nemo, Thunar), and solutions and project files that open in Codalus IDE</li>
                </ul>
            </div>
            <div class="card lift reveal" id="ai-assistance-your-way">
                <h3>AI assistance, your way</h3>
                <ul>
                    <li>Off until you turn it on, with no telemetry; nothing is sent until you choose a provider</li>
                    <li>OpenAI-compatible servers, Ollama on your machine, Anthropic, or a provider plugin; your key in the OS credential store</li>
                    <li>AI Chat with the context you choose as chips: the selection, files, errors, build output and the solution's projects, shown with each question</li>
                    <li>Answers in rendered Markdown, with code blocks in your editor's colors: copy them, insert them at the cursor, or apply them over the selection or the file after a preview</li>
                    <li>Inline suggestions and next edit suggestions, each with its own switch</li>
                    <li>Commit messages, pull request descriptions, Ask AI on an exception, a value at a stop or a failing test, Fix with AI and Explain with AI in quick actions and the Error List, tests for the selection, and profile summaries</li>
                    <li>Agent mode, one switch: it reads, searches, builds, edits and runs commands, each step shown in the chat, every change in a preview and every command after you allow it</li>
                    <li>MCP: your MCP servers' tools in agent mode, and <code>codalus mcp</code> for agents outside the IDE</li>
                    <li>External agents in AI Chat over the Agent Client Protocol (Claude, Codex, Gemini CLI, GitHub Copilot, pi, OpenCode, goose, your own CLIs): Codalus serves their file, terminal and permission requests with its own checks, gives each one the IDE's tools, and offers the agent's own model, mode and effort choices</li>
                    <li>Connect to Claude, Codex, Gemini CLI or GitHub Copilot from AI Chat in one dialog: it finds or installs Node.js with your own package manager, signs the agent in (Claude subscription through Claude Code's own login, or an API key kept in the OS credential store), tests the connection in an empty folder, and only then saves it; Disconnect undoes it</li>
                    <li>Files .gitignore or a .codalusignore excludes, and secrets, are never sent; a request log of what was</li>
                </ul>
            </div>
            <div class="card lift reveal" id="net-maui">
                <h3>.NET MAUI</h3>
                <ul>
                    <li>Android devices and emulators on Windows, Linux and macOS; iOS simulators, iPhones and Mac Catalyst on macOS; Windows Machine (the Windows target) on Windows</li>
                    <li>A device picker on the toolbar and a Devices window: start emulators, boot simulators, choose where the app runs</li>
                    <li>Build, deploy and run with the platform SDK's own run target</li>
                    <li>Debug on Android devices and emulators, iOS simulators and Mac Catalyst with our own Mono debugger: breakpoints, stepping, locals, watch and exceptions</li>
                    <li>MAUI XAML: completion, compiled binding paths from x:DataType, live errors, hover and Go to Definition</li>
                    <li>The MAUI workloads, the Android SDK and a JDK installed when you agree, and listed in Check Environment</li>
                    <li>The Windows target runs and debugs as a desktop app (netcoredbg, Hot Reload with dotnet watch), packaged or unpackaged</li>
                </ul>
            </div>
            <div class="card lift reveal" id="wpf-windows-forms-and-winui-3">
                <h3>WPF, Windows Forms and WinUI 3</h3>
                <ul>
                    <li>WPF and Windows Forms projects open, edit and build on Windows, Linux and macOS</li>
                    <li>Run, debug, test and Hot Reload them on Windows; elsewhere the IDE says they're Windows only</li>
                    <li>WPF XAML: completion of controls, dependency and attached properties, markup extensions, styles, triggers and resources through App.xaml and merged dictionaries</li>
                    <li>Binding paths from d:DataContext, checked as warnings; the markup compiler's errors in their XAML files</li>
                    <li>Go to Definition, hover, x:Name rename into the code-behind, and formatting</li>
                    <li>On Windows, the XAML Previewer draws WPF XAML on your app's own WPF as you type: design-time data from d:DesignInstance, the design size, zoom and scale, and a click selects the element's tag</li>
                    <li>On Windows, the Live Visual Tree and Live Property Explorer for running WPF apps: logical and visual trees, dependency property values with their sources, values set live, highlight, pick and Go to XAML</li>
                    <li>On Windows, the Windows Forms designer on your app's own Windows Forms: select, move, resize, nudge, copy and paste controls, the Toolbox with an icon for every control and your own controls, the Properties window and its Events view</li>
                    <li>The Properties window as the classic IDE's: categories that collapse, Font, Location, Size and Padding opened into their parts (each written as one assignment), color, alignment, multi-line text, shortcut key and date drop-downs, the font editor, the String Collection Editor and Select Resource, choices for AcceptButton and Cursor, Reset, and a component list</li>
                    <li>Drag, click or double-click from the Toolbox (or press Enter on an item) to add controls, into the selected container as in the classic IDE</li>
                    <li>Build while a form is open: the designer runs on a copy of your build output, as the classic IDE does, and loads the form on the new build after it</li>
                    <li>Snap lines, the Format menu (align, make same size, spacing, center, bring to front and send to back, Lock Controls), tab order mode, Dock and Anchor pickers and adorners</li>
                    <li>Smart tags with the designers' tasks, menus and tool strips edited in place with Type Here, the component tray, and collection editors for items, columns, tab pages and table styles</li>
                    <li>The designer's context menu as in the classic IDE: the designers' own commands (Add Tab, Edit Items...), Bring to Front and Send to Back, Align to Grid, Lock Controls, Select the parent, Cut, Copy, Paste, Delete and Properties, grayed when they don't apply; Edit's commands and Select All in the designer</li>
                    <li>Localizable forms designed per language into each culture's .resx, images imported into the form's or the project's resources, extender properties such as ToolTip on toolTip1, and data binding to a BindingSource's members</li>
                    <li>The designer writes InitializeComponent as the classic IDE does, as the smallest edit of the designer file: undo, local history and source control see only what changed; code it can't read opens as code with the reason</li>
                    <li>New WPF and Windows Forms projects; windows, pages, user controls, resource dictionaries and forms in Add New Item, nested with their code-behind</li>
                    <li>WinUI 3 apps open and edit everywhere, and build, run, debug and Hot Reload on Windows; packaged (MSIX) apps are registered, started by Windows and attached to, with Developer Mode explained when it's off</li>
                    <li>WinUI XAML: x:Bind paths checked against the page's class as errors, x:Load and x:DefaultBindMode, ThemeResource and resources through App.xaml's merged dictionaries, WinUI's compiler errors in their files</li>
                </ul>
            </div>
            <div class="card lift reveal" id="net-framework">
                <h3>.NET Framework</h3>
                <ul>
                    <li>net48, net472 and the other .NET Framework projects open, restore and build on Windows, Linux and macOS, with no targeting pack: the reference assemblies come from NuGet</li>
                    <li>Old-style (non-SDK-style) projects too: packages.config restored, a Dependencies node of their references, hint paths and packages, built with the .NET SDK's MSBuild</li>
                    <li>C# 7.3 in the editor, as the compiler uses it, and binding redirects generated for executables</li>
                    <li>Convert to SDK-Style: an old-style project rewritten as an SDK-style one, packages.config as package references and AssemblyInfo.cs as properties, after a preview of every change</li>
                    <li>Run and debug .NET Framework apps on Windows with our own .NET Framework debugger, on the debugging API that comes with the .NET Framework: breakpoints with conditions, stepping with Just My Code, call stack, threads, locals and watch with C# expressions and method calls, exceptions, and Attach to Process; elsewhere the IDE says it's Windows only</li>
                    <li>xUnit, NUnit and MSTest tests on .NET Framework in the Test Explorer on Windows, old-style test projects included: discover, run and debug</li>
                    <li>Projects that need the classic IDE's own targets (ASP.NET web applications) open with IntelliSense and say why they don't build</li>
                    <li>New .NET Framework console apps and class libraries, and the installed .NET Framework in Check Environment</li>
                </ul>
            </div>
            <div class="card lift reveal" id="visual-basic">
                <h3>Visual Basic</h3>
                <ul>
                    <li>Completion, Quick Info, signature help and live errors, from the same language service as C#</li>
                    <li>C# and VB projects in one solution: Go to Definition, Find All References and rename across both</li>
                    <li>End If, Next and End Sub added as you press Enter, keyword casing fixed, XML literals' end tags closed</li>
                    <li>Quick fixes and refactorings, formatting, the outline, folding and snippets</li>
                    <li>New Project in Visual Basic, VB item templates, and Option Strict, Explicit, Infer and Compare on the project's properties</li>
                    <li>VB tests in the Test Explorer, and debugging with breakpoints, stepping and locals</li>
                </ul>
            </div>
            <div class="card lift reveal" id="fsharp">
                <h3>F#</h3>
                <ul>
                    <li>FsAutoComplete, Ionide's language server, installed for you: completion with unopened namespaces, Quick Info, live errors and FSharpLint</li>
                    <li>Navigation, rename, quick fixes, inlay hints and signature CodeLens</li>
                    <li>Fantomas formatting with your .editorconfig</li>
                    <li>Solution Explorer in compile order: Move Up, Move Down, Add Above and Add Below; signature files under their implementation</li>
                    <li>F# Interactive in the terminal: send a selection, a line, a file or a project's references; reset</li>
                    <li>Scripts with #load and #r "nuget:", type providers, F# analyzers</li>
                    <li>Expecto, xUnit and NUnit tests in the Test Explorer; debugging F#</li>
                    <li>F# item templates and project properties</li>
                </ul>
            </div>
            <div class="card lift reveal" id="wcf">
                <h3>WCF</h3>
                <ul>
                    <li>Add Service Reference with your dotnet-svcutil: from a service's metadata, a WSDL file or a CoreWCF service you run</li>
                    <li>Namespace, collection types, synchronous operations, type reuse and access; Update and Remove</li>
                    <li>References kept as the classic IDE keeps them: Connected Services and ConnectedService.json</li>
                    <li>CoreWCF services from CoreWCF's templates in New Project</li>
                    <li>A WCF Test Client: operations with their signatures, a typed form per operation or raw XML, responses as a tree and faults as chips; BasicHttpBinding and WSHttpBinding</li>
                    <li>system.serviceModel completion, hover and checks in app.config and web.config</li>
                </ul>
            </div>
            <div class="card lift reveal" id="and-more">
                <h3>And more</h3>
                <ul>
                    <li>Remote development over SSH, in WSL and in containers; Dev Containers; reconnecting after a network drop; the Test Explorer and workspace plugins on the remote machine; tests in WSL, Docker or over SSH</li>
                    <li>Profiling: counters, CPU traces and flame graphs, memory snapshots and diffs, allocations, .NET Async, threads, exceptions, file I/O and BenchmarkDotNet</li>
                    <li>Avalonia XAML editing, a live previewer and the Live Visual Tree</li>
                    <li>An integrated terminal and C# Interactive</li>
                    <li>About forty languages highlighted; JSON and YAML schemas</li>
                    <li>Any LSP language server through a plugin</li>
                    <li>A stable plugin API (1.0): themes and file icon themes in VS Code's formats, debug adapters, declarative views and custom editors, file system, sign-in and source control providers</li>
                    <li>Plugin development: a dotnet new template, in-memory plugin tests, debugging a plugin in a development instance, and a generated API reference</li>
                    <li>A Plugin Gallery on NuGet: search, install with the plugin's permissions and signature shown first, automatic updates, and Bisect Plugins to find the one behind a problem</li>
                    <li>Components: everything downloaded on demand, with versions, sizes and licences, and offline layouts for machines without internet access</li>
                    <li>Running tasks in the status bar: loading projects, restores and builds, with a progress bar and cancel</li>
                    <li>Report a Problem and Suggest a Feature on the Help menu: a GitHub issue filled in for you, with exactly what's attached shown first (the version, the OS and the IDE's log, redacted), opened in your browser to submit yourself</li>
                </ul>
            </div>
        </div>
        <div class="rule-note">
            <p><strong>Not there yet:</strong> Dev Containers' features and Compose-based Dev Containers, Hot Reload while debugging server-side code, and translations of the interface.</p>
            <a class="link-arrow" href="@Site.Blob("docs/roadmap.md")">See the roadmap <Icon Name="arrow" Size="16" /></a>
        </div>
    </section>

    <section class="section" aria-labelledby="cta">
        <div class="band reveal">
            <div class="band-text">
                <h2 id="cta">All of it, in one download.</h2>
            </div>
            <a class="button button-light" href="download/" data-download-os><span data-label>Download for your platform</span></a>
        </div>
    </section>
</div>

@code {
    private sealed record Shot(string Key, string Label, string File, string Alt, string Caption);

    /// <summary>The areas of "Everything in the box", by their cards' ids, for the links above them.</summary>
    private static readonly (string Id, string Title)[] s_areas =
    [
        ("editor", "Editor"),
        ("navigation", "Navigation"),
        ("solutions-and-nuget", "Solutions and NuGet"),
        ("build-run-and-test", "Build, run and test"),
        ("debugging", "Debugging"),
        ("git-and-hosting", "Git and hosting"),
        ("web", "Web"),
        ("data-containers-and-cloud", "Data, containers and cloud"),
        ("make-it-yours", "Make it yours"),
        ("ai-assistance-your-way", "AI assistance"),
        ("net-maui", ".NET MAUI"),
        ("wpf-windows-forms-and-winui-3", "WPF, Windows Forms and WinUI 3"),
