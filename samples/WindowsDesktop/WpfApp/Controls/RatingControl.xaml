<UserControl x:Class="WpfApp.Controls.RatingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WpfApp.Controls"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="120" d:DesignHeight="24">
    <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Value, ElementName=Root}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
        <TextBlock Text=" / " />
        <TextBlock Text="{Binding Maximum, RelativeSource={RelativeSource AncestorType={x:Type local:RatingControl}}}" />
    </StackPanel>
</UserControl>
