<Project Sdk="Microsoft.NET.Sdk">
  <!-- A WinUI 3 app (Windows App SDK, M44). Unpackaged by default; build with -p:WinUIAppPackaged=true (or set it in the
       project) for the packaged (MSIX) variant. It edits on every OS; it builds, runs and debugs on Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinUIApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType Condition="'$(WinUIAppPackaged)' != 'true'">None</WindowsPackageType>
    <!-- Unpackaged, the app carries the Windows App SDK runtime (no install needed), which needs a runtime identifier:
         this machine's, as the .NET MAUI templates pick it. -->
    <WindowsAppSDKSelfContained Condition="'$(WinUIAppPackaged)' != 'true'">true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('windows'))">win-$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.png" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.8249" />
  </ItemGroup>

  <!-- The "Msix" capability lets MSIX tooling recognize the project before its packages are restored. -->
  <ItemGroup Condition="'$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
</Project>
