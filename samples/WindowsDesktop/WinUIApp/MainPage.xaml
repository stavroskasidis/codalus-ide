<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WinUIApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WinUIApp.Models"
    xmlns:controls="using:WinUIApp.Controls"
    mc:Ignorable="d"
    x:DefaultBindMode="OneWay"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <DataTemplate x:Key="TodoTemplate" x:DataType="models:TodoItem">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <CheckBox IsChecked="{x:Bind IsDone, Mode=TwoWay}" MinWidth="0" />
                <TextBlock Text="{x:Bind Title}" Style="{StaticResource ItemText}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Grid Margin="{StaticResource PagePadding}" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NewTitleBox" Text="{x:Bind ViewModel.NewTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="What is there to do?" />
            <Button Grid.Column="1" Content="Add" Command="{x:Bind ViewModel.AddCommand}" Style="{StaticResource AccentButton}" Click="OnAddClicked" />
        </Grid>
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" ItemTemplate="{StaticResource TodoTemplate}" SelectionMode="None" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{x:Bind FormatRemaining(ViewModel.RemainingCount)}" Foreground="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
            <controls:RatingControl Value="{x:Bind ViewModel.Rating, Mode=TwoWay}" Maximum="5" ToolTipService.ToolTip="Rating" />
            <TextBlock x:Name="TypingHint" x:Load="{x:Bind ViewModel.IsTyping}" Text="{x:Bind NewTitleBox.Text}" Foreground="{StaticResource DoneBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
