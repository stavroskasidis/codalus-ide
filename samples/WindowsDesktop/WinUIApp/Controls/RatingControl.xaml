<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinUIApp.Controls.RatingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <Slider x:Name="ValueSlider" Minimum="0" Maximum="{x:Bind Maximum, Mode=OneWay}" Value="{x:Bind Value, Mode=TwoWay}" Width="96" />
        <TextBlock Text="{x:Bind Value, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
</UserControl>
