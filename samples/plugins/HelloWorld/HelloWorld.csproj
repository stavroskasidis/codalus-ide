<Project Sdk="Microsoft.NET.Sdk">
  <!-- A sample third-party Codalus IDE plugin (see docs/plugins.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HelloWorld</AssemblyName>
    <RootNamespace>HelloWorld</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <!-- The host provides the API at runtime, so it is not copied next to the plugin. -->
    <ProjectReference Include="..\..\..\src\Codalus.Plugins.Abstractions\Codalus.Plugins.Abstractions.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <None Update="codalus-plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
