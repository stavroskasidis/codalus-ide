{
  "id": "daedalus-samples.hello",
  "version": "1.0.0",
  "displayName": "Hello World",
  "publisher": "daedalus-samples",
  "description": "A sample plugin that exercises every v0 contribution point.",
  "engines": { "daedalus": "^0.2.0" },
  "entry": { "runtime": "dotnet", "assembly": "HelloWorld.dll" },
  "activationEvents": [ "onSettingChanged:hello.announce" ],
  "contributes": {
    "commands": [
      { "id": "hello.sayHello", "title": "Say Hello", "category": "Hello" },
      { "id": "hello.echo", "title": "Echo Arguments", "category": "Hello" },
      { "id": "hello.refresh", "title": "Refresh", "category": "Hello" },
      { "id": "hello.callShell", "title": "Call a Shell Command (test)", "category": "Hello" },
      { "id": "hello.crashHost", "title": "Crash the Plugin Host (test)", "category": "Hello" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "hello.sayHello" },
        { "command": "hello.refresh" },
        { "command": "hello.crashHost", "when": "isDevelopment" }
      ],
      "menuBar/tools": [ { "command": "hello.sayHello", "group": "plugins", "order": 1 } ],
      "toolWindow/title": [ { "command": "hello.refresh", "when": "focusedView == hello.view" } ]
    },
    "keybindings": [
      { "key": "ctrl+alt+h", "mac": "cmd+alt+h", "command": "hello.sayHello" }
    ],
    "toolWindows": [
      { "id": "hello.view", "title": "Hello", "location": "right", "kind": "tree", "icon": "info" }
    ],
    "settings": {
      "title": "Hello World",
      "properties": {
        "hello.greeting": { "type": "string", "default": "Hello", "description": "The greeting to use." },
        "hello.times": { "type": "integer", "default": 1, "minimum": 1, "maximum": 5, "description": "How many greetings the view lists." },
        "hello.announce": { "type": "boolean", "default": false, "description": "Show a notification when this setting is turned on." }
      }
    }
  }
}
