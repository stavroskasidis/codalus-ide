<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A sample declarative plugin (docs/plugins.md, ADR 0016): a language, its TextMate grammar and configuration, and an
    LSP server. The plugin has no code that Daedalus loads; this project builds the language server, and its output
    folder is the plugin (daedalus-plugin.json next to TodoLanguage.dll).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TodoLanguage</AssemblyName>
    <RootNamespace>TodoLanguage</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <None Update="daedalus-plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="language-configuration.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="syntaxes\todo.tmLanguage.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
