{
  "id": "daedalus-samples.todo",
  "version": "1.0.0",
  "displayName": "Todo Lists",
  "publisher": "daedalus-samples",
  "description": "A sample declarative plugin: the .todo language with a TextMate grammar and an LSP server.",
  "engines": { "daedalus": "^0.2.4" },
  "contributes": {
    "languages": [
      { "id": "todo", "aliases": [ "Todo", "todo" ], "extensions": [ ".todo" ], "filenames": [ "TODO" ], "configuration": "language-configuration.json" }
    ],
    "grammars": [
      { "language": "todo", "scopeName": "source.todo", "path": "syntaxes/todo.tmLanguage.json" }
    ],
    "languageServers": [
      { "id": "todo-server", "name": "Todo", "languages": [ "todo" ], "command": "TodoLanguage.dll", "settingsSection": "todo" }
    ],
    "settings": {
      "title": "Todo Lists",
      "properties": {
        "todo.tags": { "type": "array", "default": [ "today", "later", "bug" ], "description": "Tags offered after @ in .todo files." }
      }
    }
  }
}
