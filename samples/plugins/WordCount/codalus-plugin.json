{
  "id": "codalus-samples.word-count",
  "version": "1.0.0",
  "displayName": "Word Count",
  "publisher": "codalus-samples",
  "description": "A sample tool for AI agents: counts the words of a text.",
  "engines": { "codalus": "^1.2.0" },
  "entry": { "runtime": "dotnet", "assembly": "WordCount.dll" },
  "enableProposedApi": true,
  "contributes": {
    "aiTools": [
      {
        "name": "count_words",
        "description": "Count the words of a text, and its most frequent word.",
        "inputSchema": {
          "type": "object",
          "properties": { "text": { "type": "string", "description": "The text." } },
          "required": [ "text" ]
        }
      }
    ]
  }
}
