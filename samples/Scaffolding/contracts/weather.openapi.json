{
  "openapi": "3.0.1",
  "info": { "title": "Weather", "version": "v1" },
  "paths": {
    "/weatherforecast": {
      "get": {
        "operationId": "GetWeatherForecast",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/WeatherForecast" } }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "temperatureC": { "type": "integer", "format": "int32" },
          "summary": { "type": "string", "nullable": true }
        }
      }
    }
  }
}
