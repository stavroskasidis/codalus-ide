<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Weather.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- A type provider: its design-time code runs in FsAutoComplete, which runs only in trusted folders. -->
    <PackageReference Include="FSharp.Data" Version="8.2.0" />
  </ItemGroup>
</Project>
