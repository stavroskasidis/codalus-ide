@page "/counter"
@implements IDisposable
@rendermode InteractiveWebAssembly

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private readonly CancellationTokenSource stopping = new();
    private int ticks;
    private int currentCount;

    protected override void OnInitialized()
    {
        // Prerendered on the server first, then run again in the browser.
        currentCount = Start(); // [initialized]
    }

    private static int Start() => OperatingSystem.IsBrowser() ? 1 : 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Interactive only: a tick every half second, where a debugger that attached after OnInitialized ran still stops.
        if (firstRender)
        {
            try
            {
                while (true)
                {
                    await Task.Delay(500, stopping.Token);
                    Tick();
                }
            }
            catch (OperationCanceledException)
            {
            }
        }
    }

    private void Tick()
    {
        ticks++; // [tick]
    }

    public void Dispose() => stopping.Cancel();

    private void IncrementCount()
    {
        currentCount++; // [increment]
    }
}
