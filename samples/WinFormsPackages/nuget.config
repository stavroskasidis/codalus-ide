<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The control library's packages come only from the local feed the tests pack them into (README.md), and restore
       into a folder of the fixture's own, so the machine's package cache never holds them. -->
  <config>
    <add key="globalPackagesFolder" value=".packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local" value="feed" />
  </packageSources>
</configuration>
