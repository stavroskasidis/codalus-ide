<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Daedalus.Spike.Avalonia"
             x:Class="Daedalus.Spike.Avalonia.SolutionExplorerView"
             x:DataType="local:SolutionExplorerTool">
  <TreeView x:Name="Tree"
            ItemsSource="{Binding Roots}"
            AutomationProperties.Name="Solution Explorer">
    <TreeView.Styles>
      <Style Selector="TreeViewItem" x:DataType="local:SolutionNodeViewModel">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      </Style>
    </TreeView.Styles>
    <TreeView.ItemTemplate>
      <TreeDataTemplate DataType="local:SolutionNodeViewModel" ItemsSource="{Binding Children}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding Glyph}" Opacity="0.7" />
          <TextBlock Text="{Binding Name}" />
        </StackPanel>
      </TreeDataTemplate>
    </TreeView.ItemTemplate>
  </TreeView>
</UserControl>
