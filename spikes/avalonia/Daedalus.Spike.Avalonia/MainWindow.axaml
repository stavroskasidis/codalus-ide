<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Daedalus.Spike.Avalonia"
        x:Class="Daedalus.Spike.Avalonia.MainWindow"
        x:DataType="local:ShellViewModel"
        Title="Daedalus Studio — spike A (Avalonia)"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="#FF007ACC" Padding="8,2">
      <TextBlock Text="{Binding Status}" Foreground="White" FontSize="12"
                 AutomationProperties.LiveSetting="Polite" />
    </Border>
    <DockControl x:Name="Dock" Layout="{Binding Layout}" Factory="{Binding Factory}" />
  </DockPanel>
</Window>
