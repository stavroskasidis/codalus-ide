<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The environment variable DebuggeeTfms="net9.0;net10.0" builds only what the installed SDK can (run.sh's DEBUGGEE_TFMS). -->
    <DebuggeeTfms Condition="'$(DebuggeeTfms)' == ''">net9.0;net10.0;net11.0</DebuggeeTfms>
    <TargetFrameworks>$(DebuggeeTfms)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
