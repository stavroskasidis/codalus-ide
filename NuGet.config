<?xml version="1.0" encoding="utf-8"?>
<!--
  The repository's package sources: nuget.org for everything. Roslyn came from the .NET team's dotnet-tools feed until
  the .NET 11 SDK's 5.12 was published on nuget.org (M65, 2026-11-19; docs/release/dotnet-upgrade.md).
  Fixtures under samples/ are copied out of the repository by the tests, so this file doesn't apply to them there.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
