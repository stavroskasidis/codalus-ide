<?xml version="1.0" encoding="utf-8"?>
<!--
  The repository's package sources. nuget.org for everything; the .NET team's public dotnet-tools feed only for the
  Roslyn packages, because the compiler of the .NET 11 release candidate SDK (M30b) isn't on nuget.org until GA.
  TODO(issue): at .NET 11 GA, take Roslyn from nuget.org and remove the dotnet-tools source (docs/release/dotnet-upgrade.md).
  Fixtures under samples/ are copied out of the repository by the tests, so this file doesn't apply to them there.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="dotnet-tools" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-tools/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Microsoft.CodeAnalysis.*" />
    </packageSource>
    <packageSource key="dotnet-tools">
      <package pattern="Microsoft.CodeAnalysis.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
